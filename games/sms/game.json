{
  "id": "sms",
  "displayName": "Super Mario Sunshine",
  "kind": "doldecomp-sms",
  "repoRoot": "./workspace/checkout",
  "stateDir": "./runtime/state",
  "graphDb": "./knowledge/graph/graph.sqlite",
  "processName": "sms-live",
  "baseRef": "upstream/main",
  "localEnv": "./config/local.env",
  "pr": {
    "groupMode": "directory",
    "titlePrefix": "SMS decomp",
    "branchPrefix": "decomp"
  },
  "knowledge": {
    "globalSources": [
      "past_prs",
      "decomp_standards"
    ],
    "gameSources": [
      "code_graph"
    ]
  },
  "tools": {
    "toolpacks": [
      "gamecube-decomp"
    ],
    "bindingsRoot": "./config/tools",
    "sharedDataRoot": "./runtime/tool-data",
    "worktreeCacheRoot": "./runtime/tool-data/claims/{worktree_id}",
    "toolsRoot": "./runtime/tools"
  },
  "config": {
    "build": "./config/build.json",
    "sources": [
      "./config/sources/prs.json",
      "./config/sources/discord.json",
      "./config/sources/wiki.json"
    ],
    "sandbox": "./config/sandbox.json"
  }
}
