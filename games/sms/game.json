{
  "id": "sms",
  "displayName": "Super Mario Sunshine",
  "kind": "doldecomp-sms",
  "repoRoot": "./checkout",
  "stateDir": "./state",
  "graphDb": "./graph/graph.sqlite",
  "processName": "sms-live",
  "baseRef": "upstream/main",
  "localEnv": "./local.env",
  "validation": {
    "qaTarget": "changes_all",
    "reportPath": "build/GMSP01/report.json",
    "reportChangesPath": "build/GMSP01/report_changes.json",
    "objdiffPath": "objdiff.json",
    "workerSectionParityGate": true,
    "workerUndefinedSymbolGate": true,
    "workerBannedIdiomGate": true
  },
  "dashboard": {
    "agentTimeoutSeconds": 3600,
    "goalValue": 100
  },
  "pr": {
    "groupMode": "sms-subsystem",
    "titlePrefix": "SMS decomp",
    "branchPrefix": "decomp",
    "maxFilesPerPr": 8,
    "splitStrategy": "deterministic",
    "improvementMinGainPoints": 2.0,
    "improvementMinMatchedBytes": 64
  },
  "knowledge": {
    "globalSources": [
      "past_prs",
      "path_facts"
    ],
    "gameSources": [
      "code_graph"
    ]
  },
  "tools": {
    "toolpacks": [
      "gamecube-decomp"
    ],
    "bindingsRoot": "./tool-bindings",
    "sharedDataRoot": "./shared/tool-data",
    "worktreeCacheRoot": "./worktrees/{worktree_id}/tool-cache"
  }
}
