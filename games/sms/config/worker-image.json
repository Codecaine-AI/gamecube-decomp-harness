{
  "pip_packages": ["clang-format==21.1.8"],
  "linux_tools": [
    {"name": "dtk", "output": "build/tools/dtk", "tag": "v1.3.0"},
    {"name": "binutils", "output": "build/binutils", "tag": "2.42-1"}
  ],
  "configure_args": ["--map", "--version", "GMSJ01", "--wrapper", "build/tools/wibo", "--dtk", "build/tools/dtk", "--objdiff", "build/tools/objdiff-cli"],
  "build_targets": ["all_source", "progress", "build/GMSJ01/report.json"],
  "verification_commands": [
    ["sha1sum", "-c", "config/GMSJ01/build.sha1"],
    ["clang-format", "--version"],
    ["test", "-x", "build/tools/wibo-real"]
  ]
}
