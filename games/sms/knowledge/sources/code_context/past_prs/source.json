{
  "id": "past_prs",
  "kind": "pr_corpus",
  "title": "Past PR corpus",
  "trust_tier": "historical",
  "freshness": "refreshable",
  "section": "code_context",
  "access_modes": [
    "refreshable_corpus",
    "file_edges",
    "review_risks",
    "graph_search",
    "source_search"
  ],
  "description": "Historical PR dump, changed files, PR text, review comments, diffs, and generated postmortems.",
  "data_paths": [
    "games/sms/knowledge/sources/code_context/past_prs/data"
  ],
  "index_outputs": [
    "games/sms/knowledge/sources/code_context/past_prs/indexes/prs.jsonl",
    "games/sms/knowledge/sources/code_context/past_prs/indexes/pr_file_edges.jsonl",
    "games/sms/knowledge/sources/code_context/past_prs/indexes/file_rollups.jsonl"
  ],
  "commands": {
    "status": "python3 games/sms/knowledge/sources/code_context/past_prs/api/status.py --json",
    "refresh": "python3 games/sms/knowledge/sources/code_context/past_prs/commands/fetch_recent_pr_dump.py",
    "index": "bun run kg:rebuild -- --game sms --sources past_prs",
    "search": "python3 games/sms/knowledge/sources/code_context/past_prs/api/search.py --query <query> --json",
    "graph_search": "bun run kg:search -- --game sms --source past_prs --query <query>"
  },
  "capabilities": [
    "search",
    "file_edges",
    "review_risks",
    "tactic_synthesis"
  ]
}
