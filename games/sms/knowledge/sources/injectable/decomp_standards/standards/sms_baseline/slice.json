{
  "family": "sms_baseline",
  "standards": [
    "global_standard:sms-authored-evidence",
    "global_standard:sms-cpp-format",
    "global_standard:sms-game-code-only",
    "global_standard:sms-initial-sweep-scope",
    "global_standard:sms-map-research",
    "global_standard:sms-map-symbols",
    "global_standard:sms-name-review",
    "global_standard:sms-names-types-helpers",
    "global_standard:sms-regression-evidence",
    "global_standard:sms-stack-independent-matching",
    "global_standard:sms-temporary-tactics"
  ],
  "rules": [
    {
      "rule_id": "sms_vendor_edit",
      "standard_id": "global_standard:sms-game-code-only",
      "severity": "error",
      "applies_to": [
        "src/**",
        "include/**"
      ],
      "message": "Autonomous SMS changes must stay in game code."
    },
    {
      "rule_id": "sms_dummy_stack_padding",
      "standard_id": "global_standard:sms-temporary-tactics",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "Dummy stack padding may not be committed."
    },
    {
      "rule_id": "sms_name_change_requires_review",
      "standard_id": "global_standard:sms-name-review",
      "severity": "error",
      "applies_to": [
        "src/**",
        "include/**",
        "config/GMSJ01/symbols.txt"
      ],
      "message": "Name changes require maintainer review."
    },
    {
      "rule_id": "sms_symbol_map_validation",
      "standard_id": "global_standard:sms-map-symbols",
      "severity": "error",
      "applies_to": [
        "src/*.cpp"
      ],
      "message": "Changed C++ units require built symbol-map validation."
    }
  ]
}
