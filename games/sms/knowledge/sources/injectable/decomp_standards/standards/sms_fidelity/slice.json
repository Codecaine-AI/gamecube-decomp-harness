{
  "family": "sms_fidelity",
  "standards": [
    "global_standard:sms-pch-string-convention",
    "global_standard:sms-fabricated-marker",
    "global_standard:sms-no-agent-comments",
    "global_standard:sms-accessor-evidence",
    "global_standard:avoid-pragmas-register-asm",
    "global_standard:literals-and-data-ownership",
    "global_standard:no-inert-emission"
  ],
  "rules": [
    {
      "rule_id": "sms_local_class_needs_owner",
      "standard_id": "global_standard:sms-authored-evidence",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "File-scope classes in a .cpp need a header owner."
    },
    {
      "rule_id": "sms_pch_string_convention",
      "standard_id": "global_standard:sms-pch-string-convention",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "Include the PCH dummy-string headers instead of copying them."
    },
    {
      "rule_id": "sms_fabricated_marker",
      "standard_id": "global_standard:sms-fabricated-marker",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "Fabricated pragmas, helpers and expanded inlines are rejected; marker comments do not exempt them."
    },
    {
      "rule_id": "sms_intrinsic_bypass",
      "standard_id": "global_standard:sms-authored-evidence",
      "severity": "warning",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "MSL intrinsic bypasses need binary evidence."
    },
    {
      "rule_id": "sms_dummy_vec_helper",
      "standard_id": "global_standard:sms-pch-string-convention",
      "severity": "warning",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "dummy(Vec*) needs its emitted-symbol comment."
    },
    {
      "rule_id": "sms_agent_comment",
      "standard_id": "global_standard:sms-no-agent-comments",
      "severity": "error",
      "applies_to": [
        "src/**",
        "include/**"
      ],
      "message": "Agent-written comments (TODO, nonmatching, fakematch, frame notes) are rejected in SMS."
    },
    {
      "rule_id": "sms_accessor_evidence",
      "standard_id": "global_standard:sms-accessor-evidence",
      "severity": "warning",
      "llm_review": true,
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "Accessor and inline swaps need evidence that the accessor exists in the original."
    }
  ]
}
