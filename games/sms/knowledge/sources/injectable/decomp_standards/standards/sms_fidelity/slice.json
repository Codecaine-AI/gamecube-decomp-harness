{
  "family": "sms_fidelity",
  "standards": [
    "global_standard:sms-pch-string-convention",
    "global_standard:sms-fabricated-marker",
    "global_standard:sms-no-agent-comments",
    "global_standard:sms-accessor-evidence",
    "global_standard:avoid-pragmas-register-asm",
    "global_standard:literals-and-data-ownership",
    "global_standard:no-inert-emission",
    "global_standard:sms-plain-code",
    "global_standard:sms-no-steering"
  ],
  "rules": [
    {
      "rule_id": "sms_local_class_needs_owner",
      "standard_id": "global_standard:sms-authored-evidence",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "File-scope classes in a .cpp need a header owner."
    },
    {
      "rule_id": "sms_pch_string_convention",
      "standard_id": "global_standard:sms-pch-string-convention",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "Include the PCH dummy-string headers instead of copying them."
    },
    {
      "rule_id": "sms_fabricated_marker",
      "standard_id": "global_standard:sms-fabricated-marker",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "Fabricated pragmas, helpers and expanded inlines are rejected; marker comments do not exempt them."
    },
    {
      "rule_id": "sms_intrinsic_bypass",
      "standard_id": "global_standard:sms-authored-evidence",
      "severity": "warning",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "MSL intrinsic bypasses need binary evidence."
    },
    {
      "rule_id": "sms_dummy_vec_helper",
      "standard_id": "global_standard:sms-pch-string-convention",
      "severity": "warning",
      "applies_to": [
        "src/*.cpp",
        "src/*.c"
      ],
      "message": "dummy(Vec*) needs its emitted-symbol comment."
    },
    {
      "rule_id": "sms_agent_comment",
      "standard_id": "global_standard:sms-no-agent-comments",
      "severity": "error",
      "applies_to": [
        "src/**",
        "include/**"
      ],
      "message": "Agent-written comments (TODO, nonmatching, fakematch, frame notes) are rejected in SMS."
    },
    {
      "rule_id": "sms_accessor_evidence",
      "standard_id": "global_standard:sms-accessor-evidence",
      "severity": "warning",
      "llm_review": true,
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "Accessor and inline swaps need evidence that the accessor exists in the original; otherwise they are steering probes for the steering gate."
    },
    {
      "rule_id": "sms_single_use_temp",
      "standard_id": "global_standard:sms-no-steering",
      "severity": "warning",
      "llm_review": true,
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "A temp or alias that only re-spells an expression is a steering probe, not a fix."
    },
    {
      "rule_id": "sms_form_rewrite",
      "standard_id": "global_standard:sms-no-steering",
      "severity": "warning",
      "llm_review": true,
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "A same-behaviour rewrite (if/ternary, order, type spelling, literal form, compound assignment, boolean form) is a steering probe, not a fix."
    },
    {
      "rule_id": "sms_codegen_directive",
      "standard_id": "global_standard:sms-no-steering",
      "severity": "error",
      "applies_to": [
        "src/**",
        "include/**"
      ],
      "message": "Added volatile, register or #pragma steers codegen and is rejected in SMS."
    },
    {
      "rule_id": "sms_invented_helper",
      "standard_id": "global_standard:sms-fabricated-marker",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "Functions the diff adds need an upstream declaration or a symbols.txt/mario.MAP entry; invented helpers are dropped."
    },
    {
      "rule_id": "sms_nonsense_code",
      "standard_id": "global_standard:sms-plain-code",
      "severity": "error",
      "applies_to": [
        "src/*.cpp",
        "src/*.c",
        "include/**"
      ],
      "message": "Code a human would not write (repeated tests, double negations, empty branches, dead or repeated stores) is dropped."
    }
  ]
}
