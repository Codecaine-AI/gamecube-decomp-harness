{
  "id": "melee",
  "displayName": "Super Smash Bros. Melee",
  "kind": "doldecomp-melee",
  "repoRoot": "./workspace/checkout",
  "stateDir": "./runtime/state",
  "graphDb": "./knowledge/graph/graph.sqlite",
  "processName": "melee-live",
  "baseRef": "origin/master",
  "localEnv": "./config/local.env",
  "dashboard": {
    "agentTimeoutSeconds": 3600,
    "goalValue": 100
  },
  "pr": {
    "groupMode": "melee-subsystem",
    "titlePrefix": "Melee decomp",
    "branchPrefix": "decomp",
    "maxFilesPerPr": 8,
    "splitStrategy": "agent",
    "improvementMinGainPoints": 2.0,
    "improvementMinMatchedBytes": 64
  },
  "knowledge": {
    "globalSources": [
      "past_prs",
      "decomp_standards",
      "path_facts"
    ],
    "gameSources": [
      "code_graph"
    ]
  },
  "tools": {
    "toolpacks": [
      "gamecube-decomp"
    ],
    "bindingsRoot": "./config/tools",
    "sharedDataRoot": "./runtime/tool-data",
    "worktreeCacheRoot": "./runtime/tool-data/claims/{worktree_id}",
    "toolsRoot": "./runtime/tools"
  },
  "config": {
    "build": "./config/build.json",
    "sandbox": "./config/sandbox.json",
    "sources": [
      "./config/sources/prs.json",
      "./config/sources/discord.json",
      "./config/sources/wiki.json"
    ]
  }
}
