{
  "id": "melee",
  "displayName": "Super Smash Bros. Melee",
  "kind": "doldecomp-melee",
  "repoRoot": "./checkout",
  "stateDir": "./state",
  "graphDb": "./graph/graph.sqlite",
  "processName": "melee-live",
  "baseRef": "origin/master",
  "localEnv": "./local.env",
  "validation": {
    "qaTarget": "changes_all",
    "reportPath": "build/GALE01/report.json",
    "reportChangesPath": "build/GALE01/report_changes.json",
    "objdiffPath": "objdiff.json",
    "workerSectionParityGate": true,
    "workerUndefinedSymbolGate": true,
    "workerBannedIdiomGate": true
  },
  "dashboard": {
    "agentTimeoutSeconds": 3600,
    "goalValue": 100
  },
  "sandbox": {
    "default_profile": "2-core",
    "snapshot_baked_rev": "1e28b4203bf5b53d9399e90c22bd287de0d64657",
    "workspace_root": "/opt/melee",
    "profiles": {
      "2-core": {
        "snapshot_name": "melee-sandbox-20260827-ripgrep",
        "resource_class": { "cpu": 2, "memory_gib": 4, "disk_gib": 5 }
      },
      "4-core": {
        "snapshot_name": "melee-sandbox-20260827-ripgrep-4c",
        "resource_class": { "cpu": 4, "memory_gib": 8, "disk_gib": 5 }
      }
    }
  },
  "pr": {
    "groupMode": "melee-subsystem",
    "titlePrefix": "Melee decomp",
    "branchPrefix": "decomp",
    "maxFilesPerPr": 8,
    "splitStrategy": "agent",
    "improvementMinGainPoints": 2.0,
    "improvementMinMatchedBytes": 64
  },
  "knowledge": {
    "globalSources": [
      "past_prs",
      "decomp_standards",
      "path_facts"
    ],
    "gameSources": [
      "code_graph"
    ]
  },
  "tools": {
    "toolpacks": [
      "gamecube-decomp"
    ],
    "bindingsRoot": "./tool-bindings",
    "sharedDataRoot": "./shared/tool-data",
    "worktreeCacheRoot": "./worktrees/{worktree_id}/tool-cache"
  }
}
