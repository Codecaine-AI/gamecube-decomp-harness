{
  "family": "names_defines_headers_and_prototypes",
  "rules": [
    {
      "rule_id": "m2c_residue_names",
      "severity": "error",
      "standard_id": "global_standard:conservative-naming",
      "applies_to": [
        "src/**/*.c",
        "src/**/*.cpp"
      ]
    },
    {
      "rule_id": "define_alias",
      "severity": "error",
      "standard_id": "global_standard:no-define-alias-global-renames",
      "applies_to": [
        "src/**/*.c",
        "src/**/*.cpp"
      ]
    },
    {
      "rule_id": "shadowed_declaration",
      "severity": "error",
      "standard_id": "global_standard:truthful-headers-and-includes",
      "applies_to": [
        "src/**/*.c"
      ],
      "excludes": [
        "src/dolphin/**",
        "src/MSL/**",
        "src/MetroTRK/**",
        "src/Runtime/**",
        "src/JSystem/**",
        "src/PowerPC_EABI_Support/**",
        "src/TRK_MINNOW_DOLPHIN/**",
        "src/THPPlayer/**",
        "include/JSystem/**",
        "include/dolphin/**"
      ]
    },
    {
      "rule_id": "bare_local_prototype",
      "severity": "error",
      "standard_id": "global_standard:truthful-headers-and-includes",
      "applies_to": [
        "src/**/*.c"
      ],
      "excludes": [
        "src/dolphin/**",
        "src/MSL/**",
        "src/MetroTRK/**",
        "src/Runtime/**",
        "src/JSystem/**",
        "src/PowerPC_EABI_Support/**",
        "src/TRK_MINNOW_DOLPHIN/**",
        "src/THPPlayer/**",
        "include/JSystem/**",
        "include/dolphin/**"
      ]
    }
  ],
  "escalations": [],
  "standards": [
    "global_standard:conservative-naming",
    "global_standard:no-define-alias-global-renames",
    "global_standard:truthful-headers-and-includes"
  ]
}
