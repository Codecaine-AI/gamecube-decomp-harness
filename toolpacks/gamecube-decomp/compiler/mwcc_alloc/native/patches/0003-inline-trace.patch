+/* (decision trace: see compiler/MwccTrace.h; the verdict repeats the checks below without acting on them) */
+static void trace_save_locals(CInlineInfo *body)
+{
+    ObjectList *list;
+    int index;
+
+    index = 0;
+    for (list = locals; list != NULL; list = list->next) {
+        if (list->object->datatype == DLOCAL)
+            MwccTrace_NoteSavedLocal(body, index++, list->object);
+    }
+}
+
+static void trace_rebuilt_locals(CInlineInfo *body)
+{
+    ObjectList *list;
+    int index;
+
+    index = 0;
+    for (list = locals; list != NULL; list = list->next)
+        MwccTrace_NoteRebuiltLocal(body, index++, list->object);
+}
+
+static SInt32 trace_statement_line;
+
+static void trace_inline_site(ENode *funcref, int statement_level, int inlined_statement)
+{
+    Object *callee;
+    CInlineInfo *info;
+    const char *verdict;
+    const char *reason;
+    int qualified;
+
+    callee = funcref->data.objref;
+    if (callee == NULL || callee->type == NULL || callee->type->type != TYPEFUNC)
+        return;
+    qualified = (callee->qual & Q_INLINE) || (TYPE_METHOD(callee->type)->flags & FUNC_IS_CTOR);
+    /* (u.func.u is inline information only for an inline function: intrinsics keep other data there) */
+    info = qualified && (callee->datatype == DFUNC || callee->datatype == DVFUNC) ? callee->u.func.u : NULL;
+    verdict = "called";
+    if (statement_level) {
+        if (inlined_statement) {
+            verdict = "inlined";
+            reason = "statement";
+        } else {
+            reason = "statement_form";
+        }
+    } else if (!can_inline(funcref)) {
+        if (!qualified)
+            reason = "not_inline";
+        else if (!(callee->datatype == DFUNC || (callee->datatype == DVFUNC && (funcref->flags & ENODE_FLAG_80))))
+            reason = "virtual_or_not_function";
+        else if (info == NULL)
+            reason = "no_body";
+        else
+            reason = "statement_count_limit";
+    } else if (info == NULL) {
+        reason = "no_body";
+    } else if (info->kind < 6) {
+        if (inline_statement_mode != 0 && inline_call_count < 16 && info->kind == 3) {
+            verdict = "inlined";
+            reason = "statement_expansion";
+        } else {
+            reason = "body_not_expression";
+        }
+    } else {
+        verdict = "inlined";
+        reason = "expression";
+    }
+    MwccTrace_Begin("inline", data_00582468, MWCC_TRACE_CLS_NONE);
+    MwccTrace_Site("site", MwccTrace_SiteFile(function_fileinfo.file), trace_statement_line);
+    MwccTrace_Str("callee", (callee->datatype == DFUNC || callee->datatype == DVFUNC) && callee->u.func.linkname != NULL
+                                ? callee->u.func.linkname->name
+                                : (callee->name != NULL ? callee->name->name : NULL));
+    MwccTrace_Name("callee_display", callee->name);
+    MwccTrace_Int("pass_index", data_00582468);
+    if (info != NULL)
+        MwccTrace_Int("stmt_count", inline_statement_count(info));
+    else
+        MwccTrace_Null("stmt_count");
+    MwccTrace_Str("verdict", verdict);
+    MwccTrace_Str("reason", reason);
+    MwccTrace_Bool("auto_inline", !(callee->qual & Q_INLINE) && qualified);
+    MwccTrace_End();
+}
