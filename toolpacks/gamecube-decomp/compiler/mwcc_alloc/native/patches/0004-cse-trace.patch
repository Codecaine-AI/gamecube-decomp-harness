+/* (decision trace: see compiler/MwccTrace.h) */
+static int trace_cse_pass;
+static int trace_cse_occurrence;
+
+static void trace_cse(IROExpr *cse, IROLinear *use, IRONode *block)
+{
+    const char *text;
+
+    text = MwccTrace_LinearText(cse->linear);
+    MwccTrace_NoteOrigin(cse->temp->name, "cse", text);
+    MwccTrace_Begin("cse", trace_cse_pass, MWCC_TRACE_CLS_NONE);
+    MwccTrace_Name("temp", cse->temp->name);
+    MwccTrace_Str("expr", MwccTrace_LinearText(cse->linear));
+    MwccTrace_Int("block", block->index);
+    MwccTrace_Int("occurrence", ++trace_cse_occurrence);
+    MwccTrace_Int("def_index", cse->linear->index);
+    MwccTrace_Int("use_index", use->index);
+    if (use->stmt != NULL)
+        MwccTrace_Int("line", use->stmt->sourceoffset);
+    MwccTrace_End();
+}
