+static int trace_argument_index(Object *object)
+{
+    ObjectList *entry;
+    int index;
+
+    index = 0;
+    for (entry = arguments; entry != NULL; entry = entry->next) {
+        if (entry->object == object)
+            return index;
+        index++;
+    }
+    return -1;
+}
+
+static int trace_is_argument(Object *object)
+{
+    return trace_argument_index(object) >= 0;
+}
+
+static void trace_graph(int reg_class, int register_count)
+{
+    int pass;
+    int reg;
+    int index;
+    InterferenceNode *node;
+    Object *object;
+    VarInfo *info;
+    const char *name;
+
+    pass = MwccTrace_BeginAllocationPass(reg_class);
+    for (reg = 0; reg < register_count; reg++) {
+        node = gInterferenceGraph[reg];
+        object = node->object;
+        if (reg < 32 && object == NULL)
+            continue;
+        MwccTrace_Begin("vreg", pass, reg_class);
+        MwccTrace_Int("vreg", reg);
+        name = object != NULL && object->name != NULL ? object->name->name : NULL;
+        if (object == NULL) {
+            MwccTrace_Str("kind", "backend_temp");
+            MwccTrace_Null("object");
+        } else {
+            MwccTrace_Str("kind", trace_is_argument(object)                   ? "arg"
+                                  : name == NULL || name[0] == '@' || name[0] == '$' ? "temp"
+                                                                                     : "local");
+            MwccTrace_Str("object", name);
+            info = object->datatype == DLOCAL ? object->u.var.info : NULL;
+            /* (only a local's declaration token is its declaration: an argument's and a temporary's are wherever the
+             * parser was when their information was made) */
+            if (trace_is_argument(object)) {
+                MwccTrace_ArgumentDeclaration();
+                MwccTrace_Int("arg_index", trace_argument_index(object));
+            } else {
+                if (name == NULL || name[0] == '@' || name[0] == '$')
+                    MwccTrace_Declaration(NULL);
+                else
+                    MwccTrace_LocalDeclaration(object, info != NULL ? &info->deftoken : NULL);
+            }
+            if (info != NULL)
+                MwccTrace_Int("varnumber", info->varnumber);
+            MwccTrace_Str("origin", MwccTrace_Origin(object->name));
+            if ((node->flags & Interference_FirstOfPair) != 0)
+                MwccTrace_Str("pair", "first");
+            else if ((node->flags & Interference_SecondOfPair) != 0)
+                MwccTrace_Str("pair", "second");
+        }
+        MwccTrace_Null("web");
+        if (reg < 32)
+            MwccTrace_Bool("precolored", 1);
+        MwccTrace_End();
+    }
+    for (reg = 32; reg < register_count; reg++) {
+        node = gInterferenceGraph[reg];
+        MwccTrace_Begin("node", pass, reg_class);
+        MwccTrace_Int("vreg", reg);
+        MwccTrace_Int("degree", node->degree);
+        MwccTrace_ArrayBegin("neighbors");
+        for (index = 0; index < node->neighbor_count; index++)
+            MwccTrace_ArrayInt(node->neighbors[index]);
+        MwccTrace_ArrayEnd();
+        MwccTrace_Bool("coalesced", (node->flags & Interference_Coalesced) != 0);
+        if ((node->flags & Interference_Coalesced) != 0)
+            MwccTrace_Int("coalesced_into", node->physical_register);
+        MwccTrace_Null("spill_cost");
+        MwccTrace_End();
+    }
+}
+
+static void trace_spill_costs(int reg_class, int node_count)
+{
+    int reg;
+    InterferenceNode *node;
+
+    for (reg = 32; reg < node_count; reg++) {
+        node = gInterferenceGraph[reg];
+        if ((node->flags & 6) != 0)
+            continue;
+        MwccTrace_Begin("node_cost", MwccTrace_AllocationPass(reg_class), reg_class);
+        MwccTrace_Int("vreg", reg);
+        MwccTrace_Int("spill_cost", node->spill_cost);
+        MwccTrace_Int("degree", node->degree);
+        MwccTrace_End();
+    }
+}
+
+/* (the stall's cost is recomputed here: a double the caller keeps across this call would leave the x87 stack for
+ * memory and round, and the allocator's own comparisons of costs would change) */
+static void trace_push(int reg_class, InterferenceNode *node, int stalled)
+{
+    MwccTrace_Begin("push", MwccTrace_AllocationPass(reg_class), reg_class);
+    MwccTrace_Int("vreg", node->virtual_register);
+    MwccTrace_Int("sweep", trace_sweep);
+    MwccTrace_Bool("stalled", stalled);
+    if (stalled) {
+        if (node->virtual_register >= gColoringRegisterCount || node->degree == 0)
+            MwccTrace_Ratio("cost_ratio", 3.40282347e+38);
+        else
+            MwccTrace_Ratio("cost_ratio", (double)node->spill_cost / (double)node->degree);
+        MwccTrace_Int("spill_cost", node->spill_cost);
+        MwccTrace_Int("degree", node->degree);
+    }
+    MwccTrace_End();
+}
+
+static void trace_color(int reg_class, InterferenceNode *node)
+{
+    MwccTrace_Begin("color", MwccTrace_AllocationPass(reg_class), reg_class);
+    MwccTrace_Int("vreg", node->virtual_register);
+    MwccTrace_Int("color", (node->flags & Interference_Spilled) != 0 ? -1 : node->physical_register);
+    MwccTrace_Int("order", trace_order++);
+    MwccTrace_End();
+    if ((node->flags & Interference_Spilled) != 0) {
+        MwccTrace_Begin("spill", MwccTrace_AllocationPass(reg_class), reg_class);
+        MwccTrace_Int("vreg", node->virtual_register);
+        MwccTrace_End();
+    }
+}
+
+static void trace_commit(int reg_class, int register_count)
+{
+    int reg;
+    int color;
+    InterferenceNode *node;
+    char text[8];
+
+    for (reg = 32; reg < register_count; reg++) {
+        node = gInterferenceGraph[reg];
+        if ((node->flags & Interference_Spilled) != 0)
+            continue;
+        color = node->physical_register;
+        while (color >= 32) {
+            color = gInterferenceGraph[color]->physical_register;
+            if (color < 0)
+                break;
+        }
+        MwccTrace_Begin("commit", MwccTrace_AllocationPass(reg_class), reg_class);
+        MwccTrace_Int("vreg", reg);
+        if (color < 0 || color >= 32) {
+            MwccTrace_Null("reg");
+        } else {
+            text[0] = reg_class == 0 ? 'r' : reg_class == 1 ? 'f' : 'v';
+            if (color >= 10) {
+                text[1] = (char)('0' + color / 10);
+                text[2] = (char)('0' + color % 10);
+                text[3] = 0;
+            } else {
+                text[1] = (char)('0' + color);
+                text[2] = 0;
+            }
+            MwccTrace_Str("reg", text);
+        }
+        MwccTrace_End();
+    }
+}
