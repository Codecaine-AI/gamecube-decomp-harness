+u32 ToolData::Hash(const char* key)
+{
+	u32 stringHash = 0;
+	char current_char;
+
+	while ((current_char = *key) != 0) {
+		key++;
+		stringHash = (current_char + (stringHash << 8)) % 0x1FFFFD9;
+	}
+	return stringHash;
+}
