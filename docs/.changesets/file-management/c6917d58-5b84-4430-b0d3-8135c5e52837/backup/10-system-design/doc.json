        }
      ],
      "children": []
    },
    "b-system-shared-knowledge-canvas": {
      "id": "b-system-shared-knowledge-canvas",
      "type": "canvas",
      "props": {
        "src": "assets/canvases/system-flow.canvas.json",
        "title": "The Shared Knowledge Loop"
      },
      "children": []
    },
    "b-system-flow-intro": {
      "id": "b-system-flow-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Process Outline follows the canvas from the task queue through workers and the librarian, then back to workers through shared knowledge."
        }
      ],
      "children": []
    },
    "b-system-knowledge-process": {
      "id": "b-system-knowledge-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The harness assigns queued functions and targets to many workers in parallel."
          },
          {
            "text": "Each worker works in its own sandbox and reads shared game knowledge.",
            "steps": [
              {
                "text": "The sandbox provides source files and tools for editing, compiling, debugging, and scoring."
              }
            ]
          },
          {
            "text": "Completed worker results pass through summarization to the librarian.",
            "steps": [
              {
                "text": "Attempts can provide useful evidence even when they do not produce a code match."
              }
            ]
          },
          {
            "text": "The librarian processes evidence for the shared knowledge base.",
            "steps": [
              {
                "text": "Worker results, external pull requests, Discord messages, and game wiki content supply evidence."
              },
              {
                "text": "Validated findings become shared game knowledge and links between related subjects."
              }
            ]
          },
          {
            "text": "Workers use the accumulated knowledge in later attempts, continuing the loop."
          }
        ]
      },
      "children": []
    },
