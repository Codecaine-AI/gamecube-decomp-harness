    "b-10-system-design-d-comp-orchestrator-is-a-1": {
      "id": "b-10-system-design-d-comp-orchestrator-is-a-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The GameCube decomp harness runs many workers in parallel to decompile a game's functions and targets. Each worker has a sandbox with tools and reads a shared knowledge base, so findings from one attempt can help other workers."
        }
      ],
      "children": []
    },
