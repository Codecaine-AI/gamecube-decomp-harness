            "channel, author, time range, thread",
            "None"
          ],
          [
            "Pull requests",
            "BM25 over title, body, archived discussion",
            "Discussion chunks",
            "touched file/target, author",
            "None"
          ],
          [
            "Wiki",
            "BM25 over section content",
            "Sections, the primary search method",
            "page, mirror revision",
            "None"
          ],
          [
            "Attempts",
