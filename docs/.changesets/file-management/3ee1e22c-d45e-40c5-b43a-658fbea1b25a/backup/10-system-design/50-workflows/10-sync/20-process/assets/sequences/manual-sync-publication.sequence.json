{
  "version": 1,
  "id": "manual-sync-publication",
  "title": "Manual Sync: From Request to Publication",
  "participants": [
    {
      "id": "operator",
      "name": "Operator",
      "kind": "participant"
    },
    {
      "id": "sync",
      "name": "Sync",
      "kind": "participant"
    },
    {
      "id": "dispatch",
      "name": "Dispatch State",
      "kind": "participant"
    },
    {
      "id": "checkout",
      "name": "Checkout / staging",
      "kind": "participant"
    },
    {
      "id": "knowledge",
      "name": "Knowledge intake",
      "kind": "participant"
    },
    {
      "id": "state",
      "name": "Durable state",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "operator",
      "to": "sync",
      "text": "Observe upstream and request Sync",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "operator",
      "to": "sync",
      "text": "Start",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "sync",
      "to": "dispatch",
      "text": "Acquire Sync lease or queue",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m4",
      "from": "dispatch",
      "to": "sync",
      "text": "Authority granted after prior holder settles",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m5",
      "from": "sync",
      "to": "checkout",
      "text": "Stage policy merge and PR reconciliation",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m6",
      "from": "checkout",
      "to": "sync",
      "text": "Clean staging and report evidence",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m7",
      "from": "sync",
      "to": "state",
      "text": "Persist validated state",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m8",
      "from": "sync",
      "to": "operator",
      "text": "Ready for publication",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m9",
      "from": "operator",
      "to": "sync",
      "text": "Confirm sync.publish",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m10",
      "from": "sync",
      "to": "checkout",
      "text": "Recheck heads; persist intent; repoint canonical checkout",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m11",
      "from": "sync",
      "to": "knowledge",
      "text": "Run intake against accepted checkout and report",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m12",
      "from": "knowledge",
      "to": "sync",
      "text": "Imported evidence and queued librarian tasks",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m13",
      "from": "sync",
      "to": "state",
      "text": "Commit publication boundary",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m14",
      "from": "sync",
      "to": "checkout",
      "text": "Complete pending PR branch pushes",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m15",
      "from": "sync",
      "to": "dispatch",
      "text": "Finalize published; release lease",
      "line": "sync"
    }
