    "se-intro": {
      "id": "se-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sandbox lifecycle events use the worker's existing trace identity. Creation and deletion are retained game events; individual exec and file-transfer timings are operation spans."
        }
      ],
      "children": []
    },
    "se-events": {
      "id": "se-events",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Creation and Deletion"
        }
      ],
      "children": []
    },
    "se-types": {
      "id": "se-types",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host records "
        },
        {
          "insert": "sandbox.created",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the provisioned resource class and "
        },
        {
          "insert": "sandbox.deleted",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with one cleanup reason: "
        },
        {
          "insert": "settlement",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reap",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reconciliation",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "provision_failure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "retry_reprovision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The owning worker job also retains "
        },
        {
          "insert": "sandbox_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " so recovery can locate the workspace after process loss."
        }
      ],
      "children": []
    },
    "se-lineage": {
      "id": "se-lineage",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Provisioning uses the worker job as "
        },
        {
          "insert": "correlation_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Settlement and "
        },
        {
          "insert": "reap",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " prefer the owning Run, and "
        },
        {
          "insert": "reconciliation",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " recovers it from labels or state. "
        },
        {
          "insert": "causation_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies the responsible job or event. All remote operation spans stay under the worker job's "
        },
        {
          "insert": "trace_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "se-boundary": {
      "id": "se-boundary",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The agent's kernel container groups its prompt, tools, session, and artifacts. The sandbox is the operating-system workspace used by that execution. It does not create a second agent session or a separate lineage."
        }
      ],
      "children": []
    }
  }
}
