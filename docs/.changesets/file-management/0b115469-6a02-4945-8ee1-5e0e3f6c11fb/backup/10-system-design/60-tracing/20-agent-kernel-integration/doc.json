        {
          "insert": "Validated Submission"
        }
      ],
      "children": []
    },
    "b-kernel-submission-sequence": {
      "id": "b-kernel-submission-sequence",
      "type": "sequence",
      "props": {
        "sequenceId": "b-kernel-submission-sequence",
        "src": "assets/sequences/kernel-linkage.sequence.json",
        "title": "Event-to-kernel validated submission"
      },
      "children": []
    },
    "b-kernel-submission-outline": {
      "id": "b-kernel-submission-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Load the durable game event by game and event identity"
          },
          {
            "text": "Validate correlation and the resolved same-game cause"
          },
          {
            "text": "Overwrite caller-supplied protected metadata"
          },
          {
            "text": "Upsert deterministic container lineage"
          },
          {
            "text": "Emit the deterministic kernel event"
          },
          {
            "text": "Persist the harness linkage cursor"
          }
        ]
      },
      "children": []
    },
    "b-index-persisted-cursor-and-fa-6": {
