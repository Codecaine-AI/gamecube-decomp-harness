    "b-index-kernel-trace-linkage-2": {
      "id": "b-index-kernel-trace-linkage-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Kernel trace linkage joins accepted game events to runtime spans through protected metadata and a persisted harness cursor. Optional telemetry may be absent, but a runtime event that was emitted must receive its durable join."
        }
      ],
      "children": []
    },
    "harness-kernel-association": {
      "id": "harness-kernel-association",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator's harness_kernel_traces table associates each game and harness with one or more app_session_id values. Its key is (game_id, harness_id, app_session_id). kernel_trace_json retains container links, trace URL, and linkage cursor. Agent Kernel trace payloads and historical session identities remain immutable."
        }
      ],
      "children": []
    },
    "b-index-validated-submission-3": {
      "id": "b-index-validated-submission-3",
      "type": "heading",
      "props": {
