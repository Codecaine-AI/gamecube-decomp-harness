        "src": "./assets/sequences/guardian-successor.sequence.json",
        "title": "Guardian Settlement and Successor Acquisition"
      },
      "children": []
    },
    "b-state-envelope-provenance-shape": {
      "id": "b-state-envelope-provenance-shape",
      "type": "state-shape",
      "props": {
        "description": "The provenance slice shared by accepted durable state records.",
        "example": "{\n  \"revision\": 7,\n  \"updated_at\": \"2026-09-11T18:00:00Z\",\n  \"caused_by_event_id\": \"event-dispatch-7\"\n}",
        "fields": [
          {
            "name": "revision",
            "type": "integer",
            "description": "Advances exactly once for each accepted revision."
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "caused_by_event_id",
            "type": "EventId",
            "description": "The single accepted game event that produced this revision."
          }
        ],
        "name": "StateEnvelope"
      },
      "children": []
    },
    "b-state-envelope-provenance-contract": {
      "id": "b-state-envelope-provenance-contract",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Creation is an accepted transition, so caused_by_event_id is non-null after creation. The state write, event append, and outgoing spool records commit together under the expected revision; rejection commits none of them. Event payloads contain only the registered transition facts, not another state snapshot."
        }
      ],
      "children": []
    },
    "b-index-correlation-and-caus-4": {
      "id": "b-index-correlation-and-caus-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Correlation, Causation, and Spans"
        }
      ],
      "children": []
    },
    "b-index-correlation-id-is-requ-5": {
      "id": "b-index-correlation-id-is-requ-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "correlation_id identifies one user-visible workflow and remains stable across retries and derived work. causation_id names the command accepted directly or the preceding same-game event. trace_id remains workflow-local, span_id names the accepted operation, and parent_span_id is either the distinct parent span or null for a root."
        }
      ],
      "children": []
    },
    "b-index-accountable-actors-6": {
      "id": "b-index-accountable-actors-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accountable Actors"
        }
      ],
      "children": []
    },
    "b-accountable-actors-table": {
      "id": "b-accountable-actors-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Actor",
          "Credited accepted action"
        ],
        "density": "compact",
        "rows": [
          [
            "operator",
            "An authenticated operator command."
          ],
          [
            "runner",
            "Deterministic controller or scheduler work."
          ],
          [
            "agent",
            "The identified agent action that produced the fact."
          ],
          [
            "guardian",
            "Recovery or liveness settlement."
          ],
          [
            "external_observer",
            "Observation without authoritative mutation."
          ]
        ],
        "title": "Actor credit"
      },
      "children": []
    },
    "b-guardian-successor-heading": {
      "id": "b-guardian-successor-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Settlement and Successor Acquisition"
        }
      ],
      "children": []
    },
    "b-guardian-successor-sequence": {
      "id": "b-guardian-successor-sequence",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Guardian settles the outgoing workflow",
            "steps": [
              {
                "text": "Append game.dispatch_released and run.paused under the settlement command and root span."
              }
            ]
          },
          {
            "text": "Successor acquires authority",
            "steps": [
              {
                "text": "Append game.dispatch_acquired under the queued operator workflow lineage."
              },
              {
                "text": "Append sync.ingesting with operator credit; guardian is not an allowed ingestion actor."
              }
            ]
          }
        ]
      },
      "children": []
    },
