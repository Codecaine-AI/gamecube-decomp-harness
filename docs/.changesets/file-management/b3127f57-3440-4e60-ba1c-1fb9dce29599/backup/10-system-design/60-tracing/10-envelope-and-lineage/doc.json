    "b-index-every-game-event-is-one-2": {
      "id": "b-index-every-game-event-is-one-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every game event is one durable, game-scoped fact with workflow identity, immediate causation, accountable authorship, and trace lineage. Consumers reconstruct accepted history from events while durable state remains authoritative for the current snapshot."
        }
      ],
      "children": []
    },
    "b-index-envelope-3": {
      "id": "b-index-envelope-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Envelope"
        }
      ],
      "children": []
    },
    "b-envelope-state-shape": {
      "id": "b-envelope-state-shape",
      "type": "state-shape",
      "props": {
        "description": "The immutable header stored with every accepted game fact.",
        "example": "{\n  \"event_id\": \"event-dispatch-7\",\n  \"sequence\": 7,\n  \"event_type\": \"game.dispatch_acquired\",\n  \"schema_version\": 1,\n  \"game_id\": \"melee\",\n  \"subject_kind\": \"game\",\n  \"subject_id\": \"melee\",\n  \"correlation_id\": \"run-7\",\n  \"causation_id\": \"command-run-7\",\n  \"trace_id\": \"trace-run-7\",\n  \"span_id\": \"span-11111111-1111-4111-8111-111111111111\",\n  \"parent_span_id\": null,\n  \"actor\": \"runner\",\n  \"occurred_at\": \"2026-09-11T18:00:00Z\",\n  \"payload\": {\n    \"kind\": \"run\",\n    \"workflow_id\": \"run-7\",\n    \"lease_id\": \"lease-run-7\",\n    \"state_revision\": 7\n  }\n}",
        "fields": [
          {
            "name": "event_id",
            "type": "EventId"
          },
          {
            "name": "sequence",
            "type": "integer",
            "description": "Monotonic within one game event log."
          },
          {
            "name": "event_type",
            "type": "registered string"
          },
          {
            "name": "schema_version",
            "type": "positive integer"
          },
          {
            "name": "game_id",
            "type": "GameId"
          },
          {
            "name": "subject_kind",
            "type": "registered string"
          },
          {
            "name": "subject_id",
            "type": "string"
          },
          {
            "name": "correlation_id",
            "type": "CorrelationId"
          },
          {
            "name": "causation_id",
            "type": "CommandId | EventId"
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "span_id",
            "type": "SpanId"
          },
          {
            "name": "parent_span_id",
            "type": "SpanId | null"
          },
          {
            "name": "actor",
            "type": "operator | runner | agent | guardian | external_observer"
          },
          {
            "name": "occurred_at",
            "type": "timestamp"
          },
          {
            "name": "payload",
            "type": "registered closed object"
          }
        ],
        "name": "GameEventEnvelope"
      },
      "children": []
    },
    "b-state-envelope-provenance-heading": {
      "id": "b-state-envelope-provenance-heading",
