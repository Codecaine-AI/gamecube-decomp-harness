    "continuing-harness-0": {
      "id": "continuing-harness-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run executes epochs against one harness worktree. Every settled epoch passes through Sync before the next epoch is admitted. The durable run identity continues across automatic Sync handoffs."
        }
      ],
      "children": []
    },
    "continuing-harness-1": {
      "id": "continuing-harness-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accepted Epoch Handoff"
        }
      ],
      "children": []
    },
    "continuing-harness-2": {
      "id": "continuing-harness-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Finish active claims, settle integration, and record epoch evidence. Complete Sync under exclusive source ownership. Refresh report truth and target eligibility for the accepted head, then admit the next epoch unless paused or blocked."
        }
      ],
      "children": []
    },
    "continuing-harness-3": {
      "id": "continuing-harness-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A pause stops new admission and settles active work safely. Sync can update the same harness while paused, and resuming uses that accepted state. Process restarts do not create a new harness or discard epoch history."
        }
      ],
      "children": []
    },
    "continuing-harness-4": {
      "id": "continuing-harness-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Workers still edit isolated game-specific Daytona workspaces. Their claim base is the accepted harness head. The host validates and integrates their results into the maintained harness worktree."
        }
      ],
      "children": []
    },
    "continuing-harness-5": {
      "id": "continuing-harness-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Run Ownership"
        }
      ],
      "children": []
    },
    "b-20-run-overview-1": {
      "id": "b-20-run-overview-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run workflow is the autonomous execution stage for one game harness. It occupies the "
        },
        {
          "insert": "Harness State",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-harness/20-harness-state"
            }
          }
        },
        {
          "insert": " workflow slot and dispatch lease while durable "
        },
        {
          "insert": "Run State",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-workflows/20-run/10-run-state"
            }
          }
        },
        {
          "insert": " binds scheduling, worker evidence, and integration to one run identity. The workflow turns ranked targets into isolated attempts, serial integration, and boundary-confirmed progress."
        }
      ],
      "children": []
    },
    "b-20-run-run-process-canvas-14": {
      "id": "b-20-run-run-process-canvas-14",
      "type": "canvas",
      "props": {
        "src": "./assets/canvases/run-process.canvas.json",
        "title": "Run process"
      },
      "children": []
    },
    "b-20-run-epoch-heading-2": {
      "id": "b-20-run-epoch-heading-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How an Epoch Turns"
        }
      ],
      "children": []
    },
    "b-20-run-wake-snapshot-3": {
      "id": "b-20-run-wake-snapshot-3",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Run workflow",
            "steps": [
              {
                "text": "Wake the Run Loop from the highest-priority relevant durable signal or maintenance cadence"
              },
              {
                "text": "Read run state, active claims, epoch records, checkpoints, and the current ranked board"
              },
              {
                "text": "Rank the full board and admit every eligible target once"
              },
              {
                "text": "Enqueue one deduplicated `worker` job for each admitted epoch target"
              },
              {
                "text": "Claim the job and epoch target atomically, then provision an isolated worktree and ClaimToken"
              },
              {
                "text": "Execute and validate bounded worker attempts; settle every outcome from durable worker evidence"
              },
              {
                "text": "Queue knowledge processing for every closed worker outcome, whether it succeeded or failed"
              },
              {
                "text": "Apply and commit each accepted checkpoint to the harness worktree through the single-flight integration lane"
              },
              {
                "text": "At the epoch boundary, rebuild report truth, confirm or revert tentative work, and record a save point"
              },
              {
                "text": "Run Sync, capture post-sync evidence, and refresh the board before admitting the next epoch; preserve pause and blockers"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-20-run-integrate-boundary-5": {
      "id": "b-20-run-integrate-boundary-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker completion hands the closed run to "
        },
        {
          "insert": "Librarian Pathways",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-knowledge-base/40-librarian-pathways"
            }
          }
        },
        {
          "insert": "; the run records only that handoff and continues from the refreshed board. "
        },
        {
          "insert": "Process Lifecycle",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-workflows/20-run/50-process-lifecycle"
            }
          }
        },
        {
          "insert": " binds direct process execution, observation, and exit settlement to the run's dispatch authority."
        }
      ],
      "children": []
    },
