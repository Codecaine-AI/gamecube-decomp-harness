    "continuing-harness-0": {
      "id": "continuing-harness-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The harness runs Sync initially and after every completed epoch. Sync prepares or updates the harness worktree and configured knowledge sources, then records a boundary before the next epoch. Manual Sync and automatic epoch Sync share the source-authority boundary."
        }
      ],
      "children": []
    },
    "continuing-harness-1": {
      "id": "continuing-harness-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accepted Automatic Handoff"
        }
      ],
      "children": []
    },
    "continuing-harness-2": {
      "id": "continuing-harness-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run settles the epoch and its evidence, then hands off exclusive source authority to Sync. Successful staged reconciliation and validation permit automatic application under the configured policy. Conflicts, failed validation, or missing required evidence block the next epoch instead of publishing an unverified result."
        }
      ],
      "children": []
    },
    "continuing-harness-3": {
      "id": "continuing-harness-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync records completion even when upstream and source heads are unchanged. Source changes produce post-sync evidence and invalidate affected report and board data. Source refresh follows each configured source policy; entering Sync does not force a full wiki mirror or full knowledge rebuild every epoch."
        }
      ],
      "children": []
    },
    "continuing-harness-4": {
      "id": "continuing-harness-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Initial Sync captures and imports configured local source inputs, builds search indexes, and reconciles report-derived entities. Missing required inputs block readiness. External acquisition and background curation are distinct stages; a local capture does not prove a remote mirror is current."
        }
      ],
      "children": []
    },
    "continuing-harness-5": {
      "id": "continuing-harness-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Manual Sync is available while paused and preserves desired pause. Bootstrap, manual Sync, and epoch Sync operate on the same harness worktree."
        }
      ],
      "children": []
    },
    "continuing-harness-6": {
      "id": "continuing-harness-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Manual Sync Entry"
        }
      ],
      "children": []
    },
    "b-10-sync-sync-is-the-operator-ini-1": {
      "id": "b-10-sync-sync-is-the-operator-ini-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Manual Sync initializes harness ownership from a verified configured Git checkout when needed. It stages reconciliation and validation, then publishes after operator confirmation. Publication records source, build, and evidence readiness only after intake succeeds. Sandbox readiness remains pending until separately validated."
        }
      ],
      "children": []
    },
    "b-10-sync-inputs-2": {
