    "b-10-sync-process-publish-60": {
      "id": "b-10-sync-process-publish-60",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync Process defines manual staging, validation, confirmation, and recovery. Automatic epoch Sync uses the boundary pipeline and does not wait for manual publication confirmation. Both record accepted source transitions and block new work on failed required gates."
        }
      ],
      "children": []
    },
