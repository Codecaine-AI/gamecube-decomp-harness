    "sweep-aef3068091f348dc": {
      "id": "sweep-aef3068091f348dc",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run, Sync, and knowledge payloads remain in their domain stores. Harness state links these records without embedding the entire history."
        }
      ],
      "children": []
    },
    "sweep-9af2086e446e42ce": {
      "id": "sweep-9af2086e446e42ce",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "One Dispatch Owner"
        }
      ],
      "children": []
    },
    "sweep-5960bb76a77c4906": {
      "id": "sweep-5960bb76a77c4906",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "At most one workflow holds active_workflow for a game. The lease kind vocabulary retains run, pr, and sync. A queued request grants no authority. "
        },
        {
          "insert": "Dispatch Authority and Handoffs",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-harness-process/50-dispatch-authority"
            }
          }
        },
        {
          "insert": " owns acquisition, fencing, settlement, and recovery."
        }
      ],
      "children": []
    },
