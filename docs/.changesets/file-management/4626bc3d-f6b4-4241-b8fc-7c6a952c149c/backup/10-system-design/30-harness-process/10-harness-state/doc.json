    "continuing-harness-0": {
      "id": "continuing-harness-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness state owns one game's canonical worktree, accepted source head, latest accepted upstream revision, workflow status, and blockers. It survives process restarts and pauses. Dispatch coordination stores exclusive lease authority separately."
        }
      ],
      "children": []
    },
    "continuing-harness-1": {
      "id": "continuing-harness-1",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Accepted Ownership"
        }
      ],
      "children": []
    },
    "continuing-harness-2": {
      "id": "continuing-harness-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync and Run are the two main workflows. Idle, paused, and blocked describe execution status. Epoch, Sync, and save-point records remain separate durable records linked from the harness timeline."
        }
      ],
      "children": []
    },
    "continuing-harness-3": {
      "id": "continuing-harness-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Initial Sync validates the configured checkout and establishes readiness. Every completed epoch runs Sync before another epoch can start. Automatic epoch Sync retains the fenced Run lease; manual Sync uses the dispatch handoff. Desired pause survives either path."
        }
      ],
      "children": []
    },
    "continuing-harness-4": {
      "id": "continuing-harness-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Only accepted integration or source reconciliation advances the harness head. The latest upstream revision changes only after accepted reconciliation. Preserve initial and historical baselines in evidence records and distinguish state revision numbers from Git revisions."
        }
      ],
      "children": []
    },
    "continuing-harness-5": {
      "id": "continuing-harness-5",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Source and Execution State"
        }
      ],
      "children": []
    },
