    "sweep-e82d1eae976c4842": {
      "id": "sweep-e82d1eae976c4842",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "DispatchState owns dispatch authority, queued requests, blockers, and event provenance. HarnessState owns source lineage, readiness, execution intent, and timeline links. The dashboard composes these records with run, Sync, and knowledge summaries."
        }
      ],
      "children": []
    },
