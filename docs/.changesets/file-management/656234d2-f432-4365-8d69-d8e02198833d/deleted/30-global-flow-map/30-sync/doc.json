    "map-sync-intro": {
      "id": "map-sync-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync updates the game's source baseline and knowledge inputs before Run resumes. Initial and manual Sync use staged publication; epoch Sync runs automatically inside the settled Run boundary."
        }
      ],
      "children": []
    },
    "map-sync-outline": {
      "id": "map-sync-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Enter Sync",
            "steps": [
              {
                "text": "Manual: acquire a Sync lease or queue."
              },
              {
                "text": "Epoch boundary: retain the Run lease after settlement."
              }
            ]
          },
          {
            "text": "Reconcile and verify source",
            "steps": [
              {
                "text": "Manual: stage changes and wait for publication confirmation."
              },
              {
                "text": "Epoch boundary: apply the configured merge policy and recompute evidence automatically."
              }
            ]
          },
          {
            "text": "Refresh configured knowledge sources",
            "steps": [
              {
                "text": "Import captures, reconcile subjects, and queue librarian processing."
              }
            ]
          },
          {
            "text": "Record the accepted source and evidence",
            "steps": [
              {
                "text": "Failed required gates block the next epoch. Desired pause remains in effect."
              }
            ]
          }
        ]
      },
      "children": []
    },
