    "b-day-evid-1": {
      "id": "b-day-evid-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker outputs cross the sandbox boundary as evidence and selected patches. The host owns checkpoint records, source integration, worker summaries, and knowledge ingestion. Sandbox deletion does not discard the evidence those lanes require."
        }
      ],
      "children": []
    },
    "b-day-evid-2": {
      "id": "b-day-evid-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
    "b-audit-28f45a5dad28": {
      "id": "b-audit-28f45a5dad28",
      "type": "structured-table",
      "props": {
        "columns": [
          "Handoff",
          "Host Consumer"
        ],
        "rows": [
          [
            "Attempt scores, validation logs, and checkpoint patches",
            "Runner records evidence and selects eligible checkpoints."
          ],
          [
            "Selected checkpoint",
            "Serial integration applies the patch to harness ancestry and records the outcome."
          ],
          [
            "Completed worker artifacts and transcript",
            "When enabled, the worker summarizer produces a run narrative for knowledge intake."
          ],
          [
            "Summary and cited observations",
            "The independently enabled librarian consumer writes accepted shared knowledge for later workers."
          ]
        ]
      },
      "children": []
    },
    "b-day-evid-9": {
      "id": "b-day-evid-9",
      "type": "heading",
