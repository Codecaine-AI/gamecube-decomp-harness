    "setup-overview": {
      "id": "setup-overview",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide walks through onboarding a game to the shared harness. Begin with a verified game image and an upstream decompilation repository, then prepare configuration, optional knowledge sources, and a worker image. Each game supplies its own target, paths, and build settings."
        }
      ],
      "children": []
    },
    "setup-overview-model": {
      "id": "setup-overview-model",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-game/10-game-model"
            }
          }
        },
        {
          "insert": " defines the configuration, directory layout, and state used throughout this guide."
        }
      ],
      "children": []
    },
    "setup-guide-flow": {
      "id": "setup-guide-flow",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Verify the Game ISO",
            "steps": [
              {
                "text": "Confirm the game image matches the upstream project's supported region, revision, and checksum."
              }
            ]
          },
          {
            "text": "Configure Upstream",
            "steps": [
              {
                "text": "Build the upstream checkout and register game paths, target settings, and tools."
              }
            ]
          },
          {
            "text": "Set Up Knowledge Sources",
            "steps": [
              {
                "text": "Capture selected sources, import their records, and build search indexes."
              }
            ]
          },
          {
            "text": "Build the Worker Image",
            "steps": [
              {
                "text": "Package the game workspace with shared tools and configure Daytona profiles."
              }
            ]
          },
          {
            "text": "Establish Readiness and Backfill",
            "steps": [
              {
                "text": "Accept build evidence, validate the sandbox, and record the initial save point."
              }
            ]
          }
        ]
      },
      "children": []
    },
