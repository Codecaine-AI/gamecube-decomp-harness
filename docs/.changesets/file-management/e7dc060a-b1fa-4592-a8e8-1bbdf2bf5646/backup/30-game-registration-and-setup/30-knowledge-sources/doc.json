        "setup-backfill-link"
      ]
    },
    "external-required": {
      "id": "external-required",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The upstream decompilation repository is required. Discord channels and a wiki are optional knowledge sources. For each selected source, record its scope and required processing stage so initial Sync can report incomplete preparation."
        }
      ],
      "children": []
    },
    "setup-source-prose": {
      "id": "setup-source-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Declare the PR repository and any selected Discord channels or wiki scope in the files referenced by "
        },
        {
          "insert": "config.sources",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Each definition names its upstream, capture location, adapter, refresh policy, and required processing stage. Represent an absent source explicitly as disabled or unavailable."
        }
      ],
      "children": []
    },
    "setup-source-stages": {
      "id": "setup-source-stages",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Acquire source material",
            "steps": [
              {
                "text": "Capture the configured repository discussions, Discord messages, or wiki pages."
              }
            ]
          },
          {
            "text": "Import the capture",
            "steps": [
              {
                "text": "Write source records with stable evidence identities."
              }
            ]
          },
          {
            "text": "Build search indexes",
            "steps": [
              {
                "text": "Make imported material searchable by the knowledge tools."
              }
            ]
          },
          {
            "text": "Curate knowledge",
            "steps": [
              {
                "text": "Run the librarian over source tasks or a target-driven backfill. Validate proposals before writing facts."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "setup-wiki-explanation": {
      "id": "setup-wiki-explanation",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Capture the Wiki",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-game-registration-and-setup/30-knowledge-sources/10-wiki"
            }
          }
        },
        {
          "insert": " describes site selection, capture scope, the shared MediaWiki helper, and verification. The source pipeline imports the resulting local mirror before indexing and backfill."
        }
      ],
      "children": []
    },
    "setup-discord-link": {
      "id": "setup-discord-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set Up Discord Channels",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-game-registration-and-setup/30-knowledge-sources/20-discord"
            }
          }
        },
        {
          "insert": " explains channel selection, access, capture configuration, and how to verify the imported evidence."
        }
      ],
      "children": []
    },
    "setup-backfill-link": {
      "id": "setup-backfill-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Backfill",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/40-librarian-pathways/40-backfill"
            }
          }
        },
        {
          "insert": " researches targets using the prepared sources and search indexes. Track source preparation and completed curation separately so Run can distinguish available evidence from knowledge still awaiting review."
        }
      ],
      "children": []
    }
  }
