  "title": "Verify Original Inputs",
  "root": "root",
  "blocks": {
    "root": {
      "id": "root",
      "type": "paragraph",
      "props": {},
      "children": [
        "setup-inputs-prose",
        "setup-sms-example",
        "input-verify",
        "input-compressed"
      ]
    },
    "setup-inputs-prose": {
      "id": "setup-inputs-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Choose the upstream repository and a supported game version before writing build settings. The checkout's build instructions determine the original inputs, compiler, and report format. Place the checkout at "
        },
        {
          "insert": "workspace/checkout/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the game directory, and supply the original game inputs in the location that project expects."
        }
      ],
      "children": []
    },
    "setup-sms-example": {
      "id": "setup-sms-example",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For Super Mario Sunshine, "
        },
        {
          "insert": "doldecomp/sms",
          "attributes": {
            "link": "https://github.com/doldecomp/sms"
          }
        },
        {
          "insert": " supports Japanese Rev 0 as "
        },
        {
          "insert": "GMSJ01",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Its build accepts an RVZ disc image in "
        },
        {
          "insert": "orig/GMSJ01/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " inside the checkout. The harness game ID is "
        },
        {
          "insert": "sms",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The build target ID is "
        },
        {
          "insert": "GMSJ01",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "input-verify": {
      "id": "input-verify",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Verify the disc region and revision against the upstream project's supported target before configuring the harness. Record the verification method and the checksum of the original disc data; a filename alone does not establish the version."
        }
      ],
      "children": []
    },
    "input-compressed": {
      "id": "input-compressed",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use the input format accepted by the upstream build. SMS accepts RVZ directly, so conversion to ISO is not a prerequisite. A checksum of the compressed RVZ is different from a checksum of the original disc data."
        }
      ],
      "children": []
    }
  }
}
