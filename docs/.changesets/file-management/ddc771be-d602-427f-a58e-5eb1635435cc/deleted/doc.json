    "b-index-dispatch-and-cycle-eve-2": {
      "id": "b-index-dispatch-and-cycle-eve-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Dispatch events preserve workflow authority and recoverable evidence delivery. Durable ordering and replay identities prevent retries from manufacturing a second accepted fact."
        }
      ],
      "children": []
    },
    "b-index-an-occupied-lease-follow-4": {
      "id": "b-index-an-occupied-lease-follow-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An occupied lease follows this accepted event order:"
        }
      ],
      "children": []
    },
    "b-index-text-5": {
      "id": "b-index-text-5",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "game.dispatch_requested\n  -> game.dispatch_released\n  -> game.dispatch_acquired"
        }
      ],
      "children": []
    },
    "b-index-when-the-lease-is-free-6": {
      "id": "b-index-when-the-lease-is-free-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When the lease is free, acquisition follows the request without a release. A blocker discovered during handoff produces "
        },
        {
          "insert": "game.dispatch_blocked",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and acquisition waits. A queued request may be cleared by "
        },
        {
          "insert": "game.dispatch_request_cancelled",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without pretending that authority transferred."
        }
      ],
      "children": []
    },
    "b-dispatch-handoff-sequence-diagram": {
      "id": "b-dispatch-handoff-sequence-diagram",
      "type": "sequence",
      "props": {
        "sequenceId": "b-dispatch-handoff-sequence-diagram",
        "src": "./assets/sequences/dispatch-handoff.sequence.json",
        "title": "Dispatch handoff"
      },
      "children": []
    },
    "b-index-release-creates-one-immu-7": {
      "id": "b-index-release-creates-one-immu-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Release creates one immutable handoff snapshot. "
        },
        {
          "insert": "game.dispatch_released",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries its "
        },
        {
          "insert": "handoff_snapshot_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "handoff_snapshot_content_hash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the successor "
        },
        {
          "insert": "game.dispatch_acquired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries the same pair plus the new lease and accepted state revision. The snapshot persists the release event identity and zero or one acquisition identity. Consumers join the pair by snapshot identity and hash, not by timestamps, correlation, or trace."
        }
      ],
      "children": []
    },
    "b-index-the-release-stays-in-the-8": {
      "id": "b-index-the-release-stays-in-the-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The release stays in the outgoing workflow's "
        },
        {
          "insert": "correlation_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "trace_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Acquisition and ingestion stay in the successor workflow's original correlation and trace. Their causation remains "
        },
        {
          "insert": "game.dispatch_released",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "game.dispatch_acquired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "sync.ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so the release-to-acquire link is the durable bridge across workflow-local lineage. Stable snapshot content yields a stable hash and snapshot identity; snapshot, release, and acquisition writes roll back together on failure."
        }
      ],
      "children": []
    },
    "b-index-exiting-run-loop-settlement-9": {
      "id": "b-index-exiting-run-loop-settlement-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Settlement by the exiting run-loop process and successor acquisition are two accepted actions. The exiting run-loop emits "
        },
        {
          "insert": "game.dispatch_released",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "run.paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the settlement command and settlement root span, with "
        },
        {
          "insert": "guardian",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as actor for event compatibility. The successor action emits "
        },
        {
          "insert": "game.dispatch_acquired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "sync.ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the original queued operator "
        },
        {
          "insert": "sync.start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " command and root span, with "
        },
        {
          "insert": "operator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as actor. Immediate "
        },
        {
          "insert": "sync.start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " uses the same operator provenance. "
        },
        {
          "insert": "sync.ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " accepts only "
        },
        {
          "insert": "operator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "runner",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never "
        },
        {
          "insert": "guardian",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-index-transport-replay-10": {
      "id": "b-index-transport-replay-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Transport replay"
        }
      ],
      "children": []
    },
    "b-transport-replay-outline": {
      "id": "b-transport-replay-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Commit the accepted event and deterministic delivery identities together"
          },
          {
            "text": "Deliver at least once",
            "steps": [
              {
                "text": "A consumer commits the delivery identity with its effect."
              }
            ]
          },
          {
            "text": "Acknowledge durable acceptance",
            "steps": [
              {
                "text": "Duplicate delivery is an acknowledged no-op."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-index-each-accepted-game-ev-11": {
      "id": "b-index-each-accepted-game-ev-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each accepted game-event transaction creates its outgoing spool deliveries in the same commit. A delivery identity is deterministic from "
        },
        {
          "insert": "event_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and destination. Delivery is at least once: a crash before acknowledgement redelivers the same identity, the consumer commits the identity with its effect, and a duplicate is an acknowledged no-op. A spool entry clears only after durable acceptance, and replay never appends another game event or reapplies an accepted fact."
        }
      ],
      "children": []
    },
    "b-index-save-point-failure-repla-12": {
      "id": "b-index-save-point-failure-repla-12",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Save-point failure replay"
        }
      ],
      "children": []
    },
    "b-index-a-failed-save-point-reco-13": {
      "id": "b-index-a-failed-save-point-reco-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Save-point failures append a failed harness timeline boundary with recovery.stage set to save_point_capture, raise a blocker, and mark evidence stale. Retain the anchored commit, trigger, command identity, and diagnostics for recovery."
        }
      ],
      "children": []
    },
    "b-index-a-successful-retry-write-14": {
      "id": "b-index-a-successful-retry-write-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Capture appends a save_point timeline boundary with outcome recorded or evidence_unknown. A successful retry remains anchored to the original source position. Stable operation identities prevent duplicate accepted evidence; required freshness gates control admission."
        }
      ],
      "children": []
    },
    "b-index-the-entire-failure-spool-15": {
      "id": "b-index-the-entire-failure-spool-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The entire failure spool validates before replay begins. A malformed final "
        },
        {
          "insert": "*.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " spool file or invalid spool schema fails loudly with an error naming the path; the corrupt file is retained and no partial event is emitted. A missing spool directory is an empty spool."
        }
      ],
      "children": []
    },
    "b-dispatch-sequence-heading": {
      "id": "b-dispatch-sequence-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Dispatch Handoff"
        }
      ],
      "children": []
    },
    "b-dispatch-handoff-sequence": {
      "id": "b-dispatch-handoff-sequence",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Request authority",
            "steps": [
              {
                "text": "Append game.dispatch_requested."
              }
            ]
          },
          {
            "text": "Settle the occupied lease",
            "steps": [
              {
                "text": "Stamp the requested handoff on the holder and stop it."
              },
              {
                "text": "Append game.dispatch_released with the immutable handoff snapshot."
              }
            ]
          },
          {
            "text": "Acquire authority",
            "steps": [
              {
                "text": "Append game.dispatch_acquired with the same snapshot identity and hash."
              }
            ]
          }
        ]
      },
      "children": []
    }
  }
}
