        {
          "insert": "Historical Measurements"
        }
      ],
      "children": []
    },
    "b-stop-thinking-10": {
      "id": "b-stop-thinking-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The August 19, 2026 replay covered 53 recorded sessions and estimated 70.0% sandbox-cost savings with about 8% added wall time. The live benchmark measured about 1.01 seconds to stop and 1.02 seconds to wake to first exec. These are dated experiment results, not runtime guarantees."
        }
      ],
      "children": []
    },
