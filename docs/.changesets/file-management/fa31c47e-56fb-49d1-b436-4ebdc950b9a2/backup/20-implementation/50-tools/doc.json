              "path": "toolpacks",
              "label": "toolpacks"
            }
          }
        },
        {
          "insert": " (every future toolpack keeps this shape), "
        },
        {
          "insert": "apps/server/src/core/tools",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/tools",
              "label": "apps/server/src/core/tools"
            }
          }
        },
        {
          "insert": ", "
