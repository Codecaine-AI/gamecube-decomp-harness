            "reference": {
              "kind": "source",
              "path": "games/melee/config/tools",
              "label": "games/melee/tool-bindings"
            }
          }
        },
        {
          "insert": ". A future tool registers an id in the toolpack registry and gains an id-based wrapper; game-specific data goes to the game's bindings and tool-data roots, never into the pack."
        }
      ],
      "children": []
