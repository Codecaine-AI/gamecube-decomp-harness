    "b-tools-toolpack-decision-7": {
      "id": "b-tools-toolpack-decision-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": tool implementations include contracts, default APIs, runners, registry, and shared helpers. These live in a game-agnostic toolpack ("
        },
        {
          "insert": "toolpacks/gamecube-decomp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", ids registered in its "
        },
        {
          "insert": "registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). A game opts in via "
        },
        {
          "insert": "games/<id>/game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and owns its bindings and generated tool data. "
        },
        {
          "insert": "apps/server/src/core/tools",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns only the resolver, runtime, profiles, and agent-facing wrappers. It contains no tool implementations or mirrored server-local resource tree. Wrappers call tools by stable id, never by physical script path."
        }
      ],
      "children": []
    },
    "b-tools-toolpack-why-8": {
      "id": "b-tools-toolpack-why-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was server-owned tool resources and game-specific helpers inside the pack; those paths are retired and the boundary is enforced by "
        },
        {
          "insert": "apps/server/src/core/tools/tooling-layout.test.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/tools/tooling-layout.test.ts",
              "label": "apps/server/src/core/tools/tooling-layout.test.ts"
            }
          }
        },
        {
          "insert": ". The split keeps the pack reusable across GameCube games and keeps the server game-agnostic."
        }
      ],
      "children": []
    },
    "b-tools-toolpack-applies-9": {
      "id": "b-tools-toolpack-applies-9",
