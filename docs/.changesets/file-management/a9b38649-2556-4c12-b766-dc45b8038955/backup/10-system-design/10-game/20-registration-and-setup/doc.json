    "sweep-13fc0b5571604bc5": {
      "id": "sweep-13fc0b5571604bc5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Setting up a game connects an upstream decompilation project and original game inputs to the harness. Prepare its checkout, configuration, and knowledge sources, then establish build and sandbox readiness before Run. Registration discovers the configuration. Initial Sync and validation establish what the harness can use."
        }
      ],
      "children": []
    },
    "setup-model-link": {
      "id": "setup-model-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-game/10-game-model"
            }
          }
        },
        {
          "insert": " defines the configuration and game directory layout used here."
        }
      ],
      "children": []
    },
    "setup-inputs-heading": {
      "id": "setup-inputs-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Choose the Project and Game Version"
        }
      ],
      "children": []
    },
    "setup-inputs-prose": {
      "id": "setup-inputs-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Choose the upstream repository and a supported game version before writing build settings. The checkout's build instructions determine the original inputs, compiler, and report format. Place the checkout at "
        },
        {
          "insert": "workspace/checkout/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the game directory, and supply the original game inputs in the location that project expects."
        }
      ],
      "children": []
    },
    "setup-sms-example": {
      "id": "setup-sms-example",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For Super Mario Sunshine, "
        },
        {
          "insert": "doldecomp/sms",
          "attributes": {
            "link": "https://github.com/doldecomp/sms"
          }
        },
        {
          "insert": " supports Japanese Rev 0 as "
        },
        {
          "insert": "GMSJ01",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Its build accepts an RVZ disc image in "
        },
        {
          "insert": "orig/GMSJ01/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " inside the checkout. The harness game ID is "
        },
        {
          "insert": "sms",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The build target ID is "
        },
        {
          "insert": "GMSJ01",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "sweep-83863eb80867423a": {
      "id": "sweep-83863eb80867423a",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Descriptor Discovery"
        }
      ],
      "children": []
    },
    "sweep-d9b2806681f14780": {
      "id": "sweep-d9b2806681f14780",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Create "
        },
        {
          "insert": "games/<id>/game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a matching "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "resolveGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selects an explicit game ID, the configured "
        },
        {
          "insert": "defaultGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or the sole descriptor directory. Multiple candidates without a default fail. A directory without "
        },
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not a registered game."
        }
      ],
      "children": []
    },
    "sweep-eaa29256ae6d47d5": {
      "id": "sweep-eaa29256ae6d47d5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "Resolution"
        ],
        "rows": [
          [
            "game.json and config references",
            "Build, sandbox, and tools references load from game-relative files. Inline section values override referenced values. config.build hydrates validation."
          ],
          [
            "config/local.json",
            "Optional local overrides merge over the descriptor."
          ],
          [
            "Explicit overrides",
            "Highest precedence. Explicit path overrides resolve from explicitOverrideBaseDir or the current directory."
          ]
        ]
      },
      "children": []
    },
    "sweep-b95135d32c45403f": {
      "id": "sweep-b95135d32c45403f",
      "type": "heading",
      "props": {
        "level": 2
      },
