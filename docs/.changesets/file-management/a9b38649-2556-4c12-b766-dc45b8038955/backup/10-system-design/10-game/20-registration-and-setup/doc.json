    "sweep-f86c9a9f087e42c0": {
      "id": "sweep-f86c9a9f087e42c0",
      "type": "structured-table",
      "props": {
        "columns": [
          "Condition",
          "Result"
        ],
        "rows": [
          [
            "Invalid ID, missing descriptor, malformed descriptor, or mismatched descriptor ID",
            "Resolution throws."
          ],
          [
            "Missing checkout, graph directory, or local environment file",
            "Resolution returns warnings. These are filesystem existence checks."
          ],
          [
            "Remote access, toolkit execution, build readiness, or credentials",
            "Resolution does not prove these are usable. The consuming operation performs its own checks."
          ]
        ]
      },
      "children": []
    },
    "sweep-3b3455c642414890": {
      "id": "sweep-3b3455c642414890",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Worktree Handoff"
        }
      ],
      "children": []
    },
    "sweep-43d77e0967de4dca": {
      "id": "sweep-43d77e0967de4dca",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness State owns the canonical worktree and source lineage. Sync owns upstream intake, staging, validation, and confirmed publication. Descriptor resolution alone does not establish bootstrap readiness."
        }
      ],
      "children": []
    },
    "sweep-63b60d70afc343cd": {
      "id": "sweep-63b60d70afc343cd",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The resolution contract is implemented by "
        },
        {
          "insert": "apps/server/src/core/game-registry/resolver.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/game-registry/resolver.ts"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    }
  }
