        {
          "insert": "Resolved Configuration"
        }
      ],
      "children": []
    },
    "sweep-2e832693ab9f4e5d": {
      "id": "sweep-2e832693ab9f4e5d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Descriptor-relative paths resolve against the game directory. Defaults are "
        },
        {
          "insert": "workspace/checkout",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "runtime/state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "knowledge/graph/graph.sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "config/local.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Required consumers use these resolved paths rather than guessing another checkout or store."
        }
      ],
      "children": []
    },
    "sweep-b52402a0c9e64f32": {
      "id": "sweep-b52402a0c9e64f32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process name defaults to "
        },
        {
          "insert": "<gameId>-live",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "baseRef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defaults to "
        },
        {
          "insert": "origin/master",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Melee keeps the stable process name "
        },
        {
          "insert": "melee-live",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Runtime consumers receive explicit resolved checkout, state, graph, environment, and tool-data paths."
        }
      ],
      "children": []
    },
    "setup-sandbox-profiles": {
      "id": "setup-sandbox-profiles",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sandbox configuration supports named profiles with inherited common fields. Melee uses "
        },
        {
          "insert": "2-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by default and retains "
        },
        {
          "insert": "4-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as an optional profile. Unknown profile names and invalid resource values fail resolution. Claim metadata records the resolved profile, image, baked revision, workspace, and resources."
        }
      ],
      "children": []
    },
    "setup-sandbox-profile-shape": {
      "id": "setup-sandbox-profile-shape",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"default_profile\": \"2-core\",\n  \"profiles\": {\n    \"2-core\": {\n      \"snapshot_name\": \"example-game-2c\",\n      \"snapshot_baked_rev\": \"commit-A\",\n      \"workspace_root\": \"/work/game\",\n      \"resource_class\": {\n        \"cpu\": 2,\n        \"memory_gib\": 4,\n        \"disk_gib\": 5\n      }\n    },\n    \"4-core\": {\n      \"snapshot_name\": \"example-game-4c\",\n      \"snapshot_baked_rev\": \"commit-A\",\n      \"workspace_root\": \"/work/game\",\n      \"resource_class\": {\n        \"cpu\": 4,\n        \"memory_gib\": 8,\n        \"disk_gib\": 5\n      }\n    }\n  }\n}",
        "fields": [
          {
            "name": "default_profile",
            "type": "string",
            "description": "Must name a configured profile; default is 2-core."
          },
          {
            "name": "profiles",
            "type": "map<string, SandboxProfile>",
            "description": "Named execution options.",
            "fields": [
              {
                "name": "snapshot_name",
                "type": "string",
                "description": "Accepted Daytona snapshot."
              },
              {
                "name": "snapshot_baked_rev",
                "type": "revision",
                "description": "Checkout revision in this image."
              },
              {
                "name": "workspace_root",
                "type": "string",
                "description": "Game workspace inside Daytona."
              },
              {
                "name": "resource_class",
                "type": "object",
                "description": "CPU, memory in GiB, and disk in GiB."
              }
            ]
          }
        ],
        "name": "SandboxProfiles",
        "source": {
          "path": "apps/server/src/core/game-registry/resolver.ts",
          "symbol": "GameSandboxConfig"
        }
      },
      "children": []
    },
    "setup-source-heading": {
      "id": "setup-source-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Configure Knowledge Sources"
        }
      ],
      "children": []
    },
    "setup-source-prose": {
      "id": "setup-source-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Declare the PR repository, Discord server and channels, and wiki scope in the files referenced by "
        },
        {
          "insert": "config.sources",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Each definition names its upstream, capture location, adapter, refresh policy, and required processing stage. An absent source needs an explicit disabled or unavailable state. It is not an empty successful import."
        }
      ],
      "children": []
    },
    "setup-source-stages": {
      "id": "setup-source-stages",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Acquire source material",
            "steps": [
              {
                "text": "Capture the configured repository discussions, Discord messages, or wiki pages."
              }
            ]
          },
          {
            "text": "Import the capture",
            "steps": [
              {
                "text": "Write source records with stable evidence identities."
              }
            ]
          },
          {
            "text": "Build search indexes",
            "steps": [
              {
                "text": "Make imported material searchable by the knowledge tools."
              }
            ]
          },
          {
            "text": "Curate knowledge",
            "steps": [
              {
                "text": "Run the librarian over source tasks or a target-driven backfill. Validate proposals before writing facts."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "setup-wiki-explanation": {
      "id": "setup-wiki-explanation",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wiki acquisition depends on the site. SMS configures Super Mario Wiki and uses the shared MediaWiki helper to capture its Sunshine category tree, complete pages, and media. "
        },
        {
          "insert": "Wiki",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/10-knowledge-sources/10-archival/30-wiki"
            }
          }
        },
        {
          "insert": " defines capture scope, verification, and the command. The source pipeline imports the resulting "
        },
        {
          "insert": "local-mirror",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " before indexing and backfill."
        }
      ],
      "children": []
    },
    "setup-backfill-link": {
      "id": "setup-backfill-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Backfill",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/40-librarian-pathways/40-backfill"
            }
          }
        },
        {
          "insert": " researches targets using the prepared sources and search indexes. Track source preparation and completed curation separately so Run can distinguish available evidence from knowledge still awaiting review."
        }
      ],
      "children": []
    },
    "setup-initial-sync-heading": {
      "id": "setup-initial-sync-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Initial Sync and Backfill"
        }
      ],
      "children": []
    },
    "setup-initial-sync-process": {
      "id": "setup-initial-sync-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Resolve Project Configuration",
            "steps": [
              {
                "text": "Validate identity, repository, target/build profile, tools, and declared external sources."
              },
              {
                "text": "Report missing required credentials or capabilities without treating missing data as an empty source."
              }
            ]
          },
          {
            "text": "Establish the Harness Worktree",
            "steps": [
              {
                "text": "Provision the configured checkout before initial Sync; resolve and verify its Git source identity."
              },
              {
                "text": "Build and validate the selected target; derive report targets and source entities before curation."
              }
            ]
          },
          {
            "text": "Seed Configured Knowledge",
            "steps": [
              {
                "text": "Capture initial PR, Discord, and wiki material according to declared scope."
              },
              {
                "text": "Import immutable records and build search indexes."
              },
              {
                "text": "Queue or run librarian backfill; record which subjects and source captures were covered."
              }
            ]
          },
          {
            "text": "Verify Execution and Readiness",
            "steps": [
              {
                "text": "Run validate-sandbox for the selected profile after initial Sync accepts build evidence."
              },
              {
                "text": "Build host and Daytona reports at the accepted head; compare scored functions and sizes and preserve proof."
              },
              {
                "text": "Require the configured bootstrap gates, with optional unfinished curation visibly pending."
              }
            ]
          },
          {
            "text": "Record Initial Boundary",
            "steps": [
              {
                "text": "Persist accepted head, upstream baseline, configuration provenance, and initial save point."
              },
              {
                "text": "Enable Run admission only after readiness succeeds. Resume interrupted setup from durable stage results."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "setup-bootstrap-gates": {
      "id": "setup-bootstrap-gates",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Bootstrap requires declared source acquisition, import, and search indexes, plus mechanical entities and valid build evidence. Semantic curation can remain pending with visible coverage. Sandbox readiness requires separate verified execution evidence before Run admission."
        }
      ],
      "children": []
    },
    "setup-sandbox-readiness-heading": {
      "id": "setup-sandbox-readiness-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Sandbox Readiness"
        }
      ],
      "children": []
    },
    "setup-sandbox-readiness": {
      "id": "setup-sandbox-readiness",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Initial Sync accepts the configured checkout and build evidence before sandbox validation. The validation command reserves exclusive dispatch authority, checks the accepted head and configuration, builds host and Daytona reports, compares scored functions and sizes, preserves evidence, and deletes the sandbox. Only successful validation marks sandbox readiness ready. Initial readiness is recorded when every required gate is ready."
        }
      ],
      "children": []
    },
    "setup-sandbox-readiness-command": {
      "id": "setup-sandbox-readiness-command",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun run server:job -- validate-sandbox --game <id> [--sandbox-profile <name>]"
        }
      ],
      "children": []
    },
    "setup-sandbox-readiness-evidence": {
      "id": "setup-sandbox-readiness-evidence",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Evidence lives under the resolved game state directory at "
        },
        {
          "insert": "sandbox-validation/<operation>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It records host and remote reports, profile, image, accepted head, configuration, and build output. This operation contacts Daytona. Configuration tests alone do not satisfy the gate, and no live validation is implied by a registered descriptor."
        }
      ],
      "children": []
    },
    "sweep-911f6c86cc964f3c": {
      "id": "sweep-911f6c86cc964f3c",
