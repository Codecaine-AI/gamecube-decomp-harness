          },
          {
            "name": "severity",
            "type": "string",
            "required": true
          },
          {
            "name": "bad_pattern",
            "type": "string",
            "required": true
          },
          {
            "name": "preferred_shape",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string[]",
            "required": false,
            "description": "The legacy why field folds into this"
          },
          {
            "name": "evidence_ref",
            "type": "string",
            "required": false
          }
        ],
        "name": "StandardExample",
        "source": {
          "path": "apps/server/src/core/knowledge/standards.ts",
          "symbol": "StandardExampleFileRecord"
