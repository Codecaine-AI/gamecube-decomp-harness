    "b-st-load-po": {
      "id": "b-st-load-po",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Rank family directories by order.json families; unlisted families sort last, alphabetically"
          },
          {
            "text": "Concatenate every slice's standards.jsonl (or examples.jsonl), then re-emit records in order.json sequence and append anything unlisted in family-then-file order"
          },
          {
            "text": "First record wins on a duplicate id"
          },
          {
            "text": "An edit through POST /api/standards rewrites the family slice and refreshes order.json"
          }
        ]
      },
      "children": []
