      "type": "structured-table",
      "props": {
        "columns": [
          "Value",
          "Meaning"
        ],
        "rows": [
          [
            "accepted",
            "In force; worker-facing rules are eligible for prompt inclusion. Automated enforcement requires associated lint rules."
          ],
          [
            "proposed",
            "Awaiting QA review; not injected"
          ],
          [
            "superseded",
            "Replaced by another standard named in superseded_by"
          ],
          [
            "merged",
            "Folded into another standard"
          ],
          [
            "workflow_only",
            "Governs the pipeline, not authored source; never worker-facing"
          ]
        ]
