    "b-st-intro": {
      "id": "b-st-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A standard is an authored rule for source changes. Its record states the requirement, preferred and rejected forms, status, and any lint rules that enforce it. Examples show concrete repairs. This page describes the current file contract; shared and game-specific scope is a separate proposed extension."
        }
      ],
      "children": []
    },
    "b-st-rec-h": {
      "id": "b-st-rec-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Record"
        }
      ],
      "children": []
    },
    "b-st-shape": {
      "id": "b-st-shape",
      "type": "state-shape",
      "props": {
        "description": "One line of a family's standards.jsonl.",
        "example": "{\n  \"schema_version\": \"global_standard_v1\",\n  \"id\": \"global_standard:preserve-public-signatures\",\n  \"kind\": \"global_standard\",\n  \"status\": \"proposed\",\n  \"title\": \"Preserve Public Signatures\",\n  \"summary\": \"Keep public declarations consistent with the owning header.\",\n  \"do\": [\n    \"Use the owning header declaration.\"\n  ],\n  \"do_not\": [\n    \"Add a conflicting local declaration.\"\n  ],\n  \"evidence_refs\": [\n    \"code://example-revision/src/melee/ft/ftcommon.h#L10-L14\"\n  ],\n  \"family\": \"declarations\",\n  \"worker_facing\": true\n}",
        "fields": [
          {
            "name": "schema_version",
            "type": "string",
            "required": true,
            "description": "global_standard_v1"
          },
          {
            "name": "id",
            "type": "string",
            "required": true,
            "description": "global_standard:<slug>, lowercase letters, digits, hyphens"
          },
          {
            "name": "kind",
            "type": "string",
            "required": true,
            "description": "global_standard"
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "description": "accepted, proposed, superseded, merged, workflow_only"
          },
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "summary",
            "type": "string | string[]",
            "required": true
          },
          {
            "name": "do",
            "type": "string[]",
            "required": true,
            "description": "Preferred shapes; rendered to the worker as preferred prompt signals"
          },
          {
            "name": "do_not",
            "type": "string[]",
            "required": true,
            "description": "Rejected shapes; rendered as rejected prompt signals"
          },
          {
            "name": "evidence_refs",
            "type": "string[]",
            "required": true
          },
          {
            "name": "family",
            "type": "string",
            "required": false,
            "description": "The slice directory the record lives in"
          },
          {
            "name": "severity",
            "type": "string",
            "required": false,
            "description": "For example required"
          },
          {
            "name": "qa_enforcement",
            "type": "string",
            "required": false,
            "description": "How the gate enforces it, for example partial_hard_lint_plus_repair_hints"
          },
          {
            "name": "qa_rule_ids",
            "type": "string[]",
            "required": false,
            "description": "The review_lint rule ids that cite this standard"
          },
          {
            "name": "worker_facing",
            "type": "boolean",
            "required": false,
            "description": "false hides the standard from the worker prompt"
          },
          {
            "name": "disposition, retired_into, example_policy, preferred_repairs, superseded_by, curator_update_policy",
            "type": "optional",
            "required": false
          }
        ],
        "name": "Standard",
        "source": {
          "path": "apps/server/src/core/knowledge/standards.ts",
          "symbol": "StandardsFileRecord"
        }
      },
      "children": []
    },
    "b-st-ex-shape": {
      "id": "b-st-ex-shape",
      "type": "state-shape",
