    "b-10-worker-opening-2": {
      "id": "b-10-worker-opening-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker executes one claimed decompilation target toward a 100% objdiff match in its own Daytona sandbox. It edits only the approved write set, initially the target file. The host runner owns validation, checkpoints, continuation, and lifecycle close."
        }
      ],
      "children": []
    },
    "b-10-worker-inputs-heading-4": {
      "id": "b-10-worker-inputs-heading-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Context Inputs"
        }
      ],
      "children": []
    },
    "b-10-worker-sources-3": {
      "id": "b-10-worker-sources-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker packet carries an optional repair request, target and inlined source, the first diff, one V2 target-knowledge card when available, and decomp standards. Context budgets are full, compact, or minimal. A proposed-name source view helps reading, but edits and compiler citations use canonical symbols and original source."
        }
      ],
      "children": []
    },
    "b-10-worker-inputs-body-5": {
      "id": "b-10-worker-inputs-body-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker Knowledge Surfaces",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/60-worker-surfaces",
              "label": "Worker Knowledge Surfaces"
            }
          }
        },
        {
          "insert": " owns the detailed card, source-view, and query contract. Tool registration supplies the available callable tools separately from packet context."
        }
      ],
      "children": []
    },
