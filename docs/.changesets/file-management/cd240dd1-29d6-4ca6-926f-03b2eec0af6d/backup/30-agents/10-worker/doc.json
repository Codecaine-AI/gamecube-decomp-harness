    "b-10-worker-runs-body-9": {
      "id": "b-10-worker-runs-body-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run scheduler dispatches one worker session per target claim. Commands and edits run in the sandbox while the host runs the agent loop. On close, selected checkpoint evidence enters serial integration. Enabled worker-summary processing produces a host-side narrative for librarian intake."
        }
      ],
      "children": []
    },
