      "children": []
    },
    "b-system-overview-bullet-1": {
      "id": "b-system-overview-bullet-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Shared Knowledge",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-system-overview-bullet-1-detail-1"
      ]
    },
    "b-system-overview-bullet-1-detail-1": {
      "id": "b-system-overview-bullet-1-detail-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "We build a shared knowledge base from external pull requests, Discord messages, and game wiki content."
        }
      ],
      "children": []
    },
    "b-system-overview-bullet-2": {
      "id": "b-system-overview-bullet-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Parallel Workers",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-system-overview-bullet-2-detail-1"
      ]
    },
    "b-system-overview-bullet-2-detail-1": {
      "id": "b-system-overview-bullet-2-detail-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Many workers repeatedly attempt targets across epochs, using the knowledge accumulated so far to guide their decompilation work."
        }
      ],
      "children": []
    },
    "b-system-overview-bullet-3": {
      "id": "b-system-overview-bullet-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Worker Sandboxes",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-system-overview-bullet-3-detail-1"
      ]
    },
    "b-system-overview-bullet-3-detail-1": {
      "id": "b-system-overview-bullet-3-detail-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Each worker operates in its own sandbox with source files and tools for editing, compiling, debugging, and scoring."
        }
      ],
      "children": []
    },
    "b-system-overview-bullet-4": {
      "id": "b-system-overview-bullet-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Learning From Each Attempt",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-system-overview-bullet-4-detail-1",
        "b-system-overview-bullet-4-detail-2"
      ]
    },
    "b-system-overview-bullet-4-detail-1": {
      "id": "b-system-overview-bullet-4-detail-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When a worker finishes, its results pass through summarization to the librarian."
        }
      ],
      "children": []
    },
    "b-system-overview-bullet-4-detail-2": {
      "id": "b-system-overview-bullet-4-detail-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The librarian processes the findings for the shared knowledge base so future workers can learn from the attempt."
        }
      ],
      "children": []
    },
    "b-system-overview-bullet-5": {
      "id": "b-system-overview-bullet-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "External Source Updates",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-system-overview-bullet-5-detail-1"
      ]
    },
    "b-system-overview-bullet-5-detail-1": {
      "id": "b-system-overview-bullet-5-detail-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When external sources receive new information, that information is processed and the related knowledge is updated."
        }
      ],
      "children": []
    },
