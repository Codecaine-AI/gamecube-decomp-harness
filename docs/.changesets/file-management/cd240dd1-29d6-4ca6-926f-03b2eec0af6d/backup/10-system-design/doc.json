      "id": "b-system-flow-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For a given "
        },
        {
          "insert": "game",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-game-model"
            }
          }
        },
        {
          "insert": ", the system builds shared knowledge that many workers use and contribute to:"
        }
