    "b-ks2-path-wiki-intro": {
      "id": "b-ks2-path-wiki-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wiki sync uses "
        },
        {
          "insert": "index_task.pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "archival_ingest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Discord sync shares this enum value, and the task payload names the source. It fires only on an explicit kg2-ingest --lane wiki, which --reset-source wiki also requires. The mirror rarely changes and its import is slow, so the wiki lane is in neither the default sync set (reconcile, prs, discord, attempts) nor all."
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-intro-detail-1": {
      "id": "b-ks2-path-wiki-intro-detail-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The importer inserts "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows at a new mirror revision during a mirror re-sync. Bulk and lower priority: no single target's ledger is waiting on it. The librarian searches the new sections and attaches facts to the subjects they mention, citing "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-agents-heading": {
      "id": "b-ks2-path-wiki-agents-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Agents Called"
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-agents-table": {
      "id": "b-ks2-path-wiki-agents-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Order",
          "Agent",
          "Does"
        ],
        "rows": [
          [
            "1",
            "Wiki importer",
            [
              {
                "insert": "On --lane wiki only: inserts "
              },
              {
                "insert": "wiki_section",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows at a new "
              },
              {
                "insert": "mirror_revision",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " without changing existing rows; advances the "
              },
              {
                "insert": "wiki",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " source watermark; enqueues the index task. A deterministic pipeline; source rows only, never facts"
              }
            ]
          ],
          [
            "2",
            "Librarian",
            [
              {
                "insert": "Consumes the task: searches the new sections, attaches "
              },
              {
                "insert": "fact",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows to the subjects they mention, admits a curated "
              },
              {
                "insert": "game_concept",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " where the material warrants one"
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-ks2-path-wiki-librarian-heading": {
      "id": "b-ks2-path-wiki-librarian-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Librarian Operation"
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-librarian-reads": {
      "id": "b-ks2-path-wiki-librarian-reads",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian searches new sections with BM25 over section content and vector retrieval over section embeddings. Structured filters narrow results by page and "
        },
        {
          "insert": "mirror_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", defaulting to the latest revision. Section embeddings are the wiki's primary search method for conceptual queries. The librarian then reads the page around each hit."
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-librarian-reads-detail-1": {
      "id": "b-ks2-path-wiki-librarian-reads-detail-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Subjects are whatever the sections mention: targets by symbol, and the mechanical entity kinds "
        },
        {
          "insert": "translation_unit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct_field",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "parameter",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", whose rows the entity extractor has already inserted from the checkout. A subject with no row is not silently invented: where the material warrants it, the librarian may admit a "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entity, curated and librarian-written like "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Wiki material is where game concepts are most often seeded. Locals and returns are not entities and get no rows."
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-librarian-writes": {
      "id": "b-ks2-path-wiki-librarian-writes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every write goes through the resolver. Fact rows are added or overwritten under the mentioned subjects, "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows replaced wholesale with "
        },
        {
          "insert": "wiki://<wiki_section.id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators into the new rows, each id naming one (page, section, mirror revision) triple, corroborated against the code graph where the checkout can confirm what the wiki said. Material that connects subjects can add curated "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. Section rows are frozen once mirrored. A re-sync inserts new rows at a new revision, so these citations can never drift and carry no digest."
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-coverage-heading": {
      "id": "b-ks2-path-wiki-coverage-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Coverage"
        }
      ],
      "children": []
    },
    "b-ks2-path-wiki-coverage-p": {
      "id": "b-ks2-path-wiki-coverage-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The wiki importer runs by hand, outside the sync and all lanes. It advances the "
        },
        {
          "insert": "wiki",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row of "
        },
        {
          "insert": "source_watermark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Its "
        },
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the mirror revision, which no other agent parses. The importer enqueues "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows with "
        },
        {
          "insert": "pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "archival_ingest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " whose payloads name the newly mirrored sections. The payload distinguishes this pathway from the Discord sync because both use the same enum value. These tasks queue behind the per-target pathways. Completion is by the task timestamps, and the pass stamps "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for each subject it covered. A subject whose "
        },
        {
          "insert": "indexed_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " predates the new material still needs a pass even when no queue row names it."
        }
      ],
      "children": []
    },
