    "source-contract-1": {
      "id": "source-contract-1",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"definition\": {\n    \"identity\": {\n      \"game_id\": \"example-game\",\n      \"source_id\": \"game-wiki\",\n      \"kind\": \"wiki\",\n      \"upstream\": \"https://wiki.example.org\"\n    },\n    \"configuration\": {\n      \"enabled\": true,\n      \"adapter\": \"local-mirror\",\n      \"adapter_version\": \"1\",\n      \"scope\": {\n        \"capture_root\": \"./knowledge/sources/wiki/export\"\n      },\n      \"credential_ref\": null,\n      \"refresh\": \"explicit\",\n      \"required_stage\": \"search_index\"\n    }\n  },\n  \"state\": {\n    \"identity\": {\n      \"game_id\": \"example-game\",\n      \"source_id\": \"game-wiki\",\n      \"kind\": \"wiki\",\n      \"upstream\": \"https://wiki.example.org\"\n    },\n    \"configuration_hash\": \"sha256-of-definition\",\n    \"operation_id\": \"bootstrap-1\",\n    \"capture\": {\n      \"manifest\": \"capture-001\",\n      \"content_hashes\": {\n        \"pages.jsonl\": \"sha256-of-content\"\n      },\n      \"revisions\": [],\n      \"cursor\": {},\n      \"acquisition_origin\": \"local_mirror\",\n      \"upstream_refreshed\": false\n    },\n    \"stages\": {\n      \"acquisition\": {\n        \"status\": \"complete\",\n        \"counts\": {\n          \"files\": 1\n        }\n      },\n      \"import\": {\n        \"status\": \"complete\",\n        \"counts\": {\n          \"records\": 20\n        }\n      },\n      \"search_index\": {\n        \"status\": \"complete\"\n      },\n      \"curation\": {\n        \"status\": \"pending\"\n      }\n    },\n    \"readiness\": \"ready\"\n  }\n}",
        "fields": [
          {
            "name": "definition",
            "type": "SourceDefinition",
            "description": "Tracked per-game input configuration.",
            "fields": [
              {
                "name": "identity",
                "type": "object",
                "description": "game_id, source_id, kind, and upstream."
              },
              {
                "name": "configuration",
                "type": "object",
                "description": "enabled, adapter/version, scope, optional credential_ref, refresh, required_stage, and optional reason."
              }
            ]
          },
          {
            "name": "state",
            "type": "SourceState",
            "description": "Generated durable state, stored separately from configuration.",
            "fields": [
              {
                "name": "identity",
                "type": "object",
                "description": "Copy of the definition identity."
              },
              {
                "name": "configuration_hash",
                "type": "string",
                "description": "Fingerprint of the definition."
              },
              {
                "name": "operation_id",
                "type": "string",
                "description": "Stable pipeline operation identity."
              },
              {
                "name": "capture",
                "type": "SourceCapture",
                "description": "Optional manifest, content_hashes, revisions, cursor, acquisition_origin, and upstream_refreshed."
              },
              {
                "name": "stages",
                "type": "Record<SourceStage, SourceStageState>",
                "description": "Each acquisition/import/search_index/curation stage has status, optional counts, and optional reason."
              },
              {
                "name": "readiness",
                "type": "pending | ready | disabled | unavailable | blocked",
                "description": "Required-stage result. Optional reason explains the outcome."
              }
            ]
          }
        ],
        "name": "SourceDefinition and SourceState",
        "source": {
          "path": "apps/server/src/core/knowledge-v2/ingest/source-pipeline.ts",
          "symbol": "SourceState"
        }
      },
      "children": []
    },
    "source-contract-2": {
      "id": "source-contract-2",
      "type": "structured-table",
      "props": {
        "columns": [
          "Source",
          "Per-Game Scope",
          "Stable Evidence"
