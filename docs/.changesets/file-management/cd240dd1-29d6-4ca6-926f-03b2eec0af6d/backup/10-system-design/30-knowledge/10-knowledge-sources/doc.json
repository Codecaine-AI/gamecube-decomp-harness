            "label": "Versioned Source Pipeline",
            "note": "Each operation selects explicit game scope, bootstrap or incremental policy, and versioned adapters. Required stages determine readiness independently of optional curation."
          }
        ],
        "language": "typescript"
      },
      "text": [
        {
          "insert": "return runSourcePipeline({\n  ...options,\n  sources,\n  adapters,\n});"
        }
      ],
