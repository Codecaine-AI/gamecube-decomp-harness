    "b-ks2-src-standards-heading": {
      "id": "b-ks2-src-standards-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Standards Sit Outside"
        }
      ],
      "children": []
    },
    "b-ks2-src-standards-body": {
      "id": "b-ks2-src-standards-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Standards are QA-owned rules with lints, injected at worker boot and enforced at the ship gate. They belong to the knowledge system but sit outside the knowledge graph. See "
        },
        {
          "insert": "Standards",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/70-standards",
              "label": "Standards"
            }
          }
        },
        {
          "insert": ". They are not a knowledge source, not walkable, and never citable as evidence. The "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enum has no "
        },
        {
          "insert": "standards",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entry, and the omission is deliberate."
        }
      ],
      "children": []
    },
    "b-ks2-src-grammar-heading": {
      "id": "b-ks2-src-grammar-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Locator Grammar"
        }
      ],
      "children": []
    },
    "b-ks2-src-grammar-body": {
      "id": "b-ks2-src-grammar-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The grammar is closed. The resolver rejects any locator that does not match its "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "'s grammar or whose kind and scheme differ. A "
        },
        {
          "insert": "discord",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row with a "
        },
        {
          "insert": "pr://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator never resolves. Each form's payload is the store row's primary key. "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the one kind with no store row. The checkout at "
        },
        {
          "insert": "<revision>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the store, and only there does a "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text pin what was read."
        }
      ],
      "children": []
    },
