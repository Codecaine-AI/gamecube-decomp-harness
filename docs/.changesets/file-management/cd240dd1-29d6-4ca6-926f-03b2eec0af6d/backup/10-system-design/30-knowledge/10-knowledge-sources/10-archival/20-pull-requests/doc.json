    "b-ks2-src-prs-intro": {
      "id": "b-ks2-src-prs-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The store behind "
        },
        {
          "insert": "pr://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators is the existing "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows of the target ledger, together with the discussion archived on them. Past PRs and their comments are frozen once ingested. New PRs append rows. A locator into this archival source cannot drift and carries no digest."
        }
      ],
      "children": []
    },
    "b-ks2-src-prs-grammar-heading": {
      "id": "b-ks2-src-prs-grammar-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Locator Grammar"
        }
      ],
      "children": []
    },
    "b-ks2-src-prs-grammar-body": {
      "id": "b-ks2-src-prs-grammar-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "pr://<pull_request.id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to the PR row itself, including its description, verdict, and archived discussion. "
        },
        {
          "insert": "pr://<pull_request.id>/comment/<n>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " addresses one comment: "
        },
        {
          "insert": "<n>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the comment's position in the PR's archived discussion, in posted order. The archive is frozen, so an index that resolves once resolves forever; the resolver rejects an index past the end of the discussion and any other path shape."
        }
      ],
      "children": []
    },
    "b-ks2-src-prs-ownership": {
      "id": "b-ks2-src-prs-ownership",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The table is owned by the target ledger: shape, writers, and lifecycle live in "
        },
        {
          "insert": "Pull Requests",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-knowledge/20-record-contracts/30-target-ledger/20-pull-requests",
              "label": "Pull Requests"
            }
          }
        },
        {
          "insert": ". This page defines only how the knowledge graph cites into it."
        }
      ],
      "children": []
    },
    "b-ks2-src-prs-search-heading": {
      "id": "b-ks2-src-prs-search-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Search Surface"
        }
      ],
      "children": []
    },
    "b-ks2-src-prs-search-body": {
      "id": "b-ks2-src-prs-search-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keyword, structured, and vector; no graph. BM25 runs over title, body, and the archived discussion. Structured filters narrow by touched file or target and by author. Vector retrieval runs over discussion chunks."
        }
      ],
      "children": []
    },
