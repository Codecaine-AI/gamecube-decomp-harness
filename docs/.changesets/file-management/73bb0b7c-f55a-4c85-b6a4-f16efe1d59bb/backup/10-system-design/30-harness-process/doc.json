    "h-opening": {
      "id": "h-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The harness coordinates one game's accepted checkout, workers, knowledge, and saved progress. Initial Sync establishes the baseline. Run then repeats epochs, each followed by a save point and Sync before more work can start."
        }
      ],
      "children": []
    },
    "h-owners-h": {
      "id": "h-owners-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What Coordinates the Work"
        }
      ],
      "children": []
    },
    "harness-ownership-map": {
      "id": "harness-ownership-map",
      "type": "canvas",
      "props": {
        "src": "./assets/canvases/game-harness.canvas.json",
        "title": "Game Harness Ownership"
      },
      "children": []
    },
    "h-owners": {
      "id": "h-owners",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness State records the accepted source, execution intent, readiness, and history. Dispatch State controls which workflow holds the lease to dispatch workers or mutate the protected checkout. Workers operate in isolated sandboxes and return results for host integration."
        }
      ],
      "children": []
    },
    "h-flow-h": {
      "id": "h-flow-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Global Flow"
        }
      ],
      "children": []
    },
    "h-flow": {
      "id": "h-flow",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Establish the initial baseline",
            "steps": [
              {
                "text": "Initial Sync accepts the configured checkout and source stages. Build, sandbox, and evidence checks establish readiness; initial backfill researches the prepared game subjects."
              }
            ]
          },
          {
            "text": "Run one epoch",
            "steps": [
              {
                "text": "Admit eligible targets at the accepted baseline. Workers return code and scored evidence, and the host serializes accepted integration."
              }
            ]
          },
          {
            "text": "Record the epoch boundary",
            "steps": [
              {
                "text": "Settle claims and integration, measure worker progress, and capture a save point before upstream reconciliation."
              }
            ]
          },
          {
            "text": "Sync the game",
            "steps": [
              {
                "text": "Reconcile upstream, refresh configured knowledge sources, and record the resulting head and evidence. A no-change Sync still has a completion record."
              }
            ]
          },
          {
            "text": "Continue or remain paused",
            "steps": [
              {
                "text": "Refresh reports and eligibility for the accepted post-sync head. Admit another epoch only when required gates pass, blockers are cleared, and desired execution is run."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "h-flow-bridge": {
      "id": "h-flow-bridge",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The sequence shows coordination between those steps. Knowledge processing can continue beside worker execution; queued librarian work and completed curation are distinct states."
        }
      ],
      "children": []
    },
    "h-global-sequence": {
      "id": "h-global-sequence",
      "type": "sequence",
      "props": {
        "src": "./assets/sequences/global-loop.sequence.json",
