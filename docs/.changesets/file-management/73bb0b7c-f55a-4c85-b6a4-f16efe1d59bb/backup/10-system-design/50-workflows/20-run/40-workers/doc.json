    "b-40-workers-run-workers-are-the-queu-1": {
      "id": "b-40-workers-run-workers-are-the-queu-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run workers execute durable worker jobs for epoch targets in host-provisioned Daytona sandboxes. The host atomically claims the job and target, seeds the workspace, and launches the worker agent process. The child works under its ClaimToken while the host owns admission, settlement, recovery, and integration."
        }
      ],
      "children": []
    },
