      "text": [
        {
          "insert": "The Rule"
        }
      ],
      "children": []
    },
    "b-day-lease-6": {
      "id": "b-day-lease-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Provision on demand for the claimed execution. The worker opens the persisted sandbox and fails if it is missing. Retry reprovisioning removes the prior sandbox before attaching a replacement."
        }
      ],
      "children": []
    },
    "b-day-lease-7": {
      "id": "b-day-lease-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Guard durable mutations with the current ClaimToken. Reconciliation uses the shared current-token predicate plus the job payload, active claim, and dispatch lease bindings."
        }
      ],
      "children": []
    },
    "b-day-lease-8": {
      "id": "b-day-lease-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Keep a stopped sandbox while its claim and lease remain live. Stopped state is expected during idle sleep and does not make the sandbox an orphan."
        }
      ],
      "children": []
    },
    "b-day-lease-12": {
      "id": "b-day-lease-12",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Download required evidence before worker close. Host worker-state observers trigger deletion with reason "
        },
        {
          "insert": "settlement",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at close, independently of later knowledge work."
        }
      ],
      "children": []
    },
    "b-day-lease-13": {
      "id": "b-day-lease-13",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Queue reap and startup reconciliation remove missed sandboxes. Provisioning failure and retry reprovisioning have dedicated cleanup reasons. The platform TTL remains a backstop."
        }
      ],
      "children": []
    },
    "b-day-lease-16": {
      "id": "b-day-lease-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Sleep and Recovery"
        }
      ],
      "children": []
    },
    "b-day-lease-11": {
      "id": "b-day-lease-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Stop While Thinking",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-workflows/20-run/40-workers/40-sandbox-execution/35-sleep-wake",
              "label": "Stop While Thinking"
            }
          }
        },
        {
          "insert": " owns the idle debounce and wake contract. Sleeping does not extend the claim deadline, queue lease, or sandbox TTL. Remote loss and failed wake use the worker failure and recovery paths."
        }
      ],
      "children": []
    },
    "b-audit-2de3e8e19d67": {
      "id": "b-audit-2de3e8e19d67",
      "type": "heading",
      "props": {
