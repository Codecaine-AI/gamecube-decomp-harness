    "b-day-lease-1": {
      "id": "b-day-lease-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker job lease and target claim authorize sandbox execution. The sandbox adds capacity and workspace isolation but cannot claim queue work or mutate harness state by itself."
        }
      ],
      "children": []
    },
    "b-day-lease-4": {
      "id": "b-day-lease-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
    "b-day-lease-5": {
      "id": "b-day-lease-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host atomically acquires the queue job and target claim, creates worker state, and obtains a ClaimToken. "
        },
        {
          "insert": "buildWorkerTask",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " then provisions and seeds the sandbox outside the database transaction. It persists "
        },
        {
          "insert": "sandbox_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the job before launching the host worker child."
        }
      ],
      "children": []
    },
