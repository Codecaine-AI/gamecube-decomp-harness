        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "b-day-lease-17": {
      "id": "b-day-lease-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Persisted labels and job payload bindings allow cleanup after process loss. Keeping deletion with the host preserves the same authority boundary as admission and recovery."
        }
      ],
      "children": []
    },
