    "b-st-intro": {
      "id": "b-st-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Standards are QA-owned, deliberately authored rules about how shipped source must look. They are part of the knowledge system but outside the knowledge graph: injected into the worker prompt at boot, enforced by the review_lint scan at the ship gate, shown to the librarians for recognition only, and never citable as evidence. Code: "
        },
        {
          "insert": "standards.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/knowledge/standards.ts",
              "label": "standards.ts"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "standards-files.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/knowledge/standards-files.ts",
              "label": "standards-files.ts"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "decomp-context.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/knowledge/decomp-context.ts",
              "label": "decomp-context.ts"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-st-rec-h": {
      "id": "b-st-rec-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Record"
        }
      ],
      "children": []
    },
    "b-st-shape": {
      "id": "b-st-shape",
      "type": "state-shape",
      "props": {
        "name": "Standard",
        "fields": [
          {
            "name": "schema_version",
            "type": "string",
            "required": true,
            "description": "global_standard_v1"
          },
          {
            "name": "id",
            "type": "string",
            "required": true,
            "description": "global_standard:<slug>, lowercase letters, digits, hyphens"
          },
          {
            "name": "kind",
            "type": "string",
            "required": true,
            "description": "global_standard"
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "description": "accepted, proposed, superseded, merged, workflow_only"
          },
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "summary",
            "type": "string | string[]",
            "required": true
          },
          {
            "name": "do",
            "type": "string[]",
            "required": true,
            "description": "Preferred shapes; rendered to the worker as preferred prompt signals"
          },
          {
            "name": "do_not",
            "type": "string[]",
            "required": true,
            "description": "Rejected shapes; rendered as rejected prompt signals"
          },
          {
            "name": "evidence_refs",
            "type": "string[]",
            "required": true
          },
          {
            "name": "family",
            "type": "string",
            "required": false,
            "description": "The slice directory the record lives in"
          },
          {
            "name": "severity",
            "type": "string",
            "required": false,
            "description": "For example required"
          },
          {
            "name": "qa_enforcement",
            "type": "string",
            "required": false,
            "description": "How the gate enforces it, for example partial_hard_lint_plus_repair_hints"
          },
          {
            "name": "qa_rule_ids",
            "type": "string[]",
            "required": false,
            "description": "The review_lint rule ids that cite this standard"
          },
          {
            "name": "worker_facing",
            "type": "boolean",
            "required": false,
            "description": "false hides the standard from the worker prompt"
          },
          {
            "name": "disposition, retired_into, example_policy, preferred_repairs, superseded_by, curator_update_policy",
            "type": "optional",
            "required": false
          }
        ],
        "description": "One line of a family's standards.jsonl.",
        "source": {
          "path": "apps/server/src/core/knowledge/standards.ts",
          "symbol": "StandardsFileRecord"
        }
      },
      "children": []
    },
