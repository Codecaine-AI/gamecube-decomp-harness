    "b-st-files-p": {
      "id": "b-st-files-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Standards live as per-family vertical slices under the decomp_standards source. order.json at the slices root fixes record order across families; consumers rely on it."
        }
      ],
      "children": []
    },
    "b-st-tree": {
      "id": "b-st-tree",
      "type": "file-tree",
      "props": {
        "entries": [
          {
            "path": "games/melee/knowledge/sources/injectable/decomp_standards/standards/",
            "note": "Slices root, resolved through sources/registry.json"
          },
          {
            "path": "games/melee/knowledge/sources/injectable/decomp_standards/standards/order.json",
            "note": "families, standards, examples order"
          },
          {
            "path": "games/melee/knowledge/sources/injectable/decomp_standards/standards/<family>/standards.jsonl",
            "note": "One standard per line"
          },
          {
            "path": "games/melee/knowledge/sources/injectable/decomp_standards/standards/<family>/examples.jsonl",
            "note": "One example per line"
          }
        ]
      },
      "children": []
    },
    "b-st-families": {
      "id": "b-st-families",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Seven families exist: literals_data_and_externs, asserts_reports_and_header_inlines, typed_access_and_pointer_math, codegen_tactics, names_defines_headers_and_prototypes, authored_source_shape, pipeline_owned_verification."
        }
      ],
      "children": []
    },
    "b-st-load-po": {
      "id": "b-st-load-po",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Rank family directories by order.json families; unlisted families sort last, alphabetically"
          },
          {
            "text": "Concatenate every slice's standards.jsonl (or examples.jsonl), then re-emit records in order.json sequence and append anything unlisted in family-then-file order"
          },
          {
            "text": "First record wins on a duplicate id"
          },
          {
            "text": "An edit through POST /api/standards rewrites the family slice and refreshes order.json"
          }
        ]
      },
      "children": []
    },
