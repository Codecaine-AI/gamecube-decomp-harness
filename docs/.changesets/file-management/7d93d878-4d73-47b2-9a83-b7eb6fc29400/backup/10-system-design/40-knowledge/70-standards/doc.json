    "b-st-rule": {
      "id": "b-st-rule",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Not knowledge",
        "tone": "decision"
      },
      "text": [
        {
          "insert": "A standard is never a fact and never evidence. The librarian prompt says so in its rules, and the apply layer has no fact type or evidence kind a standard could occupy. A recurring tactic or a successful patch never publishes or changes a standard on its own; a person edits the slice."
        }
      ],
      "children": []
