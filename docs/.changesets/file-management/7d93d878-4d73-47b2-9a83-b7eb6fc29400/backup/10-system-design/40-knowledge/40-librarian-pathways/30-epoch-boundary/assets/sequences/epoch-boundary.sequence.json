{
  "version": 1,
  "id": "epoch-boundary",
  "title": "Epoch boundary: intake and deferred curation",
  "participants": [
    {
      "id": "p1",
      "name": "Epoch boundary",
      "kind": "actor"
    },
    {
      "id": "p2",
      "name": "Shared intake",
      "kind": "participant"
    },
    {
      "id": "p3",
      "name": "Source records",
      "kind": "participant"
    },
    {
      "id": "p4",
      "name": "Index tasks",
      "kind": "participant"
    },
    {
      "id": "p5",
      "name": "Consumer",
      "kind": "participant"
    },
    {
      "id": "p6",
      "name": "Librarian model",
      "kind": "participant"
    },
    {
      "id": "p7",
      "name": "Apply layer",
      "kind": "participant"
    },
    {
      "id": "p8",
      "name": "Shared knowledge",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "p1",
      "to": "p2",
      "line": "sync",
      "text": "Run knowledge intake after report recomputation"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "p2",
      "to": "p8",
      "line": "sync",
      "text": "Reconcile targets and preserve rename continuity"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "p2",
      "to": "p8",
      "line": "sync",
      "text": "Re-anchor citations only where code is unchanged"
    },
    {
      "kind": "message",
      "id": "m4",
      "from": "p2",
      "to": "p3",
      "line": "sync",
      "text": "Import PRs, Discord, then attempts"
    },
    {
      "kind": "message",
      "id": "m5",
      "from": "p2",
      "to": "p4",
      "line": "sync",
      "text": "Enqueue source tasks; no regression pathway"
    },
    {
      "kind": "fragment",
      "id": "f1",
      "op": "opt",
      "operands": [
        {
          "guard": "Accepted librarian follow-up",
          "items": [
            {
              "kind": "message",
              "id": "m6",
              "from": "p5",
              "to": "p4",
              "line": "sync",
              "text": "Enqueue drift_recheck for later subject review"
            }
          ]
        }
      ]
    },
    {
      "kind": "fragment",
      "id": "f2",
      "op": "opt",
      "operands": [
        {
          "guard": "--librarian-consumer enabled or manual drain",
          "items": [
            {
              "kind": "message",
              "id": "m7",
              "from": "p5",
              "to": "p4",
              "line": "sync",
              "text": "Claim source or drift task; split oversized batches"
            },
            {
              "kind": "message",
              "id": "m8",
              "from": "p5",
              "to": "p6",
              "line": "sync",
              "text": "Pass current records, source material, and flagged drift"
            },
            {
              "kind": "message",
              "id": "m9",
              "from": "p6",
              "to": "p7",
              "line": "sync",
              "text": "Propose supported writes, clears, and links"
            },
            {
              "kind": "message",
              "id": "m10",
              "from": "p7",
              "to": "p8",
              "line": "sync",
              "text": "Validate citations and apply accepted items"
            },
            {
              "kind": "message",
              "id": "m11",
              "from": "p5",
              "to": "p4",
              "line": "sync",
              "text": "Complete, or release once for remaining drift"
            }
          ]
        }
      ]
    },
    {
      "kind": "note",
      "id": "n1",
      "anchor": "p4",
      "side": "over",
      "text": "Curation is optional"
    }
  ],
  "style": {}
}
