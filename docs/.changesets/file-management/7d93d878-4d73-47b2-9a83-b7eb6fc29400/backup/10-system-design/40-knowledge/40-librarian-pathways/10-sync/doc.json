    "b-ks2-path-sync-intro": {
      "id": "b-ks2-path-sync-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync imports external evidence during confirmed publication. After the canonical checkout is repointed, V2 intake reconciles identities and mechanically re-anchors unchanged code citations before ingesting PRs, Discord, and attempts. This intake precedes the durable publication boundary transaction, PR pushes, and final dispatch release. The wiki lane runs only for an explicit --lane wiki request; neither the default lanes nor --lane all includes it."
        }
      ],
      "children": []
    },
    "b-ks2-path-sync-intro-detail-1": {
      "id": "b-ks2-path-sync-intro-detail-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Importers persist raw source and attempt records, advance their watermarks, and enqueue index tasks. PR intake produces pr_imported tasks; Discord and wiki intake produce archival_ingest tasks. Intake does not wait for semantic curation. An enabled librarian consumer researches queued tasks and proposes changes through the validated apply layer."
        }
      ],
      "children": []
    },
