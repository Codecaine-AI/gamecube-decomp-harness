    "b-wsum-intro": {
      "id": "b-wsum-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run-close agent. From one closed worker's transcript and its deterministic checkpoint digest it writes the narrative half of the run object: a run summary, one approach and outcome reasoning per submission, and reusable observations. It never writes facts. A single prompt with no tools; model codex-lb/gpt-5.6-sol, thinking medium, background."
        }
      ],
      "children": []
    },
