    "b-wsum-shape": {
      "id": "b-wsum-shape",
      "type": "state-shape",
      "props": {
        "name": "worker_summary",
        "fields": [
          {
            "name": "run",
            "type": "object",
            "required": true,
            "fields": [
              {
                "name": "summary",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "submissions",
            "type": "object[]",
            "required": true,
            "description": "Exactly one per digest submission, joined by submission_id",
            "fields": [
              {
                "name": "submission_id",
                "type": "string",
                "required": true,
                "description": "Echoed verbatim; the only runtime field allowed"
              },
              {
                "name": "approach",
                "type": "string",
                "required": true
              },
              {
                "name": "outcome_reasoning",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "notable_observations",
            "type": "object[]",
            "required": true,
            "fields": [
              {
                "name": "observation",
                "type": "string",
                "required": true
              },
              {
                "name": "reusable_when",
                "type": "string",
                "required": true
              }
            ]
          }
        ],
        "description": "Validated by the summarizer job, not the apply layer: any extra key at any level, a count mismatch, a duplicate, unknown, or omitted submission_id rejects the output.",
        "source": {
          "path": "apps/server/src/core/agent-catalog/agents/knowledge/worker-summarizer/schema.json"
        }
      },
      "children": []
    },
    "b-wsum-rules-p": {
      "id": "b-wsum-rules-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Rules the prompt enforces: narrative fields only, no scores or runtime references; when the worker's claim and the checkpoint verdict disagree, the checkpoint verdict wins; an empty submissions array is correct for a run that closed without one; a failed path is recorded only when a scored checkpoint shows it failed."
        }
      ],
      "children": []
    },
    "b-wsum-runs-h": {
      "id": "b-wsum-runs-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "When It Runs"
        }
      ],
      "children": []
    },
    "b-wsum-runs-po": {
      "id": "b-wsum-runs-po",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The run loop starts the worker_summary processor only with --worker-summary; default off. At start it enqueues a job for every closed worker state that lacks one"
          },
          {
            "text": "A job runs inline at concurrency 16 with a 60 s lease and five attempts; it skips when a worker_run already exists, when the target has no current V2 row, or when there is neither a scored checkpoint nor an error signal"
          },
          {
            "text": "The digest and condensed transcript go to the model; the response is validated"
          },
          {
            "text": "In one transaction: worker_run and submission rows (description = approach plus outcome reasoning), the run_narrative sidecar with produced_by live, the attempt watermark, and a run_closed index task with payload attempt://run/<id>"
          },
          {
            "text": "kg2-renarrate re-runs the same prompt over historical worker_run rows that have no narrative, match outcomes first, writing run_narrative with produced_by backfill and updating submission descriptions; it enqueues nothing"
          }
        ]
      },
      "children": []
    },
