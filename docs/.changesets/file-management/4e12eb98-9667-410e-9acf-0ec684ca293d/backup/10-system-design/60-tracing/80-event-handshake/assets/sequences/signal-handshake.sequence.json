{
  "version": 1,
  "id": "signal-handshake",
  "title": "Signal Handshake",
  "style": {},
  "participants": [
    {
      "id": "p0",
      "name": "Producer",
      "kind": "participant"
    },
    {
      "id": "p1",
      "name": "Wake queue",
      "kind": "participant"
    },
    {
      "id": "p2",
      "name": "Runner",
      "kind": "participant"
    },
    {
      "id": "p3",
      "name": "Scheduler",
      "kind": "participant"
    },
    {
      "id": "p4",
      "name": "Game state",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "id": "m0",
      "kind": "message",
      "from": "p0",
      "to": "p1",
      "line": "sync",
      "text": "Persist wake signal and provenance"
    },
    {
      "id": "m1",
      "kind": "message",
      "from": "p2",
      "to": "p1",
      "line": "sync",
      "text": "Claim relevant unhandled signal"
    },
    {
      "id": "m2",
      "kind": "message",
      "from": "p2",
      "to": "p3",
      "line": "sync",
      "text": "Request scheduling decision"
    },
    {
      "id": "m3",
      "kind": "message",
      "from": "p3",
      "to": "p2",
      "line": "sync",
      "text": "Return decision"
    },
    {
      "id": "m4",
      "kind": "message",
      "from": "p2",
      "to": "p4",
      "line": "sync",
      "text": "Commit accepted transition and game event"
    },
    {
      "id": "m5",
      "kind": "message",
      "from": "p2",
      "to": "p1",
      "line": "sync",
      "text": "Mark signal handled"
    }
  ]
}
