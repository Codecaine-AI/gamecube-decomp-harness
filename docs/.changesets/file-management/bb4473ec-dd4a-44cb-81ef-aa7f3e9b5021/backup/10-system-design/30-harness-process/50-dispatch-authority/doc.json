      "id": "b-doc-a-handoff-request-names-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Background-safe evidence ingestion stays outside this lease because it dispatches no agents and mutates no checkout surface. "
        },
        {
          "insert": "Dispatch, Harness, and Replay",
          "attributes": {
            "reference": {
              "kind": "doc",
