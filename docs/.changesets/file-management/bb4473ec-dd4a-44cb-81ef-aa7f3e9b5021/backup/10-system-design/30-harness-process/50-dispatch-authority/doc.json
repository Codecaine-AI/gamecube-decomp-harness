      },
      "text": [
        {
          "insert": "Lease Operations"
        }
      ],
      "children": []
    },
    "b-dispatch-operations-surface": {
      "id": "b-dispatch-operations-surface",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "requestDispatch",
            "description": "Acquire free authority or queue the workflow with causal request identity.",
            "params": [
              {
                "name": "store",
                "type": "StateStore"
              },
              {
                "name": "input",
                "type": "RequestDispatchInput",
                "description": "TransitionContext plus kind, workflowId, reason, and optional handoffOnQueue."
              }
            ],
            "returns": "RequestDispatchDecision"
          },
          {
            "name": "releaseDispatch",
            "description": "Verify the current lease, record release, and activate an eligible successor.",
            "params": [
              {
                "name": "store",
                "type": "StateStore"
              },
              {
                "name": "input",
                "type": "ReleaseDispatchInput",
                "description": "TransitionContext plus leaseId and optional handoffSnapshotId."
              }
            ],
            "returns": "DispatchState"
          },
          {
            "name": "recoverDispatch",
            "description": "Recover authority after reconciliation and cancellation evidence.",
            "params": [
              {
                "name": "store",
                "type": "StateStore"
              },
              {
                "name": "input",
                "type": "RecoverDispatchInput",
                "description": "TransitionContext plus leaseId, recoveryReason, and cancelledSubjectIds."
              }
            ],
            "returns": "DispatchRecoveryResult"
          }
        ],
        "title": "Dispatch authority operations"
      },
      "children": []
    },
