    "b-40-harness-state-harnessstate-composes-th-1": {
      "id": "b-40-harness-state-harnessstate-composes-th-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each registered game has one harness state and canonical worktree. Initial Sync establishes readiness, then Run epochs alternate with Sync. Timeline events and save points preserve progress across pauses and process restarts."
        }
      ],
      "children": []
    },
    "b-harness-story-entry": {
      "id": "b-harness-story-entry",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Process Overview defines the Run and Sync loop. Harness state owns accepted source lineage and readiness, while the timeline preserves epoch, Sync, and save-point evidence."
        }
      ],
      "children": []
    },
