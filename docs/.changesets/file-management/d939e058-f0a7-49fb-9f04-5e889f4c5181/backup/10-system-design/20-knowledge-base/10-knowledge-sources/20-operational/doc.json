      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The operational class holds sources that grow as agents run. Attempts provide evidence from the target ledger. Runs, submissions, and transcripts accumulate with every run, and rows are immutable once written. Code is the active checkout and the only drifting source, so every "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " citation carries a required "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text."
        }
      ],
      "children": []
    },
