    "b-ks2-src-code-intro": {
      "id": "b-ks2-src-code-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The code source is the one kind with no store row. The checkout itself is the store. A "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator names a line span in the checkout at a pinned revision. Code is an operational source that drifts as the checkout moves with each merge. Only code citations therefore carry a required "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-ks2-src-code-grammar-heading": {
      "id": "b-ks2-src-code-grammar-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Locator Grammar"
        }
      ],
      "children": []
    },
    "b-ks2-src-code-grammar-body": {
      "id": "b-ks2-src-code-grammar-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "code://<revision>/<path>#L<start>-L<end>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to the lines "
        },
        {
          "insert": "<start>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "<end>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of "
        },
        {
          "insert": "<path>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the checkout at "
        },
        {
          "insert": "<revision>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". There is no store row to look up. Resolution reads the checkout. The resolver rejects any locator outside this grammar, a path missing at the revision, or a line range past the end of the file."
        }
      ],
      "children": []
    },
    "b-ks2-src-code-drift-heading": {
      "id": "b-ks2-src-code-drift-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Digest and Drift"
        }
      ],
      "children": []
    },
    "b-ks2-src-code-drift-body": {
      "id": "b-ks2-src-code-drift-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every code citation, whether an "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row or a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "kind = code",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", carries a "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text, fixing what was actually read at citation time. The resolver verifies the span and its digest when the citing row is written; reconciliation re-resolves "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators later and flags claims whose spans no longer match. Drift detection applies only to code. Archival and attempt locators are never rechecked because their stores are immutable."
        }
      ],
      "children": []
    },
    "b-ks2-src-code-search-heading": {
      "id": "b-ks2-src-code-search-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Search Surface"
        }
      ],
      "children": []
    },
    "b-ks2-src-code-search-body": {
      "id": "b-ks2-src-code-search-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Code supports graph search through symbol lookup, xrefs, and grep over the checkout. Navigation is deterministic and unranked, without BM25 or vectors. Search uses the code graph the harness already derives, with no separate index to build."
        }
      ],
      "children": []
    },
