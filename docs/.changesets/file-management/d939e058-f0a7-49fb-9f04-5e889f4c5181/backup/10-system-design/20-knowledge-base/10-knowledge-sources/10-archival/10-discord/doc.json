    "b-ks2-src-discord-search-body": {
      "id": "b-ks2-src-discord-search-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keyword, structured, and vector; no graph. BM25 runs over "
        },
        {
          "insert": "content",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Structured filters narrow by channel, author, time range, and thread. Vector retrieval embeds each message with its surrounding thread so queries like \"the thing that makes you slide\" retrieve relevant messages. Discord and wiki material benefit most from vector retrieval because slang and allusion defeat BM25."
        }
      ],
      "children": []
    },
