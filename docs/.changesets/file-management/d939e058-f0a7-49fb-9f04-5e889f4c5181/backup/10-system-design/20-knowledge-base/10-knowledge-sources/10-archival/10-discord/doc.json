    "b-ks2-src-discord-intro": {
      "id": "b-ks2-src-discord-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Discord source is the archival store behind "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators: community discussion landed from chat exports as "
        },
        {
          "insert": "discord_message",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. A new export appends rows and gets them indexed. A row never changes after insert, so a locator into it cannot drift and carries no digest. Display resolves the locator and shows "
        },
        {
          "insert": "content",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at read time; nothing is snapshotted onto the citing row."
        }
      ],
      "children": []
    },
    "b-ks2-src-discord-shape-heading": {
      "id": "b-ks2-src-discord-shape-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "discord_message",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
    "b-ks2-src-discord-shape": {
      "id": "b-ks2-src-discord-shape",
      "type": "state-shape",
      "props": {
        "description": "One row per ingested message; immutable after insert.",
        "example": "{\n  \"id\": \"1123581321\",\n  \"channel\": \"matching\",\n  \"author\": \"ansem\",\n  \"posted_at\": \"2026-08-10T22:14:00Z\",\n  \"content\": \"pretty sure 800BFFD0 is the hitstun decay helper\",\n  \"thread_id\": null,\n  \"ingested_at\": \"2026-08-11T03:00:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "discord message id",
            "description": "Primary key; the payload of a `discord://message/` locator"
          },
          {
            "name": "channel",
            "type": "string"
          },
          {
            "name": "author",
            "type": "string"
          },
          {
            "name": "posted_at",
            "type": "timestamp",
            "description": "When the message was written on Discord"
          },
          {
            "name": "content",
            "type": "string"
          },
          {
            "name": "thread_id",
            "type": "discord message id",
            "description": "Present when the message sits in a thread",
            "required": false
          },
          {
            "name": "ingested_at",
            "type": "timestamp",
            "description": "When the export landed the row here"
          }
        ],
        "name": "discord_message"
      },
      "children": []
    },
    "b-ks2-src-discord-shape-example-note-1": {
      "id": "b-ks2-src-discord-shape-example-note-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the locator "
        },
        {
          "insert": "discord://message/1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to this row. Two facts citing the same message each carry their own evidence row pointing to the shared message row."
        }
      ],
      "children": []
    },
    "b-ks2-src-discord-shape-example-note-2": {
      "id": "b-ks2-src-discord-shape-example-note-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "thread_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": null here because the message sits directly in "
        },
        {
          "insert": "channel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not in a thread."
        }
      ],
      "children": []
    },
    "b-ks2-src-discord-parsing": {
      "id": "b-ks2-src-discord-parsing",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Parsing: in "
        },
        {
          "insert": "discord://message/1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the scheme is "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the payload "
        },
        {
          "insert": "1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a "
        },
        {
          "insert": "discord_message.id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The resolver checks the scheme against the citing row's "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then looks the payload up as the primary key. The resolver rejects any other shape, including extra path segments or a payload that is not a message id."
        }
      ],
      "children": []
    },
