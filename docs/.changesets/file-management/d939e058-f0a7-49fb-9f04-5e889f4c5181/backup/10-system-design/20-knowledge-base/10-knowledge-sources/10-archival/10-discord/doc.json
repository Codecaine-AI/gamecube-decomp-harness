    "b-ks2-src-discord-fk-body": {
      "id": "b-ks2-src-discord-fk-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "None, in either direction. "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows cite a message by "
        },
        {
          "insert": "(kind, locator)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not by foreign key. One pointer mechanism spans all five heterogeneous sources. Reverse lookup finds claims supported by this message through an indexed query on "
        },
        {
          "insert": "(kind, locator)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The table references nothing."
        }
      ],
      "children": []
    },
