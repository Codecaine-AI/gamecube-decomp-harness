          },
          {
            "path": "workspace/repository/",
            "note": "Git repository for a linked worktree, if used"
          },
          {
            "path": "workspace/staging/",
            "note": "Isolated Sync worktrees"
          },
          {
            "path": "knowledge/",
            "note": "Evidence and knowledge for this game"
          },
          {
            "path": "knowledge/sources/",
            "note": "Captured PR, Discord, and wiki material"
          },
          {
            "path": "knowledge/store/",
            "note": "Knowledge database"
          },
          {
            "path": "knowledge/indexes/",
            "note": "Rebuildable search indexes"
          },
          {
            "path": "knowledge/graph/",
            "note": "Derived source graph"
          },
          {
            "path": "runtime/",
            "note": "Execution state and generated tool data"
          },
          {
            "path": "runtime/state/",
            "note": "Harness records and operation evidence"
          },
          {
            "path": "runtime/tool-data/",
            "note": "Generated tool indexes and caches"
          },
          {
            "path": "runtime/tools/",
            "note": "Installed tool binaries"
          }
        ]
      },
      "children": []
