    "b-10-game-model-game-model-1": {
      "id": "b-10-game-model-game-model-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each game has its own configuration, source checkout, knowledge, and runtime state under "
        },
        {
          "insert": "games/<game-id>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Shared orchestration and GameCube tools operate on the selected game's files. The configuration identifies what to build and which sources to learn from. Harness State records accepted progress as the game runs."
        }
      ],
      "children": []
    },
    "game-configuration-heading": {
      "id": "game-configuration-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Configuration"
        }
      ],
      "children": []
    },
    "game-configuration-intro": {
      "id": "game-configuration-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the entry point. It gives the game a stable identity and points to its checkout, state, tools, and supporting configuration files. The example shows the configuration layout, not a game that is ready to run."
        }
      ],
      "children": []
    },
    "setup-game-descriptor-shape": {
      "id": "setup-game-descriptor-shape",
      "type": "state-shape",
      "props": {
        "description": "Tracked game.json entry point, including configuration references consumed before descriptor resolution.",
        "example": "{\n  \"id\": \"example-game\",\n  \"displayName\": \"Example Game\",\n  \"repoRoot\": \"./workspace/checkout\",\n  \"stateDir\": \"./runtime/state\",\n  \"graphDb\": \"./knowledge/graph/graph.sqlite\",\n  \"baseRef\": \"origin/main\",\n  \"processName\": \"example-game-live\",\n  \"tools\": {\n    \"toolpacks\": [\n      \"gamecube-decomp\"\n    ],\n    \"bindingsRoot\": \"./config/tools\"\n  },\n  \"config\": {\n    \"build\": \"./config/build.json\",\n    \"sandbox\": \"./config/sandbox.json\",\n    \"sources\": [\n      \"./config/sources/prs.json\",\n      \"./config/sources/discord.json\",\n      \"./config/sources/wiki.json\"\n    ]\n  }\n}",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "description": "Stable game identity."
          },
          {
            "name": "displayName",
            "type": "string",
            "description": "Operator-facing name.",
            "required": false
          },
          {
            "name": "repoRoot",
            "type": "string",
            "description": "Game-relative canonical checkout; grouped default workspace/checkout.",
            "required": false
          },
          {
            "name": "stateDir",
            "type": "string",
            "description": "Game state directory; grouped default runtime/state.",
            "required": false
          },
          {
            "name": "graphDb",
            "type": "string",
            "description": "Graph database path.",
            "required": false
          },
          {
            "name": "baseRef",
            "type": "string",
            "description": "Upstream Git ref.",
            "required": false
          },
          {
            "name": "processName",
            "type": "string",
            "description": "Stable managed process name; melee-live for Melee.",
            "required": false
          },
          {
            "name": "tools",
            "type": "object",
            "description": "toolpacks, bindingsRoot, sharedDataRoot, and worktreeCacheRoot.",
            "required": false,
            "fields": [
              {
                "name": "toolpacks",
                "type": "string[]",
                "description": "Shared toolpack identifiers."
              },
              {
                "name": "bindingsRoot",
                "type": "string",
                "description": "Game-relative tool bindings directory."
              },
              {
                "name": "sharedDataRoot",
                "type": "string",
                "required": false
              },
              {
                "name": "worktreeCacheRoot",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "config",
            "type": "object",
            "description": "Game-relative build, sandbox, tools, and sources configuration references.",
            "required": false,
            "fields": [
              {
                "name": "build",
                "type": "string",
                "required": false
              },
              {
                "name": "sandbox",
                "type": "string",
                "required": false
              },
              {
                "name": "tools",
                "type": "string",
                "required": false
              },
              {
                "name": "sources",
                "type": "string[]",
                "required": false
              }
            ]
          }
        ],
        "name": "Game Configuration",
        "source": {
          "path": "apps/server/src/core/game-registry/config.ts",
          "symbol": "readGameDescriptorConfig"
        }
      },
      "children": []
    },
