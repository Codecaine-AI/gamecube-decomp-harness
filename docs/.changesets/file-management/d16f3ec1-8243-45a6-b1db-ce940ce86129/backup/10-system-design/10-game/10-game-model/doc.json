    "setup-grouped-tree": {
      "id": "setup-grouped-tree",
      "type": "file-tree",
      "props": {
        "entries": [
          {
            "path": "game.json",
            "note": "Game identity and configuration references"
          },
          {
            "path": "config/",
            "note": "Settings for this game"
          },
          {
            "path": "config/build.json",
            "note": "Build and report settings"
          },
          {
            "path": "config/sandbox.json",
            "note": "Execution images and resource profiles"
          },
          {
            "path": "config/tools/",
            "note": "Bindings to shared tool implementations"
          },
          {
            "path": "config/sources/prs.json",
            "note": "Repository and PR capture policy"
          },
          {
            "path": "config/sources/discord.json",
            "note": "Server, channels, and capture policy"
          },
          {
            "path": "config/sources/wiki.json",
            "note": "Wiki scope, capture location, and refresh"
          },
          {
            "path": "config/local.json",
            "note": "Ignored machine-specific overrides"
          },
          {
            "path": "config/local.env",
            "note": "Game-specific environment values"
          },
          {
            "path": "workspace/",
            "note": "Source checkouts"
          },
          {
            "path": "workspace/checkout/",
            "note": "Canonical checkout used by the harness"
          },
          {
            "path": "workspace/checkout/build/",
