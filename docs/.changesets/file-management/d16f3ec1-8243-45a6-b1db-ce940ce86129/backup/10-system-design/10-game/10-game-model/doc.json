    "game-files-intro": {
      "id": "game-files-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This tree shows the contents of "
        },
        {
          "insert": "games/<game-id>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Setup creates the configuration and checkout. Source intake and execution populate the knowledge and runtime directories. Shared application code and toolpack implementations live outside the game folder."
        }
