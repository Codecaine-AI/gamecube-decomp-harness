    "setup-overview": {
      "id": "setup-overview",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This guide walks through onboarding a game to the shared harness. Begin with a verified game image and an upstream decompilation repository, then prepare configuration, optional knowledge sources, and a worker image. Each game supplies its own target, paths, and build settings."
        }
      ],
      "children": []
    },
    "setup-overview-model": {
      "id": "setup-overview-model",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game Model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-game/10-game-model"
            }
          }
        },
        {
          "insert": " defines the configuration, directory layout, and state used throughout this guide."
        }
      ],
      "children": []
    },
    "setup-guide-flow": {
      "id": "setup-guide-flow",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Verify the Game ISO",
            "steps": [
              {
                "text": "Verify the supported disc region, revision, and checksum."
              }
            ]
          },
          {
            "text": "Configure Upstream",
            "steps": [
              {
                "text": "Build the upstream checkout and register the game's settings."
              }
            ]
          },
          {
            "text": "Prepare Knowledge Sources",
            "steps": [
              {
                "text": "Capture and import evidence, then prepare code analysis and search indexes."
              }
            ]
          },
          {
            "text": "Daytona Setup",
            "steps": [
              {
                "text": "Configure API access, then build and deploy the game's worker image."
              }
            ]
          },
          {
            "text": "Knowledge Base Seeding",
            "steps": [
              {
                "text": "Run initial librarian backfill and complete readiness checks before Run."
              }
            ]
          }
        ]
      },
      "children": []
    },
