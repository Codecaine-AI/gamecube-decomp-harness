{
  "schemaVersion": 1,
  "id": "doc-9ffaf7ac67180d1daa74a2bc8136b0a0",
  "title": "Capture GitHub Pull Requests",
  "root": "root",
  "blocks": {
    "root": {
      "id": "root",
      "type": "paragraph",
      "props": {},
      "children": [
        "prs-intro",
        "prs-config",
        "prs-scope",
        "prs-material",
        "prs-limits-heading",
        "prs-limits",
        "prs-resume",
        "prs-verify",
        "prs-handoff"
      ]
    },
    "prs-intro": {
      "id": "prs-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Capture the full pull-request history of the selected upstream decompilation repository into the game's local source archive. Include open, closed, and merged PRs so initial librarian backfill can research both accepted changes and unsuccessful approaches. Downloading the archive and curating knowledge from it are separate steps."
        }
      ],
      "children": []
    },
    "prs-config": {
      "id": "prs-config",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Configure the "
        },
        {
          "insert": "github-prs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " source with an explicit "
        },
        {
          "insert": "identity.upstream",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "owner/repository",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " form, "
        },
        {
          "insert": "scope.capture_root",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "scope.prs_subdir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "scope.acquisition_script",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Use the upstream repository selected for this game, not an inherited Melee default. Authenticate "
        },
        {
          "insert": "gh",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with access to that repository."
        }
      ],
      "children": []
    },
    "prs-scope": {
      "id": "prs-scope",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The existing fetcher accepts "
        },
        {
          "insert": "--repo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--dump-root",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--all-prs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "--fetch-jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Use "
        },
        {
          "insert": "--all-prs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for initial history capture; the ordinary default uses a recent date window. Run with "
        },
        {
          "insert": "--dry-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " first to inspect discovery and local gaps. The configured bootstrap pipeline already adds "
        },
        {
          "insert": "--all-prs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and currently uses four fetch workers."
        }
      ],
      "children": []
    },
    "prs-material": {
      "id": "prs-material",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each PR capture includes metadata and body text, issue comments, review comments, reviews, and the diff. Preserve repository identity and PR number with the evidence. PR numbers alone are not unique across repositories."
        }
      ],
      "children": []
    },
    "prs-limits-heading": {
      "id": "prs-limits-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Rate Limits and Resuming"
        }
      ],
      "children": []
    },
    "prs-limits": {
      "id": "prs-limits",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One PR can require several paginated API requests. GitHub primary and secondary rate limits can therefore make a full archive take multiple sessions. Start with modest "
        },
        {
          "insert": "--fetch-jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " concurrency. If GitHub reports a limit, pause until its retry or reset time and lower concurrency before retrying. The fetcher does not implement automatic rate-limit backoff."
        }
      ],
      "children": []
    },
    "prs-resume": {
      "id": "prs-resume",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Retain the same archive directory when resuming. A manual rerun without "
        },
        {
          "insert": "--refresh-existing",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " skips records whose required local files are present. The source pipeline currently requests "
        },
        {
          "insert": "--refresh-existing",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so it can recapture existing records. The fetcher's "
        },
        {
          "insert": "--sleep",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " delay applies to its serial path, not to the concurrent worker pool."
        }
      ],
      "children": []
    },
    "prs-verify": {
      "id": "prs-verify",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Inspect fetch errors, missing comment streams, and per-PR diff error files before accepting completeness. The current local-completeness check tests file presence; it can count a failed diff download as present. Do not treat a zero-gap discovery result alone as proof of a complete archive."
        }
      ],
      "children": []
    },
    "prs-handoff": {
      "id": "prs-handoff",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "After verifying the capture, import the PR records and build keyword and embedding indexes. Retain capture identities and preserve already cited evidence when refreshing. Knowledge Base Seeding then uses these searchable records for target-driven librarian backfill."
        }
      ],
      "children": []
    }
  }
}
