    "checkout-intro": {
      "id": "checkout-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Clone the required upstream decompilation repository into the game's checkout directory. Follow that project's build instructions to produce a local baseline, then register the paths and build settings in "
        },
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Use the Game Model's configuration contract when filling in these settings."
        }
      ],
      "children": []
    },
    "checkout-sms-branch": {
      "id": "checkout-sms-branch",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set "
        },
        {
          "insert": "baseRef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the upstream branch used by the selected project. Keep the harness game ID separate from the upstream build target ID, which may identify a particular region and revision. Do not copy another game's target, compiler pins, or build commands without checking them."
        }
      ],
      "children": []
    },
    "sweep-83863eb80867423a": {
      "id": "sweep-83863eb80867423a",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Descriptor Discovery"
        }
      ],
      "children": []
    },
    "sweep-d9b2806681f14780": {
      "id": "sweep-d9b2806681f14780",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Create "
        },
        {
          "insert": "games/<id>/game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a matching "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "resolveGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selects an explicit game ID, the configured "
        },
        {
          "insert": "defaultGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or the sole descriptor directory. Multiple candidates without a default fail. A directory without "
        },
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not a registered game."
        }
      ],
      "children": []
    },
    "sweep-eaa29256ae6d47d5": {
      "id": "sweep-eaa29256ae6d47d5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "Resolution"
        ],
        "rows": [
          [
            "game.json and config references",
            "Build, sandbox, and tools references load from game-relative files. Inline section values override referenced values. config.build hydrates validation."
          ],
          [
            "config/local.json",
            "Optional local overrides merge over the descriptor."
          ],
          [
            "Explicit overrides",
            "Highest precedence. Explicit path overrides resolve from explicitOverrideBaseDir or the current directory."
          ]
        ]
      },
      "children": []
    },
    "sweep-b95135d32c45403f": {
      "id": "sweep-b95135d32c45403f",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Resolved Configuration"
        }
      ],
      "children": []
    },
    "sweep-2e832693ab9f4e5d": {
      "id": "sweep-2e832693ab9f4e5d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Descriptor-relative paths resolve against the game directory. Defaults are "
        },
        {
          "insert": "workspace/checkout",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "runtime/state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "knowledge/graph/graph.sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "config/local.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Required consumers use these resolved paths rather than guessing another checkout or store."
        }
      ],
      "children": []
    },
    "sweep-b52402a0c9e64f32": {
      "id": "sweep-b52402a0c9e64f32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process name defaults to "
        },
        {
          "insert": "<gameId>-live",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "baseRef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defaults to "
        },
        {
          "insert": "origin/master",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Set an explicit base ref when the upstream project uses a different branch. Runtime consumers receive explicit resolved checkout, state, graph, environment, and tool-data paths."
        }
      ],
      "children": []
    },
    "sweep-911f6c86cc964f3c": {
