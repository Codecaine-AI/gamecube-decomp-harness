    "sweep-13fc0b5571604bc5": {
      "id": "sweep-13fc0b5571604bc5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game registration resolves a descriptor into paths and runtime configuration. It reads configuration and returns warnings; it does not provision a checkout, activate a game, or emit a registration event."
        }
      ],
      "children": []
    },
    "sweep-83863eb80867423a": {
      "id": "sweep-83863eb80867423a",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Descriptor Discovery"
        }
      ],
      "children": []
    },
    "sweep-d9b2806681f14780": {
      "id": "sweep-d9b2806681f14780",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "resolveGame selects the explicit game ID, the configured defaultGame, or the sole descriptor directory. Multiple candidates without a default fail. The selected ID must be valid and match the id in games/<id>/game.json."
        }
      ],
      "children": []
    },
    "sweep-eaa29256ae6d47d5": {
      "id": "sweep-eaa29256ae6d47d5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "Resolution"
        ],
        "rows": [
          [
            "game.json",
            "Base descriptor in the selected game directory."
          ],
          [
            "local.game.json",
            "Optional local overrides merged over the base descriptor."
          ],
          [
            "Explicit overrides",
            "Highest precedence. Explicit path overrides resolve from explicitOverrideBaseDir or the current directory."
          ]
        ]
      },
      "children": []
    },
    "sweep-b95135d32c45403f": {
      "id": "sweep-b95135d32c45403f",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Resolved Configuration"
        }
      ],
      "children": []
    },
    "sweep-2e832693ab9f4e5d": {
      "id": "sweep-2e832693ab9f4e5d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Descriptor-relative repoRoot, stateDir, graphDb, and localEnv paths resolve against the game directory. Their fallback locations are checkout, state, graph/graph.sqlite, and local.env. Nested validation, dashboard, PR, knowledge, and sandbox settings receive their configured defaults."
        }
      ],
      "children": []
    },
    "sweep-b52402a0c9e64f32": {
      "id": "sweep-b52402a0c9e64f32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process name defaults to <gameId>-live and baseRef defaults to origin/master. listGames resolves each descriptor and returns a summary including checkout, state-directory, and graph-database existence flags."
        }
      ],
      "children": []
    },
    "sweep-911f6c86cc964f3c": {
      "id": "sweep-911f6c86cc964f3c",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Errors and Warnings"
        }
      ],
      "children": []
    },
    "sweep-f86c9a9f087e42c0": {
      "id": "sweep-f86c9a9f087e42c0",
      "type": "structured-table",
      "props": {
        "columns": [
          "Condition",
          "Result"
        ],
        "rows": [
          [
            "Invalid ID, missing descriptor, malformed descriptor, or mismatched descriptor ID",
            "Resolution throws."
          ],
          [
            "Missing checkout, graph directory, or local environment file",
            "Resolution returns warnings. These are filesystem existence checks."
          ],
          [
            "Remote access, toolkit execution, build readiness, or credentials",
            "Resolution does not prove these are usable. The consuming operation performs its own checks."
          ]
        ]
      },
      "children": []
    },
