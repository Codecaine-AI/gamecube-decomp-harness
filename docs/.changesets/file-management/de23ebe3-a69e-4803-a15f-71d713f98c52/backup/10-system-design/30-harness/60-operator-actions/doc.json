      "props": {
        "language": "typescript"
      },
      "text": [
        {
          "insert": "interface ActionProjection {\n  action_id: string;\n  subject_kind: string;\n  subject_id: string;\n  enabled: boolean;\n  blocked_by: Blocker[];\n  expected_transition: string;\n  confirmation_required: boolean;\n}"
        }
      ],
      "children": []
    },
