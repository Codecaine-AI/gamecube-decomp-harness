    "sweep-238ba6c8dce941d3": {
      "id": "sweep-238ba6c8dce941d3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game descriptor resolution and cycle opening are entry operations outside this inventory. PR campaign actions are absent from the current projection. Epoch draft-PR publication remains an active scheduler path and does not require a campaign action."
        }
      ],
      "children": []
    },
