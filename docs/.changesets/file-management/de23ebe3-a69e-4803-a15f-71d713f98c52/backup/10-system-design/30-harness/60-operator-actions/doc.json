      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessStateView is the server-owned projection of current coordination and operator authority. It contains 13 canonical actions, including disabled actions with their blockers. Clients display these guards and confirmation requirements; command routes recheck them before accepting a request."
        }
      ],
      "children": []
    },
    "sweep-f23d638ff73e47b0": {
      "id": "sweep-f23d638ff73e47b0",
