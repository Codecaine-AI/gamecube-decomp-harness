      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Projection State"
        }
      ],
      "children": []
    },
    "sweep-a8ac5e9de17a40d9": {
      "id": "sweep-a8ac5e9de17a40d9",
      "type": "code",
      "props": {
        "language": "typescript"
      },
      "text": [
        {
          "insert": "interface HarnessStateView {\n  game_id: string;\n  harness_revision: number;\n  cycle: CycleSummary | null;\n  active_workflow: ActiveWorkflowSummary | null;\n  queued_dispatch_requests: QueuedDispatchRequest[];\n  run: RunSummary | null;\n  pr_work: [];\n  sync: SyncSummary | null;\n  repo_sync: RepoSyncProjection;\n  knowledge: KnowledgeFreshnessSummary;\n  active_operations: [];\n  recent_events: EventSummary[];\n  available_actions: ActionProjection[]; // Exactly 13 entries.\n  compatibility_actions: [];\n}"
        }
      ],
      "children": []
    },
    "sweep-c8e7110139fc4a90": {
      "id": "sweep-c8e7110139fc4a90",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This is a field summary of the current projection. cycle includes cycle_uuid, head_revision, status, save-point evidence, blockers, and timeline. knowledge includes queued, processing, waiting, failed, oldest_pending_at, active_lease, retry, and recent_failures. The projection supplies empty pr_work, active_operations, and compatibility_actions arrays."
        }
      ],
      "children": []
    },
    "sweep-b15b3b8d9ba84510": {
      "id": "sweep-b15b3b8d9ba84510",
