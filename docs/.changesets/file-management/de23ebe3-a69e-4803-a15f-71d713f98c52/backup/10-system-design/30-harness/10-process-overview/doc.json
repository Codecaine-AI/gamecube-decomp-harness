    "sweep-e757375a57e84119": {
      "id": "sweep-e757375a57e84119",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The harness coordinates repeated worker attempts around a shared knowledge base and a durable cycle. Workers read accepted knowledge, return code and evidence, and feed summarization and librarian intake. Sync brings external source changes and PR or Discord evidence into the same continuing process."
        }
      ],
      "children": []
    },
    "sweep-aa9320b1355f4a75": {
      "id": "sweep-aa9320b1355f4a75",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Full Process"
        }
      ],
      "children": []
    },
    "sweep-39130c99fd324c2c": {
      "id": "sweep-39130c99fd324c2c",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Prepare a Cycle",
            "steps": [
              {
                "text": "Resolve the game descriptor and provision the cycle worktree through the lifecycle entry points."
              },
              {
                "text": "Capture the baseline and source lineage. Use sync to observe and reconcile upstream changes."
              }
            ]
          },
          {
            "text": "Run Workers",
            "steps": [
              {
                "text": "Admit targets from the board to a bounded epoch queue."
              },
              {
                "text": "Workers claim isolated Daytona sandboxes, read shared knowledge, and return candidate code and attempt evidence."
              },
              {
                "text": "The host validates and integrates eligible code through the serialized integration lane."
              }
            ]
          },
          {
            "text": "Close the Epoch Boundary",
            "steps": [
              {
                "text": "Rebuild report evidence and defer regression or QA findings for later work."
              },
              {
                "text": "Reconcile upstream, run publication gates, and publish the cycle draft PR when enabled and permitted."
              },
              {
                "text": "Refresh enabled knowledge inputs, close the epoch with durable evidence, and admit the next epoch unless paused."
              }
            ]
          },
          {
            "text": "Continue or Close",
            "steps": [
              {
                "text": "Run operator sync when upstream changes need reconciliation."
              },
              {
                "text": "Continue the cycle using accepted code and accumulated knowledge."
              },
              {
                "text": "Close explicitly only after dispatch and save-point obligations settle."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "sweep-8f6b9a8d3e374cf2": {
      "id": "sweep-8f6b9a8d3e374cf2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Shared Knowledge"
        }
      ],
      "children": []
    },
    "sweep-6e6d8d97558f4ca3": {
      "id": "sweep-6e6d8d97558f4ca3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker summaries and attempts, merged PRs, Discord messages, and drift findings produce librarian tasks. The librarian proposes facts and relationships; the apply layer validates them before writing the shared knowledge base. Later workers receive a knowledge card and can query or render supporting records."
        }
      ],
      "children": []
    },
    "sweep-26d2c5ac87a349ed": {
      "id": "sweep-26d2c5ac87a349ed",
