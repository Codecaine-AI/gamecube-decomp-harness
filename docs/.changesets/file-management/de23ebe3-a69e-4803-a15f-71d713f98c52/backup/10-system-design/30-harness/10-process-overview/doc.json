        }
      ],
      "children": []
    },
    "sweep-e76e5923c3da4116": {
      "id": "sweep-e76e5923c3da4116",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness State",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-harness/20-harness-state"
            }
          }
        },
        {
          "insert": " owns dispatch coordination. Sync and run cannot mutate protected source concurrently. Their handoff settles the outgoing lease before the successor acquires authority."
        }
      ],
      "children": []
    },
    "sweep-a572150b266a4eb2": {
      "id": "sweep-a572150b266a4eb2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The current operator projection has no PR campaign controls. Cycle draft-PR publication occurs at the epoch boundary. Retained PR phase and historical campaign records do not restore the removed campaign workflow."
        }
      ],
      "children": []
    },
    "sweep-dfd90903ad5644b0": {
