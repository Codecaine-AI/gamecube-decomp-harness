    "b-day-scale-1": {
      "id": "b-day-scale-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker concurrency consumes sandbox capacity and host agent capacity. Each sandbox owns its compiler resources and workspace. The host still runs model sessions, knowledge tools, telemetry, evidence storage, and integration."
        }
      ],
      "children": []
    },
    "b-day-scale-3": {
      "id": "b-day-scale-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Structure"
        }
      ],
      "children": []
    },
    "b-day-scale-4": {
      "id": "b-day-scale-4",
      "type": "structured-table",
      "props": {
        "columns": [
          "Resource",
          "Control"
        ],
        "rows": [
          [
            "Worker claims",
            "Run admission, worker pool size, ready targets, and provider quota."
          ],
          [
            "Worker compilation",
            "Each sandbox owns its vCPU and local build state. Workers do not share host Ninja slots."
          ],
          [
            "Model calls",
            "Host model-service capacity through codex-lb."
          ],
          [
            "Host report builds",
            "Host build admission and jobserver limits."
          ],
          [
            "Disk",
            "Claim workspaces consume provider disk until deletion. Host artifacts and durable shared stores consume local disk."
          ]
        ]
      },
      "children": []
    },
    "b-day-scale-7": {
      "id": "b-day-scale-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Rule"
        }
      ],
      "children": []
    },
    "b-day-scale-5": {
      "id": "b-day-scale-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Size concurrency from the configured sandbox resource class and current provider quotas. Account for disk retained by stopped claims and simultaneous wake-up demand."
        }
      ],
      "children": []
    },
    "b-day-scale-6": {
      "id": "b-day-scale-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Do not use host-era worker slot directories or a fleet compile jobserver as sandbox admission controls. They cannot govern isolated remote filesystems."
        }
      ],
      "children": []
    },
    "b-audit-cd228bc2f7bc": {
      "id": "b-audit-cd228bc2f7bc",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Sleep governs idle intervals within a claim. Close-time deletion releases the claim workspace. These are separate lifecycle decisions."
        }
      ],
      "children": []
    },
    "b-audit-50230d4c3497": {
      "id": "b-audit-50230d4c3497",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Budget host memory, CPU, and disk for agent sessions, tool routing, logs, downloaded evidence, and knowledge processing as worker count grows."
        }
      ],
      "children": []
    },
    "b-day-scale-10": {
      "id": "b-day-scale-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "b-day-scale-8": {
      "id": "b-day-scale-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Remote workspaces remove the largest per-worker build trees from the host. They do not remove host work per agent. Capacity planning must measure both sides of the boundary."
        }
      ],
      "children": []
    },
