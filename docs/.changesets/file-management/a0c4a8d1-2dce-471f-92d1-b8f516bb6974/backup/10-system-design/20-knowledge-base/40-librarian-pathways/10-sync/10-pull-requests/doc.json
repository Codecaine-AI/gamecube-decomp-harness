      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Agents Called"
        }
      ],
      "children": []
    },
    "b-ks2-path-pr-agents-table": {
      "id": "b-ks2-path-pr-agents-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Order",
          "Agent",
          "Does"
        ],
        "rows": [
          [
            "1",
            "PR importer",
            [
              {
                "insert": "A small preprocessing agent: archives the PR and its discussion as archival source rows; reconstructs the "
              },
              {
                "insert": "pull_request",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " ledger row with touched files and targets, outcome, and summary through the same summary prompt the worker summary agent uses; advances the "
              },
              {
                "insert": "pr",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " watermark; enqueues the index task. A deterministic pipeline around that one prompt; pure enrichment, never a fact writer"
              }
            ]
          ],
          [
            "2",
            "Librarian",
            [
              {
                "insert": "Consumes the task: maps the diff to touched targets and files, reads the archived discussion, overwrites the affected live "
              },
              {
                "insert": "fact",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows citing "
              },
              {
                "insert": "pr://",
                "attributes": {
                  "code": true
                }
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-ks2-path-pr-librarian-heading": {
      "id": "b-ks2-path-pr-librarian-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Librarian Operation"
        }
      ],
      "children": []
    },
    "b-ks2-path-pr-librarian-reads": {
      "id": "b-ks2-path-pr-librarian-reads",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian reads the "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ledger row and the archived PR behind it. The subjects are the targets the diff touched, plus the "
        },
        {
          "insert": "translation_unit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "struct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entities the change reaches. The entity extractor has already inserted these mechanical rows. Structured PR search scopes the read by touched file or target and author. Keyword search over title, body, and archived discussion, plus vector search over discussion chunks, retrieves the discussion. The code graph confirms what the diff changed in the checkout. The discussion is where PR knowledge concentrates. A maintainer explaining why an idiom matches is worth more than the diff alone."
        }
      ],
      "children": []
    },
    "b-ks2-path-pr-librarian-writes": {
      "id": "b-ks2-path-pr-librarian-writes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every write goes through the resolver. The affected live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows are overwritten in place, "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows replaced wholesale with "
        },
        {
          "insert": "pr://<pull_request.id>[/comment/<n>]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators into the row and the specific comments each claim stands on, with code-graph corroboration cited as "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " where the checkout shows it. A discussion that connects subjects can add curated "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. The "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row itself is immutable after capture; the librarian never edits it."
        }
      ],
      "children": []
    },
