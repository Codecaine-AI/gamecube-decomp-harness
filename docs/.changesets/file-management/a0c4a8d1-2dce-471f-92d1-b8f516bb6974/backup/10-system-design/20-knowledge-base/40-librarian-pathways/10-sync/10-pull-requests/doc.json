            "code": true
          }
        },
        {
          "insert": ", where "
        },
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the imported PR number, and inserts one "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "pr_imported",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and a "
        },
        {
          "insert": "payload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " naming the "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row. The librarian claims and completes the task by its timestamps and stamps "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for each touched target and entity it passed over. PRs archived but not yet consumed are exactly the "
        },
        {
          "insert": "pr_imported",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tasks without "
        },
        {
          "insert": "done_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
