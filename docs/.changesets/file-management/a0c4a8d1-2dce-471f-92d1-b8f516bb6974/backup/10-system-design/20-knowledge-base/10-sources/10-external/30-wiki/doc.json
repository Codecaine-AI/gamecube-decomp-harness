    "b-ks2-src-wiki-intro": {
      "id": "b-ks2-src-wiki-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The wiki source preserves community documentation for the selected game. Captured pages become "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, and "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators identify a page section at a specific mirror revision. Importing a later revision adds new rows while existing citations continue to resolve to the captured text."
        }
      ],
      "children": []
    },
    "wiki-setup-guide-link": {
      "id": "wiki-setup-guide-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Capture the Wiki",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-game-registration-and-setup/30-prepare-knowledge-sources/10-wiki"
            }
          }
        },
        {
          "insert": " explains acquisition, local files, and verification. The contract below describes how imported sections preserve evidence for knowledge queries."
        }
      ],
      "children": []
    },
    "b-ks2-src-wiki-shape-heading": {
      "id": "b-ks2-src-wiki-shape-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
    "b-ks2-src-wiki-shape": {
      "id": "b-ks2-src-wiki-shape",
      "type": "state-shape",
      "props": {
        "description": "One row per (page, section, mirror revision); immutable after insert.",
        "example": "{\n  \"id\": \"hitstun#formula@r2026-08-15\",\n  \"page\": \"Hitstun\",\n  \"section\": \"Formula\",\n  \"mirror_revision\": \"r2026-08-15\",\n  \"content\": \"Hitstun is the number of frames a character is unable to act after being hit, derived from knockback.\",\n  \"ingested_at\": \"2026-08-15T03:00:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "wiki section id",
            "description": "Primary key encoding page, section, and mirror revision. It is the payload of a `wiki://` locator"
          },
          {
            "name": "page",
            "type": "string"
          },
          {
            "name": "section",
            "type": "string"
          },
          {
            "name": "mirror_revision",
            "type": "mirror revision",
            "description": "Which sync of the mirror this row came from"
          },
          {
            "name": "content",
            "type": "string"
          },
          {
            "name": "ingested_at",
            "type": "timestamp"
          }
        ],
        "name": "wiki_section"
      },
      "children": []
    },
    "b-ks2-src-wiki-shape-example-note-1": {
      "id": "b-ks2-src-wiki-shape-example-note-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "mirror_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": a later re-sync of this page inserts new rows at a new revision; this row stays, and a "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator keeps resolving to the text as it stood at citation time."
        }
      ],
      "children": []
    },
    "b-ks2-src-wiki-shape-example-note-2": {
      "id": "b-ks2-src-wiki-shape-example-note-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the encoding shown is illustrative; what is contractual is that one id names one (page, section, mirror revision) triple."
        }
      ],
      "children": []
    },
