    "b-day-1": {
      "id": "b-day-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each worker executes one target claim in a Daytona sandbox. The host runs the agent and model loop, owns the claim and durable records, and integrates validated patches. The sandbox holds the source workspace, compiler, and build state."
        }
      ],
      "children": []
    },
