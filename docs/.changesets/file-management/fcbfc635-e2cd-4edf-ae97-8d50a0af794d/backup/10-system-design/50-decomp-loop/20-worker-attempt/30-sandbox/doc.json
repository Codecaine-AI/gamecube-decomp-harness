    "b-day-10": {
      "id": "b-day-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Provision one sandbox after the host atomically claims the worker job and target. Seed it at the claim base revision before launching the worker child."
        }
      ],
      "children": []
    },
    "b-day-12": {
      "id": "b-day-12",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Use sandbox execution for every worker claim. "
        },
        {
          "insert": "FakeSandboxProvider",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " supplies the test seam. A missing sandbox fails the claim instead of selecting a host workspace."
        }
      ],
      "children": []
    },
    "b-day-14": {
      "id": "b-day-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Enable idle sleep by default. Remote operations share one gate that wakes the claim workspace before use and stops it after an idle debounce."
        }
      ],
      "children": []
    },
    "b-day-16": {
      "id": "b-day-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Download required attempt evidence before worker-state close. The host observes close and deletes the sandbox while settlement and knowledge processing continue."
        }
      ],
      "children": []
    },
