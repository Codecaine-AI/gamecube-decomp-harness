    "b-day-9": {
      "id": "b-day-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A claim keeps its own compiler state across model turns without sharing unfinished edits with another worker. Host ownership of authority, evidence, and integration lets the sandbox stop or disappear without becoming the source of durable truth."
        }
