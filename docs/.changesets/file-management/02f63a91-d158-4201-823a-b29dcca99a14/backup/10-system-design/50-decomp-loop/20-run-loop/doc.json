    "b-10-run-director-loop-wake-events-are-durable-40": {
      "id": "b-10-run-director-loop-wake-events-are-durable-40",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Wake requests are durable queue signals rather than accepted game facts. The Run Loop selects the signal below before other unhandled events."
        }
      ],
      "children": []
    },
