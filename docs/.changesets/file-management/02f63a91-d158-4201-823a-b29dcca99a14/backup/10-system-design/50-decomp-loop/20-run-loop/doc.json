    "b-10-run-director-loop-only-hard-gate-passing-i-57": {
      "id": "b-10-run-director-loop-only-hard-gate-passing-i-57",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Checkpoint selection ranks exactness, score, and validation time. A worker result does not by itself establish canonical source truth; serialized integration and boundary validation produce acceptance evidence. Failed and neutral checkpoints remain available for later ranking and knowledge intake."
        }
      ],
      "children": []
    },
