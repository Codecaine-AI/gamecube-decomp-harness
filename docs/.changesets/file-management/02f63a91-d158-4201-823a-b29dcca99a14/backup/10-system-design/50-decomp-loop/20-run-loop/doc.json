    "b-10-run-director-loop-an-epoch-target-plus-tar-49": {
      "id": "b-10-run-director-loop-an-epoch-target-plus-tar-49",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A worker job, its atomically acquired epoch target, and the resulting target claim form one bounded delegation contract. The child receives a target-local TaskSpec and ClaimToken; it never claims queue work or receives the dispatch lease."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-base-rev-advance-60": {
      "id": "b-10-run-director-loop-base-rev-advance-60",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A worker job captures baseRev exactly once at claim time. Provisioning and the task file use that same commit for the entire attempt. Integration commits advance the base for later workers. An epoch boundary updates the shared base only if its starting value still matches, preserving any newer integration commit."
        }
      ],
      "children": []
    },
