        "example": "{\"checkpoint_id\":\"checkpoint-88\",\"worker_state_id\":\"worker-state-501\",\"validation_state\":\"tentative\",\"selectable\":true,\"exact_match\":false,\"score_after\":99.73,\"validated_at\":\"2026-08-18T15:42:00Z\",\"integration_outcome_id\":\"integration-outcome-88\"}",
