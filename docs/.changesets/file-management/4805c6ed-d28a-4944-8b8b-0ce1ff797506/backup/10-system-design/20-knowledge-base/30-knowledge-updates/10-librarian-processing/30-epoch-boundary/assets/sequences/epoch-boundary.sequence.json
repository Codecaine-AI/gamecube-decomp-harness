{
  "version": 1,
  "id": "epoch-boundary",
  "title": "Epoch Knowledge Intake and Deferred Curation",
  "participants": [
    {
      "id": "p1",
      "name": "Epoch Sync",
      "kind": "participant"
    },
    {
      "id": "p2",
      "name": "Shared Intake",
      "kind": "participant"
    },
    {
      "id": "p3",
      "name": "Source Pipeline",
      "kind": "participant"
    },
    {
      "id": "p4",
      "name": "Knowledge Store",
      "kind": "participant"
    },
    {
      "id": "p5",
      "name": "Background Processor",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "p1",
      "to": "p2",
      "line": "sync",
      "text": "Reconcile report at the accepted candidate head"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "p2",
      "to": "p4",
      "line": "sync",
      "text": "Preserve target identity and re-anchor unchanged code"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "p2",
      "to": "p4",
      "line": "sync",
      "text": "Import attempt evidence"
    },
    {
      "kind": "message",
      "id": "m4",
      "from": "p2",
      "to": "p1",
      "line": "return",
      "text": "Mechanical intake complete"
    },
    {
      "kind": "message",
      "id": "m5",
      "from": "p1",
      "to": "p3",
      "line": "sync",
      "text": "Refresh configured game sources under source policy"
    },
    {
      "kind": "message",
      "id": "m6",
      "from": "p3",
      "to": "p4",
      "line": "sync",
      "text": "Capture, import, and index required sources"
    },
    {
      "kind": "message",
      "id": "m7",
      "from": "p3",
      "to": "p1",
      "line": "return",
      "text": "Return source manifests and readiness"
    },
    {
      "kind": "fragment",
      "id": "f1",
      "op": "alt",
      "operands": [
        {
          "guard": "Required source stages are ready",
          "items": [
            {
              "kind": "message",
              "id": "m8",
              "from": "p1",
              "to": "p1",
              "line": "sync",
              "text": "Continue evidence and Sync boundary acceptance"
            }
          ]
        },
        {
          "guard": "Required stage failed or is unavailable",
          "items": [
            {
              "kind": "message",
              "id": "m9",
              "from": "p1",
              "to": "p1",
              "line": "sync",
              "text": "Retain recovery state and block next epoch"
            }
          ]
        }
      ]
    },
    {
      "kind": "fragment",
      "id": "f2",
      "op": "opt",
      "operands": [
        {
          "guard": "Queued librarian work is enabled or manually drained",
          "items": [
            {
              "kind": "message",
              "id": "m10",
              "from": "p5",
              "to": "p4",
              "line": "sync",
              "text": "Claim source, run-closed, or drift task"
            },
            {
              "kind": "message",
              "id": "m11",
              "from": "p4",
              "to": "p5",
              "line": "return",
              "text": "Current records and resolvable evidence"
            },
            {
              "kind": "message",
              "id": "m12",
              "from": "p5",
              "to": "p5",
              "line": "sync",
              "text": "Research and validate cited proposals"
            },
            {
              "kind": "message",
              "id": "m13",
              "from": "p5",
              "to": "p4",
              "line": "sync",
              "text": "Apply accepted facts and record task outcome"
            }
          ]
        }
      ]
    },
    {
      "kind": "note",
      "id": "n1",
      "anchor": "p5",
      "side": "over",
      "text": "Curation may wait"
    }
  ],
  "style": {}
}
