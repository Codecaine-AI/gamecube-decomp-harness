    "b-summary-shape": {
      "id": "b-summary-shape",
      "type": "state-shape",
      "props": {
        "description": "A redacted event header plus bounded payload summary.",
        "example": "{\n  \"event_id\": \"event-dispatch-7\",\n  \"sequence\": 7,\n  \"event_type\": \"game.dispatch_acquired\",\n  \"correlation_id\": \"run-7\",\n  \"causation_id\": \"command-run-7\",\n  \"actor\": \"runner\",\n  \"occurred_at\": \"2026-09-11T18:00:00Z\",\n  \"payload_summary\": {\n    \"kind\": \"run\",\n    \"workflow_id\": \"run-7\",\n    \"lease_id\": \"lease-run-7\",\n    \"state_revision\": 7\n  },\n  \"schema_version\": 1,\n  \"game_id\": \"melee\",\n  \"subject_kind\": \"game\",\n  \"subject_id\": \"melee\",\n  \"trace_id\": \"trace-run-7\",\n  \"span_id\": \"span-11111111-1111-4111-8111-111111111111\",\n  \"parent_span_id\": null\n}",
        "fields": [
          {
            "name": "event_id",
            "type": "EventId"
          },
          {
            "name": "sequence",
            "type": "integer"
          },
          {
            "name": "event_type",
            "type": "string"
          },
          {
            "name": "correlation_id",
            "type": "CorrelationId"
          },
          {
            "name": "causation_id",
            "type": "CommandId | EventId"
          },
          {
            "name": "actor",
            "type": "Actor"
          },
          {
            "name": "occurred_at",
            "type": "timestamp"
          },
          {
            "name": "payload_summary",
            "type": "redacted object"
          },
          {
            "name": "schema_version",
            "type": "number",
            "required": true
          },
          {
            "name": "game_id",
            "type": "string",
            "required": true
          },
          {
            "name": "subject_kind",
            "type": "GameEventSubjectKind",
            "required": true
          },
          {
            "name": "subject_id",
            "type": "string",
            "required": true
          },
          {
            "name": "trace_id",
            "type": "string",
            "required": true
          },
          {
            "name": "span_id",
            "type": "string",
            "required": true
          },
          {
            "name": "parent_span_id",
            "type": "string | null",
            "required": true
          }
        ],
        "name": "SafeEventSummary",
        "source": {
