    "b-40-harness-state-harnessstate-composes-th-1": {
      "id": "b-40-harness-state-harnessstate-composes-th-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The accepted design gives one registered game a continuing harness state and canonical worktree. Initial Sync establishes readiness, then Run epochs alternate with Sync. Timeline events and save points preserve progress across pauses and process restarts. Runtime migration away from cycles is pending."
        }
      ],
      "children": []
    },
