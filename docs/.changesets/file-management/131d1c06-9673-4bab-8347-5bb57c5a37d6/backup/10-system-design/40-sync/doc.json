    "sync-opening": {
      "id": "sync-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync brings the game's accepted source and knowledge inputs up to date. It runs during initial setup, at each epoch boundary, and when an operator requests a refresh. The result is an accepted source head with evidence that the next Run can use."
        }
      ],
      "children": []
    },
    "sync-entry-heading": {
      "id": "sync-entry-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How Sync Begins"
        }
      ],
      "children": []
    },
    "sync-entry-table": {
      "id": "sync-entry-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Entry",
          "Source work",
          "Publication"
        ],
        "rows": [
          [
            "Initial or manual Sync",
            "Acquire a Sync lease; reconcile in isolated staging.",
            "Operator confirms validated publication."
          ],
          [
            "Epoch Sync",
            "Run retains its lease; reconcile the settled harness worktree.",
            "Publish verified boundary evidence automatically."
          ],
          [
            "Manual Sync while paused",
            "Use the manual path on the same harness worktree.",
            "Preserve the desired pause after publication."
          ]
        ],
        "title": "Sync Entry and Authority"
      },
      "children": []
    },
    "sync-entry-explanation": {
      "id": "sync-entry-explanation",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These paths share merge policy and knowledge intake, but use different execution and recovery mechanisms. Dispatch State controls the lease. Harness State records the accepted head, readiness, and completed Sync boundary."
        }
      ],
      "children": []
    },
    "sync-steps-heading": {
      "id": "sync-steps-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What Sync Produces"
        }
      ],
      "children": []
    },
    "sync-steps": {
      "id": "sync-steps",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Observe the configured upstream and source inputs",
            "steps": [
              {
                "text": "Record which revisions and captures the refresh will use."
              }
            ]
          },
          {
            "text": "Reconcile source under exclusive authority",
            "steps": [
              {
                "text": "Apply the configured merge policy and identify displaced local work."
              }
            ]
          },
          {
            "text": "Validate the resulting checkout and refresh knowledge",
            "steps": [
              {
                "text": "Use the report to reconcile targets, import source evidence, and queue librarian processing."
              }
            ]
          },
          {
            "text": "Record the accepted boundary",
            "steps": [
              {
                "text": "Persist source and evidence references. Failed required gates keep the next epoch blocked."
              }
            ]
          },
          {
            "text": "Resume when the harness is ready and desired state is running",
            "steps": [
              {
                "text": "A successful manual Sync preserves an existing desired pause."
              }
            ]
          }
        ]
      },
      "children": []
    },
    "sync-unchanged": {
      "id": "sync-unchanged",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An unchanged upstream still needs a completed Sync record and current evidence. A knowledge-only manual Sync keeps the source head unchanged. Configured source policies decide which captures need refreshing; each epoch does not download the entire wiki or repeat initial backfill."
        }
      ],
      "children": []
    },
    "sync-manual-map-heading": {
      "id": "sync-manual-map-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Manual Sync Ownership"
        }
      ],
      "children": []
    },
    "sync-manual-map-intro": {
      "id": "sync-manual-map-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The manual path separates temporary staging from the canonical harness checkout. This map shows the artifacts owned by each stage. The detailed sequence explains the point at which publication changes the checkout."
        }
      ],
      "children": []
    },
