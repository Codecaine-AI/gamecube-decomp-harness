    "sync-knowledge-prose": {
      "id": "sync-knowledge-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Acquisition produces local captures of PRs, Discord, and wiki content. Intake imports available evidence and reconciles subjects with the accepted checkout and report. Librarian processing consumes the resulting tasks to curate facts and links; a completed capture or queued task does not mean that curation has finished."
        }
      ],
      "children": []
    },
