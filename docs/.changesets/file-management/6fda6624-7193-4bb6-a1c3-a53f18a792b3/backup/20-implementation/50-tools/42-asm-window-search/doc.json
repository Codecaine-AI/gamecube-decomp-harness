      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Window retrieval finds a loop or idiom inside a larger function when whole-function similarity is too broad. Similarity identifies a donor to inspect. It does not establish semantic equivalence or permission to copy source."
        }
      ],
