      "text": [
        {
          "insert": "asm_window_search",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns ranked donor windows with query and donor offsets, fuzzy-match scores, and normalized-window similarity. It compares 32-instruction windows using hashed normalized instruction n-grams."
        }
      ],
      "children": []
