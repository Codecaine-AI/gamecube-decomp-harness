    "b-audit-d600829e1ce6": {
      "id": "b-audit-d600829e1ce6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The MWCC Allocator suite captures compiler evidence and analyzes saved traces without changing source. Worker capture runs in a Linux sandbox using stock, hash-gated GC/1.2.5 or GC/1.2.5n MWCC under qemu-i386 and gdb-multiarch."
        }
      ],
      "children": []
    },
