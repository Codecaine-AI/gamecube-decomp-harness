    "b-audit-cd743f05733d": {
      "id": "b-audit-cd743f05733d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "mwcc_alloc_compare",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " takes workspace-relative "
        },
        {
          "insert": "before",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "after",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " snapshot paths. It returns virtual-register additions, removals, and color, graph, neighbor, and simplify-order changes. It compares GPR coloring snapshots and does not prove why a source change caused a difference."
        }
      ],
      "children": []
    },
