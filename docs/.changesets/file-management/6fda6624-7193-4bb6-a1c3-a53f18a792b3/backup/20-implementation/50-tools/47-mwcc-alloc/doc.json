    "b-audit-d00aac115d5d": {
      "id": "b-audit-d00aac115d5d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Allocator traces help test a specific register, stack, or scheduling hypothesis. A solver result is model evidence. Require baseline replay agreement, edit canonical source, rebuild, and verify with checkdiff before treating a predicted allocation as a match."
        }
      ],
      "children": []
    },
