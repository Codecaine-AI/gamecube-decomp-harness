    "b-audit-15b6ab8231cc": {
      "id": "b-audit-15b6ab8231cc",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Capture requires a worker sandbox. In worker contexts, capture, compare, and analysis run through the sandbox wrapper against retained workspace files. Offline analysis can also run on macOS outside a worker claim."
        }
      ],
      "children": []
    },
    "b-audit-e7128fef03f3": {
