    "b-audit-df65463e7b2e": {
      "id": "b-audit-df65463e7b2e",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The wrapper bounds targets to 16, coloring paths and fixed objects to 64, function_index to 1 through 100000, and degree_search to 0 through 8. Optional output names the saved result artifact. Invalid argument combinations or paths return structured errors."
        }
      ],
      "children": []
    },
