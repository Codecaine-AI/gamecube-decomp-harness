    "b-audit-13176181a023": {
      "id": "b-audit-13176181a023",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pair captures two stages of one compile, not candidate-versus-retail output. Legacy coloring is GPR-only. Trace retains emitted GPR and FPR graphs and reports identity and omitted event classes. Full tracing can take minutes. Inspect the identity and symbol-order caveat before interpreting a capture."
        }
      ],
      "children": []
    },
