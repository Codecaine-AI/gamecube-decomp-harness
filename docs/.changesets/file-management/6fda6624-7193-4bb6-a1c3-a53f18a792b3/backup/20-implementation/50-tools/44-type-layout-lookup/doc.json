    "b-audit-aaecd756e69b": {
      "id": "b-audit-aaecd756e69b",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use a prebuilt host index when available. For a sandbox claim without a usable index, the resolver fetches build/ctx.c and builds a private host cache through "
        },
        {
          "insert": "build_type_index.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". That fallback omits source-cast scanning, so casts mode needs a host-built index with cast data."
        }
      ],
      "children": []
    },
    "b-audit-b699ab78fec7": {
      "id": "b-audit-b699ab78fec7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why"
        }
      ],
      "children": []
    },
    "b-audit-6ee52dfe5f8b": {
      "id": "b-audit-6ee52dfe5f8b",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Record layout evidence helps identify aliasing and candidate type relationships without copying the whole workspace. Layout similarity does not establish semantic ownership, current ABI correctness, or MWCC allocation behavior. Rebuild the index after relevant type changes."
        }
      ],
      "children": []
    },
