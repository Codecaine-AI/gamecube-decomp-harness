      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Type Layout Lookup queries normalized PPC-EABI record layouts. It supplies duplicate layouts, near matches, union views, and cast-overlay evidence tied to an indexed build context."
        }
      ],
      "children": []
    },
