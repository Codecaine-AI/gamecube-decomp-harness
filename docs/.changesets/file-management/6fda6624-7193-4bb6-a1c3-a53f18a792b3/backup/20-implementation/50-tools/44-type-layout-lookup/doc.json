    "b-audit-a48a2a4d6ae3": {
      "id": "b-audit-a48a2a4d6ae3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Missing indexes and records return structured status payloads. A successful process exit is not proof that the requested layout exists. Returned layouts reflect the build/ctx.c used to build that index."
        }
      ],
      "children": []
    },
    "b-audit-e13f7be8ade2": {
