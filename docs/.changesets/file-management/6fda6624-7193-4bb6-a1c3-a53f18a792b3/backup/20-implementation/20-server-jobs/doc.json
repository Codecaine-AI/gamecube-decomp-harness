    "compile-policy": {
      "id": "compile-policy",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The compile jobserver uses a shared FIFO token budget on macOS and Linux. Its Ninja wrapper inherits through "
        },
        {
          "insert": "PATH",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "MAKEFLAGS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so cooperating host builds share capacity instead of each consuming a full independent pool. Daytona compilation uses its own sandbox resources."
        }
      ],
      "children": []
    },
    "compile-recovery": {
      "id": "compile-recovery",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Startup reuses a live daemon with the same slot count. A different requested count fails instead of restarting a daemon that may serve active builds. Dead process or missing FIFO state can be replaced. Wrapper execution returns its token when the child exits."
        }
      ],
      "children": []
    },
    "compile-source": {
      "id": "compile-source",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "apps/server/src/infrastructure/shell/global-compile-jobserver.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "apps/server/src/infrastructure/shell/global-compile-jobserver.ts"
            }
          }
        },
        {
          "insert": " owns daemon startup, token coordination, and wrapper environment."
        }
      ],
      "children": []
    },
    "report-execution": {
