    "startup-context": {
      "id": "startup-context",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Server startup configures shared host build capacity before reconciling interrupted Sync publication and opening HTTP routes. Job commands also configure build capacity before dispatching their domain implementation."
        }
      ],
      "children": []
    },
    "startup-outline": {
      "id": "startup-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Configure the host compile jobserver when a slot budget is supplied."
          },
          {
            "text": "Reconcile interrupted Sync publication before accepting operator requests."
          },
          {
            "text": "Open the HTTP server with kernel reads, application APIs, and dashboard assets."
          }
        ]
      },
      "text": [],
      "children": []
