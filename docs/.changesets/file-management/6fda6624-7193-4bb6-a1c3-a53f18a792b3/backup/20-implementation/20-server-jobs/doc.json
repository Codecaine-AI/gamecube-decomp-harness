      "text": [
        {
          "insert": "Server startup prepares host build coordination and recovers interrupted Sync publication before opening HTTP routes. The job dispatcher parses game and runtime options and invokes the owning domain implementation. This page maps those entry points and the shared report runner to their code."
        }
      ],
      "children": []
