    "report-policy": {
      "id": "report-policy",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The report runner configures a missing build graph, builds the configured report target, and optionally generates changes against the baseline. "
        },
        {
          "insert": "--reset-baseline",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " replaces the comparison baseline with the fresh report. Report paths and targets come from the selected game."
        }
      ],
      "children": []
    },
    "report-reuse": {
      "id": "report-reuse",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "With "
        },
        {
          "insert": "ORCH_REPORT_REUSE=1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a matching reuse key permits the existing report to be reused. The key includes the checkout head and build configuration inputs. A miss regenerates the report. Baseline reset and change generation remain explicit options."
        }
      ],
      "children": []
    },
    "report-serialization": {
      "id": "report-serialization",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Calls to "
        },
        {
          "insert": "forceReportRun",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are serialized by resolved repository root within the host process. A failed call does not prevent the next queued call from running. This map is process-local and does not lock independent host processes that write the same checkout."
        }
      ],
      "children": []
    },
