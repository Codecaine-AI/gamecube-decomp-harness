        "content": "#include \"ftCo_0C60.h\"\n\n#include \"ftCo_HammerWait.h\"\n#include \"ftCo_Pass.h\"\n#include <melee/ft/inlines.h>\n#include <melee/ft/types.h>\n\nbool ftCo_HammerFall_CheckInput(Fighter_GObj* gobj)\n{\n    if (ftCo_Pass_CheckInput(gobj)) {\n        ftCo_HammerFall_EnterFromPass(gobj);\n        return true;\n    }\n    return false;\n}\n\nvoid ftCo_HammerFall_EnterFromPass(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n    ftCo_Pass_EnterWithMotion(gobj, ftCo_MS_HammerFall, Ft_MF_None, 0);\n    ftCo_Hammer_Setup(fp);\n}\n",
