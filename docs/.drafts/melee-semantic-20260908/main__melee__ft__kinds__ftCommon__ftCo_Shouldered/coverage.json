            "content": "#include \"ftCo_Shouldered.h\"\n\n#include <Runtime/platform.h>\n\n#include <melee/lb/forward.h>\n\n#include <placeholder.h>\n\n#include \"ftCo_Attack100.h\"\n#include \"ftCo_Damage.h\"\n#include \"ftCo_Throw.h\"\n#include \"types.h\"\n#include <dolphin/mtx.h>\n#include <melee/ft/fighter.h>\n#include <melee/ft/ftanim.h>\n#include <melee/ft/ftcoll.h>\n#include <melee/ft/ftcommon.h>\n#include <melee/ft/ftparts.h>\n#include <melee/ft/types.h>\n#include <melee/lb/lb_00B0.h>\n\n#ifdef MUST_MATCH\n#pragma force_active on\n#endif\n\n/* 09C744 */ static void ftCo_Shouldered_ApplyDamage(Fighter_GObj* gobj);\n\nvoid ftCo_Shouldered_Enter(Fighter_GObj* gobj, FtMotionId msid)\n{\n    u32 unused1;\n    u32 unused2;\n    Fighter* fp = gobj->user_data;\n    if (fp->motion_id != msid || msid != ftCo_MS_ShoulderedWait) {\n        Fighter_ChangeMotionState(\n            gobj, msid, fp->x2222_b6 ? Ft_MF_FreezeState : Ft_MF_None, 0, 1, 0,\n            fp->victim_gobj);\n        ftCommon_ResetVelocities(gobj);\n        ftCommon_8007E2F4(fp, 0x1FF);\n        fp->accessory1_cb = ftCo_CapturePulled_UpdatePosition;\n    }\n}\n\nvoid ftCo_8009C640(Fighter_GObj* gobj, FtMotionId msid)\n{\n    Fighter* fp = gobj->user_data;\n    PAD_STACK(8);\n    ftCommon_InitGrab(fp, 0,\n                      (int) (fp->dmg.x1830_percent * p_ftCommonData->x4A0 +\n                             p_ftCommonData->x4A4));\n    fp->mv.co.shouldered.x0 = 0;\n    fp->mv.co.shouldered.x4 = 0;\n    ftCo_Shouldered_Enter(gobj, msid);\n}\n\nvoid ftCo_Shouldered_ApplyDamage(Fighter_GObj* gobj)\n{\n    Fighter* fp = gobj->user_data;\n    Fighter_GObj* vic_gobj = fp->victim_gobj;\n    Fighter* vic_fp = vic_gobj->user_data;\n    Vec3 pos;\n    HitCapsule* hit = &vic_fp->xDF4[1];\n    PAD_STACK(8);\n    ftCo_CaptureCut_Release(fp->victim_gobj, gobj);\n    lbJObjTransformPoint(fp->parts[ftParts_GetBoneIndex(fp, FtPart_XRotN)].joint, NULL,\n                &pos);\n    fp->dmg.kb_applied = ftColl_CalcKnockback(fp, vic_fp, hit, hit->unk_count);\n    fp->dmg.x1848_kb_angle = hit->kb_angle;\n    fp->dmg.facing_dir_1 = -vic_fp->facing_dir;\n    fp->dmg.x184c_damaged_hurtbox = 1;\n    fp->dmg.x1854_collpos = pos;\n    fp->dmg.x1860_element = hit->element;\n    ftColl_RecordFighterHit(vic_gobj, gobj, &fp->dmg.facing_dir_1);\n    Fighter_ApplyDamage(fp, hit->damage);\n    ftCo_Damage_CalcKnockback(fp);\n    ftCo_Damage_Enter(gobj, 0);\n}\n\nstatic inline float inlineA0(Fighter_GObj* gobj)\n{\n    Fighter* fp = gobj->user_data;\n    return fp->ground_or_air == GA_Ground\n               ? p_ftCommonData->x4A8\n               : p_ftCommonData->x4A8 * p_ftCommonData->x4AC;\n}\n\nvoid ftCo_Shouldered_Anim(Fighter_GObj* gobj)\n{\n    HitCapsule* hit;\n    Fighter* fp2;\n    Fighter* fp1;\n    Fighter_GObj* gobj1;\n    u32 unused1;\n    u32 unused2;\n    Vec3 pos;\n    Fighter* fp = gobj->user_data;\n    PAD_STACK(16);\n    fp->mv.co.shouldered.x4 = ftCommon_GrabMash(fp, inlineA0(fp->victim_gobj));\n    if (fp->grab_timer <= 0) {\n        gobj1 = fp->victim_gobj;\n        fp1 = gobj1->user_data;\n        fp2 = fp1->victim_gobj->user_data;\n        hit = &fp2->xDF4[1];\n        lbJObjTransformPoint(\n            fp1->parts[(ftParts_GetBoneIndex(fp1, FtPart_TransN2))].joint,\n            NULL, &pos);\n        fp1->dmg.kb_applied = ftColl_CalcKnockback(fp1, fp2, hit, hit->unk_count);\n        fp1->dmg.x1848_kb_angle = hit->kb_angle;\n        fp1->dmg.facing_dir_1 = fp1->facing_dir;\n        fp1->dmg.x184c_damaged_hurtbox = 1;\n        fp1->dmg.x1854_collpos = pos;\n        fp1->dmg.x1860_element = hit->element;\n        ftColl_RecordFighterHit(gobj1, fp1->victim_gobj, &fp1->dmg.facing_dir_1);\n        Fighter_ApplyDamage(fp1, hit->damage);\n        ftCo_Damage_CalcKnockback(fp1);\n        ftCo_Damage_Enter(gobj1, 0);\n        ftCo_Shouldered_ApplyDamage(gobj);\n        return;\n    }\n    if (fp->mv.co.shouldered.x0) {\n        fp->mv.co.shouldered.x0 -= 1;",
