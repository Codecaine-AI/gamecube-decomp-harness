            "content": "#include \"ftCo_Run.h\"\n\n#include <melee/ft/forward.h>\n\n#include <placeholder.h>\n\n#include \"forward.h\"\n#include \"ftCo_AppealS.h\"\n#include \"ftCo_Attack100.h\"\n#include \"ftCo_AttackDash.h\"\n#include \"ftCo_Guard.h\"\n#include \"ftCo_Jump.h\"\n#include \"ftCo_RunBrake.h\"\n#include \"ftCo_SpecialS.h\"\n#include \"ftCo_TurnRun.h\"\n#include <melee/ft/fighter.h>\n#include <melee/ft/ft_081B.h>\n#include <melee/ft/ftcommon.h>\n#include <melee/ft/inlines.h>\n#include <melee/ft/types.h>\n\nbool ftCo_Run_CheckInput(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n\n    if (fp->input.lstick[0].x * fp->facing_dir >=\n        p_ftCommonData->x58_someLStickXThreshold)\n    {\n        ftCo_Run_Enter(gobj, 0.0F);\n        return true;\n    }\n    return false;\n}\n\nbool ftCo_Run_CheckInputFromTurnRun(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n\n    if ((fp->input.lstick[0].x * fp->facing_dir) >=\n        p_ftCommonData->x58_someLStickXThreshold)\n    {\n        ftCo_Run_Enter(gobj, p_ftCommonData->x430);\n        return true;\n    }\n    return false;\n}\n\nbool ftCo_Run_CheckInputFromRunDirect(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n    if (fp->input.lstick[0].x * fp->facing_dir >=\n        p_ftCommonData->x58_someLStickXThreshold)\n    {\n        ftCo_Run_Enter_Full(gobj, 0.0F, fp->cur_anim_frame,\n                            fp->frame_speed_mul);\n        return true;\n    }\n    return false;\n}\n\nvoid ftCo_Run_Enter(Fighter_GObj* gobj, float arg0)\n{\n    ftCo_Run_Enter_Full(gobj, arg0, 0.0F, 1.0F);\n}\n\nvoid ftCo_Run_Enter_Full(Fighter_GObj* gobj, float arg0, float anim_start,\n                         float anim_speed)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n    Fighter_ChangeMotionState(gobj, ftCo_MS_Run, Ft_MF_None, anim_start,\n                              anim_speed, 0.0F, NULL);\n    fp->mv.co.run.x0 = arg0;\n    fp->mv.co.run.x4 = fp->gr_vel;\n}\n\nvoid ftCo_Run_Anim(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n    f32 vel;\n    f32 anim_rate;\n    PAD_STACK(1);\n\n    if (ft_GetGroundFrictionMultiplier(fp) < 1.0F) {\n        vel = fp->mv.co.run.x4;\n    } else {\n        vel = fp->gr_vel;\n    }\n\n    if (vel * fp->facing_dir <= 0.0F) {\n        anim_rate = 0.0F;\n    } else {\n        anim_rate = ABS(vel) / fp->co_attrs.run_animation_scaling;\n    }\n\n    ftAnim_SetAnimRate(gobj, anim_rate);\n    if (fp->mv.co.run.x0 > 0.0F) {\n        fp->mv.co.run.x0 -= 1.0F;\n    }\n}\n\nvoid ftCo_Run_IASA(Fighter_GObj* gobj)\n{\n    Fighter* fp = GET_FIGHTER(gobj);\n\n    RETURN_IF(ftCo_SpecialS_CheckInput(gobj));\n    RETURN_IF(ftCo_SpecialHi_CheckInput(gobj));\n    RETURN_IF(ftCo_SpecialN_CheckInput(gobj));\n    RETURN_IF(ftCo_SpecialLw_CheckInput(gobj));\n    RETURN_IF(ftCo_CatchDash_CheckInput(gobj));\n\n    if (ftCo_AttackDash_CheckInput(gobj)) {\n        ftCo_AttackDash_SetMv0(gobj);\n        return;\n    }\n\n    if (ftCo_Guard_CheckInput(gobj)) {\n        ftCo_Guard_SetMv20(gobj, p_ftCommonData->x410);\n        ftCo_Guard_SetMv24(gobj);\n        return;\n    }",
