    {
      "link_id": "link:03ad4a8b-dbfa-493c-a574-e00c619a6c16",
      "baseline_record": {
        "id": "link:03ad4a8b-dbfa-493c-a574-e00c619a6c16",
        "from_target_id": "target:function:main/sysdolphin/baselib/texpdag:HSD_TExpSchedule",
        "from_entity_id": null,
        "to_target_id": null,
        "to_entity_id": "game_concept:game_concept:gamecube-tev-color-combiner",
        "role": "implements",
        "why": "The function orders TEV expression nodes and converts their inter-node color and alpha dependencies into concrete GX combiner register selectors.",
        "kind": "code",
        "locator": "code://1e28b4203b/src/sysdolphin/baselib/texpdag.c#L330-L382",
        "digest": "sha256:60dec28ea07044a7"
      },
      "disposition": "retain",
      "reason": "Uses32-entry work arrays, initializes min=5 and min_order to all zeros, builds direct and transitive masks, and calls order_dag starting at index0 without a num0 guard. If no candidate scores below5, the order remains zeros. It never reruns assign_reg on the saved order, so destination fields reflect the final explored candidate. Selected nodes populate result. Non-FF c_dst/a_dst mark reg[dst+4].color=3/alpha=1. RGB color inputs index c_in with producer c_dst; color inputs selecting alpha index a_in with producer c_dst as well, whereas alpha inputs index args with producer a_dst. These exact operations do not guarantee a valid executable schedule.",
      "canonical_evidence": [
        {
          "kind": "code",
          "locator": "code://c302741689bd67c361cd7faadb221df3193992c3/src/sysdolphin/baselib/texpdag.c#L333-L385",
          "why": "Pinned canonical branch/type/caller evidence."
        },
        {
          "kind": "code",
          "locator": "code://c302741689bd67c361cd7faadb221df3193992c3/src/sysdolphin/baselib/texpdag.h#L12-L39",
          "why": "Pinned canonical branch/type/caller evidence."
        },
