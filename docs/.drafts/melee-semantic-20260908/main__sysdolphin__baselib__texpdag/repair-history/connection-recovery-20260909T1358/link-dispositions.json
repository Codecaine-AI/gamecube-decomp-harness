    {
      "link_id": "link:1e3b1972-c467-4861-986a-1e35503df747",
      "baseline_record": {
        "id": "link:1e3b1972-c467-4861-986a-1e35503df747",
        "from_target_id": "target:function:main/sysdolphin/baselib/texpdag:HSD_TExpMakeDag",
        "from_entity_id": null,
        "to_target_id": null,
        "to_entity_id": "game_concept:game_concept:gamecube-tev-color-combiner",
        "role": "implements",
        "why": "The function converts inter-expression TEV color and alpha references into the dependency graph that the compiler schedules before emitting GameCube TEV-stage descriptors.",
        "kind": "code",
        "locator": "code://1e28b4203b/src/sysdolphin/baselib/texp.c#L1184-L1228",
        "digest": "sha256:d249e31e509e3ad9"
      },
      "disposition": "retain",
      "reason": "Asserts a TEV root, discovers distinct reachable TEV pointers into fixed32 storage, initializes distances to-1 and calls CalcDistance(root,0). The j<32 assertion precedes processing a node, not every base[n++] append, so safe capacity enforcement is not established. The distance-driven adjacent-swap loops are followed by reverse DAG construction. Nodes receive tev,idx,nb_dep,nb_ref and deduplicated color/alpha dependency pointers; producer nb_ref increments once per distinct edge. Dependency lookup searches only remaining positions and asserts a match. The header dist field is not initialized here; no general sorting or DAG validity guarantee is claimed.",
      "canonical_evidence": [
        {
          "kind": "code",
          "locator": "code://c302741689bd67c361cd7faadb221df3193992c3/src/sysdolphin/baselib/texpdag.c#L161-L287",
