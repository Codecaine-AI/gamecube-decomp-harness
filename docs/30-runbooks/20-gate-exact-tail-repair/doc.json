      "text": [
        {
          "insert": "Intended use in a fresh session: "
        },
        {
          "insert": "\"Follow docs/30-runbooks/20-gate-exact-tail-repair.md. Monitor for new gate-exact tails every 30 minutes; process any to completion and write the reports.\"",
          "attributes": {
            "italic": true
          }
        },
        {
          "insert": " (Pair with "
        },
        {
          "insert": "/loop 30m",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or a Monitor for the cadence.)"
        }
      ],
      "children": []
