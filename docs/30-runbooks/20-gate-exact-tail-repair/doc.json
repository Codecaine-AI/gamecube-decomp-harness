          "insert": "DB=\"projects/melee/state/orchestrator.sqlite\"          # ALWAYS open read-only: sqlite3 -readonly\nRUN=$(sqlite3 -readonly \"$DB\" \"SELECT id FROM runs ORDER BY created_at DESC LIMIT 1;\")\n# Session tree (the run's live source; NEVER edit except via the apply step below):\n# find it from a running job-runner:  ps ax | grep job-runner | grep -o '\\-\\-repo-root [^ ]*'\n# or: projects/melee/worktrees/sessions/<session>/current"
        }
