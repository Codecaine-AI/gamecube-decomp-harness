    "b-20-gate-exact-tail-repair-sql-11": {
      "id": "b-20-gate-exact-tail-repair-sql-11",
      "type": "code",
      "props": {
        "language": "sql"
      },
      "text": [
        {
          "insert": "SELECT ws.target_key, ws.ended_at, ws.best_score, ws.artifact_dir\nFROM worker_state ws\nWHERE ws.summary_json LIKE '%gate_failed_exact_followup_budget_exhausted%'\n  AND ws.ended_at > '<last sweep timestamp>'\nORDER BY ws.ended_at DESC;"
        }
      ],
