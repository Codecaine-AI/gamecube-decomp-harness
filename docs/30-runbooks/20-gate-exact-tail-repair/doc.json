    "b-20-gate-exact-tail-repair-sql-13": {
      "id": "b-20-gate-exact-tail-repair-sql-13",
      "type": "code",
      "props": {
        "language": "sql"
      },
      "text": [
        {
          "insert": "SELECT ws.target_key, MAX(wc.new_score), ws.artifact_dir\nFROM worker_checkpoints wc JOIN worker_state ws ON ws.id=wc.worker_state_id\nWHERE wc.exact_match=1 AND wc.selectable=0 GROUP BY ws.target_key;"
        }
      ],
      "children": []
