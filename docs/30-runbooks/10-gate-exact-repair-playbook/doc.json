    "b-10-gate-exact-repair-playbook-symbols-txt-splits-t-11": {
      "id": "b-10-gate-exact-repair-playbook-symbols-txt-splits-t-11",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "symbols.txt / splits.txt metadata, not source.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " If the residual diff is only relocation-symbol naming/extent differences: check "
        },
        {
          "insert": "config/GALE01/symbols.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for wrong data extents (missed NUL terminators, pad bytes, unsplit blobs), TU-local literals mis-annotated "
        },
        {
          "insert": "scope:global",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (rename to "
        },
        {
          "insert": "@NNN scope:local data:string",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and claim the gap in "
        },
        {
          "insert": "config/GALE01/splits.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), data attributed to the wrong TU, or a missing TU split — MWCC 1.2.5n's merged-data anchor always sits at the object's .data+0; a retail anchor elsewhere proves the code lived in a separate TU."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-name-evidenced-data-pr-12": {
      "id": "b-10-gate-exact-repair-playbook-name-evidenced-data-pr-12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Name evidenced data properly.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "numeric_literal_to_symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "address_named_static_data",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " findings on real, evidenced, unit-owned tables: give the data a semantic name across "
        },
        {
          "insert": ".c",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": ".static.h",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "symbols.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (precedent: "
        },
        {
          "insert": "gm_HandicapDamageRatios",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Declarations of another TU's data belong in the OWNING header, never "
        },
        {
          "insert": "extern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": ".c",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Define data after its user to defeat constant folding / force symbol-anchored addressing when the target relocations demand it."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-asserts-use-the-real-13": {
      "id": "b-10-gate-exact-repair-playbook-asserts-use-the-real-13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Asserts: use the real header inline helpers.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Open-coded "
        },
        {
          "insert": "__assert(...)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with extracted strings usually means the proper "
        },
        {
          "insert": "HSD_ASSERT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "-bearing inline helper in the sysdolphin header already produces exactly those strings/lines. If a header helper is missing an assert its sibling has, fixing the header (with repo-wide A/B proof) may be the true repair."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-fix-headers-truthfully-14": {
      "id": "b-10-gate-exact-repair-playbook-fix-headers-truthfully-14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Fix headers truthfully.",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " Begin with in-slice typing; if evidence proves the canonical signature is the blocker, request owning-header widening instead of hiding the mismatch behind a banned "
        },
        {
          "insert": "#define",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alias, K&R declaration, or bare local prototype. Retype the owning prototype and run scope-following checks for the owner and direct consumers."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-mwcc-codegen-idioms-15": {
      "id": "b-10-gate-exact-repair-playbook-mwcc-codegen-idioms-15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "MWCC codegen idioms",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " (each needs an evidence comment per "
        },
        {
          "insert": "global_standard:matching-tactics-need-evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "):"
        }
      ],
      "children": [
        "b-10-gate-exact-repair-playbook-anti-inline-without-prag-16",
