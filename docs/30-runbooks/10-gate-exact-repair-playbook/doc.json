    "b-10-gate-exact-repair-playbook-you-are-repairing-stuck-2": {
      "id": "b-10-gate-exact-repair-playbook-you-are-repairing-stuck-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "You are repairing stuck decompilation targets in the Melee decomp project. Orchestrator workers reached (or nearly reached) an exact match for your target function(s), but the return was rejected by QA/hard gates and the repair tail exhausted. Your job: deliver the match "
        },
        {
          "insert": "gate-clean",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ". Your coordinator's prompt gives you the unit, targets, artifact dirs, and deliverable dir."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-target-selection-coordi-3": {
      "id": "b-10-gate-exact-repair-playbook-target-selection-coordi-3",
