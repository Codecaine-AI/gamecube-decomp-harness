    "b-10-gate-exact-repair-playbook-anti-inline-without-prag-16": {
      "id": "b-10-gate-exact-repair-playbook-anti-inline-without-prag-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Anti-inline without pragmas: unreachable "
        },
        {
          "insert": "if (0) { ...no-op call statements... }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pads the pre-expansion statement count (auto-inline threshold: 14; loop bodies/switch cases/call args don't count) and generates zero code."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-declspec-weak-on-a-17": {
      "id": "b-10-gate-exact-repair-playbook-declspec-weak-on-a-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "__declspec(weak)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on a data definition removes it from MWCC's ≥3-object same-section pooling."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-an-inlined-u16-returning-18": {
      "id": "b-10-gate-exact-repair-playbook-an-inlined-u16-returning-18",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An inlined u16-returning helper reproduces argument-materialization truncation (replaces banned goto shapes)."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-inline-helper-return-tem-19": {
      "id": "b-10-gate-exact-repair-playbook-inline-helper-return-tem-19",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Inline-helper return temps land in the host frame's bottom temp pool and propagate through inline copies (never across real calls); named locals slot by declaration order in the standalone compile only."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-when-clean-c-provably-ca-20": {
      "id": "b-10-gate-exact-repair-playbook-when-clean-c-provably-ca-20",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "When clean C provably cannot match, the sanctioned last resort is the upstream-master "
        },
        {
          "insert": "#ifdef __MWERKS__",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / prototype-clean "
        },
        {
          "insert": "#else",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " guard (see toy.c) — clang/CI must never see the non-clean form. Verify with "
        },
        {
          "insert": "clang @compile_flags.txt -fsyntax-only",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-suspect-lint-false-pos-21": {
      "id": "b-10-gate-exact-repair-playbook-suspect-lint-false-pos-21",
      "type": "list-item",
