          "insert": "Target selection (coordinator)"
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-the-canonical-marker-for-4": {
      "id": "b-10-gate-exact-repair-playbook-the-canonical-marker-for-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical marker for this playbook is the worker end event "
        },
        {
          "insert": "\"gate-exact tail\"",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — stop reason "
        },
        {
          "insert": "gate_failed_exact_followup_budget_exhausted",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", stored in "
        },
        {
          "insert": "worker_state.summary_json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (emitted by "
        },
        {
          "insert": "apps/server/src/core/session-runtime/phases/running/workers/worker-cycle.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", UI label in "
        },
        {
          "insert": "worker-reports.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Select targets with:"
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-sql-5": {
      "id": "b-10-gate-exact-repair-playbook-sql-5",
      "type": "code",
      "props": {
        "language": "sql"
      },
      "text": [
        {
          "insert": "SELECT target_key, id, artifact_dir, best_score, ended_at FROM worker_state\nWHERE session_id='<run-id>' AND summary_json LIKE '%gate_failed_exact_followup_budget_exhausted%';"
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-do-not-approximate-with-6": {
      "id": "b-10-gate-exact-repair-playbook-do-not-approximate-with-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Do NOT approximate with best_score thresholds: tail closures exist with recorded best scores well below 100 (the rejected candidate isn't always the best checkpoint), and high-percent near-misses that never gate-failed are out of scope. Then dedupe before fleeting: drop targets covered by "
        },
        {
          "insert": "projects/melee/state/runs/<run>/oob_repairs/manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (prior repair fleets; match by symbol too — units get renamed/split), targets currently 100 in the session tree, targets claimed by "
        },
        {
          "insert": "lifecycle_status='running'",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " workers, and targets with an integration applied after the last report snapshot (mind "
        },
        {
          "insert": "report.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " mtime). Map missing symbols via "
        },
        {
          "insert": "metadata.virtual_address",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "report.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
