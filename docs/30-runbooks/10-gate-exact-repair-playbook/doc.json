    "b-10-gate-exact-repair-playbook-read-your-targets-worke-23": {
      "id": "b-10-gate-exact-repair-playbook-read-your-targets-worke-23",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Read your targets' worker artifacts FIRST: "
        },
        {
          "insert": "sqlite3 -readonly projects/melee/state/orchestrator.sqlite \"SELECT id, artifact_dir FROM worker_state WHERE target_key='<unit>::<symbol>';\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " then "
        },
        {
          "insert": "<artifact_dir>/runner_validation/attempt-N.repair_request.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (verbatim QA findings) and "
        },
        {
          "insert": "attempt-N.write_set.diff",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (the near-miss diffs). Worker output "
        },
        {
          "insert": ".txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " files show exact build/diff commands."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-base-on-the-run-s-sessio-24": {
      "id": "b-10-gate-exact-repair-playbook-base-on-the-run-s-sessio-24",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Base on the run's session tree (coordinator provides the path). DO NOT edit it. Private worktree: "
        },
        {
          "insert": "git -C <session-current> worktree add <deliverable-dir>-wt HEAD",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then snapshot and apply the dirty state: "
        },
        {
          "insert": "git -C <session-current> diff > <deliverable-dir>/session-dirty.snapshot.patch && git -C <wt> apply <that file>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Copy any untracked session files your unit needs."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-build-verify-with-the-pr-25": {
      "id": "b-10-gate-exact-repair-playbook-build-verify-with-the-pr-25",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Build/verify with the project's tooling: "
        },
        {
          "insert": "configure.py --require-protos --wrapper build/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "ninja build/GALE01/<unit>.o",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "build/tools/objdiff-cli diff -p . -u <unit> --config functionRelocDiffs=data_value --format json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Warm tool cache: /private/tmp/melee-tool-cache. COPY build/tools + build/compilers from an existing worktree — never symlink into the session tree."
        }
      ],
      "children": []
    },
    "b-10-gate-exact-repair-playbook-same-tool-scoring-only-26": {
      "id": "b-10-gate-exact-repair-playbook-same-tool-scoring-only-26",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
