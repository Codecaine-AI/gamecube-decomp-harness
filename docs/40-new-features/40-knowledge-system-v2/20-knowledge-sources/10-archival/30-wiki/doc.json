    "b-ks2-src-wiki-search-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Keyword, structured, and vector; no graph. BM25 runs over "
        },
        {
          "insert": "content",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; structured filters narrow by "
        },
        {
          "insert": "page",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "mirror_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with the latest revision the default. Vector retrieval runs over sections and is the primary surface for "
        },
        {
          "insert": "game_mapping",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " work — conceptual queries land here."
        }
