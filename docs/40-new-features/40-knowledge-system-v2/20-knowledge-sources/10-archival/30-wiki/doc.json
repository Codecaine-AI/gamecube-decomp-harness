    "b-ks2-src-wiki-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WIKI — The wiki source is the archival store behind "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators: SmashWiki material mirrored into "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. A "
        },
        {
          "insert": "wiki_section.id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " encodes page, section, and mirror revision, so a locator pins exactly the text a claim was read against. Archival class — a mirror re-sync inserts new rows at a new "
        },
        {
          "insert": "mirror_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; existing rows never change, so a locator cannot drift and carries no digest."
        }
      ],
      "id": "b-ks2-src-wiki-intro",
      "children": []
    },
    "b-ks2-src-wiki-shape-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        }
      ],
      "id": "b-ks2-src-wiki-shape-heading",
      "children": []
    },
    "b-ks2-src-wiki-shape": {
      "type": "state-shape",
      "props": {
        "name": "wiki_section",
        "description": "Draft for review — the shape is proposed, not settled. One row per (page, section, mirror revision); immutable after insert.",
        "example": "{\n  \"id\": \"hitstun#formula@r2026-08-15\",\n  \"page\": \"Hitstun\",\n  \"section\": \"Formula\",\n  \"mirror_revision\": \"r2026-08-15\",\n  \"content\": \"Hitstun is the number of frames a character is unable to act after being hit, derived from knockback.\",\n  \"ingested_at\": \"2026-08-15T03:00:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "wiki section id",
            "description": "Primary key; encodes page, section, and mirror revision — the payload of a `wiki://` locator"
          },
          {
            "name": "page",
            "type": "string"
          },
          {
            "name": "section",
            "type": "string"
          },
          {
            "name": "mirror_revision",
            "type": "mirror revision",
            "description": "Which sync of the mirror this row came from"
          },
          {
            "name": "content",
            "type": "string"
          },
          {
            "name": "ingested_at",
            "type": "timestamp"
          }
        ]
      },
      "id": "b-ks2-src-wiki-shape",
      "children": []
    },
    "b-ks2-src-wiki-shape-example-note-1": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "mirror_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": a later re-sync of this page inserts new rows at a new revision; this row stays, and a "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator keeps resolving to the text as it stood at citation time."
        }
      ],
      "id": "b-ks2-src-wiki-shape-example-note-1",
      "children": []
    },
    "b-ks2-src-wiki-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the encoding shown is illustrative; what is contractual is that one id names one (page, section, mirror revision) triple."
        }
      ],
      "id": "b-ks2-src-wiki-shape-example-note-2",
      "children": []
    },
