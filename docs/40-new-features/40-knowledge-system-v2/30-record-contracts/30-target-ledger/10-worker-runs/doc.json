    "b-sks-rc-wr-shape": {
      "id": "b-sks-rc-wr-shape",
      "type": "state-shape",
      "props": {
        "name": "worker_run",
        "description": "Parent container, immutable after capture. No embedded submissions or citations: those are submission and evidence rows.",
        "fields": [
          {
            "name": "id",
            "type": "worker_run id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "description": "FK → target; the one target the run worked on"
          },
          {
            "name": "goal",
            "type": "string",
            "description": "What the run set out to do"
          },
          {
            "name": "baseline",
            "type": "object",
            "description": "Copied from the runtime before the first submission; the summary agent never restates it",
            "fields": [
              {
                "name": "score",
                "type": "number",
                "description": "Fuzzy match percentage before the first submission"
              },
              {
                "name": "validation_refs",
                "type": "sequence",
                "description": "Refs to the runtime validation results the score came from"
              }
            ]
          },
          {
            "name": "run_id",
            "type": "string",
            "required": false,
            "description": "Runtime provenance; copied verbatim from the runtime"
          },
          {
            "name": "worker_state_id",
            "type": "string",
            "required": false,
            "description": "Runtime provenance; copied verbatim from the runtime"
          },
          {
            "name": "final_outcome",
            "type": "match | improvement | no_change | error",
            "description": "Must agree with the last submission's `score` against `baseline.score`; this is the only place an outcome is stored"
          },
          {
            "name": "error_type",
            "type": "build_failure | tool_failure | timeout | worker_crash",
            "required": false,
            "description": "Why `final_outcome` is `error`; null otherwise"
          },
          {
            "name": "integration",
            "type": "integrated | conflicted",
            "required": false,
            "description": "Whether the run's diff landed in the tree after close; joined mechanically like the scores — the summary agent never emits it; absent when an `error` run left nothing to integrate"
          },
          {
            "name": "started_at",
            "type": "timestamp",
            "description": "When the run began"
          },
          {
            "name": "ended_at",
            "type": "timestamp",
            "required": false,
            "description": "Absent when the run ended in an `error` that left no scored submission"
          },
          {
            "name": "closed_at",
            "type": "timestamp",
            "description": "When the run closed and the row was captured; the row is written once, here"
          }
        ],
        "example": "{\n  \"id\": \"wr-ftCo_800BFFD0-0008\",\n  \"target_id\": \"tgt-ftCo_800BFFD0\",\n  \"goal\": \"Push ftCo_800BFFD0 (main/melee/ft/ftcommon) from 91.2 fuzzy to a full match\",\n  \"baseline\": {\n    \"score\": 91.2,\n    \"validation_refs\": [\n      \"val_ftCo_800BFFD0_e10r12\"\n    ]\n  },\n  \"run_id\": \"run-epoch10-2026-08-28\",\n  \"worker_state_id\": \"ws_7f3a9c\",\n  \"final_outcome\": \"improvement\",\n  \"error_type\": null,\n  \"integration\": \"integrated\",\n  \"started_at\": \"2026-08-28T14:02:11Z\",\n  \"ended_at\": \"2026-08-28T14:31:47Z\",\n  \"closed_at\": \"2026-08-28T14:31:47Z\"\n}"
      },
      "children": []
    },
