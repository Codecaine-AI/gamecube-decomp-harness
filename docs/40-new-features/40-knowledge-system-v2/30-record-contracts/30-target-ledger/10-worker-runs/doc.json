    "b-sks-rc-wr-shape-example-note-2": {
      "id": "b-sks-rc-wr-shape-example-note-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "integration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is orthogonal to "
        },
        {
          "insert": "final_outcome",
          "attributes": {
