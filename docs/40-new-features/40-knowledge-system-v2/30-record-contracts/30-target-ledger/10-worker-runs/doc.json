    "b-sks-rc-wr-proposal-heading": {
      "id": "b-sks-rc-wr-proposal-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example — proposed facts and the fact overwrite"
        }
      ],
      "children": []
    },
    "b-sks-rc-wr-proposal-process": {
      "id": "b-sks-rc-wr-proposal-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The summary agent writes and proposes",
            "steps": [
              {
                "text": "Inserts the `worker_run` row and its `submission` rows, one per scored try; `final_outcome` from the last `score` against `baseline.score`."
              },
              {
                "text": "No `event` row is inserted: good news lives in `target_status` and the submissions themselves.",
                "kind": "note"
              },
              {
                "text": "For each reusable thing the run learned, its proposal carries a proposed `Fact` (`value`, type, a `rationale` arguing for it, and the code-span or submission evidence behind it)."
              },
              {
                "text": "The proposal is input for the librarian, not a row. The run is complete and immutable from here.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The librarian reads the run",
            "steps": [
              {
                "text": "Reads the `worker_run` and `submission` rows, the proposal, the live `fact` rows for `worker_run.target_id`, and the target's `event` rows."
              },
              {
                "text": "May add fact proposals of its own or search the code graph for subjects worth connecting with curated `link` rows; the run does not change.",
                "kind": "note"
              },
              {
                "text": "A failed interpretation stays on the run side: the `submission` rows record the `hypothesis` and the scores that contradicted it; it never becomes a fact."
              }
            ]
          },
          {
            "text": "The librarian overwrites live `fact` rows",
            "steps": [
              {
                "text": "Each affected fact row is overwritten in place — Facts added, reworded, or cleared — and each fact's `evidence` rows are replaced in the same write with the new citations."
              },
              {
                "text": "A run outcome never becomes a Fact by itself; only a written claim on the page does.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The card is rebuilt",
            "steps": [
              {
                "text": "The derived ledger view shows first — submissions joined to their worker runs, merged with the pull requests and events, newest first; the page's Facts show under \"what we think this is\"; `target_status` is written by the scored report."
              }
            ]
          }
        ]
      },
      "children": []
    },
