    "b-sks-rc-wr-intro": {
      "id": "b-sks-rc-wr-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WORKER RUN — One "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row per traced engagement by a worker on a target, with "
        },
        {
          "insert": "final_outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " saying how it ended. What it tried is its "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, one per scored try. An external PR is never a "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": it is a "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row, its own ledger entry type. Outcomes live here — on "
        },
        {
          "insert": "worker_run.final_outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the submission scores — never on an "
        },
        {
          "insert": "event",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row; a closing run inserts nothing into "
        },
        {
          "insert": "event",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows are written once, at close, by the worker summary agent, and are immutable after capture; every later reference to a run (an "
        },
        {
          "insert": "event_ref",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row, an "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator) lives in another table. A run can propose live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows for the target but never writes them. Scoring and integration are orthogonal: a run can match at 100 % and still lose the merge race — "
        },
        {
          "insert": "integration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records which way the diff went, joined mechanically like the scores."
        }
      ],
      "children": []
    },
