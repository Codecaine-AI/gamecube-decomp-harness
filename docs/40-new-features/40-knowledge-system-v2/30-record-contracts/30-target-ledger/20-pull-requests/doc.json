    "b-sks-rc-prs-reconstruction": {
      "id": "b-sks-rc-prs-reconstruction",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The reconstruction story: the PR importer reads the PR's diff and discussion through the summary prompt and deduces what was tried — which functions changed, what idiom the change applied, what the scored report said before and after. One deduced "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " per target the PR touched; a PR touching several targets yields several "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. Discord is not imported this way: Discord material enters the system only as facts and evidence on entities, never as a ledger entry."
        }
      ],
      "children": []
    },
    "b-sks-rc-prs-outcome-note": {
      "id": "b-sks-rc-prs-outcome-note",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Enum "
