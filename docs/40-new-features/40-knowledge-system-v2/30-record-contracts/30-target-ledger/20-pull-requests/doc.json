    "b-sks-rc-prs-shape": {
      "id": "b-sks-rc-prs-shape",
      "type": "state-shape",
      "props": {
        "name": "pull_request",
        "description": "One reconstructed ledger entry per external PR per target. Immutable; no submission rows, no runtime provenance.",
        "fields": [
          {
            "name": "id",
            "type": "pull_request id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "description": "FK → target; the target the PR touched"
          },
          {
            "name": "pr_ref",
            "type": "string",
            "description": "The PR's number or URL in the PR archive; outside the knowledge store"
          },
          {
            "name": "summary",
            "type": "string",
            "description": "What the PR did to this target, deduced by the importer from the diff and discussion; a reconstruction, not a trace"
          },
          {
            "name": "outcome",
            "type": "match | improvement | no_change | error",
            "description": "Same enum as `worker_run.final_outcome`, judged from the PR's effect on the target"
          },
          {
            "name": "merged_at",
            "type": "timestamp",
            "description": "When the PR merged; orders the entry in the ledger view"
          }
        ],
        "example": "{\n  \"id\": \"pr-ftCo_800BFFD0-0003\",\n  \"target_id\": \"tgt-ftCo_800BFFD0\",\n  \"pr_ref\": \"melee#1482\",\n  \"summary\": \"Rewrote the guard branches around the damage-vector compare using __fabsf; the diff matches the pattern the discussion calls the float-compare idiom and took the function from 74.0 to 91.2 fuzzy\",\n  \"outcome\": \"improvement\",\n  \"merged_at\": \"2026-07-03T19:41:22Z\"\n}"
      },
      "children": []
    },
    "b-sks-rc-prs-shape-example-note-1": {
      "id": "b-sks-rc-prs-shape-example-note-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Reconstruction, labeled: "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the importer's deduction from the PR diff and discussion — the row never pretends a worker trace exists."
        }
      ],
      "children": []
    },
    "b-sks-rc-prs-shape-example-note-2": {
      "id": "b-sks-rc-prs-shape-example-note-2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "No "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows and no "
        },
        {
          "insert": "runtime_ref",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "worker_state_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": there are no run-state artifacts to point at."
