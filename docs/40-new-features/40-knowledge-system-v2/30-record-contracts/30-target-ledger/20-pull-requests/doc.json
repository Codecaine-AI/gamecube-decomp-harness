        {
          "insert": "pull_request.outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is "
        },
        {
          "insert": "worker_run.final_outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "'s enum, documented in Worker Runs: "
        },
        {
          "insert": "match",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "improvement",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "no_change",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "error",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It is judged from the scored report's before-and-after for the target, not from submissions."
        }
      ],
      "children": []
    },
