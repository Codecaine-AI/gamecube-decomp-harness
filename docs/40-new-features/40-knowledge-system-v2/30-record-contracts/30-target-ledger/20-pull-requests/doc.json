    "b-sks-rc-prs-intro": {
      "id": "b-sks-rc-prs-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "PULL REQUEST — One "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row per external PR that touched a target: a maintainer or contributor change, imported after the fact. The row is reconstructed — no worker trace exists, so the PR importer deduces what the PR did from its diff and discussion and writes one "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", honestly labeled as reconstruction. There are no "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows: scored tries belong to "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entries, and inventing them for a PR would fabricate a trace. Written once by the PR importer; immutable after capture."
        }
      ],
      "children": []
    },
