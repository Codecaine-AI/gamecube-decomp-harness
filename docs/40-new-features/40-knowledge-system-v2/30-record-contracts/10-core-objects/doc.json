    "b-sks-rc-core-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two core objects and one join. "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is mechanical: one row per GALE01 build-report item, every column written by reconciliation, the operational root everything hangs off — status, the target ledger, the queue — in a set only a new report can change. "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is curated: a meaning-only subject the report does not list — a file, a struct, a struct field, a parameter, a game concept, a pattern — admitted by the librarian, with nothing operational attached. "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " joins any subject to any subject, target or entity on either side, with a "
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a "
        },
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and an inline evidence pointer — a "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into a knowledge source. Everything debatable about either object is "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows on it, assembled by the knowledge-record view."
        }
      ],
      "id": "b-sks-rc-core-intro",
      "children": []
    },
