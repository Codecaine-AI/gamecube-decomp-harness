    "b-sks-rc-entities-param-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A parameter's identity is its position, never its name: the "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the function's "
        },
        {
          "insert": "stable_key",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus the ABI slot ("
        },
        {
          "insert": "main/melee/ft/ftcommon:ftCo_800BFFD0#r3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), and every name it has ever been given is an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact. The entity is joined to its function's "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row ("
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \"parameter\"); a parameter typed as a known struct gets an entity→entity "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the struct entity ("
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \"typed_as\"). Signature drift is handled with the lifecycle, not relocation: a parameter that stops existing is "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; two parameters that collapse into one struct pointer are "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the replacement. Local variables and return values are never entities — they have no stable identity across recompiles — and stay "
        },
        {
          "insert": "inferred_type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "data_flow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " facts on the function's "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-sks-rc-entities-param-body",
      "children": []
    },
