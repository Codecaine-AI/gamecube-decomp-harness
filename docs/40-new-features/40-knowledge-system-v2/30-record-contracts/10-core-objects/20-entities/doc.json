    "b-sks-rc-entities-names-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has no name column. The display name is an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact on the entity, carrying confidence, a rationale, and evidence like any other claim. Renaming a struct is a fact overwrite, never an identity change; the "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays."
        }
      ],
      "id": "b-sks-rc-entities-names-body",
      "children": []
    },
    "b-sks-rc-entities-merge-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Merge lifecycle"
        }
      ],
      "id": "b-sks-rc-entities-merge-heading",
      "children": []
    },
    "b-sks-rc-entities-merge-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no revisioning here: no revision counter, no "
        },
        {
          "insert": "supersedes_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A fact overwrite is the unit of change. The only identity transitions are "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — two rows turned out to be the same thing — and "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — the subject stopped existing, with no successor."
        }
      ],
      "id": "b-sks-rc-entities-merge-body",
      "children": []
    },
    "b-sks-rc-entities-merge-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Pick the winner. The loser's `identity_status` becomes `merged` and its `merged_into_id` points at the winner."
          },
          {
            "text": "Fold each of the loser's live facts into the winner as a normal fact overwrite; folding into an occupied type is still one overwrite of the winner's row."
          },
          {
            "text": "Re-point the loser's `link` rows so joins land on the winner; the tombstone keeps old references resolvable."
          },
          {
            "text": "Never delete the loser's row: anything that stored the loser's id still resolves through `merged_into_id`.",
            "kind": "note"
          }
        ]
      },
      "id": "b-sks-rc-entities-merge-process",
      "children": []
    },
    "b-sks-rc-entities-param-heading": {
      "type": "heading",
      "props": {
        "level": 2
