          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and resolves through "
        },
        {
          "insert": "merged_into_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; it is never deleted."
