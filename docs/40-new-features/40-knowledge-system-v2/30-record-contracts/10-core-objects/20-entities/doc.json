    "b-sks-rc-entities-shape": {
      "type": "state-shape",
      "props": {
        "name": "entity",
        "description": "Curated identity only: no name column, no meaning, no status, no revisioning.",
        "example": "{\n  \"id\": \"ent-tu-ftcommon\",\n  \"kind\": \"translation_unit\",\n  \"locator\": \"src/melee/ft/ftcommon.c\",\n  \"parent_entity_id\": null,\n  \"identity_status\": \"active\",\n  \"merged_into_id\": null\n}",
        "fields": [
          {
            "name": "id",
            "type": "entity id",
            "description": "Primary key"
          },
          {
            "name": "kind",
            "type": "translation_unit | struct | struct_field | game_concept | parameter | pattern",
            "description": "What sort of subject the `locator` pins"
          },
          {
            "name": "locator",
            "type": "string",
            "description": "Pins the identity; format depends on `kind` (see the enum table). One row per real thing"
          },
          {
            "name": "parent_entity_id",
            "type": "entity id",
            "required": false,
            "description": "FK → entity; containment — a `struct_field` points at its `struct`"
          },
          {
            "name": "identity_status",
            "type": "active | merged | retired",
            "description": "Whether the row is live, folded into another row, or gone with no successor"
          },
          {
            "name": "merged_into_id",
            "type": "entity id",
            "required": false,
            "description": "FK → entity; set when `identity_status` is `merged` — the winner the loser's facts were folded into"
          }
        ]
      },
      "id": "b-sks-rc-entities-shape",
      "children": []
    },
