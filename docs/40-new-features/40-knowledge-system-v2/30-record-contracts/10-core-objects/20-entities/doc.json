    "b-sks-rc-entities-kinds-split": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Four of the six kinds — "
        },
        {
          "insert": "translation_unit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct_field",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "parameter",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — are mechanical: auto-generated from the report and the checkout by reconciliation and the entity extractor, insert-if-missing only, never edited or retired by the extractor on its own. The two larger-idea kinds, "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", carry their own grounding and admission story — curated, librarian-written — and get their own child pages, Game Concepts and Patterns."
        }
      ],
      "id": "b-sks-rc-entities-kinds-split",
      "children": []
    },
