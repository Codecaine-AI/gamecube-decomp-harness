      "id": "b-sks-rc-fact-no-slots",
      "children": []
    },
    "b-sks-rc-fact-names-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Inferred-name safety: an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact is a guess about what the subject is called — like every fact, an inference. Any worker-facing projection (target card, search chunk, prompt context) must show it as a guess, with its "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and never as the canonical name. The "
        },
        {
          "insert": "symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column on "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays the only name a worker may write into source."
        }
      ],
      "id": "b-sks-rc-fact-names-body",
      "children": []
