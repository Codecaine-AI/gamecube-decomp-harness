    "b-sks-rc-fact-no-slots": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no "
        },
        {
          "insert": "invariant",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " type and no "
        },
        {
          "insert": "negative_semantic",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " type (both were list-valued facts on the retired "
        },
        {
          "insert": "knowledge_record",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " table). An invariant is just a confident "
        },
        {
          "insert": "state_behavior",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "purpose",
          "attributes": {
            "code": true
          }
