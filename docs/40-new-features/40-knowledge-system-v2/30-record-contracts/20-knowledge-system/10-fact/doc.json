      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the argument from those observations to the claim. Each evidence row's "
        },
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
