    "b-sks-overview-audit-p": {
      "id": "b-sks-overview-audit-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The current system is useful shared history search attached to a strong derived code graph, but it is not yet the intended expert memory. The audited ledger contains 20,189 records: 12,408 worker/live-history records, 5,574 past-PR records, 1,252 Discord records, 599 corroboration records, and 327 boundary operational records. Of 18,894 records citing attempt evidence, 17,370 cite only attempt evidence. Only 16 use wiki_section evidence, and 11 of those cite an actual SmashWiki section."
        }
      ],
      "children": []
    },
    "b-sks-overview-domains": {
      "id": "b-sks-overview-domains",
      "type": "structured-table",
      "props": {
        "columns": [
          "Domain",
          "Canonical contents",
          "Default worker use"
        ],
        "rows": [
          [
            "Semantic memory",
            "Evidence-backed beliefs about code and game meaning",
            "Target-first expert context"
          ],
          [
            "Attempt memory",
            "Observed goals, submissions, outcomes, and negative results",
            "Avoid repeated work and adapt successful moves"
          ],
          [
            "Operational history",
            "Run, boundary, queue, retry, and lifecycle events",
            "Excluded unless diagnosing orchestration"
          ],
          [
            "Knowledge sources",
            "Raw Discord, PR, wiki, attempt, and code material",
            "Resolved on demand behind evidence locators"
          ],
          [
            "Derived projections",
            "Graph entities and edges, search chunks, target cards, rankings, and dashboards",
            "Fast retrieval; never canonical truth"
          ]
        ]
      },
      "children": []
    },
    "b-sks-overview-flow": {
