      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Agents called"
        }
      ],
      "children": []
    },
    "b-ks2-path-event-agents-table": {
      "id": "b-ks2-path-event-agents-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Order",
          "Agent",
          "Does"
        ],
        "rows": [
          [
            "1",
            "Run-loop",
            [
              {
                "insert": "At the epoch boundary: inserts the "
              },
              {
                "insert": "regression",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " event row and its "
              },
              {
                "insert": "event_ref",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows ("
              },
              {
                "insert": "worker_run",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", "
              },
              {
                "insert": "epoch",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "); enqueues the event index task"
              }
            ]
          ],
          [
            "1",
            "Report reconciliation",
            [
              {
                "insert": "The upstream variant: inserts a "
              },
              {
                "insert": "regression",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " with a "
              },
              {
                "insert": "commit",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " ref when a new revision breaks a formerly matched target, and enqueues the same task; never an LLM"
              }
            ]
          ],
          [
            "2",
            "Librarian",
            [
              {
                "insert": "Consumes the task: re-examines the target's live "
              },
              {
                "insert": "fact",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows against the records the event's refs name, overwrites or re-cites, citing "
              },
              {
                "insert": "attempt://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " and "
              },
              {
                "insert": "pr://",
                "attributes": {
                  "code": true
                }
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-ks2-path-event-librarian-heading": {
      "id": "b-ks2-path-event-librarian-heading",
      "type": "heading",
      "props": {
