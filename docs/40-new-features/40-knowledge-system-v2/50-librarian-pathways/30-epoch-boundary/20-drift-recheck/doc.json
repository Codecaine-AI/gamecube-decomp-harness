    "b-ks2-path-drift-intro": {
      "id": "b-ks2-path-drift-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "DRIFT RECHECK — The code pathway ("
        },
        {
          "insert": "index_task.pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "drift_recheck",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Fires on a new report revision. Only code drifts: archival sources and attempt rows are immutable once ingested, so only "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators are ever re-resolved. Report reconciliation and the entity extractor run mechanically first; a "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence row that no longer resolves flags its facts, and the librarian re-cites or rewrites them. The flag never silently edits a fact."
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-agents-heading": {
      "id": "b-ks2-path-drift-agents-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Agents called"
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-agents-table": {
      "id": "b-ks2-path-drift-agents-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Order",
          "Agent",
          "Does"
        ],
        "rows": [
          [
            "1",
            "Report reconciliation",
            [
              {
                "insert": "Diffs the new revision against the stored "
              },
              {
                "insert": "target",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows; writes "
              },
              {
                "insert": "target",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " and "
              },
              {
                "insert": "target_status",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; re-resolves the live facts' "
              },
              {
                "insert": "code://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " locators and flags rows whose span or "
              },
              {
                "insert": "digest",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " no longer holds; enqueues the drift tasks. Never an LLM"
              }
            ]
          ],
          [
            "2",
            "Entity extractor",
            [
              {
                "insert": "Runs with reconciliation: deterministic extraction from the checkout at the revision; inserts missing "
              },
              {
                "insert": "file",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", "
              },
              {
                "insert": "struct",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", "
              },
              {
                "insert": "struct_field",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", and "
              },
              {
                "insert": "parameter",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " entity rows; never edits or retires an existing row on its own"
              }
            ]
          ],
          [
            "3",
            "Librarian",
            "Consumes the tasks: re-cites the flagged facts whose claims still hold at the new revision, rewrites or clears the rest"
          ]
        ]
      },
      "children": []
    },
    "b-ks2-path-drift-librarian-heading": {
      "id": "b-ks2-path-drift-librarian-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Librarian operation"
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-librarian-reads": {
      "id": "b-ks2-path-drift-librarian-reads",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian reads each flagged "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and its "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, then the checkout at the new revision through the graph surface — symbols, xrefs, grep; the only search code offers. Subjects are the targets and mechanical entities whose facts stand on flagged "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows; a fact whose other citations are archival or "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps those untouched — they cannot drift."
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-librarian-writes": {
      "id": "b-ks2-path-drift-librarian-writes",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "For each flagged fact: when the claim still holds, an ordinary overwrite re-cites it — "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows replaced wholesale with "
        },
        {
          "insert": "code://<revision>/<path>#L<start>-L<end>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators and fresh digests at the new revision; when it does not, the fact is rewritten or cleared. Drift itself never deletes knowledge: facts on a "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "unresolved",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " target stay stored, and a claim is never reattached to a guessed replacement for a drifted target."
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-coverage-heading": {
      "id": "b-ks2-path-drift-coverage-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Coverage"
        }
      ],
      "children": []
    },
    "b-ks2-path-drift-coverage-p": {
      "id": "b-ks2-path-drift-coverage-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "No source watermark moves — code is not a watermarked source, and the report revision itself is the position. Reconciliation enqueues one "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "drift_recheck",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " per subject whose facts carry flagged "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence, "
        },
        {
          "insert": "payload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " naming the subject. The librarian claims and completes by the task timestamps and stamps "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at pass completion. A flag whose task has no "
        },
        {
          "insert": "done_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is unprocessed drift — visible in the queue until the next pass clears it."
        }
      ],
      "children": []
    },
