    "b-ks2-path-epoch-intro": {
      "id": "b-ks2-path-epoch-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "EPOCH BOUNDARY — The boundary phase: fires when the epoch merges and the report rebuilds. Two pathways carry it. On the "
        },
        {
          "insert": "regression",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pathway, the run-loop or report reconciliation inserts a regression event and the librarian re-examines the affected targets' live facts — facts are never auto-invalidated. On the "
        },
        {
          "insert": "drift_recheck",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pathway, report reconciliation and the entity extractor run mechanically over the new report revision, and "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence that no longer resolves flags its facts for the librarian to re-cite or rewrite. Only code drifts; archival citations never do."
        }
      ],
      "children": []
    },
