    "b-ks2-path-wiki-intro": {
      "id": "b-ks2-path-wiki-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WIKI SYNC — The wiki half of the sync phase ("
        },
        {
          "insert": "index_task.pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "archival_ingest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the enum value is shared with the Discord sync, and the task payload names the source). Fires when the wiki importer inserts "
        },
        {
          "insert": "wiki_section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows at a new mirror revision — a mirror re-sync. Bulk and lower priority: no single target's ledger is waiting on it. The librarian searches the new sections and attaches facts to the subjects they mention, citing "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
