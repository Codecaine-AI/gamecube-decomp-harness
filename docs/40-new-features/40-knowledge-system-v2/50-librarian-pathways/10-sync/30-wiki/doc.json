      "children": []
    },
    "b-ks2-path-wiki-coverage-p": {
      "id": "b-ks2-path-wiki-coverage-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The wiki importer advances the "
        },
        {
          "insert": "wiki",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row of "
        },
        {
          "insert": "source_watermark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — "
        },
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the mirror revision; no other agent parses it — and enqueues "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows with "
        },
        {
          "insert": "pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "archival_ingest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " whose payloads name the newly mirrored sections — the payload, not the enum value, distinguishes this pathway from the Discord sync. These tasks queue behind the per-target pathways. Completion is by the task timestamps, and the pass stamps "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for each subject it covered — and a subject whose "
        },
        {
          "insert": "indexed_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " predates the new material still needs a pass even when no queue row names it."
        }
      ],
      "children": []
    },
