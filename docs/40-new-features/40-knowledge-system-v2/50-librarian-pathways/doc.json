    "b-ks2-path-state-intro": {
      "id": "b-ks2-path-state-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Coverage is tracked in three tables: "
        },
        {
          "insert": "source_watermark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records how far each source has been ingested, "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the queue between the enqueuing agents and the librarian, and "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the per-subject cursor. What still needs processing is derivable: queue rows without "
        },
        {
          "insert": "done_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", plus subjects whose "
        },
        {
          "insert": "indexed_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " predates relevant new material."
        }
      ],
      "children": []
    },
    "b-ks2-path-watermark-shape": {
      "id": "b-ks2-path-watermark-shape",
      "type": "state-shape",
      "props": {
        "name": "source_watermark",
        "description": "Draft for review — the shape is proposed, not settled. One row per source; written by that source's importer, or the worker summary agent for `attempt`.",
        "example": "{\n  \"source\": \"discord\",\n  \"position\": \"1123581321\",\n  \"updated_at\": \"2026-08-11T03:00:00Z\"\n}",
        "fields": [
          {
            "name": "source",
            "type": "enum: pr | discord | wiki | attempt",
            "description": "Primary key; one row per source"
          },
          {
            "name": "position",
            "type": "string",
            "description": "Opaque to everything but the writing agent: last message id or timestamp, PR number, mirror revision, run id"
          },
          {
            "name": "updated_at",
            "type": "timestamp",
            "description": "When the watermark last advanced"
          }
        ]
      },
      "children": []
    },
    "b-ks2-path-watermark-shape-example-note-1": {
      "id": "b-ks2-path-watermark-shape-example-note-1",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": here the last ingested "
        },
        {
          "insert": "discord_message.id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — the Discord importer compares its next export against this and appends only rows past it. No other agent parses the value."
        }
      ],
      "children": []
    },
    "b-ks2-path-task-shape": {
      "id": "b-ks2-path-task-shape",
      "type": "state-shape",
      "props": {
        "name": "index_task",
        "description": "Draft for review — the shape is proposed, not settled. The queue between the enqueuing agents and the librarian: written by the enqueuing agent, claimed and completed by the librarian. Status is derived from the timestamps — no status column.",
        "example": "{\n  \"id\": \"task-000482\",\n  \"pathway\": \"run_closed\",\n  \"payload\": \"attempt://run/rn-20260830-0114\",\n  \"enqueued_at\": \"2026-08-30T01:14:22Z\",\n  \"started_at\": \"2026-08-30T01:15:03Z\",\n  \"done_at\": null\n}",
        "fields": [
          {
            "name": "id",
            "type": "task id",
            "description": "Primary key"
          },
          {
            "name": "pathway",
            "type": "enum: run_closed | pr_imported | regression | archival_ingest | drift_recheck",
            "description": "Which pathway the task belongs to"
          },
          {
            "name": "payload",
            "type": "string",
            "description": "A locator or subject id naming what to index"
          },
          {
            "name": "enqueued_at",
            "type": "timestamp",
            "description": "Set by the enqueuing agent at insert"
          },
          {
            "name": "started_at",
            "type": "timestamp",
