        "description": "Draft for review — the shape is proposed, not settled. The per-subject cursor: when the librarian last completed a pass over this subject. Written by the librarian at pass completion. Exactly one of `target_id` and `entity_id` is set.",
        "example": "{\n  \"target_id\": \"main/melee/ft/ftcommon:ftCo_800BFFD0\",\n  \"entity_id\": null,\n  \"indexed_at\": \"2026-08-30T01:16:40Z\"\n}",
        "fields": [
          {
            "name": "target_id",
            "type": "target id",
            "description": "Set when the subject is a target; exclusive with `entity_id`",
            "required": false
          },
          {
            "name": "entity_id",
            "type": "entity id",
            "description": "Set when the subject is an entity; exclusive with `target_id`",
            "required": false
          },
          {
            "name": "indexed_at",
            "type": "timestamp",
            "description": "When the librarian last completed a pass over this subject"
          }
        ]
      },
      "children": []
