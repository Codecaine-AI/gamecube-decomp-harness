    "b-ks2-path-intro": {
      "id": "b-ks2-path-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "LIBRARIAN PATHWAYS — New material reaches the knowledge graph along inbound pathways grouped into three phases: sync — pull requests, Discord exports, wiki mirror syncs, material flowing in between runs; run — a worker run closes; and epoch boundary — the epoch merges and the report rebuilds. Each pathway names the agents that run and in what order, and each ends the same way: an "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the queue, claimed by the librarian. The librarian role — the event-driven librarian and its target-driven backfill counterpart — is the only writer of "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and curated entity rows. Everything upstream writes source or ledger rows and enqueues; nothing upstream touches the graph."
        }
      ],
      "children": []
    },
    "b-ks2-path-table-heading": {
      "id": "b-ks2-path-table-heading",
      "type": "heading",
      "props": {
        "level": 2
