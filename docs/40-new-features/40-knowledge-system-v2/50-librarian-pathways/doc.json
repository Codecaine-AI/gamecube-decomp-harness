    "b-ks2-path-table": {
      "id": "b-ks2-path-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Phase",
          "Pathway",
          "Trigger",
          "Agents called",
          "Librarian writes"
        ],
        "rows": [
          [
            "Sync",
            [
              {
                "insert": "pr_imported",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A pull request is imported",
            "PR importer, then the librarian",
            [
              {
                "insert": "Fact updates on the targets and files the diff touches, citing "
              },
              {
                "insert": "pr://",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Sync",
            [
              {
                "insert": "archival_ingest",
                "attributes": {
                  "code": true
                }
              }
            ],
            "The Discord or wiki importer appends rows past its watermark — one enum value, two pathways; the task payload names the source",
            "Discord or wiki importer, then the librarian",
            [
              {
                "insert": "Facts attached to the subjects the new material mentions; a curated "
              },
              {
                "insert": "game_concept",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " may be admitted when the material warrants it"
              }
            ]
          ],
          [
            "Run",
            [
              {
                "insert": "run_closed",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A worker run closes",
            "Worker summary agent, then the librarian",
            [
              {
                "insert": "Fact overwrites on the touched targets and entities, citing "
              },
              {
                "insert": "attempt://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; pattern facts for recurring resolution moves"
              }
            ]
          ],
          [
            "Epoch boundary",
            [
              {
                "insert": "regression",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A regression event is inserted — by the run-loop at an integration failure, or by report reconciliation on an upstream break",
            "Run-loop or report reconciliation, then the librarian",
            [
              {
                "insert": "Re-examined live facts on the affected targets — overwritten or re-cited, citing the records behind the event's refs ("
              },
              {
                "insert": "pr://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " / "
              },
              {
                "insert": "attempt://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "); events themselves are not citable"
              }
            ]
          ],
          [
            "Epoch boundary",
            [
              {
                "insert": "drift_recheck",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A new report revision",
            "Report reconciliation and the entity extractor, then the librarian",
            [
              {
                "insert": "Re-cited or rewritten facts whose "
              },
              {
                "insert": "code://",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " evidence no longer resolves"
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-ks2-path-roster-heading": {
