    "b-sks-worker-tool-table": {
      "id": "b-sks-worker-tool-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Surface",
          "Contract"
        ],
        "rows": [
          [
            "expert_context",
            "Return target-ranked semantic assertions, relations, attempts, uncertainty, and evidence pointers"
          ],
          [
            "semantic_search",
            "Search claims and aliases by entity, claim type, status, and confidence"
          ],
          [
            "attempt_search",
            "Search goals, mismatch signatures, outcomes, and negative evidence independently"
          ],
          [
            "evidence_get",
            "Resolve and return one evidence artifact with its locator and digest metadata"
          ],
          [
            "SmashWiki search/get",
            "Available to workers for mechanics questions and mapped into evidence artifacts when cited"
          ],
          [
            "graph walk",
            "Traverse current structural and accepted semantic relations without treating search chunks as truth"
          ]
        ]
      },
      "children": []
    },
