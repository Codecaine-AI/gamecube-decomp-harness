    "b-sks-worker-intro": {
      "id": "b-sks-worker-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A worker starts from one target and receives a compact expert card, not a ledger dump. The card combines current structural facts, accepted semantic assertions, clearly labeled hypotheses, prior attempts, patterns with their provenance, and unresolved questions. Evidence stays behind pointers until the worker needs it."
        }
      ],
      "children": []
    },
