    "b-sks-worker-safety-callout": {
      "id": "b-sks-worker-safety-callout",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Required enforcement",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "Prompt text alone is insufficient. The worker context labels internal aliases as non-source names, patch validation rejects knowledge-driven identifier or comment insertion when it violates the decomp policy, and review lint reports any attempted leak with the assertion id that influenced it."
        }
      ],
      "children": []
    },
    "b-sks-worker-librarian": {
      "id": "b-sks-worker-librarian",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian receives the complete worker attempt, existing assertions in scope, transcript evidence, and relevant evidence pointers. Its report is staged as separate assertion candidates, verdicts, and rejected records. Publication persists each category or records why it was discarded; no output category is counted and then dropped."
        }
      ],
      "children": []
    }
