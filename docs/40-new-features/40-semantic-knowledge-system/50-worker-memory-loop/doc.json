      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "CodebaseExpertCard"
        }
      ],
      "children": []
    },
    "b-sks-worker-card-shape": {
      "id": "b-sks-worker-card-shape",
      "type": "state-shape",
      "props": {
        "fields": [
          {
            "name": "target",
            "type": "current file, unit, function, match, and editability identity"
          },
          {
            "name": "observed_behavior",
            "type": "accepted observed semantic assertions"
          },
          {
            "name": "likely_meaning",
            "type": "accepted or disputed inferred assertions with confidence"
          },
          {
            "name": "internal_aliases",
            "type": "read-only inferred names and roles"
          },
          {
            "name": "relationships",
            "type": "structural and semantic one-hop relations"
          },
          {
            "name": "attempt_memory",
            "type": "prior submissions and negative results"
          },
          {
            "name": "game_grounding",
            "type": "accepted game mappings and SmashWiki pointers"
          },
          {
            "name": "uncertainties",
            "type": "disputes, stale claims, and missing knowledge"
          },
          {
            "name": "evidence_pointers",
            "type": "ids for targeted follow-up retrieval"
          }
        ],
        "name": "CodebaseExpertCard"
      },
      "children": []
    },
    "b-sks-worker-retrieval": {
