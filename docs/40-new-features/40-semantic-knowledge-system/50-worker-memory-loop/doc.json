    "b-sks-worker-retrieval-process": {
      "id": "b-sks-worker-retrieval-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Resolve the target and load its expert card"
          },
          {
            "text": "Read semantic assertions before broad keyword search"
          },
          {
            "text": "Read prior attempts when choosing or avoiding a move"
          },
          {
            "text": "Fetch exact evidence for uncertain, disputed, or decision-changing claims"
          },
          {
            "text": "Expand to graph neighbors, analogs, PRs, or SmashWiki only when the target question requires them"
          }
        ]
      },
      "children": []
    },
