        {
          "insert": "Feature Scope"
        }
      ],
      "children": []
    },
    "b-sks-overview-goals": {
      "id": "b-sks-overview-goals",
      "type": "structured-table",
      "props": {
        "columns": [
          "Goal",
          "Required result"
        ],
        "rows": [
          [
            "Expert code understanding",
            "A worker can ask what a target likely does and receive anchored claims about purpose, data flow, state, fields, variables, and game meaning."
          ],
          [
            "Attempt memory",
            "Tactics, checkpoints, failures, partial improvements, and negative evidence remain reusable without masquerading as semantic facts."
          ],
          [
            "Safe inferred names",
            "Likely names and roles are stored as internal hypotheses tied to decomp identifiers; AI workers never write those names into source."
          ],
          [
            "Traceable truth",
            "Every accepted claim resolves to evidence, records its epistemic basis, and becomes stale when its current-code anchor drifts."
          ],
          [
            "Rebuildable retrieval",
            "Graph edges, target cards, FTS, rankings, and dashboard projections can be deleted and recreated from canonical inputs."
          ]
        ]
      },
      "children": []
    },
    "b-sks-overview-audit": {
      "id": "b-sks-overview-audit",
      "type": "heading",
