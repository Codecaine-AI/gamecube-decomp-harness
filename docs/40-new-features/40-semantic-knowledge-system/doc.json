    },
    "b-sks-overview-process": {
      "id": "b-sks-overview-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Resolve the worker target to stable file, unit, function, field, variable, and game-concept entities"
          },
          {
            "text": "Load a compact expert card containing accepted assertions, disputed hypotheses, useful attempts, and knowledge gaps"
          },
          {
            "text": "Chase code, assembly, graph, PR, attempt, or SmashWiki evidence only when the task needs detail"
          },
          {
            "text": "Record the attempt outcome separately from new semantic candidates"
          },
          {
            "text": "Validate, review, and publish semantic candidates; rebuild affected projections for later workers"
          }
        ]
      },
      "children": []
    },
