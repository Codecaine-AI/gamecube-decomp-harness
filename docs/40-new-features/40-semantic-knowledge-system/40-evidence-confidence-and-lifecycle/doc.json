    "b-sks-lifecycle-process": {
      "id": "b-sks-lifecycle-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Candidate",
            "steps": [
              {
                "text": "A worker, librarian, human, or importer proposes an anchored claim with evidence"
              }
            ]
          },
          {
            "text": "Accepted or disputed",
            "steps": [
              {
                "text": "Validation resolves evidence; review accepts one interpretation or preserves competing interpretations"
              }
            ]
          },
          {
            "text": "Refuted",
            "steps": [
              {
                "text": "Contradicting evidence defeats the claim; the record remains searchable as a known dead end"
              }
            ]
          },
          {
            "text": "Stale",
            "steps": [
              {
                "text": "The anchor, content hash, source version, or evidence locator no longer matches current inputs"
              }
            ]
          },
          {
            "text": "Graduated",
            "steps": [
              {
                "text": "A human-owned canonical source makes the claim redundant; the knowledge record keeps lineage without driving retrieval"
              }
            ]
          }
        ]
      },
      "children": []
    },
