    },
    "b-sks-lifecycle-revisions-p": {
      "id": "b-sks-lifecycle-revisions-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Assertions are logical records with append-only revisions. A correction, confidence change, verdict, new evidence set, or status transition appends a revision and names the superseded revision. Reconciliation rechecks anchors and evidence against current inputs. It changes the effective status to stale through a recorded revision; it never guesses a replacement symbol or silently reattaches a claim."
        }
      ],
      "children": []
    }
