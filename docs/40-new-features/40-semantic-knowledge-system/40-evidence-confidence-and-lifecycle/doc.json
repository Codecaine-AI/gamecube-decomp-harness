    "b-sks-lifecycle-intro": {
      "id": "b-sks-lifecycle-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Confidence is a judgment about a specific claim, not a substitute for evidence. Publication requires resolvable evidence, a current subject anchor, a declared epistemic basis, and a lifecycle transition recorded by the governing reviewer or importer."
        }
      ],
      "children": []
    },
