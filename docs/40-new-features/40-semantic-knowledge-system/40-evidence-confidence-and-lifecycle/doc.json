        }
      ],
      "children": []
    },
    "b-sks-lifecycle-gate-table": {
      "id": "b-sks-lifecycle-gate-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Gate",
          "Required behavior"
        ],
        "rows": [
          [
            "Shape",
            [
              {
                "insert": "All required fields and enumerated values validate; exactly one of "
              },
              {
                "insert": "target_id",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " and "
              },
              {
                "insert": "entity_id",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " is set"
              }
            ]
          ],
          [
            "Anchor",
            "The subject row exists; a claim is never reattached to a guessed replacement for a drifted target"
          ],
          [
            "Evidence",
            [
              {
                "insert": "Every cited "
              },
              {
                "insert": "evidence",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " id resolves and its digest matches; a citation that fails resolution blocks the write"
              }
            ]
          ],
          [
            "Support",
            [
              {
                "insert": "The cited evidence pins what was seen; the "
              },
              {
                "insert": "rationale",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " must argue from those observations to the "
              },
              {
                "insert": "value",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Deduplication",
            [
              {
                "insert": "A changed claim overwrites its row rather than adding a neighbour; multiple live rows per subject and "
              },
              {
                "insert": "slot",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " only when the claims are genuinely distinct"
              }
            ]
          ],
          [
            "Naming policy",
            [
              {
                "insert": "An "
              },
              {
                "insert": "inferred_name",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " fact is a guess and every worker-facing projection shows it as one, with its confidence; the "
              },
              {
                "insert": "symbol",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " column on "
              },
              {
                "insert": "target",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " stays the only name a worker may write into source"
              }
            ]
          ]
        ]
      },
      "children": []
    },
    "b-sks-lifecycle-revisions": {
      "id": "b-sks-lifecycle-revisions",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Drift, Reconciliation, and Regressions"
        }
      ],
      "children": []
    },
    "b-sks-lifecycle-revisions-p": {
      "id": "b-sks-lifecycle-revisions-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Facts hang off subjects, and the report-derived subjects move. Reconciliation diffs each new report revision against the stored "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows by "
        },
        {
          "insert": "stable_key",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "address",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and moves "
        },
        {
          "insert": "identity_status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only through explicit rules — "
        },
        {
          "insert": "current",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "moved",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "unresolved",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A vanished item is never deleted and never reattached to a guessed symbol. A changed "
        },
        {
          "insert": "target_status.content_hash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alone is status, not identity: it never moves "
        },
        {
          "insert": "identity_status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", but it is reconciliation's cue to recheck what was pinned against the old content."
        }
      ],
      "children": []
    },
    "b-sks-lifecycle-drift-facts-p": {
      "id": "b-sks-lifecycle-drift-facts-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "That recheck runs over the target's live facts: "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows whose "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " no longer resolves are flagged, so the next revision drops or re-cites the facts whose "
        },
        {
          "insert": "evidence_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " relied on them. The flag never silently edits a fact — a drop or a re-cite is an ordinary librarian overwrite or clear, with the prior version appended to "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Drift never deletes knowledge: facts on a "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "unresolved",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " target stay stored with their history."
        }
      ],
      "children": []
    },
    "b-sks-lifecycle-regressions-p": {
      "id": "b-sks-lifecycle-regressions-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Regressions are ledger entries, not knowledge. When an upstream change or a boundary merge conflict breaks a formerly good state, the run loop or checkout reconciliation inserts an "
        },
        {
          "insert": "event",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row ("
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "regression",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") with "
        },
        {
          "insert": "event_ref",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows naming the commit, epoch, PR, or worker run involved; its summary is addressed to the next worker, who sees it first in the derived ledger view. The facts on the target do not change because the score did — the librarian revises a fact only when the claim about meaning changes — and the regression can be cited as evidence but never speaks as a fact."
        }
      ],
      "children": []
    },
