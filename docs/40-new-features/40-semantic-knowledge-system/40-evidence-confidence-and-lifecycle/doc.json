    "b-sks-lifecycle-process": {
      "id": "b-sks-lifecycle-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Derived",
            "steps": [
              {
                "text": "The librarian derives a claim while indexing new material — a closed worker run, an imported PR, wiki or Discord material — and drafts `value`, `rationale`, `confidence`, and the evidence citations"
              }
            ]
          },
          {
            "text": "Written",
            "steps": [
              {
                "text": "The resolver checks every cited `evidence` id; the claim becomes a live `fact` row under one subject and `slot`"
              }
            ]
          },
          {
            "text": "Revised",
            "steps": [
              {
                "text": "A changed claim overwrites the live row in place; the prior version is appended to `fact_history` in the same write"
              }
            ]
          },
          {
            "text": "Cleared",
            "steps": [
              {
                "text": "A claim no longer believed is cleared; its final version lands in `fact_history`, which nothing edits or deletes"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-sks-lifecycle-process-note": {
      "id": "b-sks-lifecycle-process-note",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no candidate queue, no dispute state, and no refuted record: a claim either is a live fact or it is history. A tested interpretation that did not work never becomes a fact — it lives on the ledger side, in "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " hypothesis and outcome columns, and can be cited as "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence when a later claim leans on it."
        }
      ],
      "children": []
    },
    "b-sks-lifecycle-gates": {
      "id": "b-sks-lifecycle-gates",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
