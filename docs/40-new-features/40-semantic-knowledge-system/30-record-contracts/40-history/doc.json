    "b-sks-rc-history-shape": {
      "type": "state-shape",
      "props": {
        "name": "history_entry",
        "description": "Append-only: a row is never edited or removed.",
        "fields": [
          {
            "name": "id",
            "type": "history_entry id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "description": "FK → target; whose ledger"
          },
          {
            "name": "at",
            "type": "timestamp",
            "description": "Ledger order"
          },
          {
            "name": "kind",
            "type": "attempt | invalidated | merged | upstream_change | note"
          },
          {
            "name": "outcome",
            "type": "improved | unchanged | regressed | matched | invalidated"
          },
          {
            "name": "attempt_id",
            "type": "attempt id",
            "required": false,
            "description": "FK → attempt; required for `attempt` and `invalidated`, optional for `merged` and `note`, absent for `upstream_change`"
          },
          {
            "name": "summary",
            "type": "string",
            "description": "One line, shown on the card"
          }
        ]
      },
      "id": "b-sks-rc-history-shape",
      "children": []
    },
