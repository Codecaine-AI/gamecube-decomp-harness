      "children": []
    },
    "b-sks-rc-history-example-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The attempt closes at 100 % match",
            "steps": [
              {
                "text": "The summary agent inserts `attempt` A for target X, then `history_entry` H1 (`target_id` X, `kind` `attempt`, `attempt_id` A, `outcome` `matched`, `summary` \"inlined the guard; 71 % → 100 %\") and `history_ref` (H1, `attempt`, A)."
              }
            ]
          },
          {
            "text": "The boundary merge conflicts on X's file",
            "steps": [
              {
                "text": "The run-loop inserts `history_entry` H2 (`target_id` X, `kind` `invalidated`, `attempt_id` A, `outcome` `invalidated`, `summary` \"boundary merge conflicted on ftcommon.c; A's code is not in the tree\") and `history_ref` rows (H2, `attempt`, A) and (H2, `epoch`, epoch 9)."
              },
              {
                "text": "The conflicted hunks, the queue state, and the retry are run state, not rows here.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The scored report upserts `target_status` for X: `match_pct` 100, `linked` false, `last_attempt_id` A."
          },
          {
            "text": "The next worker reads X's history first",
            "steps": [
              {
                "text": "Newest row: H2, `invalidated`, pointing at A and the boundary. It opens A's `attempt_step` rows, takes the working code, and blends it into the current tree instead of re-deriving it.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The librarian reads A, H1, and H2; if the conflict revealed reusable knowledge, it writes the next `knowledge_record` revision for X with a `tactic_use` row naming A and a `fact_extra` (`slot` `invariant`) about why the match was fragile. H1 and H2 stay as they are."
          }
        ]
      },
      "id": "b-sks-rc-history-example-process",
      "children": []
    },
