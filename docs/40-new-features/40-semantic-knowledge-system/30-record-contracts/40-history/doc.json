    "b-sks-rc-history-projection": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker-facing projection of a target shows the history FIRST, newest row at the top, with "
        },
        {
          "insert": "invalidated",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows highlighted. A row is one line: "
        },
        {
          "insert": "at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and its "
        },
        {
          "insert": "history_ref",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ids; the worker follows "
        },
        {
          "insert": "attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "attempt_step",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows when it needs the checkpoints. Storing a row does not make it knowledge: what the attempt taught becomes a "
