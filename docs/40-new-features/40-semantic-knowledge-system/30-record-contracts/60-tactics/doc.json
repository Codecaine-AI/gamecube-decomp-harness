    "b-sks-rc-tactics-shape": {
      "type": "state-shape",
      "props": {
        "name": "tactic",
        "description": "Global. No embedded uses, patterns, or success_rate: uses are tactic_use rows, patterns are pattern_tactic rows, success_rate is a query.",
        "fields": [
          {
            "name": "id",
            "type": "tactic id",
            "description": "Primary key; global, not scoped to a target; one per revision"
          },
          {
            "name": "name",
            "type": "string",
            "description": "Short, human-readable, imperative"
          },
          {
            "name": "summary",
            "type": "string",
            "description": "The move in one paragraph"
          },
          {
            "name": "when",
            "type": "string",
            "description": "Precondition: what the diff, mismatch, or situation looks like"
          },
          {
            "name": "do",
            "type": "string",
            "description": "The steps, in the worker's terms"
          },
          {
            "name": "origin_attempt_id",
            "type": "attempt id",
            "description": "FK → attempt; where the tactic was first minted. The target is `attempt.target_id`"
          },
          {
            "name": "confidence",
            "type": "number 0..1",
            "description": "How sure we are the `when` and `do` are right"
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "updated_by",
            "type": "librarian | human"
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "supersedes_id",
            "type": "tactic id",
            "required": false,
            "description": "FK → tactic; the previous revision; absent on revision 1"
          }
        ]
      },
      "id": "b-sks-rc-tactics-shape",
      "children": []
    },
