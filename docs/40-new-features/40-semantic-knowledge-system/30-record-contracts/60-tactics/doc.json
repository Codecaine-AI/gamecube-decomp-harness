      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Open questions",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "- Naming: \"tactic\" or \"technique\". Tactic is kept because "
        },
        {
          "insert": "tactic_use",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the derived tactics view already use the word; technique would separate the global idea from the per-attempt step more clearly.\n- How "
        },
        {
          "insert": "success_rate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " handles "
        },
        {
          "insert": "partial",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows: count a partial as 0, as 0.5, or report "
        },
        {
          "insert": "worked",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "partial",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "failed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as three rates and let the card decide."
        }
      ],
      "id": "b-sks-rc-tactics-open",
      "children": []
