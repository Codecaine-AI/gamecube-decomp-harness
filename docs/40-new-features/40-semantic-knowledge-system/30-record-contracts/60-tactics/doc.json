    "b-sks-rc-tactics-example-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example — a scheduling fix becomes a tactic and is reused"
        }
      ],
      "id": "b-sks-rc-tactics-example-heading",
      "children": []
    },
    "b-sks-rc-tactics-example-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "A worker fixes a scheduling mismatch",
            "steps": [
              {
                "text": "On ftCo_Attack100 the diff shows two stores in the wrong order. The worker reorders the two assignments in source; the checkpoint scores 94 % → 100 %."
              }
            ]
          },
          {
            "text": "The summary agent reports it",
            "steps": [
              {
                "text": "It inserts `attempt` A (`target_id` ftCo_Attack100) and an `attempt_step` row: `description` \"swapped the two field stores before the call\", `outcome` `success`, its `checkpoint_id`. Its proposal says no existing tactic matched and describes the move."
              }
            ]
          },
          {
            "text": "The librarian mints the tactic",
            "steps": [
              {
                "text": "No `tactic` row has a `when` that matches, so it inserts `tactic` T revision 1: `name` \"reorder adjacent stores\", `when` \"two stores to the same struct appear swapped in the diff\", `do` \"swap the two assignments in source; re-score\", `origin_attempt_id` A, `confidence` 0.9. It inserts `tactic_use` (T, A, `worked`)."
              },
              {
                "text": "T names A through `origin_attempt_id`; A itself is not written to. ftCo_Attack100's knowledge page shows the use through the derived tactics view, not through a column of its own.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "A later attempt on another target uses it",
            "steps": [
              {
                "text": "A worker on ftCo_AttackS3 searches tactics by `when`, finds T, applies the steps, and gets a partial improvement. Its summary agent inserts `attempt` B with a step of `outcome` `partial`, and its proposal names T."
              },
              {
                "text": "The librarian inserts `tactic_use` (T, B, `partial`). `success_rate` for T is now computed from two rows; nothing on T changed, so no new revision is written."
              }
            ]
          }
        ]
      },
      "id": "b-sks-rc-tactics-example-process",
      "children": []
    },
