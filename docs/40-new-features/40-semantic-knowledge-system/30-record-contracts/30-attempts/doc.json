    "b-sks-rc-attempts-minting": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Minting: when a step did something reusable that no existing "
        },
        {
          "insert": "tactic.when",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " matches, the librarian inserts a new "
        },
        {
          "insert": "tactic",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row whose "
        },
        {
          "insert": "origin_attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names this attempt, plus a "
        },
        {
          "insert": "tactic_use",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row for this attempt with the step's mapped "
        },
        {
          "insert": "outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". When a step applied an existing tactic, the librarian inserts only the "
        },
        {
          "insert": "tactic_use",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row. The attempt is never written to; the summary agent's proposal names the tactic candidate, and the librarian never invents a "
        },
        {
          "insert": "tactic_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " the table does not hold."
        }
      ],
      "id": "b-sks-rc-attempts-minting",
      "children": []
    },
