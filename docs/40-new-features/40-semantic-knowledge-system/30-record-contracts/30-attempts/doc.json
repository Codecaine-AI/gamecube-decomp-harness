    "b-sks-rc-attempts-step-shape": {
      "type": "state-shape",
      "props": {
        "name": "attempt_step",
        "description": "One row per real checkpoint. Formerly the tactics list embedded on the attempt record; a step is not a tactic.",
        "fields": [
          {
            "name": "id",
            "type": "attempt_step id",
            "description": "Primary key"
          },
          {
            "name": "attempt_id",
            "type": "attempt id",
            "description": "FK → attempt"
          },
          {
            "name": "checkpoint_id",
            "type": "string",
            "description": "The worker checkpoint that observed the step; a runtime object outside the knowledge store; must be real"
          },
          {
            "name": "description",
            "type": "string",
            "description": "What the worker tried"
          },
          {
            "name": "hypothesis",
            "type": "string",
            "required": false,
            "description": "The explanation the step tested; anything the transcript claimed but no checkpoint proved"
          },
          {
            "name": "outcome",
            "type": "failed | neutral | partial | success",
            "description": "Result at that checkpoint; must agree with the checkpoint's score delta"
          },
          {
            "name": "effects",
            "type": "score, mismatch, regression, and hard-gate results",
            "description": "Copied from the checkpoint verbatim"
          }
        ]
      },
      "id": "b-sks-rc-attempts-step-shape",
      "children": []
    },
