    "b-sks-rc-attempts-use-shape": {
      "type": "state-shape",
      "props": {
        "name": "tactic_use",
        "description": "Join: the tactics used on an attempt. (tactic_id, attempt_id) is the PK. Written by the librarian, not the summary agent.",
        "fields": [
          {
            "name": "tactic_id",
            "type": "tactic id",
            "description": "FK → tactic; the global tactic used"
          },
          {
            "name": "attempt_id",
            "type": "attempt id",
            "description": "FK → attempt; this attempt"
          },
          {
            "name": "outcome",
            "type": "worked | partial | failed",
            "description": "Mapped from the outcome of the step that applied the tactic"
