    "b-sks-rc-attempts-shape": {
      "type": "state-shape",
      "props": {
        "name": "attempt",
        "description": "Immutable after capture. No embedded steps, tactics, or evidence: those are attempt_step, tactic_use, and source rows.",
        "fields": [
          {
            "name": "id",
            "type": "attempt id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "description": "FK → target; the one target the attempt worked on"
          },
          {
            "name": "origin_kind",
            "type": "worker_run | pull_request | discord_thread"
          },
          {
            "name": "goal",
            "type": "string",
            "description": "What the attempt set out to do"
          },
          {
            "name": "baseline",
            "type": "score and validation refs",
            "description": "Copied from the runtime before the first step"
          },
          {
            "name": "final_outcome",
            "type": "failed | partial | success | abandoned",
            "description": "Must agree with the score delta from `baseline` to the final checkpoint"
          },
          {
            "name": "run_id",
            "type": "string",
            "required": false,
            "description": "Runtime provenance; required for `worker_run`"
          },
          {
            "name": "worker_state_id",
            "type": "string",
            "required": false,
            "description": "Runtime provenance; required for `worker_run`"
          },
          {
            "name": "started_at",
            "type": "timestamp"
          },
          {
            "name": "ended_at",
            "type": "timestamp",
            "required": false
          }
        ]
      },
      "id": "b-sks-rc-attempts-shape",
      "children": []
    },
