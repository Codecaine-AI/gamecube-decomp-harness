    "b-sks-rc-attempts-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "ATTEMPT — One "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row per thing we made and tried on a target: a worker run, a PR, or a Discord try, with "
        },
        {
          "insert": "origin_kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " saying which and "
        },
        {
          "insert": "final_outcome",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " saying how it ended. What it tried is its "
        },
        {
          "insert": "attempt_step",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, one per real checkpoint; this table is the old embedded tactics list, renamed so that "
        },
        {
          "insert": "tactic",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " means only the global table. Which global tactics the attempt used, and how each went, are "
        },
        {
          "insert": "tactic_use",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. The "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "attempt_step",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows are written once, at the end, by a worker summary agent, and are immutable after capture; every later link to an attempt ("
        },
        {
          "insert": "history_entry.attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tactic_use.attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tactic.origin_attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "target_status.last_attempt_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") lives in another table. An attempt can propose facts for the target's "
        },
        {
          "insert": "knowledge_record",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " but never writes it. When the agent writes the attempt it also inserts one "
        },
        {
          "insert": "history_entry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the target."
        }
      ],
      "id": "b-sks-rc-attempts-intro",
      "children": []
    },
