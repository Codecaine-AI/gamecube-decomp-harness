    "b-sks-rc-attempts-proposal-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example — proposed facts and the next revision"
        }
      ],
      "id": "b-sks-rc-attempts-proposal-heading",
      "children": []
    },
    "b-sks-rc-attempts-proposal-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The summary agent writes and proposes",
            "steps": [
              {
                "text": "Inserts the `attempt` row, its `attempt_step` rows (one per checkpoint), and the target's `history_entry` (`kind` `attempt`, `outcome` from the score delta) with its `history_ref`."
              },
              {
                "text": "For each reusable thing the attempt learned, its proposal carries a proposed `Fact` (`value`, slot, `basis`, and the code-span or checkpoint sources behind it) and, per step, the `tactic.id` it applied or a description of the new move."
              },
              {
                "text": "The proposal is input for the librarian, not a row. The attempt is complete and immutable from here.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The librarian reads the attempt",
            "steps": [
              {
                "text": "Reads the `attempt` and `attempt_step` rows, the proposal, the live `knowledge_record` for `attempt.target_id`, and the target's `history_entry` rows."
              },
              {
                "text": "May add Facts of its own, or search the code graph for `related_target` candidates; all of it lands in the same revision. The attempt does not change.",
                "kind": "note"
              },
              {
                "text": "For each step: if the proposal names a `tactic.id`, inserts `tactic_use` (that tactic, this attempt, mapped `outcome`); if it describes a reusable new move, inserts a `tactic` row with `origin_attempt_id` = this attempt and a `tactic_use` row for it."
              },
              {
                "text": "A librarian verdict that a step ruled an interpretation out becomes a `fact_extra` row with `slot` `negative_semantic`, whose `fact_source` cites the step's checkpoint `source`."
              }
            ]
          },
          {
            "text": "Revision N+1 of the `knowledge_record` is written",
            "steps": [
              {
                "text": "A new `knowledge_record` row with `supersedes_id` = N: Facts added, reworded, or cleared; `fact_source` rows inserted for every new citation."
              },
              {
                "text": "An attempt outcome never becomes a Fact by itself; only a written claim on the page does.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The card is rebuilt",
            "steps": [
              {
                "text": "The history shows first, newest row at the top; the page's `summary` and Facts show under \"what we think this is\"; the attempt is ranked under \"what was tried\"; `target_status` is written by the scored report."
              }
            ]
          }
        ]
      },
      "id": "b-sks-rc-attempts-proposal-process",
      "children": []
    },
