            "description": "The prior version's claim, verbatim"
          },
          {
            "name": "rationale",
            "type": "string",
            "description": "The prior version's argument, verbatim"
          },
          {
            "name": "confidence",
            "type": "number 0..1",
            "description": "The prior version's confidence"
          },
          {
            "name": "evidence_ids",
            "type": "evidence id[]",
            "description": "The prior version's pinned observations"
          },
          {
            "name": "updated_at",
            "type": "timestamp",
            "description": "When the prior version had been written"
          }
        ]
      },
      "id": "b-sks-rc-fact-history-shape",
      "children": []
    },
