    "b-sks-rc-fact-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "FACT — The atom of knowledge. One "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row per live claim: a one-sentence "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " about exactly one subject — a "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or an "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — filed under a "
        },
        {
          "insert": "slot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", weighted by "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", argued through "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and pinned to its observations through "
        },
        {
          "insert": "evidence_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The live row is overwritten in place when the claim changes, and every overwrite appends the prior version to "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the same write. What we currently think is the set of live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows; how we got here is "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The assembled page of one subject's live facts is the knowledge record — a derived view, not a table."
        }
      ],
      "id": "b-sks-rc-fact-intro",
      "children": []
    },
    "b-sks-rc-fact-epistemology": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every fact is AI-inferred. The game is not decompiled; nothing in this system is ground truth, so there is no observed-versus-inferred category on a claim — "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alone carries how sure we are. Upstream names that are not random hex are treated as likely directionally correct; that belief also lives in "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not in a category. What a claim stands on is explicit instead: "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the claim, "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the deriving agent's argument for it, and "
        },
        {
          "insert": "evidence_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are the pinned observations the argument stands on."
        }
      ],
      "id": "b-sks-rc-fact-epistemology",
      "children": []
    },
    "b-sks-rc-fact-writer-invariant": {
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Invariant — one writer, same-write history",
        "tone": "success"
      },
      "text": [
        {
          "insert": "The librarian is the only writer of "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; humans do not edit facts. There is no "
        },
        {
          "insert": "updated_by",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column anywhere in the knowledge system — provenance lives in the cited "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows and the "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not in a byline. An overwrite or clear of a live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row and the append of its prior version to "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " happen in the same write; a history row never appears on its own."
        }
      ],
      "id": "b-sks-rc-fact-writer-invariant",
      "children": []
    },
    "b-sks-rc-fact-shape-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        }
      ],
      "id": "b-sks-rc-fact-shape-heading",
      "children": []
    },
    "b-sks-rc-fact-shape-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Exactly one of "
        },
        {
          "insert": "target_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "entity_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is set: a fact is about a report item or about a curated subject, never both, never neither. Multiple live rows per (subject, "
        },
        {
          "insert": "slot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") are allowed when the claims are genuinely distinct; the normal shape is one live row per claim, and a changed claim overwrites its row rather than adding a neighbour."
        }
      ],
      "id": "b-sks-rc-fact-shape-body",
      "children": []
    },
    "b-sks-rc-fact-shape": {
      "type": "state-shape",
      "props": {
        "name": "fact",
        "description": "One row per live claim. Overwritten in place; prior versions are `fact_history` rows.",
        "example": "{\n  \"id\": \"fact-01j9x2\",\n  \"target_id\": \"tgt-ftco-800bffd0\",\n  \"entity_id\": null,\n  \"slot\": \"purpose\",\n  \"value\": \"Applies knockback decay to the fighter's velocity each frame while in hitstun.\",\n  \"rationale\": \"The loop scales vel.x and vel.y by the same decay constant the hitstun state dispatch loads; the unit sits in the ftCommon group and the only caller is the hitstun handler.\",\n  \"confidence\": 0.8,\n  \"evidence_ids\": [\"ev-9f2ac41d\", \"ev-1b77e0aa\"],\n  \"updated_at\": \"2026-08-12T04:31:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "fact id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "required": false,
            "description": "The subject when the claim is about a report item; exactly one of `target_id` and `entity_id` is set"
          },
          {
            "name": "entity_id",
            "type": "entity id",
            "required": false,
            "description": "The subject when the claim is about a curated subject (file, struct, struct field, game concept, parameter, pattern)"
          },
          {
            "name": "slot",
            "type": "purpose | inferred_name | inferred_type | data_flow | state_behavior | game_mapping",
            "description": "Which kind of claim this is"
          },
          {
            "name": "value",
            "type": "string",
            "description": "The claim, one sentence"
          },
          {
            "name": "rationale",
            "type": "string",
            "description": "The deriving agent's argument from the cited evidence to the value, addressed to the next reader"
          },
          {
            "name": "confidence",
            "type": "number 0..1",
            "description": "How sure we are of this claim"
          },
          {
            "name": "evidence_ids",
            "type": "evidence id[]",
            "description": "One or more `evidence` rows the rationale stands on; the resolver checks each before the row is written"
          },
          {
            "name": "updated_at",
            "type": "timestamp",
            "description": "When this row was last written"
          }
        ]
      },
      "id": "b-sks-rc-fact-shape",
      "children": []
    },
    "b-sks-rc-fact-shape-example-note-1": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "target_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " set, "
        },
        {
          "insert": "entity_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " null: the claim is about a report item; the two subject keys are never both set."
        }
      ],
      "id": "b-sks-rc-fact-shape-example-note-1",
      "children": []
    },
    "b-sks-rc-fact-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "evidence_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": two pinned observations — here a "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " span and a "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " message — both resolved by the resolver before the write."
        }
      ],
      "id": "b-sks-rc-fact-shape-example-note-2",
      "children": []
    },
    "b-sks-rc-fact-shape-example-note-3": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the argument from those observations to the claim. The evidence pins what was seen; the rationale says why it supports the "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-sks-rc-fact-shape-example-note-3",
      "children": []
    },
    "b-sks-rc-fact-slots-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Enum "
        },
        {
          "insert": "fact.slot",
