            "name": "id",
            "type": "history id",
            "description": "Primary key"
          },
          {
            "name": "fact_id",
            "type": "fact id",
            "description": "The live row this version belonged to"
          },
          {
            "name": "slot",
            "type": "purpose | inferred_name | inferred_type | data_flow | state_behavior | game_mapping",
