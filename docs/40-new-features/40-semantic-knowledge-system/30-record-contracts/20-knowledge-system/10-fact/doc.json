    "b-sks-rc-fact-slots-table": {
      "type": "structured-table",
      "props": {
        "columns": [
          "Slot",
          "The claim says"
        ],
        "rows": [
          [
            [
              {
                "insert": "purpose",
                "attributes": {
                  "code": true
                }
              }
            ],
            "What the subject does and why it exists"
          ],
          [
            [
              {
                "insert": "inferred_name",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A likely human-readable name or role, kept inside the knowledge system; the display name for an entity"
          ],
          [
            [
              {
                "insert": "inferred_type",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A likely type, shape, unit, enum domain, or callback signature"
          ],
          [
            [
              {
                "insert": "data_flow",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Where a value originates, how it changes, where it is consumed"
          ],
          [
            [
              {
                "insert": "state_behavior",
                "attributes": {
                  "code": true
                }
              }
            ],
            "A state, transition, guard, timer, or event-driven behaviour"
          ],
          [
            [
              {
                "insert": "game_mapping",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Which grounded game or SmashWiki concept the code behaviour is"
          ]
        ]
      },
      "id": "b-sks-rc-fact-slots-table",
      "children": []
    },
    "b-sks-rc-fact-no-slots": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no "
        },
        {
          "insert": "invariant",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " slot and no "
        },
        {
          "insert": "negative_semantic",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " slot (both were list-valued facts on the retired "
        },
        {
          "insert": "knowledge_record",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " table). An invariant is just a confident "
        },
        {
          "insert": "state_behavior",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "purpose",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact. A tested interpretation that did not work lives on the ledger side — the "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " hypothesis and outcome columns already carry it — and never becomes a fact."
        }
      ],
      "id": "b-sks-rc-fact-no-slots",
      "children": []
    },
    "b-sks-rc-fact-names-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Inferred-name safety: an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact is a guess about what the subject is called — like every fact, an inference. Any worker-facing projection (target card, search chunk, prompt context) must show it as a guess, with its "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and never as the canonical name. The "
        },
        {
          "insert": "symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column on "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays the only name a worker may write into source."
        }
      ],
      "id": "b-sks-rc-fact-names-body",
      "children": []
    },
    "b-sks-rc-fact-history-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        }
      ],
      "id": "b-sks-rc-fact-history-heading",
      "children": []
    },
    "b-sks-rc-fact-history-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Append-only, keyed by "
        },
        {
          "insert": "fact_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". One row per overwrite or clear: the prior version of the fact — "
        },
        {
          "insert": "slot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "evidence_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "updated_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exactly as they were — appended in the same write that overwrites the live row. The agent reads live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows; it walks "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " WHERE "
        },
        {
          "insert": "fact_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (newest first) only when it needs to know what changed. Nothing edits or deletes a history row."
        }
      ],
      "id": "b-sks-rc-fact-history-body",
      "children": []
    },
    "b-sks-rc-fact-history-shape": {
      "type": "state-shape",
      "props": {
        "name": "fact_history",
        "description": "Append-only. One row per overwrite or clear of a live `fact` row, written in the same write.",
        "example": "{\n  \"id\": \"fh-01ja01\",\n  \"fact_id\": \"fact-01j9x2\",\n  \"slot\": \"purpose\",\n  \"value\": \"Scales the fighter's velocity while airborne.\",\n  \"rationale\": \"The decay multiply runs inside the airborne branch; at the time nothing tied it to hitstun specifically.\",\n  \"confidence\": 0.55,\n  \"evidence_ids\": [\"ev-9f2ac41d\"],\n  \"updated_at\": \"2026-07-30T18:02:00Z\"\n}",
        "fields": [
