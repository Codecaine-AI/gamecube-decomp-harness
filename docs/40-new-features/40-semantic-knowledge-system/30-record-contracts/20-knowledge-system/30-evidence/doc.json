    "b-sks-rc-evidence-shape": {
      "type": "state-shape",
      "props": {
        "name": "evidence",
        "description": "Shared by every table that cites an observation; never duplicated per citer.",
        "example": "{\n  \"id\": \"ev-9f2ac41d\",\n  \"kind\": \"discord\",\n  \"locator\": \"discord://melee-decomp/matching/1123581321\",\n  \"digest\": \"sha256:4f0e8c21b7a94d35\",\n  \"excerpt\": \"pretty sure 800BFFD0 is the hitstun decay helper\",\n  \"captured_at\": \"2026-08-10T22:14:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "evidence id",
            "description": "Primary key; content hash of `locator` and `digest`"
          },
          {
            "name": "kind",
            "type": "pr | discord | attempt | wiki | code"
          },
          {
            "name": "locator",
            "type": "typed store locator",
            "description": "Must resolve; format per `kind` is open"
          },
          {
            "name": "digest",
            "type": "digest",
            "description": "Of the captured material"
          },
          {
            "name": "excerpt",
            "type": "string",
            "required": false
          },
          {
            "name": "captured_at",
            "type": "timestamp"
          }
        ]
      },
      "id": "b-sks-rc-evidence-shape",
      "children": []
    },
    "b-sks-rc-evidence-shape-example-note-1": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": hashed from "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — a second citation of the same captured material reuses this row instead of inserting another."
        }
      ],
      "id": "b-sks-rc-evidence-shape-example-note-1",
      "children": []
    },
    "b-sks-rc-evidence-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "excerpt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": what a page shows inline; the resolver verifies the "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not the excerpt."
        }
      ],
      "id": "b-sks-rc-evidence-shape-example-note-2",
      "children": []
    },
