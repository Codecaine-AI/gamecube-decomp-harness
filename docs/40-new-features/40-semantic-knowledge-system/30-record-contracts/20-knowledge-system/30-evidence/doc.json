    "b-sks-rc-evidence-stores-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Five stores back the five kinds: the "
        },
        {
          "insert": "pr://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " past-PR index, the "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " archive, the "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " store of worker runs and their submissions, the "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " mirrored corpus, and a "
        },
        {
          "insert": "code://<revision>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " checkout. The locator format per "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is open; what must hold is that it resolves, and that the digest pins what was actually read."
        }
      ],
      "id": "b-sks-rc-evidence-stores-body",
      "children": []
    },
