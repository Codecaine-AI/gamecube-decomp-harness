    "b-sks-rc-patterns-admission-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Admission is the standard curated path — the librarian writes the rows — with one extra actor: the mechanical builders ("
        },
        {
          "insert": "mismatch-patterns",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "opseq-similarity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") propose, and only propose. A builder's output never becomes an "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row directly. Discord material enters the system the same way: the importer lands it as facts and evidence on knowledge subjects — mostly patterns and game concepts — never as ledger entries."
        }
      ],
      "id": "b-sks-rc-patterns-admission-body",
      "children": []
    },
    "b-sks-rc-patterns-admission-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "A builder or a human notices a recurring convention and proposes a `pattern` entity: a draft locator, draft facts, candidate links."
          },
          {
            "text": "The librarian judges the proposal: admit it as a new entity, fold it into an existing one, or discard it."
          },
          {
            "text": "On admission, substance lands as ordinary facts (typically `purpose`) citing `discord://` and `code://` evidence; reach lands as `link` rows, each with a `why` and an `evidence_id`."
          },
          {
            "text": "Game concepts follow the same curated path, usually seeded from the wiki importer — see the Game Concepts sibling page.",
            "kind": "note"
          }
        ]
      },
      "id": "b-sks-rc-patterns-admission-process",
      "children": []
    },
