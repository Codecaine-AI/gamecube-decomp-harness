    "b-sks-rc-patterns-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "PATTERNS — "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " kind that pins a curated convention noticed in how the original developers wrote code ("
        },
        {
          "insert": "pattern:velocity-fields-last",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — velocity variables sit at the bottom of fighter structs). A pattern row is an ordinary "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row: the same table, the same merge lifecycle, the same curated admission documented in "
        },
        {
          "insert": "Entities",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-new-features/40-semantic-knowledge-system/30-record-contracts/10-core-objects/20-entities",
              "label": "Entities"
            }
          }
        },
        {
          "insert": ". Nothing on this page adds a column, a table, or a fact slot. The other larger-idea kind, "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", has its own page: "
        },
        {
          "insert": "Game Concepts",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-new-features/40-semantic-knowledge-system/30-record-contracts/10-core-objects/20-entities/10-game-concepts",
              "label": "Game Concepts"
            }
          }
