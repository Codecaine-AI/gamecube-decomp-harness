    "b-sks-rc-patterns-grounding-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Grounding and locator"
        }
      ],
      "id": "b-sks-rc-patterns-grounding-heading",
      "children": []
    },
    "b-sks-rc-patterns-grounding-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A pattern is a habit of the original developers, kept deliberately unstructured: layout habits (\"velocity variables are always at the bottom of fighter structs\"), ordering and ordinality habits in functions, idioms a matched function keeps reappearing with. The "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a curated slug like "
        },
        {
          "insert": "pattern:velocity-fields-last",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Grounding is typically "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — community lore that names the habit — and "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — the convention visible in the checkout. What makes a pattern useful is not structure but reach: the "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows from everything that shows it."
        }
      ],
      "id": "b-sks-rc-patterns-grounding-body",
      "children": []
    },
