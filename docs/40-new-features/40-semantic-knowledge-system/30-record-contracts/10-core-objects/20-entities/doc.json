    "b-sks-rc-entities-kinds-split": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Four of the six kinds — "
        },
        {
          "insert": "file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "struct_field",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "parameter",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — are code-shaped and self-explanatory: the "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names something in the checkout, and this page settles what needs settling about them. The two larger-idea kinds, "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", carry their own grounding and admission story and get their own child pages, "
        },
        {
          "insert": "Game Concepts",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "40-new-features/40-semantic-knowledge-system/30-record-contracts/10-core-objects/20-entities/10-game-concepts",
              "label": "Game Concepts"
            }
          }
        },
