    "b-sks-rc-entities-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Merge is a tombstone: a losing row keeps its "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", flips "
        },
        {
          "insert": "identity_status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and resolves through "
        },
        {
          "insert": "merged_into_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; it is never deleted."
        }
      ],
      "id": "b-sks-rc-entities-shape-example-note-2",
      "children": []
    },
    "b-sks-rc-entities-shape-example-note-3": {
      "type": "list-item",
      "props": {
