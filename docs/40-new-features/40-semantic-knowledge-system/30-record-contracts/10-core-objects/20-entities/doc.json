    "b-sks-rc-entities-shape": {
      "type": "state-shape",
      "props": {
        "name": "entity",
        "description": "Curated identity only: no name column, no meaning, no status, no revisioning.",
        "example": "{\n  \"id\": \"ent-shield\",\n  \"kind\": \"game_concept\",\n  \"locator\": \"concept:shield\",\n  \"parent_entity_id\": null,\n  \"identity_status\": \"active\",\n  \"merged_into_id\": null\n}",
        "fields": [
          {
            "name": "id",
            "type": "entity id",
            "description": "Primary key"
          },
          {
            "name": "kind",
            "type": "file | struct | struct_field | game_concept | parameter | pattern",
            "description": "What sort of subject the `locator` pins"
          },
          {
            "name": "locator",
            "type": "string",
            "description": "Pins the identity; format depends on `kind` (see the enum table). One row per real thing"
          },
          {
            "name": "parent_entity_id",
            "type": "entity id",
            "required": false,
            "description": "FK \u2192 entity; containment \u2014 a `struct_field` points at its `struct`"
          },
          {
            "name": "identity_status",
            "type": "active | merged | retired",
            "description": "Whether the row is live, folded into another row, or gone with no successor"
          },
          {
            "name": "merged_into_id",
            "type": "entity id",
            "required": false,
            "description": "FK \u2192 entity; set when `identity_status` is `merged` \u2014 the winner the loser's facts were folded into"
          }
        ]
      },
      "id": "b-sks-rc-entities-shape",
      "children": []
    },
