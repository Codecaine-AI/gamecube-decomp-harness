                  "code": true
                }
              }
            ],
            [
              {
                "insert": "entity",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Zero or one",
            [
              {
                "insert": "Containment: a "
              },
              {
                "insert": "struct_field",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "'s struct"
              }
