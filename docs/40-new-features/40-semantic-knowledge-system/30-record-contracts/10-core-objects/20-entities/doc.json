    "b-sks-rc-entities-names-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Names are facts"
        }
      ],
      "id": "b-sks-rc-entities-names-heading",
      "children": []
    },
    "b-sks-rc-entities-names-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has no name column. The display name is an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact on the entity, carrying confidence, a rationale, and evidence like any other claim. Renaming a struct is a fact overwrite \u2014 "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " preserves the prior version in the same write \u2014 never an identity change; the "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays."
        }
      ],
      "id": "b-sks-rc-entities-names-body",
      "children": []
    },
    "b-sks-rc-entities-merge-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Merge lifecycle"
        }
      ],
      "id": "b-sks-rc-entities-merge-heading",
      "children": []
    },
    "b-sks-rc-entities-merge-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no revisioning here: no revision counter, no "
        },
        {
          "insert": "supersedes_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A fact overwrite is the unit of change, and "
        },
        {
          "insert": "fact_history",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " already preserves it. The only identity transitions are "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \u2014 two rows turned out to be the same thing \u2014 and "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \u2014 the subject stopped existing, with no successor."
        }
      ],
      "id": "b-sks-rc-entities-merge-body",
      "children": []
    },
    "b-sks-rc-entities-merge-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Pick the winner. The loser's `identity_status` becomes `merged` and its `merged_into_id` points at the winner."
          },
          {
            "text": "Fold each of the loser's live facts into the winner as a normal fact overwrite; `fact_history` keeps the prior versions in the same write."
          },
          {
            "text": "Re-point the loser's `link` rows so joins land on the winner; the tombstone keeps old references resolvable."
          },
          {
            "text": "Never delete the loser's row: every folded fact's history survives, and anything that stored the loser's id still resolves through `merged_into_id`.",
            "kind": "note"
          }
        ]
      },
      "id": "b-sks-rc-entities-merge-process",
      "children": []
    },
    "b-sks-rc-entities-param-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Parameters"
        }
      ],
      "id": "b-sks-rc-entities-param-heading",
      "children": []
    },
    "b-sks-rc-entities-param-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A parameter's identity is its position, never its name: the "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the function's "
        },
        {
          "insert": "stable_key",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus the ABI slot ("
        },
        {
          "insert": "ftCo.o:ftCo_800BFFD0#r3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), and every name it has ever been given is an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact. The entity is joined to its function's "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " by a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row ("
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \"parameter\"); a parameter typed as a known struct gets an entity\u2192entity "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the struct entity ("
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \"typed_as\"). Signature drift is handled with the lifecycle, not relocation: a parameter that stops existing is "
        },
        {
          "insert": "retired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; two parameters that collapse into one struct pointer are "
        },
        {
          "insert": "merged",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the replacement. Local variables and return values are never entities \u2014 they have no stable identity across recompiles \u2014 and stay "
        },
        {
          "insert": "inferred_type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "data_flow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " facts on the function's "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-sks-rc-entities-param-body",
      "children": []
    },
    "b-sks-rc-entities-links-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
