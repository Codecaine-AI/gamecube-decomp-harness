    "b-sks-rc-entities-links-out": {
      "type": "structured-table",
      "props": {
        "columns": [
          "From",
          "To",
          "Cardinality",
          "Meaning"
        ],
        "rows": [
          [
            [
              {
                "insert": "entity.parent_entity_id",
