          "insert": "No name column: what this entity is called is an "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact on it, with confidence and evidence, never identity."
        }
      ],
      "id": "b-sks-rc-entities-shape-example-note-3",
      "children": []
