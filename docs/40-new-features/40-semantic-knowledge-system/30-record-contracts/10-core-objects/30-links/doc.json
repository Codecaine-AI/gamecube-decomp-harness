    "b-sks-rc-links-shape": {
      "id": "b-sks-rc-links-shape",
      "type": "state-shape",
      "props": {
        "description": "Curated subject-to-subject join. Exactly one `from_*` and exactly one `to_*` column is set.",
        "example": "{\n  \"from_target_id\": null,\n  \"from_entity_id\": \"ent-param-ftCo_800BFFD0-r3\",\n  \"to_target_id\": \"tgt-ftCo_800BFFD0\",\n  \"to_entity_id\": null,\n  \"role\": \"parameter\",\n  \"why\": \"signature hypothesis names r3 as the fighter pointer\",\n  \"evidence_id\": \"ev-7b21e9c4\"\n}",
        "fields": [
          {
            "name": "from_target_id",
            "type": "target id",
            "required": false,
            "description": "FK → target; XOR with `from_entity_id` — exactly one of the two is set"
          },
          {
            "name": "from_entity_id",
            "type": "entity id",
            "required": false,
            "description": "FK → entity; XOR with `from_target_id`"
          },
          {
            "name": "to_target_id",
            "type": "target id",
            "required": false,
            "description": "FK → target; XOR with `to_entity_id` — exactly one of the two is set"
          },
          {
            "name": "to_entity_id",
            "type": "entity id",
            "required": false,
            "description": "FK → entity; XOR with `to_target_id`"
          },
          {
            "name": "role",
            "type": "string",
            "description": "Short free text naming the relationship: `parameter`, `member`, `reads`, `writes`, `typed_as`, `related`, …"
          },
          {
            "name": "why",
            "type": "string",
            "description": "One-line rationale a reader can check"
          },
          {
            "name": "evidence_id",
            "type": "evidence id",
            "description": "FK → evidence; what showed the relationship"
          }
        ],
        "name": "link"
      },
      "children": []
    },
