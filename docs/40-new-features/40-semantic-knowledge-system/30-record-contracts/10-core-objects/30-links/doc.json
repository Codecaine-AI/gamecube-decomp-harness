    "b-sks-rc-links-containment": {
      "id": "b-sks-rc-links-containment",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Rule — observed containment is never a link",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "That a function is in a unit, or a unit is in a file, is report-derived structure: it lives on "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "unit_target_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "source_path",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and in the file view, and stays a derived view. A "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row is a curated claim someone made and cited; mechanical structure never becomes one."
        }
