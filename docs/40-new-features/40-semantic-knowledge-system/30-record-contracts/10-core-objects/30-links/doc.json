    "b-sks-rc-links-intro": {
      "id": "b-sks-rc-links-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "LINK — "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the one generic join between knowledge subjects: any "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to any "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with a "
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " naming the relationship, a one-line "
        },
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that showed it. It subsumes two former tables: an old "
        },
        {
          "insert": "related_target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row is a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " target→target with "
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " \"related\", and an old "
        },
        {
          "insert": "entity_target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row is a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entity→target. One table, four optional foreign keys, two XOR rules."
        }
