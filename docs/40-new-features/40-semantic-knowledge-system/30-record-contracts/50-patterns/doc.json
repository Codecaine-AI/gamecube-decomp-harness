    "b-sks-rc-patterns-shape": {
      "type": "state-shape",
      "props": {
        "name": "pattern",
        "description": "Global. No embedded examples, tactics, or sources: those are pattern_example, pattern_tactic, and source rows.",
        "fields": [
          {
            "name": "id",
            "type": "pattern id",
            "description": "Primary key; global, not scoped to a target; one per revision"
          },
          {
            "name": "name",
            "type": "string",
            "description": "Short, human-readable"
          },
          {
            "name": "summary",
            "type": "string",
            "description": "What the developers did and where it shows up, one paragraph"
          },
          {
            "name": "kind",
            "type": "code_shape | data_layout | control_flow | naming | mismatch_signature"
          },
          {
            "name": "recognizer",
            "type": "opcode-sequence fingerprint, source shape, or mismatch signature",
            "description": "How to spot it; the typed format is open"
          },
          {
            "name": "recipe",
            "type": "string",
            "required": false,
            "description": "The C shape that produces it"
          },
          {
            "name": "confidence",
            "type": "number 0..1",
            "description": "How sure we are the recognizer and recipe are right"
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "updated_by",
            "type": "builder | librarian | human"
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "supersedes_id",
            "type": "pattern id",
            "required": false,
            "description": "FK → pattern; the previous revision; absent on revision 1"
          }
        ]
      },
      "id": "b-sks-rc-patterns-shape",
      "children": []
    },
