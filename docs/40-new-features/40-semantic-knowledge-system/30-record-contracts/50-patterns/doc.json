      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example — a mismatch signature seen on three functions becomes a pattern"
        }
      ],
      "id": "b-sks-rc-patterns-example-heading",
      "children": []
    },
    "b-sks-rc-patterns-example-process": {
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The builder seeds a recognizer",
            "steps": [
              {
                "text": "The mismatch-patterns builder sees the same diff shape (two stores swapped in the epilogue) in the scored reports of ftCo_Attack100, ftCo_Attack11, and ftCo_AttackS3."
              },
              {
                "text": "It inserts `pattern` P revision 1: `kind` `mismatch_signature`, `recognizer` = that diff shape, `recipe` empty, `updated_by` `builder`."
              }
            ]
          },
          {
            "text": "The librarian writes the recipe",
            "steps": [
              {
                "text": "Attempt A on ftCo_Attack100 fixed the diff by writing the local before the call; its `attempt_step` row cites the checkpoint."
              },
              {
                "text": "The librarian inserts P revision 2 with `supersedes_id` = revision 1: `recipe` = \"write the local before the call so the compiler emits the stores in source order\", `confidence` 0.8. It inserts three `pattern_example` rows (P, each target, a code-span `source_id`) and one `pattern_tactic` row (P, the tactic minted from A)."
              },
              {
                "text": "The librarian also inserts `target_pattern` (ftCo_Attack100, P, `why` \"its epilogue showed the swapped-store signature\") alongside the next `knowledge_record` revision.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "A later worker searches",
            "steps": [
              {
                "text": "A worker on a fourth function asks which patterns match its mismatch; the `recognizer` matches P, and the card shows P's `recipe` and its `pattern_tactic` rows before the worker tries anything."
              }
            ]
          }
        ]
      },
      "id": "b-sks-rc-patterns-example-process",
