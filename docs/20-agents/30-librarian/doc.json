    "b-process-intro": {
      "id": "b-process-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process uses the phase names from the prompt. Each step explains the decision that phase is meant to support."
        }
      ],
      "children": []
    },
    "b-agent-process": {
      "id": "b-agent-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Process a librarian task",
            "steps": [
              {
                "text": "read_task",
                "steps": [
                  {
                    "text": "Read pass, task, and object to establish why this review exists."
                  }
                ]
              },
              {
                "text": "scope_subjects",
                "steps": [
                  {
                    "text": "Read each touched subject's existing record and separate writable scope from supporting context."
                  }
                ]
              },
              {
                "text": "audit_rename_and_drift",
                "steps": [
                  {
                    "text": "Review renamed symbols and changed or missing citations before judging new material."
                  }
                ]
              },
              {
                "text": "corroborate",
                "steps": [
                  {
                    "text": "Search for support and contradiction, and resolve every source that may be cited."
                  }
                ]
              },
              {
                "text": "draft_per_subject",
                "steps": [
                  {
                    "text": "Decide whether each subject gains knowledge, is confirmed, or learns nothing. Draft only supported facts and links."
                  }
                ]
              },
              {
                "text": "curate_entities",
                "steps": [
                  {
                    "text": "Look up existing concepts and patterns before proposing an admission or merge."
                  }
                ]
              },
              {
                "text": "reconcile",
                "steps": [
                  {
                    "text": "Compare proposals with the live record. Revise changed claims, clear unsupported ones, and retain sound claims."
                  }
                ]
              },
              {
                "text": "report",
                "steps": [
                  {
                    "text": "Return facts, links, entities, merges, and follow_ups. If the apply layer rejects items, return one full corrected proposal."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
