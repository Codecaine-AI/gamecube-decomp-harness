    "b-context-3": {
      "id": "b-context-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "touched_subjects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lists the subjects owed a decision, with their current records and material. "
        },
        {
          "insert": "renamed_from",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "drift",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identify evidence needing review."
        }
      ],
      "children": []
    },
    "b-context-4": {
      "id": "b-context-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "supporting_subjects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " adds connected concepts and patterns for understanding without making every supporting subject a required research task."
        }
      ],
      "children": []
    },
    "b-context-5": {
      "id": "b-context-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "decomp_standards",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " explains enforced conventions. Standards are not game facts or evidence for a proposed claim."
        }
      ],
      "children": []
    },
    "b-context-6": {
