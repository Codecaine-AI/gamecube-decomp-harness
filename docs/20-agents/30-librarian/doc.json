    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian reviews incoming material and updates its understanding of the game's subjects. Its process starts from the current record, checks changed evidence, and proposes only the changes that the sources support."
        }
      ],
      "children": []
    },
