    "b-output-text": {
      "id": "b-output-text",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "librarian_pass_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " response is a proposal. "
