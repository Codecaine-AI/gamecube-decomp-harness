    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker summarizer turns a completed attempt into a readable account of its reasoning and results. It follows the supplied transcript and checkpoint digest so later workers and librarians can understand the attempt without replaying it."
        }
      ],
      "children": []
    },
    "b-context": {
      "id": "b-context",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Context"
        }
      ],
      "children": []
    },
    "b-loader": {
      "id": "b-loader",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The role context loader is "
        },
        {
          "insert": "worker-summarizer-context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The names below match its rendered prompt blocks, in their emitted order."
        }
      ],
      "children": []
    },
    "b-context-0": {
      "id": "b-context-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names the job: summarize this closed worker run."
        }
      ],
      "children": []
    },
    "b-context-1": {
      "id": "b-context-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "target_reference",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies the target so the narrative stays attached to the correct attempt."
        }
      ],
      "children": []
    },
    "b-context-2": {
      "id": "b-context-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "checkpoint_submission_digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " supplies scored checkpoints and submission identities. These measured results take precedence over the worker's claims."
        }
      ],
      "children": []
    },
    "b-context-3": {
      "id": "b-context-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "worker_transcript",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " explains intent, experiments, and changes of direction. Truncated or missing passages remain unknown."
        }
      ],
      "children": []
    },
    "b-context-4": {
      "id": "b-context-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "output_contract",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defines the narrative-only JSON response and its submission join keys."
        }
      ],
      "children": []
    },
    "b-process": {
      "id": "b-process",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Process"
        }
      ],
      "children": []
    },
    "b-process-intro": {
      "id": "b-process-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process uses the phase names from the prompt. Each step explains the decision that phase is meant to support."
        }
      ],
      "children": []
    },
    "b-agent-process": {
      "id": "b-agent-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Summarize a worker run",
            "steps": [
              {
                "text": "read_inputs",
                "steps": [
                  {
                    "text": "Read the target and deterministic digest first, then the transcript in order."
                  }
                ]
              },
              {
                "text": "reconstruct_run",
                "steps": [
                  {
                    "text": "Explain the approaches tried, changes of direction, and what the attempt established."
                  }
                ]
              },
              {
                "text": "narrate_submissions",
                "steps": [
                  {
                    "text": "Write one narrative entry per digest submission, echoing its submission_id exactly."
                  }
                ]
              },
              {
                "text": "distill_observations",
                "steps": [
                  {
                    "text": "Preserve specific, evidence-grounded observations and when another attempt could use them."
                  }
                ]
              },
              {
                "text": "report",
                "steps": [
                  {
                    "text": "Check coverage and grounding, then return the JSON object alone."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-process-note": {
      "id": "b-process-note",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These phase names come from "
        },
        {
          "insert": "workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The summarizer has no tools because it explains the supplied record rather than conducting new research."
        }
      ],
      "children": []
    },
    "b-state": {
      "id": "b-state",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "State and Output"
        }
      ],
      "children": []
    },
    "b-state-text": {
      "id": "b-state-text",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The agent declares "
        },
        {
          "insert": "variables: {}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and no custom mutable agent-state schema. Its output is a narrative response. The summary job validates it, joins measured runtime "
        },
        {
          "insert": "value"
        },
        {
          "insert": "s, and stores attempt history."
        }
      ],
      "children": []
    },
    "b-output-text": {
      "id": "b-output-text",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "worker_summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " output contains explanation only. Scores, final outcome, baseline, and integration results remain host-owned. The echoed "
        },
        {
          "insert": "submission_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the join key, not a model-generated identity."
        }
      ],
      "children": []
    },
    "b-wsum-shape": {
      "id": "b-wsum-shape",
      "type": "state-shape",
      "props": {
        "description": "Validated by the summarizer job, not the apply layer: any extra key at any level, a count mismatch, a duplicate, unknown, or omitted submission_id rejects the output.",
        "example": "{\n  \"run\": {\n    \"summary\": \"Local declaration reordering improved the score; the final branch still differs.\"\n  },\n  \"submissions\": [\n    {\n      \"submission_id\": \"submission-2\",\n      \"approach\": \"Moved temporary declarations to match register lifetimes.\",\n      \"outcome_reasoning\": \"The checkpoint confirmed an improvement, but the final branch remained different.\"\n    }\n  ],\n  \"notable_observations\": [\n    {\n      \"observation\": \"The temporary remains live across the final comparison.\",\n      \"reusable_when\": \"Investigating register allocation around the same comparison.\"\n    }\n  ]\n}",
        "fields": [
          {
            "name": "run",
            "type": "object",
            "required": true,
            "fields": [
              {
                "name": "summary",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "submissions",
            "type": "object[]",
            "required": true,
            "description": "Exactly one per digest submission, joined by submission_id",
            "fields": [
              {
                "name": "submission_id",
                "type": "string",
                "required": true,
                "description": "Echoed verbatim; the only runtime field allowed"
              },
              {
                "name": "approach",
                "type": "string",
                "required": true
              },
              {
                "name": "outcome_reasoning",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "notable_observations",
            "type": "object[]",
            "required": true,
            "fields": [
              {
                "name": "observation",
                "type": "string",
                "required": true
              },
              {
                "name": "reusable_when",
                "type": "string",
                "required": true
              }
            ]
          }
        ],
        "name": "worker_summary",
        "source": {
          "path": "apps/server/src/core/agent-catalog/agents/knowledge/worker-summarizer/schema.json"
        }
      },
      "children": []
