    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Four agents contribute different kinds of judgment to GameKeep. The worker improves code, the worker summarizer explains an attempt, and the two librarians turn evidence into reusable knowledge."
        }
      ],
      "children": []
    },
    "b-worker": {
      "id": "b-worker",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-agents/10-worker"
            }
          }
        },
        {
          "insert": " works on one claimed target with source, mismatch evidence, knowledge, and standards."
        }
      ],
      "children": []
    },
    "b-summary": {
      "id": "b-summary",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker Summarizer",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-agents/20-worker-summarizer"
            }
          }
        },
        {
          "insert": " preserves the reasoning behind a completed attempt so later readers do not need its whole transcript."
        }
      ],
      "children": []
    },
    "b-librarian": {
      "id": "b-librarian",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Librarian",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "20-agents/30-librarian"
            }
          }
        },
        {
          "insert": " reviews incoming material and revises knowledge when the evidence warrants it."
        }
      ],
      "children": []
    },
    "b-backfill": {
      "id": "b-backfill",
      "type": "paragraph",
      "props": {},
