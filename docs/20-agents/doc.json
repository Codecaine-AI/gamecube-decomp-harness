      "children": []
    },
    "b-boundaries-text": {
      "id": "b-boundaries-text",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each agent receives a bounded question and the context needed to answer it. The runner owns worker validation and integration. The summary job combines narrative with measured results. The knowledge apply layer validates librarian proposals before writing them."
        }
      ],
      "children": []
    },
    "b-context-text": {
      "id": "b-context-text",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each page follows the prompt through named context blocks, process phases, and state or output ownership. Context identifiers use inline code so you can compare the docs with the agent UI."
        }
      ],
      "children": []
    },
    "b-shared-loader": {
      "id": "b-shared-loader",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All four context definitions declare "
        },
        {
          "insert": "melee-session-context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alongside their role loader. It provides shared session context when available. The role-specific sections are documented on each agent page."
        }
      ],
      "children": []
    },
