    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker improves one claimed target by classifying its mismatch, testing a source-level explanation, and submitting verified improvements. The prompt defines the investigation process; the runner owns validation, checkpoints, and closure."
        }
      ],
      "children": []
    },
