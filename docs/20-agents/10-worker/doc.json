    },
    "bffa60bc-60ce-46b2-9bec-0304d7efabb7": {
      "id": "bffa60bc-60ce-46b2-9bec-0304d7efabb7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Within the target card, "
        },
        {
          "insert": "ledger.recovery",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " preserves the latest recorded merge recovery context and commit references across full, compact, and minimal prompt budgets. Boundary recovery notes identify the achieved score, the later score, and the saved source revision and path. The worker reads that source and prior attempts, adapts the solution to current upstream APIs, and validates it again. Historical success does not establish that the current checkout matches."
        }
      ],
      "children": []
    },
