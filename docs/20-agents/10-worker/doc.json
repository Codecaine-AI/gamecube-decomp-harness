    "b-process-intro": {
      "id": "b-process-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process follows the numbered loop in the prompt's "
        },
        {
          "insert": "method",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " section. A diagnostic allowance bounds each hypothesis to 6 build or capture runs and 6 compiler-source reads."
        }
      ],
      "children": []
    },
    "b-agent-process": {
      "id": "b-agent-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Execute a Worker Attempt",
            "steps": [
              {
                "text": "Classify",
                "steps": [
                  {
                    "text": "Classify the residual from checkdiff and write down the mismatching rows."
                  },
                  {
                    "text": "Work in order: control flow, call order, loads and stores, instruction selection, registers, frame, relocations, then data."
                  }
                ]
              },
              {
                "text": "Hypothesize",
                "steps": [
                  {
                    "text": "Name one source construct, the evidence for it, the change it predicts, and the result that would disprove it."
                  }
                ]
              },
              {
                "text": "Measure",
                "steps": [
                  {
                    "text": "Build, diff, and read the compiler decisions with `mwcc_alloc_snapshot` or `mwcc_alloc_compare_sources`."
                  },
                  {
                    "text": "Record what the candidate showed, what that predicts for the target, and whether the prediction held."
                  }
                ]
              },
              {
                "text": "Find Evidence",
                "steps": [
                  {
                    "text": "Name the construct kinds that fit the measurement."
                  },
                  {
                    "text": "Tie one construct to this site with the link map, relocations, accepted siblings, other games' sources, or graph references."
                  }
                ]
              },
              {
                "text": "Submit",
                "steps": [
                  {
                    "text": "Write the construct, remove every probe edit, and submit."
                  },
                  {
                    "text": "Stop with a findings record after three unsupported hypotheses or a spent diagnostic allowance."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
