    "b-agent-process": {
      "id": "b-agent-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Execute a worker attempt",
            "steps": [
              {
                "text": "orient",
                "steps": [
                  {
                    "text": "Read the target, first_diff, target_knowledge, and standards. Classify the residual and identify the specific mismatching rows."
                  }
                ]
              },
              {
                "text": "exact_symbol_history",
                "steps": [
                  {
                    "text": "Read prior attempts and accepted examples for this exact symbol before editing. Resolve the underlying evidence and avoid repeating disproven shapes."
                  }
                ]
              },
              {
                "text": "name_the_mechanism",
                "steps": [
                  {
                    "text": "Identify the compiler mechanism behind the residual. Predict which source change will move which rows, and what result would disprove it."
                  }
                ]
              },
              {
                "text": "one_edit_then_diff",
                "steps": [
                  {
                    "text": "Make a focused edit, compile, and inspect the new diff. Keep verified improvements. Stop repeating a variant family after two or three unchanged residuals."
                  }
                ]
              },
              {
                "text": "escalate",
                "steps": [
                  {
                    "text": "Gather a new kind of evidence, reconsider the abstraction, or use a bounded probe. Submit verified progress and continue toward exact; request widening when the proven fix is outside the approved write set."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
