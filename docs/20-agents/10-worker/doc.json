    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker recovers the source the original developers wrote for one claimed target. It tests one hypothesis at a time, reads what the compiler decided, and ties each construct to evidence at the site. The runner owns validation, checkpoints, and closure. For SMS, a match counts only when the steering gate certifies it."
        }
      ],
      "children": []
    },
