      "text": [
        {
          "insert": "target_knowledge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " provides the target card with facts, evidence, prior runs, submission reasoning, and unresolved diagnoses. History supplies hypotheses to test against current source."
        }
