    "b-process-intro": {
      "id": "b-process-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process uses the phase names from the prompt. Each step explains the decision that phase is meant to support."
        }
      ],
      "children": []
    },
    "b-agent-process": {
      "id": "b-agent-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Backfill target knowledge",
            "steps": [
              {
                "text": "read_context",
                "steps": [
                  {
                    "text": "Read the full subject context and confirm the supplied order before using tools."
                  }
                ]
              },
              {
                "text": "for_each_fill_out_subject",
                "steps": [
                  {
                    "text": "Read source and current knowledge, research attempts and external captures, compare related functions, and resolve citations. Finish one subject before moving to the next."
                  }
                ]
              },
              {
                "text": "curate_entities",
                "steps": [
                  {
                    "text": "Look up concepts and patterns before proposing new entities or merges."
                  }
                ]
              },
              {
                "text": "reconcile",
                "steps": [
                  {
                    "text": "Check proposals against current knowledge, preserve supported claims, and revise or clear claims whose evidence changed."
                  }
                ]
              },
              {
                "text": "report",
                "steps": [
                  {
                    "text": "Check coverage and the output contract, then return one proposal JSON object."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-process-note": {
      "id": "b-process-note",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These phase names come from "
        },
        {
          "insert": "workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The target list and coverage tracking belong to the backfill runner, leaving each agent pass focused on the assigned research."
        }
      ],
      "children": []
    },
