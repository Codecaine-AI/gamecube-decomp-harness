    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The backfill librarian researches one target and its linked entities to establish initial knowledge. Its ordered subject loop builds understanding of the surrounding structures before drawing conclusions about the target."
        }
      ],
      "children": []
    },
    "b-context": {
      "id": "b-context",
      "type": "heading",
      "props": {
        "level": 2
      },
