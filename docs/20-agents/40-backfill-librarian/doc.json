          "insert": "Context"
        }
      ],
      "children": []
    },
    "b-loader": {
      "id": "b-loader",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The role context loader is "
        },
        {
          "insert": "backfill-librarian-context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The names below match its rendered prompt blocks, in their emitted order."
        }
      ],
      "children": []
    },
    "b-context-0": {
      "id": "b-context-0",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names the assigned target and the instruction to research against the current library."
        }
      ],
      "children": []
    },
    "b-context-1": {
      "id": "b-context-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "fill_out_subjects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " orders the subjects to research, linked mechanical entities first and the target last. Each arrives with its record and supporting material."
        }
      ],
      "children": []
    },
    "b-context-2": {
      "id": "b-context-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "supporting_subjects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " supplies connected concepts and patterns that help interpret the assigned subjects."
        }
      ],
      "children": []
    },
    "b-context-3": {
      "id": "b-context-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "decomp_standards",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies enforced code conventions so they are not mistaken for discoveries about the game."
        }
      ],
      "children": []
    },
    "b-context-4": {
      "id": "b-context-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "source_reading_view",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " contains "
        },
        {
          "insert": "proposed_name_files",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that aid reading. Canonical source remains the evidence."
        }
      ],
      "children": []
    },
    "b-context-5": {
