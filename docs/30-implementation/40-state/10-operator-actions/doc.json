    "sweep-0ab4c355089e4958": {
      "id": "sweep-0ab4c355089e4958",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessStateView is the server-owned projection of current coordination and operator authority. It contains 11 canonical actions, including disabled actions with their blockers. Clients display these guards and confirmation requirements; command routes recheck them before accepting a request."
        }
      ],
      "children": []
    },
