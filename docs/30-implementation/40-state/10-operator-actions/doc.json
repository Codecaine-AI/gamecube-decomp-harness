    "harness-http-operations": {
      "id": "harness-http-operations",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "GET /api/harness",
            "kind": "query",
            "description": "Read state and timeline. /api/harness/timeline accepts the same query.",
            "params": [
              {
                "name": "gameId",
                "type": "string",
                "description": "Required query."
              },
              {
                "name": "after",
                "type": "integer",
                "description": "Optional nonnegative cursor. Returns up to 100 entries."
              }
            ],
            "returns": "{ harness, timeline }"
          },
          {
            "name": "POST /api/harness/run",
            "description": "Persist Run intent, then admit, resume, or return visible blockers.",
            "params": [
              {
                "name": "gameId",
                "type": "string"
              },
              {
                "name": "commandId",
                "type": "string",
                "description": "Stable retry identity."
              },
              {
                "name": "expectedRevision",
                "type": "integer",
                "description": "HarnessState.identity.revision."
              }
            ],
            "returns": "{ harness, outcome, blockers?, process? }"
          },
          {
            "name": "POST /api/harness/pause",
            "description": "Persist pause intent and drain an active process.",
            "params": [
              {
                "name": "gameId",
                "type": "string"
              },
              {
                "name": "commandId",
                "type": "string",
                "description": "Stable retry identity."
              },
              {
                "name": "expectedRevision",
                "type": "integer",
                "description": "HarnessState.identity.revision."
              }
            ],
            "returns": "202 { harness, outcome: draining | paused }"
          },
          {
            "name": "POST /api/sync/start",
            "description": "Manual/bootstrap Sync. Initializes ownership from a verified checkout if absent.",
            "params": [
              {
                "name": "gameId",
                "type": "string"
              }
            ],
            "returns": "Sync action projection and result"
          },
          {
            "name": "POST /api/sync/publish",
            "description": "Confirm validated manual publication. Recovery and cancellation use separate /api/sync routes.",
            "params": [
              {
                "name": "gameId",
                "type": "string"
              },
              {
                "name": "syncId",
                "type": "string"
              },
              {
                "name": "confirmed",
                "type": "boolean",
                "description": "Must be true when confirmation is required."
              }
            ],
            "returns": "Sync action projection and result"
          }
        ],
        "title": "Harness HTTP Operations"
      },
      "children": []
    },
