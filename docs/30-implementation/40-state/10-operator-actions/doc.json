    "5f23ad8e-d8f3-4923-bbca-d2422e0181f7": {
      "id": "5f23ad8e-d8f3-4923-bbca-d2422e0181f7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two operator surfaces sit beside the canonical actions. "
        },
        {
          "insert": "POST /api/run/configuration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " accepts "
        },
        {
          "insert": "desired_workers",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "agent_timeout_seconds",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on a paused run when no dispatch lease is held and no scheduler process is live; the change re-stamps the run's configuration snapshot, resizes open epochs, and records a "
        },
        {
          "insert": "run.configured",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " event. "
        },
        {
          "insert": "run.hard_stop",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " also reconciles Harness State to "
        },
        {
          "insert": "workflow none / status paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when it leaves the run paused without a lease."
        }
      ],
      "children": []
    },
    "fd59fb7a-60d0-4280-b7c9-469f90ac0ee9": {
      "id": "fd59fb7a-60d0-4280-b7c9-469f90ac0ee9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two job-runner commands settle state the API does not: "
        },
        {
          "insert": "resolve-integration --choice reject",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " clears a blocking worker-output integration outcome, and "
        },
        {
          "insert": "requeue-targets",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reopens epoch targets that the infrastructure cap closed (for example during a provider outage) and resets their strike count. Both refuse while a live scheduler holds the lease. During a provider outage the scheduler opens a provider circuit (events "
        },
        {
          "insert": "provider_circuit_opened",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "provider_probe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "provider_circuit_closed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; dashboard "
        },
        {
          "insert": "run.provider_circuit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), stops claiming, probes the provider, and resumes on its own without pausing the harness."
        }
      ],
      "children": []
    },
    "sweep-238ba6c8dce941d3": {
      "id": "sweep-238ba6c8dce941d3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Game descriptor resolution precedes these actions. Initial Sync initializes harness ownership. Epoch draft-PR publication is a scheduler operation rather than another top-level workflow."
        }
      ],
      "children": []
    },
    "sweep-83f6cc5008964989": {
