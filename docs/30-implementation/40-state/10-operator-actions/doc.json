      },
      "text": [
        {
          "insert": "Confirmation and Freshness"
        }
      ],
      "children": []
    },
    "sweep-91c7edf51a5a448a": {
      "id": "sweep-91c7edf51a5a448a",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The projection requires confirmation for run.hard_stop, run.cancel, run.recover, sync.publish, sync.cancel, and sync.recover. Command routes recheck the current action guard."
        }
      ],
      "children": []
    },
    "sweep-db70dcf75b5e46b9": {
      "id": "sweep-db70dcf75b5e46b9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync stays validated until publication confirmation. Upstream movement blocks publication until staged state is revalidated. knowledge.process can be blocked by an active materializer lease, retry backoff, or an empty queue."
        }
      ],
      "children": []
    },
