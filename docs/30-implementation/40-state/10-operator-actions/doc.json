    "sweep-c8e7110139fc4a90": {
      "id": "sweep-c8e7110139fc4a90",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The state field holds source ownership, readiness, execution intent, and history links. timeline returns recent ordered harness boundaries. harness_revision mirrors state.identity.revision, or zero before initialization. DispatchState retains a separate internal revision. Knowledge summaries expose queue, lease, retry, and failure state."
        }
      ],
      "children": []
    },
