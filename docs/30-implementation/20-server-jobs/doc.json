    "b-server-jobs-decision-dispatcher-8": {
      "id": "b-server-jobs-decision-dispatcher-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "application/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns only the command dispatcher. Every job's implementation lives with its owning domain slice. This places running-phase jobs under the running phase, PR jobs under the PR phase, knowledge jobs under "
        },
        {
          "insert": "core/knowledge-v2/*/cli.ts (the kg2 jobs) or core/knowledge/jobs (the deprecated kg jobs)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", validation jobs under "
        },
        {
          "insert": "core/validation/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-server-jobs-decision-dispatcher-why-9": {
      "id": "b-server-jobs-decision-dispatcher-why-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was a standalone command app carrying job business logic in the application layer. Jobs are debuggable entrypoints over phase-owned workflow code, so workflow behavior stays with the phase that owns it and the dispatcher stays a thin routing table."
        }
      ],
      "children": []
    },
