      "text": [
        {
          "insert": "Server startup recovers interrupted Sync publication before opening HTTP routes. The job dispatcher parses game and runtime options and invokes the owning domain implementation. Shared build entry points execute game compilation and validation in Daytona."
        }
      ],
      "children": []
