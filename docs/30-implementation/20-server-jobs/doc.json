    "startup-context": {
      "id": "startup-context",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The default build mode requires no local Ninja, compiler, Wibo, or objdiff installation. Server and job startup initialize the host compile jobserver only when ORCH_BUILD_EXECUTION=local is explicitly selected."
        }
      ],
      "children": []
    },
    "startup-outline": {
      "id": "startup-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Start the server",
            "steps": [
              {
                "text": "Configure host compile coordination only for explicit local build mode."
              },
              {
                "text": "Reconcile interrupted Sync publication before accepting operator requests."
              },
              {
                "text": "Open the HTTP server with kernel reads, application APIs, and dashboard assets."
              }
            ]
          }
        ]
      },
      "text": [],
      "children": []
    },
