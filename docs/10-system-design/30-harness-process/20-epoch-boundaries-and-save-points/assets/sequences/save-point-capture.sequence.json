{
  "version": 1,
  "id": "save-point-capture",
  "title": "Sync Publication and Save-Point Capture",
  "participants": [
    {
      "id": "p1",
      "name": "Sync Boundary",
      "kind": "participant"
    },
    {
      "id": "p2",
      "name": "Publication",
      "kind": "participant"
    },
    {
      "id": "p3",
      "name": "Save-Point Capture",
      "kind": "participant"
    },
    {
      "id": "p4",
      "name": "Harness State",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "p1",
      "to": "p2",
      "line": "sync",
      "text": "Publish validated source"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "p2",
      "to": "p4",
      "line": "sync",
      "text": "Record accepted source boundary"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "p2",
      "to": "p3",
      "line": "sync",
      "text": "Capture published HEAD evidence"
    },
    {
      "kind": "fragment",
      "id": "f1",
      "op": "alt",
      "operands": [
        {
          "guard": "Capture succeeds",
          "items": [
            {
              "kind": "message",
              "id": "m4",
              "from": "p3",
              "to": "p4",
              "line": "sync",
              "text": "Append save-point evidence"
            }
          ]
        },
        {
          "guard": "Capture fails",
          "items": [
            {
              "kind": "message",
              "id": "m5",
              "from": "p3",
              "to": "p4",
              "line": "sync",
              "text": "Mark evidence stale and block admission"
            }
          ]
        }
      ]
    }
  ],
  "style": {
    "accent": "#5B7FBD",
    "fragmentAccent": "#B87835"
  }
}
