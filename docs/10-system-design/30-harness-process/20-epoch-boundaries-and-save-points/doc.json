    "eb-failure": {
      "id": "eb-failure",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A capture failure marks evidence stale and blocks the next admission. Capture after accepted publication does not undo that publication. Recovery must reconcile the actual checkout with durable state and finish the missing evidence."
        }
      ],
      "children": []
    },
