    "eb-retry": {
      "id": "eb-retry",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Git and database writes do not share one transaction. Stable command and boundary identities let recovery distinguish an accepted source change from an unfinished evidence step without counting progress twice."
        }
      ],
      "children": []
