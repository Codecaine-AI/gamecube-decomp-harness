    "eb-save": {
      "id": "eb-save",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A save point captures reports, board state, and measurements at an existing commit. It neither creates a commit merely to mark time nor backs up the entire knowledge store."
        }
      ],
      "children": []
    },
