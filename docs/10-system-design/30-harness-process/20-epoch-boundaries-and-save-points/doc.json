    "eb-measure": {
      "id": "eb-measure",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Measure worker gains before the following Sync and upstream gains after it. Compare scores only when target scope, build configuration, and metric definition agree. Refreshing the live baseline does not rewrite historical measurements."
        }
      ],
      "children": []
    },
