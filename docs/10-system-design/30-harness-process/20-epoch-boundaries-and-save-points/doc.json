    "harness-timeline-shape": {
      "id": "harness-timeline-shape",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"identity\": {\n    \"game_id\": \"example-game\",\n    \"harness_id\": \"harness-1\",\n    \"event_id\": \"boundary-13\",\n    \"order\": 129,\n    \"occurred_at\": \"2026-09-11T18:00:00Z\",\n    \"command_id\": \"sync-command-13\"\n  },\n  \"source\": {\n    \"prior_head\": \"commit-B\",\n    \"resulting_head\": \"commit-B\",\n    \"prior_upstream\": \"upstream-U\",\n    \"accepted_upstream\": \"upstream-U\",\n    \"configuration\": \"config-3\"\n  },\n  \"evidence\": {\n    \"save_point_id\": \"save-epoch-12\",\n    \"report\": \"report-B\",\n    \"freshness\": \"valid\",\n    \"source_manifest\": \"capture-14\"\n  },\n  \"recovery\": null,\n  \"eventId\": \"boundary-13\",\n  \"kind\": \"sync_completed\",\n  \"outcome\": \"no_source_change\",\n  \"runId\": \"run-7\",\n  \"epochId\": \"epoch-12\",\n  \"syncId\": \"sync-13\"\n}",
        "fields": [
          {
            "name": "identity",
            "type": "object",
            "description": "Game/harness ID, stable event ID, durable order, timestamp, and causal command.",
            "required": true
          },
          {
            "name": "eventId",
            "type": "string",
            "description": "Stable boundary identity or result.",
            "required": true
          },
          {
            "name": "kind",
            "type": "string",
            "description": "Boundary kind, including initial Sync, epoch, Sync, sandbox validation, control, and evidence events.",
            "required": true
          },
          {
            "name": "outcome",
            "type": "string",
            "description": "Recorded result, including no-source-change completion.",
            "required": true
          },
          {
            "name": "runId",
            "type": "string",
            "description": "Optional durable operation reference.",
            "required": false
          },
          {
            "name": "epochId",
            "type": "string",
            "description": "Optional durable operation reference.",
            "required": false
          },
          {
            "name": "syncId",
            "type": "string",
            "description": "Optional durable operation reference.",
            "required": false
          },
          {
            "name": "source",
            "type": "object",
            "description": "Prior/resulting heads, prior/accepted upstream revisions, and configuration identity.",
            "required": false
          },
          {
            "name": "evidence",
            "type": "object",
            "description": "Save-point ID, report/artifact references, metric scope, freshness, and source manifests.",
            "required": false
          },
          {
            "name": "recovery",
            "type": "object | null",
            "description": "Failure stage and durable resume position. A retry keeps boundary identity.",
            "required": false
          }
        ],
        "name": "HarnessTimelineEntry"
      },
      "children": []
    },
    "eb-nochange": {
      "id": "eb-nochange",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The example records completed Sync with equal prior and resulting heads. Completion does not require an invented commit. Verified source evidence may be reused when build inputs remain unchanged, while knowledge refresh has its own outcome."
        }
      ],
      "children": []
    },
