    "eb-opening": {
      "id": "eb-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An epoch boundary separates worker progress from the next source refresh. The harness settles the epoch, captures evidence at its accepted commit, runs Sync, and records the baseline for the next epoch."
        }
      ],
      "children": []
    },
    "eb-order-h": {
      "id": "eb-order-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Boundary Order"
        }
      ],
      "children": []
    },
    "eb-steps": {
      "id": "eb-steps",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Record an epoch save point",
            "steps": [
              {
                "text": "Settle claims and accepted integration."
              },
              {
                "text": "Rebuild report truth and capture epoch evidence before upstream reconciliation."
              },
              {
                "text": "Run automatic Sync under the retained Run lease."
              },
              {
                "text": "Record the Sync result and post-sync evidence, including no-source-change completion."
              },
              {
                "text": "Refresh eligibility and admit more work only when required gates pass, blockers are clear, and desired execution is run."
              }
            ]
          }
        ]
      },
      "children": []
    },
