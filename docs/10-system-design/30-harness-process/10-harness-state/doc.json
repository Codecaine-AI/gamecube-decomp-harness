    "hs-explain": {
      "id": "hs-explain",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Read the example as a game currently performing Sync while its requested intent is to run. The accepted head remains the baseline until an accepted source change advances it. Its state revision is an optimistic-concurrency counter, independent of Git commits and dispatch revisions."
        }
      ],
      "children": []
    },
    "hs-intent-h": {
      "id": "hs-intent-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Intent, Workflow, and Status"
        }
      ],
      "children": []
    },
    "hs-terms": {
      "id": "hs-terms",
      "type": "structured-table",
      "props": {
        "columns": [
          "Field",
          "Question Answered",
          "Example"
        ],
        "rows": [
          [
            "execution.desired",
            "What has the operator requested?",
            "run or paused"
          ],
          [
            "execution.workflow",
            "Which main workflow is recorded as active?",
            "run, sync, or none"
          ],
          [
            "execution.status",
            "What condition is execution in?",
            "initializing, active, idle, paused, or blocked"
          ],
          [
            "readiness and blockers",
            "Can the next epoch be admitted?",
            "Accepted head, ready gates, no blockers, and desired run"
          ]
        ]
      },
      "children": []
    },
    "hs-gates": {
      "id": "hs-gates",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A changed source head makes build and evidence readiness pending. A changed configuration also invalidates source and sandbox readiness. The next epoch must use evidence valid for its accepted source and build inputs."
        }
      ],
      "children": []
    },
    "hs-history-h": {
      "id": "hs-history-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Current State and Retained History"
        }
      ],
      "children": []
    },
    "hs-history": {
      "id": "hs-history",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness State links the current run, epoch, Sync, timeline cursor, and latest save point. The timeline records boundaries. Save points retain measured evidence at particular commits. Run, Sync, and knowledge stores keep their detailed records rather than embedding them all in this state."
        }
      ],
      "children": []
    },
