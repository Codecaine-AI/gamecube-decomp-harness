    "hs-opening": {
      "id": "hs-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Harness State is the durable record of where a game stands. It keeps the accepted checkout position, requested execution state, readiness gates, and links to history so a process restart does not reset progress."
        }
      ],
      "children": []
    },
    "hs-shape-h": {
      "id": "hs-shape-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Current Game State"
        }
      ],
      "children": []
    },
    "continuing-state-shape": {
      "id": "continuing-state-shape",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"identity\": {\n    \"game_id\": \"example-game\",\n    \"harness_id\": \"harness-1\",\n    \"revision\": 42\n  },\n  \"source\": {\n    \"worktree\": \"./workspace/checkout\",\n    \"head\": \"commit-B\",\n    \"upstream_revision\": \"upstream-U\",\n    \"configuration_revision\": \"config-3\"\n  },\n  \"execution\": {\n    \"desired\": \"run\",\n    \"workflow\": \"sync\",\n    \"status\": \"active\",\n    \"blockers\": []\n  },\n  \"readiness\": {\n    \"build\": \"ready\",\n    \"sources\": \"ready\",\n    \"sandbox\": \"ready\",\n    \"evidence\": \"ready\"\n  },\n  \"history\": {\n    \"run_id\": \"run-7\",\n    \"epoch_id\": \"epoch-12\",\n    \"sync_id\": \"sync-13\",\n    \"timeline_cursor\": 128,\n    \"save_point_id\": \"save-epoch-12\"\n  }\n}",
        "fields": [
          {
            "name": "identity",
            "type": "object",
            "description": "Stable game/harness identity and revision for concurrent state updates.",
            "fields": [
              {
                "name": "game_id",
                "type": "string"
              },
              {
                "name": "harness_id",
                "type": "string"
              },
              {
                "name": "revision",
                "type": "number",
                "description": "Optimistic concurrency revision; independent of dispatch and source revisions."
              }
            ]
          },
          {
            "name": "source",
            "type": "object",
            "description": "Canonical source truth.",
            "fields": [
              {
                "name": "worktree",
                "type": "string",
                "description": "Maintained host checkout."
              },
              {
                "name": "head",
                "type": "revision | null",
                "description": "Null until initial source acceptance."
              },
              {
                "name": "upstream_revision",
                "type": "revision | null",
                "description": "Last accepted upstream, separate from observed remote tip."
              },
              {
                "name": "configuration_revision",
                "type": "string",
                "description": "Configuration/build identity used for this state."
              }
            ]
          },
          {
            "name": "execution",
            "type": "object",
            "description": "Control and authority.",
            "fields": [
              {
                "name": "desired",
                "type": "run | paused",
                "description": "Preserved across Sync and restarts."
              },
              {
                "name": "workflow",
                "type": "sync | run | none",
                "description": "At most one source mutation owner."
              },
              {
                "name": "status",
                "type": "initializing | active | idle | paused | blocked",
                "description": "Status is separate from workflow."
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "description": "Causal failures and recovery requirements."
              }
            ]
          },
          {
            "name": "readiness",
            "type": "object",
            "description": "Build, source-stage, sandbox, and evidence gates.",
            "fields": [
              {
                "name": "build",
                "type": "pending | ready | blocked"
              },
              {
                "name": "sources",
                "type": "pending | ready | blocked"
              },
              {
                "name": "sandbox",
                "type": "pending | ready | blocked"
              },
              {
                "name": "evidence",
                "type": "pending | ready | blocked"
              }
            ]
          },
          {
            "name": "history",
            "type": "object",
            "description": "References to run/epoch/Sync records, ordered timeline cursor, and latest save point; not embedded full history.",
            "fields": [
              {
                "name": "run_id",
                "type": "string | null"
              },
              {
                "name": "epoch_id",
                "type": "string | null"
              },
              {
                "name": "sync_id",
                "type": "string | null"
              },
              {
                "name": "timeline_cursor",
                "type": "number"
              },
              {
                "name": "save_point_id",
                "type": "string | null"
              }
            ]
          }
        ],
        "name": "HarnessState",
