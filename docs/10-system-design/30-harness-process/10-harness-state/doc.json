      "children": []
    },
    "hs-authority": {
      "id": "hs-authority",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Recording Run intent does not grant a worker permission to start. Dispatch State owns the fenced lease, and readiness determines whether Run can proceed. A queued request grants no authority."
        }
      ],
      "children": []
    },
