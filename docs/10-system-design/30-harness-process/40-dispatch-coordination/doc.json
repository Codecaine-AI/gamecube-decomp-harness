      "id": "dc-handoff",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The current owner stops admission, settles work, and records release before an eligible successor can acquire authority. Automatic epoch Sync uses the retained Run lease and does not take this handoff path."
        }
      ],
      "children": []
