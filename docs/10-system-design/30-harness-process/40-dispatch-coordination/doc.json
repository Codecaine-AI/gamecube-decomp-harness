    "dc-opening": {
      "id": "dc-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Dispatch State grants one workflow at a time the authority to dispatch workers or mutate a game's protected checkout. A fenced lease identifies the current owner. A queued request records intent but cannot act until authority is available."
        }
      ],
      "children": []
    },
    "dc-paths-h": {
      "id": "dc-paths-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Two Coordination Paths"
        }
      ],
      "children": []
    },
    "dc-paths": {
      "id": "dc-paths",
      "type": "structured-table",
      "props": {
        "columns": [
          "Path",
          "Authority"
        ],
        "rows": [
          [
            "Automatic epoch Sync",
            "Run retains its current lease after claims and integration settle. No second manual Sync lease is created."
          ],
          [
            "Initial or manual Sync",
            "Sync acquires its own lease. If Run owns authority, handoff waits for safe settlement and release."
          ],
          [
            "Paused or blocked work",
            "A pause request or stale heartbeat alone cannot replace the owner. Release or reconciled recovery establishes authority."
          ]
        ]
      },
      "children": []
    },
