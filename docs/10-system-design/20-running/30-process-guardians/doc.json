    "b-25-process-guardians-those-run-loop-produced-22": {
      "id": "b-25-process-guardians-those-run-loop-produced-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Those run-loop-produced wake events ask the scheduler to admit, reprioritize,\nor back off according to policy. The run loop does not edit source or perform\ndecomp research; it only applies durable scheduling policy and starts workers."
        }
      ],
      "children": []
    },
