      "id": "b-25-process-guardians-guardians-should-not-con-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Guardians should not constantly inspect the board as a second scheduler. They\nwake from operational health events:"
        }
      ],
      "children": []
