    "b-70-save-points-the-orchestrator-s-durab-3": {
      "id": "b-70-save-points-the-orchestrator-s-durab-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator's durable position is one canonical campaign per project, not\na pile of disconnected runs. Runs remain internal work segments; the campaign\nowns the timeline. A save point is the unit of that timeline: a commit in the\ncheckout's history plus the evidence needed to know where the effort stood at\nthat commit."
        }
      ],
      "children": []
    },
    "b-70-save-points-why-4": {
      "id": "b-70-save-points-why-4",
