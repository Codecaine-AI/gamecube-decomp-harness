    "b-70-save-points-save-points-are-created-11": {
      "id": "b-70-save-points-save-points-are-created-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Save points are created automatically at every phase boundary — init, pause,\ncheckpoint, QA, sync, and fresh run — and manually through server jobs\n("
        },
        {
          "insert": "save-point",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") or the dashboard's "
        },
        {
          "insert": "Save Point",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " action. The boundary hooks are\nbest-effort: a failed save point logs a warning but never blocks the boundary\naction itself."
        }
      ],
      "children": []
    },
