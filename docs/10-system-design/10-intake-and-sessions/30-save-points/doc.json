    "b-70-save-points-reports-used-to-be-ancho-5": {
      "id": "b-70-save-points-reports-used-to-be-ancho-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reports used to be anchored to whichever run was newest, so opening the\ndashboard after a fresh run showed 0% until a rebuild. Save points anchor every\nreport to a specific commit, so opening the dashboard always answers \"where are\nwe, and what hasn't been merged upstream yet\" from durable state."
        }
      ],
      "children": []
    },
