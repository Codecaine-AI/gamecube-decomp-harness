    "b-30-state-and-events-durable-state-is-the-orc-3": {
      "id": "b-30-state-and-events-durable-state-is-the-orc-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Durable state is the orchestrator's memory. It records the board, active work,\nagent sessions, scheduler epochs, worker states, checkpoints, facts, and wake\nevents. The state substrate allows workers and deterministic scheduling to\noperate at different times without losing context."
        }
