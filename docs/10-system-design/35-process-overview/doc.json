    "b-35-process-overview-intro-2": {
      "id": "b-35-process-overview-intro-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This page is the end-to-end narrative of one full game pass: a game is registered, a cycle opens on a captured baseline, and the game then moves through the sync, run, and PR phases and back through sync, while background knowledge jobs run alongside every phase. Phase mechanics and authority rules live in "
        },
        {
          "insert": "Game Workflows",
          "attributes": {
            "link": "../50-workflows"
          }
        },
        {
          "insert": "; the durable shape of each phase lives under "
        },
        {
          "insert": "state composition",
          "attributes": {
            "link": "../40-harness-state/10-state-composition"
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-35-process-overview-game-lifecycle-outline-39": {
      "id": "b-35-process-overview-game-lifecycle-outline-39",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "register the game and provision its canonical worktree",
            "kind": "step"
          },
          {
            "text": "open a cycle and capture its baseline revision",
            "kind": "step",
            "steps": [
              {
                "text": "sync reconciles inputs and publishes the working baseline",
                "kind": "step"
              },
              {
                "text": "run dispatches epochs and publishes confirmed game work",
                "kind": "step"
              },
              {
                "text": "PR prepares, reviews, and publishes the campaign",
                "kind": "step"
              },
              {
                "text": "operator-started sync reconciles merged results into the next baseline",
                "kind": "step"
              },
              {
                "text": "background knowledge jobs run alongside every phase",
                "kind": "note"
              }
            ]
          }
        ]
      },
      "children": []
    },
