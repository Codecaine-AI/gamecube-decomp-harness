    "b-35-process-overview-registration-4": {
      "id": "b-35-process-overview-registration-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A game enters the harness through registration: the game supplies its source repository, tools, policy defaults, and knowledge inputs, and the harness provisions the canonical worktree the phases will operate on. "
        },
        {
          "insert": "Registration and Setup",
          "attributes": {
            "link": "../30-games/20-registration-and-setup"
          }
        },
        {
          "insert": " defines what a game declares and how its worktree is prepared."
        }
      ],
      "children": []
    },
    "b-35-process-overview-cycle-open-5": {
      "id": "b-35-process-overview-cycle-open-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All phase work happens inside a cycle. Opening a cycle allocates the cycle's envelope identity and captures the baseline revision the coming phases build on; "
        },
        {
          "insert": "Cycles",
          "attributes": {
            "link": "../30-games/30-cycles"
          }
        },
        {
          "insert": " defines the cycle container and its single-active rule, and "
        },
        {
          "insert": "cycle state",
          "attributes": {
            "link": "../40-harness-state/10-state-composition/30-cycle-state"
          }
        },
        {
          "insert": " holds its durable shape."
        }
      ],
      "children": []
    },
