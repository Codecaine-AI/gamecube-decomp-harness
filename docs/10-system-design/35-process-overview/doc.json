    "b-35-process-overview-knowledge-processing-36": {
      "id": "b-35-process-overview-knowledge-processing-36",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge processing is not a fourth phase. Background knowledge jobs run alongside every phase: a worker enqueues knowledge candidates as it closes, a background processor claims each job under a lease, materializes its outputs, and publishes them so that later workers observe an advanced knowledge revision. The lane never takes the dispatch lease and never blocks a phase handoff."
        }
      ],
      "children": []
    },
