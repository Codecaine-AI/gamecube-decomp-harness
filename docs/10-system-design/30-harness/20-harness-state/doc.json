		"b-10-state-composition-composition-tree-18": {
			"id": "b-10-state-composition-composition-tree-18",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The aggregate presents one coherent read across cycle lineage, workflow summaries, dispatch authority, background knowledge freshness, and tracing. Each linked domain state remains the authority for its own payload and transition rules."
				}
			],
			"children": []
		},
