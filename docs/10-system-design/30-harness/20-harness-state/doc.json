								"type": "integer"
							},
							{
								"name": "active_operation_ids",
								"type": "OperationId[]"
							}
						]
					},
					{
						"name": "updated_at",
						"type": "timestamp"
					}
				],
				"name": "HarnessState"
			},
			"children": []
		},
		"b-10-harness-state-the-session-and-workflow-4": {
			"id": "b-10-harness-state-the-session-and-workflow-4",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Cycle and workflow slots mirror identity, status, blockers, and the minimum lineage needed for an at-a-glance read. A null slot means no object of that kind exists; a null active_workflow means dispatch authority is free even when workflow slots remain populated."
				}
			],
			"children": []
		},
		"b-harness-state-one-slot-heading": {
			"id": "b-harness-state-one-slot-heading",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "One Active Workflow Slot"
				}
			],
			"children": []
		},
		"b-harness-state-one-slot-contract": {
			"id": "b-harness-state-one-slot-contract",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "HarnessState owns the invariant: one game has at most one current "
				},
				{
					"insert": "active_workflow",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " lease across sync, run, and PR. Queued requests express intent but grant no authority, and a successor cannot acquire until the current lease is durably released or recovered. "
				},
				{
					"insert": "Dispatch Authority and Handoffs",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/30-harness/50-dispatch-authority"
						}
					}
				},
				{
					"insert": " defines the lease mechanics."
				}
			],
			"children": []
		},
		"b-10-harness-state-revision-contract-6": {
			"id": "b-10-harness-state-revision-contract-6",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Aggregate Revision"
				}
			],
			"children": []
		},
		"b-10-harness-state-game-revision-advan-7": {
			"id": "b-10-harness-state-game-revision-advan-7",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "game_revision advances once for each accepted transaction that changes the aggregate view. Readers name it to obtain a coherent composition, and writers present the expected revision so commands derived from stale state are refused."
				}
			],
			"children": []
		},
		"b-10-harness-state-child-revisions-remain-l-8": {
			"id": "b-10-harness-state-child-revisions-remain-l-8",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Child revisions remain local to their state objects. HarnessState records the coherent aggregate after a child transition; it does not replace domain ordering or trace lineage."
				}
			],
			"children": []
		},
		"b-20-workflow-slot-structure-2": {
			"id": "b-20-workflow-slot-structure-2",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "StateEnvelope"
				}
			],
			"children": []
		},
		"b-restored-state-envelope-shape-20260814": {
			"id": "b-restored-state-envelope-shape-20260814",
			"type": "state-shape",
			"props": {
				"description": "Shared metadata carried by every durable game state object.",
				"example": "{\n  \"id\": \"run-2026-08-11-01\",\n  \"game_id\": \"melee\",\n  \"kind\": \"run\",\n  \"status\": \"active\",\n  \"revision\": 288,\n  \"created_at\": \"2026-08-11T18:00:00Z\",\n  \"updated_at\": \"2026-08-11T18:42:08Z\",\n  \"trace_id\": \"trace-run-2026-08-11-01\",\n  \"caused_by_event_id\": \"event-92811\",\n  \"blockers\": []\n}",
				"fields": [
					{
						"name": "id",
						"type": "StateObjectId",
						"description": "Stable identity of the state object."
					},
					{
						"name": "game_id",
						"type": "GameId",
						"description": "Owning game."
					},
					{
						"name": "kind",
						"type": "StateKind",
						"description": "Domain state-machine kind."
					},
					{
						"name": "status",
						"type": "domain-specific enum",
						"description": "A value owned by this state kind."
					},
					{
						"name": "revision",
						"type": "integer",
						"description": "Monotonic accepted-transition version."
					},
					{
						"name": "created_at",
						"type": "timestamp"
					},
					{
						"name": "updated_at",
						"type": "timestamp"
					},
					{
						"name": "trace_id",
						"type": "TraceId",
						"description": "Root trace for the object."
					},
					{
						"name": "caused_by_event_id",
						"type": "EventId",
						"required": true,
						"description": "The accepted event that produced this revision, including revision 1."
					},
					{
						"name": "blockers",
						"type": "Blocker[]",
						"fields": [
							{
								"name": "code",
								"type": "string"
							},
							{
								"name": "message",
								"type": "string"
							},
							{
								"name": "source_kind",
								"type": "string"
							},
							{
								"name": "source_id",
								"type": "string"
							},
							{
								"name": "recoverable",
								"type": "boolean"
							}
						]
					}
				],
				"name": "StateEnvelope"
			},
			"children": []
		},
		"b-20-workflow-slot-the-domain-object-extend-4": {
			"id": "b-20-workflow-slot-the-domain-object-extend-4",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Cycle, sync, run, and PR campaign objects extend this envelope with their own payload and status enum. The envelope carries no dispatch authority field: a sync, run, or PR object may act only when HarnessState points its active workflow lease at that object."
				}
			],
			"children": []
		},
		"b-20-workflow-slot-what-it-does-5": {
			"id": "b-20-workflow-slot-what-it-does-5",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Envelope Concerns"
				}
			],
			"children": []
		},
		"b-20-workflow-slot-identity-and-routing-6": {
			"id": "b-20-workflow-slot-identity-and-routing-6",
			"type": "structured-table",
			"props": {
				"columns": [
					"Concern",
					"Fields",
					"Authority",
					"Consumer"
				],
				"rows": [
					[
						"Identity and routing",
						"id, game_id, kind",
						"The domain store allocates stable identity.",
						"Stores, views, events, and traces"
					],
					[
						"Accepted ordering",
						"revision, caused_by_event_id, updated_at",
						"The domain transition commits the next local revision.",
						"CAS writers and reconstruction"
					],
					[
						"Domain status",
						"status",
						"Each state kind owns its vocabulary and transition rules.",
						"Generic views display but do not reinterpret it"
					],
					[
						"Tracing",
						"trace_id",
						"Tracing owns cross-transition lineage.",
						"Operators and trace readers"
					],
					[
						"Blockage",
						"blockers",
						"The domain records why an operation cannot proceed.",
						"Action projection and recovery"
					],
					[
						"Dispatch relationship",
						"No envelope field",
						"HarnessState.active_workflow is the sole grant.",
						"Host dispatch and checkout mutation"
					]
				]
			},
			"children": []
		},
		"b-20-workflow-slot-state-remains-authoritat-20": {
			"id": "b-20-workflow-slot-state-remains-authoritat-20",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "State remains authoritative for the current revision. "
				},
				{
					"insert": "Envelope and Lineage",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/60-tracing/10-envelope-and-lineage"
						}
					}
				},
				{
					"insert": " owns provenance and accepted-event reconstruction around the snapshot."
				}
			],
			"children": []
		},
		"b-10-harness-state-consumer-reads-9": {
			"id": "b-10-harness-state-consumer-reads-9",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Read the Aggregate"
				}
			],
			"children": []
		},
		"b-10-harness-state-read-harnessstate-once-a-10": {
			"id": "b-10-harness-state-read-harnessstate-once-a-10",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Read one coherent game projection",
						"steps": [
							{
								"text": "Read HarnessState at a named `game_revision`"
							},
							{
								"text": "Use its slots to identify the current objects and summarize their status"
							},
							{
								"text": "Resolve the domain state only when payload or transition detail is required"
							},
							{
								"text": "Use `active_workflow` only to identify current dispatch authority"
							},
							{
								"text": "Consume the server-owned action projection instead of deriving authority in the client"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-20-workflow-slot-flows-21": {
			"id": "b-20-workflow-slot-flows-21",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Envelope Procedures"
				}
			],
			"children": []
		},
		"b-20-workflow-slot-create-an-enveloped-obje-22": {
			"id": "b-20-workflow-slot-create-an-enveloped-obje-22",
			"type": "heading",
			"props": {
				"level": 3
			},
			"text": [
				{
					"insert": "Create an Enveloped Object"
				}
			],
			"children": []
		},
		"b-20-workflow-slot-allocate-a-stable-object-23": {
			"id": "b-20-workflow-slot-allocate-a-stable-object-23",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Create an enveloped state object",
						"steps": [
							{
								"text": "Allocate a stable object identity and trace root"
							},
							{
								"text": "Set the game, kind, initial domain status, and payload"
							},
							{
								"text": "Commit revision 1 with timestamps and its accepted creation event"
							},
							{
								"text": "Leave dispatch authority out of the envelope"
							},
							{
								"text": "Install the object in the corresponding HarnessState slot at the next game revision"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-20-workflow-slot-transition-status-28": {
			"id": "b-20-workflow-slot-transition-status-28",
			"type": "heading",
			"props": {
				"level": 3
			},
			"text": [
				{
					"insert": "Transition Status"
				}
			],
			"children": []
		},
		"b-20-workflow-slot-read-the-object-and-requ-29": {
			"id": "b-20-workflow-slot-read-the-object-and-requ-29",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Accept a domain transition",
						"steps": [
							{
								"text": "Read the object and require its expected local revision"
							},
							{
								"text": "Validate the requested edge and current blockers"
							},
							{
								"text": "Require the current dispatch lease for guarded host actions"
							},
							{
								"text": "Commit payload, status, blockers, revision, timestamp, and causing event atomically"
							},
							{
								"text": "Advance HarnessState so aggregate readers observe the accepted child revision"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-20-workflow-slot-a-refused-or-rolled-back-35": {
			"id": "b-20-workflow-slot-a-refused-or-rolled-back-35",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "A refused or rolled-back transition changes neither the state revision nor accepted event history."
				}
			],
			"children": []
		},
		"b-20-workflow-slot-supersede-an-object-36": {
			"id": "b-20-workflow-slot-supersede-an-object-36",
			"type": "heading",
			"props": {
				"level": 3
			},
			"text": [
				{
					"insert": "Supersede an Object"
				}
			],
			"children": []
		},
		"b-20-workflow-slot-move-the-existing-object-37": {
			"id": "b-20-workflow-slot-move-the-existing-object-37",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Supersede a durable state object",
						"steps": [
							{
								"text": "Settle the existing object's obligations and enter its terminal or replaced status"
							},
							{
								"text": "Release any HarnessState dispatch lease held by that object"
							},
							{
								"text": "Preserve its identity, revision, trace, and event lineage"
							},
							{
								"text": "Create the successor with a new identity, revision 1, and trace root"
							},
							{
								"text": "Replace the corresponding HarnessState slot in one aggregate transition"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-20-workflow-slot-supersession-never-reuse-42": {
			"id": "b-20-workflow-slot-supersession-never-reuse-42",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Supersession never reuses identity or resets an existing revision. Pause and lease reacquisition keep the same object and continue its revision sequence."
				}
			],
			"children": []
		}
	}
}
