    {
      "id": "a240b789-5c32-4e74-a1d0-0322346b2439",
      "ops": [
        {
          "type": "updateBlock",
          "blockId": "b-35-process-overview-intro-2",
          "text": [
            {
              "insert": "A game moves through registration, baseline sync, autonomous run work, PR publication, and post-merge reconciliation. Each section shows one process at system level; the workflow and state pages retain the detailed mechanics and durable contracts."
            }
          ]
        },
        {
          "type": "componentAction",
          "blockId": "b-35-process-overview-game-lifecycle-outline-39",
          "action": "process-outline.setSteps",
          "params": {
            "steps": [
              {
                "text": "register the game and prepare its canonical worktree",
                "steps": [
                  {
                    "text": "open the first cycle against a validated baseline"
                  }
                ]
              },
              {
                "text": "sync source and knowledge inputs into game truth"
              },
              {
                "text": "run autonomous epochs and confirm eligible work"
              },
              {
                "text": "prepare, review, and publish the PR campaign"
              },
              {
                "text": "sync merged results into the next working baseline"
              },
              {
                "text": "process knowledge jobs alongside every phase",
                "kind": "note"
              }
            ]
          }
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-registration-4",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-cycle-open-5",
          "mode": "subtree"
        },
        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-registration-outline-40",
          "parentId": "b-35-process-overview-root-1",
          "index": 3,
          "blockType": "process-outline",
          "props": {
            "steps": [
              {
                "text": "register the game",
                "steps": [
                  {
                    "text": "bind the source repository, tools, policy defaults, and knowledge inputs to a stable game identity"
                  },
                  {
                    "text": "validate the game descriptor before the game becomes operable"
                  }
                ]
              },
              {
                "text": "provision the canonical worktree",
                "steps": [
                  {
                    "text": "create the one worktree owned by the game"
                  },
                  {
                    "text": "verify its source boundary before assigning it to a cycle"
                  }
                ]
              },
              {
                "text": "open the cycle",
                "steps": [
                  {
                    "text": "require the previous cycle to be closed"
                  },
                  {
                    "text": "allocate the cycle envelope and capture the opening policy"
                  },
                  {
                    "text": "run opening sync to prepare and validate the baseline"
                  },
                  {
                    "text": "activate the cycle only after the worktree and baseline agree"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "updateBlock",
          "blockId": "b-35-process-overview-game-phase-walk-6",
          "text": [
            {
              "insert": "Sync"
            }
          ]
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-sync-establishes-the-w-7",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-run-produces-confirmed-12",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-pr-turns-confirmed-out-17",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-the-next-intake-return-22",
          "mode": "subtree"
        },
        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-sync-outline-41",
          "parentId": "b-35-process-overview-root-1",
          "index": 5,
          "blockType": "process-outline",
          "props": {
            "steps": [
              {
                "text": "observe source or knowledge intake",
                "steps": [
                  {
                    "text": "record upstream movement, merged PRs, staged corpora, or a knowledge-only request"
                  },
                  {
                    "text": "wait for the operator to start reconciliation"
                  }
                ]
              },
              {
                "text": "acquire dispatch authority and stage the requested changes"
              },
              {
                "text": "reconcile source history, PR identities, and knowledge inputs away from the cycle tree"
              },
              {
                "text": "validate the complete staged result"
              },
              {
                "text": "wait for operator confirmation"
              },
              {
                "text": "publish the new baseline atomically",
                "steps": [
                  {
                    "text": "advance cycle truth and the accepted knowledge revision"
                  },
                  {
                    "text": "release dispatch authority for the next phase"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "updateBlock",
          "blockId": "b-35-process-overview-handoffs-25",
          "text": [
            {
              "insert": "Run"
            }
          ]
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-sync-to-run-26",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-run-to-pr-28",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-pr-to-sync-30",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-interrupted-phase-32",
          "mode": "subtree"
        },
        {
          "type": "deleteBlock",
          "blockId": "b-35-process-overview-a-cycle-may-re-34",
          "mode": "subtree"
        },
        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-run-outline-42",
          "parentId": "b-35-process-overview-root-1",
          "index": 7,
          "blockType": "process-outline",
          "props": {
            "steps": [
              {
                "text": "acquire dispatch authority after sync releases it"
              },
              {
                "text": "wake the director on a durable event and snapshot the board"
              },
              {
                "text": "rank targets and admit one epoch of bounded work"
              },
              {
                "text": "dispatch workers into isolated worktrees"
              },
              {
                "text": "integrate worker results serially into game lineage"
              },
              {
                "text": "close the epoch boundary",
                "steps": [
                  {
                    "text": "confirm or revert tentative work"
                  },
                  {
                    "text": "record the integration commit and durable evidence"
                  },
                  {
                    "text": "repeat until the run drains, pauses, or closes"
                  }
                ]
              },
              {
                "text": "settle or recover active workers before handing authority to PR"
              }
            ]
          }
        },
        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-pr-heading-43",
          "parentId": "b-35-process-overview-root-1",
          "index": 8,
          "blockType": "heading",
          "props": {
            "level": 2
          },
          "text": [
            {
              "insert": "PR"
            }
          ]
        },
        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-pr-outline-44",
          "parentId": "b-35-process-overview-root-1",
          "index": 9,
          "blockType": "process-outline",
          "props": {
            "steps": [
              {
                "text": "classify the run result",
                "steps": [
                  {
                    "text": "promote boundary-confirmed exact matches that pass regression checks"
                  },
                  {
                    "text": "retain improvements and blocked candidates as local evidence"
                  }
                ]
              },
              {
                "text": "run the QA ship gate and repair or reject ship-blocking findings"
              },
              {
                "text": "split the eligible ship set into a review-sized series at a stable point"
              },
              {
                "text": "open one durable PR campaign"
              },
              {
                "text": "publish batches under operator control"
              },
              {
                "text": "observe remote review state and dispatch bounded review, fixer, splitter, and QA-repair work"
              },
              {
                "text": "close the campaign after every series is merged or closed"
              },
              {
                "text": "return merged identities and outcomes to operator-started sync"
              }
            ]
          }
        },
        {
          "type": "updateBlock",
          "blockId": "b-35-process-overview-knowledge-lane-35",
          "text": [
            {
              "insert": "Knowledge Processing"
            }
          ]
        },
