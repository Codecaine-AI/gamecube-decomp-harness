        {
          "type": "insertBlock",
          "blockId": "b-35-process-overview-knowledge-outline-45",
          "parentId": "b-35-process-overview-root-1",
          "index": 11,
          "blockType": "process-outline",
          "props": {
            "steps": [
              {
                "text": "enqueue results and evidence when a worker closes"
              },
              {
                "text": "claim the durable job under an expiring, fenced lease"
              },
              {
                "text": "materialize reusable learnings and attempt records"
              },
              {
                "text": "publish accepted results at the governing authority boundary"
              },
              {
                "text": "advance the accepted knowledge revision"
              },
              {
                "text": "refresh worker-facing knowledge surfaces for subsequent work"
              },
              {
                "text": "run without taking the game dispatch lease or blocking phase handoffs",
                "kind": "note"
              }
            ]
          }
        }
