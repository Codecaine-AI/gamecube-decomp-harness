			"text": [
				{
					"insert": "The harness wraps one registered game in a durable cycle, coordinates its workflow state, and carries work from an opening baseline through run and PR publication. The end-to-end process comes first; state and authority then explain how each handoff remains recoverable."
				}
			],
			"children": []
		},
