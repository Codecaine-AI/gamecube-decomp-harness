		"b-30-operator-actions-all-other-canonical-acti-53": {
			"id": "b-30-operator-actions-all-other-canonical-acti-53",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Sync remains validated until the operator confirms sync.publish. Later upstream movement adds a staleness blocker and requires validation again before publication can be projected as enabled."
				}
			],
