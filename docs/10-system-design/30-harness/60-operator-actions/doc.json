		"b-30-operator-actions-text-3": {
			"id": "b-30-operator-actions-text-3",
			"type": "state-shape",
			"props": {
				"name": "HarnessStateView",
				"fields": [
					{
						"name": "game_id",
						"type": "GameId",
						"description": "Stable game identity."
					},
					{
						"name": "game_revision",
						"type": "integer",
						"description": "Aggregate revision used for every projected field and guard."
					},
					{
						"name": "cycle",
						"type": "CycleSummary | null",
						"description": "Current cycle identity, head, timeline evidence, and blockers."
					},
					{
						"name": "active_workflow",
						"type": "ActiveWorkflowSummary | null",
						"description": "Current dispatch-lease holder and headline."
					},
					{
						"name": "queued_dispatch_requests",
						"type": "DispatchRequest[]",
						"description": "Ordered successors waiting for authority."
					},
					{
						"name": "run",
						"type": "RunSummary | null"
					},
					{
						"name": "pr_work",
						"type": "PrWorkflowSummary[]"
					},
					{
						"name": "sync",
						"type": "SyncSummary | null"
					},
					{
						"name": "knowledge",
						"type": "KnowledgeFreshnessSummary"
					},
					{
						"name": "active_operations",
						"type": "OperationSummary[]"
					},
					{
						"name": "recent_events",
						"type": "EventSummary[]",
						"description": "Bounded history; never current-state authority."
					},
					{
						"name": "available_actions",
						"type": "ActionProjection[21]",
						"description": "Complete canonical action inventory."
					},
					{
						"name": "compatibility_actions",
						"type": "ActionProjection[]",
						"description": "Noncanonical compatibility operations."
					}
				],
				"example": "{\n  \"game_id\": \"melee\",\n  \"game_revision\": 1842,\n  \"cycle\": {\n    \"cycle_id\": \"cycle-7\",\n    \"head_revision\": \"upstream-9ba1\"\n  },\n  \"active_workflow\": {\n    \"kind\": \"run\",\n    \"workflow_id\": \"run-01\",\n    \"status\": \"draining\",\n    \"headline\": \"Settling two claims\"\n  },\n  \"queued_dispatch_requests\": [\n    {\n      \"target_kind\": \"sync\",\n      \"target_workflow_id\": \"sync-02\"\n    }\n  ],\n  \"run\": {\n    \"run_id\": \"run-01\",\n    \"status\": \"draining\"\n  },\n  \"pr_work\": [],\n  \"sync\": {\n    \"sync_id\": \"sync-02\",\n    \"status\": \"requested\"\n  },\n  \"knowledge\": {\n    \"published_revision\": \"knowledge-381\",\n    \"queued\": 6,\n    \"claimed\": 0,\n    \"running\": 1,\n    \"waiting\": 1,\n    \"failed\": 0\n  },\n  \"active_operations\": [],\n  \"recent_events\": [],\n  \"available_actions\": [\n    {\n      \"action_id\": \"run.pause\",\n      \"enabled\": false\n    }\n  ],\n  \"compatibility_actions\": []\n}"
			},
			"children": []
		},
