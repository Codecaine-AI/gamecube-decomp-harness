{
  "version": 1,
  "id": "dispatch-lease-handoff",
  "title": "Dispatch lease handoff",
  "participants": [
    {
      "id": "operator",
      "name": "operator",
      "kind": "actor",
      "label": "Operator"
    },
    {
      "id": "harness",
      "name": "harness",
      "kind": "participant",
      "label": "HarnessState"
    },
    {
      "id": "current",
      "name": "current",
      "kind": "participant",
      "label": "Current workflow"
    },
    {
      "id": "successor",
      "name": "successor",
      "kind": "participant",
      "label": "Successor workflow"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "dispatch-m1",
      "from": "operator",
      "to": "harness",
      "line": "sync",
      "text": "request successor dispatch"
    },
    {
      "kind": "message",
      "id": "dispatch-m2",
      "from": "harness",
      "to": "current",
      "line": "sync",
      "text": "stamp requested handoff; stop the holder"
    },
    {
      "kind": "message",
      "id": "dispatch-m3",
      "from": "current",
      "to": "harness",
      "line": "return",
      "text": "settled work and handoff evidence"
    },
    {
      "kind": "message",
      "id": "dispatch-m4",
      "from": "harness",
      "to": "current",
      "line": "sync",
      "text": "release current lease"
    },
    {
      "kind": "message",
      "id": "dispatch-m5",
      "from": "harness",
      "to": "successor",
      "line": "sync",
      "text": "acquire with a fresh lease_id"
    }
  ],
  "style": {
    "accent": "#5B7FBD"
  }
}
