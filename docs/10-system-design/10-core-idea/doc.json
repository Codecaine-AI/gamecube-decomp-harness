    "b-10-core-idea-decomp-work-follows-a-su-1": {
      "id": "b-10-core-idea-decomp-work-follows-a-su-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decomp work follows a Sudoku mental model: each discovered fact constrains other targets and makes later matches easier. A worker run ends after a bounded move rather than requiring the current file to be finished. Each move persists to a durable shared board so parallel workers can build on accumulated knowledge without depending on one run to complete the problem."
        }
      ],
      "children": []
    },
    "b-10-core-idea-think-like-sudoku-2": {
      "id": "b-10-core-idea-think-like-sudoku-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Think Like Sudoku"
        }
      ],
      "children": []
    },
    "b-10-core-idea-the-core-idea-of-this-sy-3": {
      "id": "b-10-core-idea-the-core-idea-of-this-sy-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The core idea of this system is to treat the process of Decomp like filling out a Sudoku board"
        }
      ],
      "children": []
    },
