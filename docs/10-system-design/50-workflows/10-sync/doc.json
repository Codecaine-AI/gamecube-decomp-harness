    "b-10-sync-sync-occupies-the-sync-w-18": {
      "id": "b-10-sync-sync-occupies-the-sync-w-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync occupies the sync workflow slot in "
        },
        {
          "insert": "HarnessState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It may dispatch reconciliation workers and mutate sync staging surfaces only while it holds the game dispatch lease."
        }
      ],
      "children": []
    },
    "b-10-sync-text-19": {
      "id": "b-10-sync-text-19",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "requested\n  -> no lease; observation only\noperator sync.start\n  -> acquire a free lease\n  -> or queue the request behind the active workflow\nactive sync\n  -> ingest\n  -> reconcile\n  -> validate\n  -> wait for operator confirmation\n  -> publish\n  -> release lease"
        }
      ],
      "children": []
    },
    "b-10-sync-if-run-or-pr-holds-the-l-20": {
      "id": "b-10-sync-if-run-or-pr-holds-the-l-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If run or PR holds the lease, sync remains queued until that workflow completes a durable drain and handoff. The current holder stops new admission, settles or recovers active queue work, records the handoff snapshot, and releases authority before sync starts."
        }
      ],
      "children": []
    },
