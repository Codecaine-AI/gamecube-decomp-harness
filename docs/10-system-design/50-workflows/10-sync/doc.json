      "id": "b-10-sync-marks-sync-published-re-52",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Marks sync published, releases dispatch authority, and pins boundary evidence to the published head."
        }
      ],
      "children": []
    },
    "b-10-sync-a-knowledge-only-publica-53": {
      "id": "b-10-sync-a-knowledge-only-publica-53",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A knowledge-only publication advances the monotonic knowledge revision without moving the cycle head, recording "
        },
        {
          "insert": "remote_application",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", creating source invalidations, or pushing PR branches. Transaction or push failure leaves sync blocked with durable recovery state; it never degrades to a log-only warning."
        }
      ],
      "children": []
    },
    "b-10-sync-statuses-54": {
      "id": "b-10-sync-statuses-54",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Statuses"
        }
      ],
      "children": []
    },
    "b-10-sync-status-meaning-sta-55": {
      "id": "b-10-sync-status-meaning-sta-55",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Status | Meaning | Stable Invariant |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "requested",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Intake is observed but not started. | No lease is held and no protected state changes. |\n| "
        },
        {
          "insert": "ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Sync stages source and knowledge inputs. | Canonical source and knowledge truth remain unchanged. |\n| "
        },
        {
          "insert": "reconciling",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Staging rebases cycle history and open PR series. | Cycle current remains untouched. |\n| "
        },
        {
          "insert": "validating",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Staged state produces publication evidence. | Publication cannot start without successful evidence. |\n| "
        },
        {
          "insert": "validated",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Evidence is complete and awaits confirmation. | Later upstream movement requires revalidation. |\n| "
        },
        {
          "insert": "publishing",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Confirmed records and branch updates are being committed. | Cancellation is unavailable; recovery moves forward. |\n| "
        },
        {
          "insert": "published",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The boundary and required pushes are durable. | Sync is terminal and releases authority. |\n| "
        },
        {
          "insert": "blocked",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Intervention or retry is required. | Lease and recoverable state are preserved when active. |\n| "
        },
        {
          "insert": "cancelled",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The operator abandoned pre-publication work. | Staging is discarded and cycle current is unchanged. |"
        }
      ],
      "children": []
    }
  }
}
