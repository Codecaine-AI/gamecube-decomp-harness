    "b-10-sync-observation-records-the-8": {
      "id": "b-10-sync-observation-records-the-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Observation records the request and its evidence. It does not acquire the dispatch lease, start workers, or mutate source and knowledge truth. Only the operator action "
        },
        {
          "insert": "sync.start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " activates the workflow."
        }
      ],
      "children": []
    },
    "b-10-sync-process-overview-57": {
      "id": "b-10-sync-process-overview-57",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Process Overview"
        }
      ],
      "children": []
    },
    "b-10-sync-sync-process-canvas-61": {
      "id": "b-10-sync-sync-process-canvas-61",
      "type": "canvas",
      "props": {
