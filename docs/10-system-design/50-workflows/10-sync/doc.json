    "b-10-sync-text-19": {
      "id": "b-10-sync-text-19",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "requested\n  -> no lease; observation only\noperator sync.start\n  -> acquire a free lease\n  -> or queue the request behind the active workflow\nactive sync\n  -> ingest\n  -> reconcile\n  -> validate\n  -> wait for operator confirmation\n  -> publish\n  -> release lease"
        }
