    "b-10-sync-if-run-or-pr-holds-the-l-20": {
      "id": "b-10-sync-if-run-or-pr-holds-the-l-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If run or PR holds the lease, sync remains queued until that workflow completes a durable drain and handoff. The current holder stops new admission, settles or recovers active queue work, records the handoff snapshot, and releases authority before sync starts."
        }
      ],
      "children": []
    },
