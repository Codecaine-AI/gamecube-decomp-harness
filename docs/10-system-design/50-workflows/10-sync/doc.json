			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Sync Process",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows/10-sync/20-process"
						}
					}
				},
				{
					"insert": " prepares the baseline, pulls Discord and merged-PR inputs into staging, reconciles source and PR series, validates the result, publishes on confirmation, and hands accepted external inputs to knowledge processing."
				}
			],
			"children": []
		},
