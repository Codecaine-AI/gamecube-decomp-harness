    },
    "b-10-sync-process-observe-stage-58": {
      "id": "b-10-sync-process-observe-stage-58",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The workflow first observes upstream or knowledge intake and preserves that observation evidence in the intake record. After the operator starts sync, every pre-publication change is made in the staging worktree, where source and knowledge inputs can be reconciled and validated without changing the active cycle."
        }
      ],
      "children": []
    },
    "b-10-sync-process-reconcile-59": {
      "id": "b-10-sync-process-reconcile-59",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reconciliation aligns cycle history with the requested upstream baseline and records the open PR series reconciled against staged history in "
        },
        {
          "insert": "pr_reconciliation",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Validation then establishes the operator gate: the operator may confirm publication only after the complete staged result has produced successful evidence."
        }
      ],
      "children": []
    },
    "b-10-sync-process-publish-60": {
      "id": "b-10-sync-process-publish-60",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Confirmed publication moves forward atomically and writes the publication record: the cycle head, upstream anchor, "
        },
        {
          "insert": "remote_application",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", invalidations, PR-push intents, and monotonic knowledge revision. "
        },
        {
          "insert": "Reconciliation and Publication",
          "attributes": {
            "link": "./20-reconciliation-and-publication"
          }
        },
        {
          "insert": " carries the detailed baseline, staging, and publication contract, while "
        },
        {
          "insert": "Sync State",
          "attributes": {
            "link": "./10-sync-state"
          }
        },
        {
          "insert": " defines the workflow-local statuses."
        }
      ],
      "children": []
    },
    "b-10-sync-dispatch-authority-17": {
      "id": "b-10-sync-dispatch-authority-17",
