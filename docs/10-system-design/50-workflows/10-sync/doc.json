    "b-10-sync-sync-is-the-operator-ini-1": {
      "id": "b-10-sync-sync-is-the-operator-ini-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync is the operator-initiated reconciliation workflow for a game cycle. It turns observed upstream or knowledge intake into a validated baseline while keeping canonical harness state unchanged until confirmed publication. The canonical "
        },
        {
          "insert": "sync state",
          "attributes": {
            "link": "../../40-harness-state/10-state-composition/40-sync-state"
          }
        },
        {
          "insert": " records its typed workflow state."
        }
      ],
      "children": []
    },
