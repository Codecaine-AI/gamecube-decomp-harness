		"b-10-sync-text-19": {
			"id": "b-10-sync-text-19",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Observe or refresh sync intake",
						"steps": [
							{
								"text": "No lease; canonical source and knowledge state do not change",
								"kind": "note"
							}
						]
					},
					{
						"text": "Operator starts Sync",
						"steps": [
							{
								"text": "Acquire a free dispatch lease"
							},
							{
								"text": "Otherwise queue behind the active workflow"
							}
						]
					},
					{
						"text": "Execute staged reconciliation and validation"
					},
					{
						"text": "Operator confirms publication"
					},
					{
						"text": "Publish or preserve durable recovery state, then release the lease"
					}
				]
			},
			"children": []
		},
