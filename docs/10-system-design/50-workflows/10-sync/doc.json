		"b-10-sync-observation-records-the-8": {
			"id": "b-10-sync-observation-records-the-8",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Observation refreshes intake evidence without acquiring dispatch authority. The operator action sync.start either activates Sync under a free lease or queues it behind the active workflow."
				}
			],
			"children": []
		},
