		"b-35-write-safety-the-necessity-ladder-26": {
			"id": "b-35-write-safety-the-necessity-ladder-26",
			"type": "structured-table",
			"props": {
				"columns": [
					"Rung",
					"Category",
					"Scope",
					"Required evidence",
					"Decision"
				],
				"rows": [
					[
						"1",
						[
							{
								"insert": "target-source",
								"attributes": {
									"code": true
								}
							}
						],
						"Target .c file.",
						"Target compile and objdiff evidence.",
						"The initial claim grants it."
					],
					[
						"2",
						[
							{
								"insert": "config-metadata",
								"attributes": {
									"code": true
								}
							}
						],
						"Relevant symbols or splits file.",
						"Rung-1 failure, symbol or range owner, and before/after objdiff.",
						"Runner may approve."
					],
					[
						"3",
						[
							{
								"insert": "owning-header",
								"attributes": {
									"code": true
								}
							}
						],
						"Exactly one canonical declaring header.",
						"Rung-1 and rung-2 failures, expected owner, and declaration evidence.",
						"Runner may approve in header mode."
					],
					[
						"4",
						[
							{
								"insert": "foreign-source",
								"attributes": {
									"code": true
								}
							}
						],
						"Definition-owner .c file.",
						"Every lower-rung failure plus definition owner and consumer scope.",
						"Always routed_cross_module; never auto-granted."
					]
				]
			},
			"children": []
		},
		"b-35-write-safety-widening-requests-travel-27": {
			"id": "b-35-write-safety-widening-requests-travel-27",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "A request names one category, exact paths, the mismatched declaration or symbol, expected owner, measured comparison evidence, and every lower-rung failure. The durable decision vocabulary is "
				},
				{
					"insert": "approved",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " | "
				},
				{
					"insert": "denied",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " | "
				},
				{
					"insert": "routed_cross_module",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": "."
				}
			],
			"children": []
		},
		"b-35-write-safety-rollout-controls-29": {
			"id": "b-35-write-safety-rollout-controls-29",
			"type": "structured-table",
			"props": {
				"title": "Write-set widening modes; default: off",
				"columns": [
					"Mode",
					"Runtime effect"
				],
				"rows": [
					[
						[
							{
								"insert": "off",
								"attributes": {
									"code": true
								}
							}
						],
						"Keep claims target-only and do not evaluate widening requests."
					],
					[
						[
							{
								"insert": "shadow",
								"attributes": {
									"code": true
								}
							}
						],
						"Record decisions but expose or apply no grant."
					],
					[
						[
							{
								"insert": "config",
								"attributes": {
									"code": true
								}
							}
						],
						"Apply approved config-metadata grants."
					],
					[
						[
							{
								"insert": "header",
								"attributes": {
									"code": true
								}
							}
						],
						"Apply approved config-metadata and owning-header grants."
					]
				]
			},
			"children": []
		},
		"b-35-write-safety-recycled-targets-reset-28": {
			"id": "b-35-write-safety-recycled-targets-reset-28",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "An expired, cancelled, or reaped token loses authority. A later claim mints a new token and starts again at target-source; old requests and decisions remain telemetry rather than authorization."
				}
			],
			"children": []
		},
		"b-35-write-safety-workspace-rule-7": {
			"id": "b-35-write-safety-workspace-rule-7",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Workspaces and Shared Writers"
				}
			],
			"children": []
		},
		"b-35-write-safety-the-main-checkout-remain-8": {
			"id": "b-35-write-safety-the-main-checkout-remain-8",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Worker worktrees isolate simultaneous attempts and keep unfinished changes out of the main checkout, which remains the canonical integration surface. Epoch-scoped Ninja slots and tool-specific pools cap shared machine pressure without weakening per-claim path authority."
				}
			],
			"children": []
		},
		"b-35-write-safety-risk-rule-20": {
			"id": "b-35-write-safety-risk-rule-20",
			"type": "structured-table",
			"props": {
				"columns": [
					"Risk",
					"Control"
				],
				"rows": [
					[
						"Same-file or shared-support edits",
						"Run concurrently only in isolated worktrees; apply selected checkpoints serially; route collisions through resolver or operator."
					],
					[
						"Unrequested out-of-set edits",
						"Categorize paths, record telemetry, and return a repair reason; bank only after authorization or revert."
					],
					[
						"Stale patch base",
						"Check base_rev; rebase and revalidate or reject."
					],
					[
						"Shared build/tool pressure",
						"Use epoch-scoped Ninja slots and tool-specific pools; every command still runs in the claim worktree."
					],
					[
						"Shared CSV/artifact writes",
						"Workers write shards; reducers alone write merged summaries, charts, and artifacts."
					],
					[
						"Bad integration",
						"Record scoped passes as tentative; the boundary confirms, or attributes and reverts the guilty change and marks it regressed."
					]
				]
			},
			"children": []
		},
		"b-35-write-safety-worker-output-integratio-9": {
			"id": "b-35-write-safety-worker-output-integratio-9",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Serial Integration"
				}
			],
			"children": []
		},
		"b-35-write-safety-worker-outputs-move-thro-10": {
			"id": "b-35-write-safety-worker-outputs-move-thro-10",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Integration is apply-on-accept. Accepting a worker checkpoint enqueues one integration job keyed by the checkpoint id; the Run Loop drains those jobs in single flight, and each patch is applied and committed to the live cycle repo immediately ("
				},
				{
					"insert": "commitAppliedPatch",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " in apps/server/src/core/cycle-runtime/phases/running/integration/worker-output-queue.ts, commit message "
				},
				{
					"insert": "worker-integration(<id8>): <targetKey> [checkpoint <id8>]",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": "). Nothing pools for the epoch boundary: its snapshot commit is residual, usually empty, and tolerated as a no-op."
				}
			],
			"children": []
		},
