		"b-35-write-safety-target-claim-write-sets-2": {
			"id": "b-35-write-safety-target-claim-write-sets-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Write safety fences every durable worker mutation, limits source changes to an approved category-typed write set, isolates attempts in host-provisioned worktrees, and serializes selected output into cycle ancestry."
				}
			],
			"children": []
		},
		"b-35-write-safety-write-safety-starts-with-3": {
			"id": "b-35-write-safety-write-safety-starts-with-3",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The target claim is the live authorization record. Lease expiry, cancellation, or reaping invalidates the ClaimToken inside the same transaction that would mutate worker evidence, while explicit host markers reserve recovery and settlement operations to named host paths."
				}
			],
			"children": []
		},
		"b-35-write-safety-claim-rule-4": {
			"id": "b-35-write-safety-claim-rule-4",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Fenced Mutations"
				}
			],
			"children": []
		},
		"b-35-write-safety-before-editing-a-worker-5": {
			"id": "b-35-write-safety-before-editing-a-worker-5",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The host creates the claim, worker state, lease, target-source write set, and ClaimToken atomically with the worker-job claim. The six mutation operations below accept that current authority and reject stale children before durable state changes."
				}
			],
			"children": []
		},
		"b-35-write-safety-text-6": {
			"id": "b-35-write-safety-text-6",
			"type": "interaction-surface",
			"props": {
				"title": "ClaimToken-fenced worker mutations",
				"operations": [
					{
						"name": "recordWorkerCheckpoint",
						"description": "Validate authority and append one runner-owned checkpoint.",
						"params": [
							{
								"name": "input",
								"type": "WorkerCheckpointInput",
								"description": "Includes authority: WorkerWriteAuthority and checkpoint evidence."
							}
						],
						"returns": "WorkerCheckpointRecord"
					},
					{
						"name": "closeWorkerState",
						"description": "Validate authority and close the worker lifecycle ledger.",
						"params": [
							{
								"name": "input",
								"type": "WorkerStateCloseInput",
								"description": "Includes authority: WorkerWriteAuthority and the runner-owned terminal outcome."
							}
						],
						"returns": "void"
					},
					{
						"name": "widenClaimWriteSet",
						"description": "Apply an approved write-set decision to the live claim.",
						"params": [
							{
								"name": "claimId",
								"type": "string"
							},
							{
								"name": "entries",
								"type": "WriteSetEntry[]"
							},
							{
								"name": "authority",
								"type": "WorkerWriteAuthority",
								"description": "Verifies ClaimToken { jobId, kind, leaseId } or an explicit { host: string } marker in the same transaction."
							}
						],
						"returns": "{ writeSet: string[]; entries: WriteSetEntry[] }"
					},
					{
						"name": "setClaimWorktreePath",
						"description": "Attach the host-provisioned worktree to the claim.",
						"params": [
							{
								"name": "claimId",
								"type": "string"
							},
							{
								"name": "workerStateId",
								"type": "string"
							},
							{
								"name": "worktreePath",
								"type": "string"
							},
							{
								"name": "authority",
								"type": "WorkerWriteAuthority",
								"description": "Verifies ClaimToken { jobId, kind, leaseId } or an explicit { host: string } marker in the same transaction."
							}
						],
						"returns": "void"
					},
					{
						"name": "appendWorkerSessionId",
						"description": "Append an executor session identity to the worker ledger.",
						"params": [
							{
								"name": "workerStateId",
								"type": "string"
							},
							{
								"name": "sessionId",
								"type": "string"
							},
							{
								"name": "authority",
								"type": "WorkerWriteAuthority",
								"description": "Verifies ClaimToken { jobId, kind, leaseId } or an explicit { host: string } marker in the same transaction."
							}
						],
						"returns": "void"
					},
					{
						"name": "updateWorkerStateBaselineScore",
						"description": "Record the runner-owned baseline used to test improvement.",
						"params": [
							{
								"name": "workerStateId",
								"type": "string"
							},
							{
								"name": "score",
								"type": "number | null"
							},
							{
								"name": "authority",
								"type": "WorkerWriteAuthority",
								"description": "Verifies ClaimToken { jobId, kind, leaseId } or an explicit { host: string } marker in the same transaction."
							}
						],
						"returns": "void"
					}
				]
			},
			"children": []
		},
