		"b-35-write-safety-scoped-checks-bank-31": {
			"id": "b-35-write-safety-scoped-checks-bank-31",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Scoped passes remain tentative until the epoch boundary runs the global build and zero-regression report. Confirmed outcomes can proceed to "
				},
				{
					"insert": "Score Gate and Handoff",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows"
						}
					}
				},
				{
					"insert": "; regression attribution reverts the guilty change, marks its outcome regressed through checkpoint evidence, and confirms the clean remainder."
				}
			],
			"children": []
		},
		"b-35-write-safety-apply-on-accept-base-rev-32": {
			"id": "b-35-write-safety-apply-on-accept-base-rev-32",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Every integration commit advances the base revision that newly provisioned sandbox workers start from, so a worker spawned mid-epoch builds on accepted work instead of the epoch-start tree and the conflict window shrinks to genuinely concurrent attempts. A patch that still collides — two workers started from the same base, the first landed, and the second's "
				},
				{
					"insert": "git apply --check",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " fails against the moved tree — records a conflict outcome for the integration resolver. A "
				},
				{
					"insert": "resolved",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " outcome is terminal: the harness commits the resolver's hand-merged tree and never re-applies the original patch."
				}
			],
			"children": []
		}
	}
}
