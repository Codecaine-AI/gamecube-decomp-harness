		"b-40-workers-run-workers-are-the-queu-1": {
			"id": "b-40-workers-run-workers-are-the-queu-1",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Run workers execute durable "
				},
				{
					"insert": "worker",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " jobs for epoch targets in host-provisioned worktrees. They sit beneath the "
				},
				{
					"insert": "Run Loop",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows/20-run/20-run-loop"
						}
					}
				},
				{
					"insert": ": the host atomically claims each slot job with its epoch target, writes "
				},
				{
					"insert": "task_spec.json",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", and submits "
				},
				{
					"insert": "worker-task",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " through "
				},
				{
					"insert": "WorkerExecutor",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": "; the child applies tactics and reports fenced worker state with its "
				},
				{
					"insert": "ClaimToken",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ". Keeping queue claims, dispatch, admission, settlement, recovery, epoch control, and draining on the host prevents children from extending their own authority."
				}
			],
			"children": []
		},
