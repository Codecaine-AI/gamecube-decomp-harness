    "b-40-workers-run-workers-are-the-queu-1": {
      "id": "b-40-workers-run-workers-are-the-queu-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run workers execute durable jobs of kind worker within the run's epochs. The host atomically claims each slot job with its epoch target, provisions the worktree, writes task_spec.json, and submits job-runner worker-task through the WorkerExecutor port. The child receives a ClaimToken for fenced worker-state writes but never claims queue work or receives the dispatch lease; admission, settlement, recovery, epoch control, and draining remain owned by the run director."
        }
      ],
      "children": []
    },
