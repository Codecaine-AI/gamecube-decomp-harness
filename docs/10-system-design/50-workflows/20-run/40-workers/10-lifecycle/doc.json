		"b-40-worker-lifecycle-worker-target-packet-lif-2": {
			"id": "b-40-worker-lifecycle-worker-target-packet-lif-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "A worker is one bounded decompilation attempt represented by a durable worker job and one epoch target claim. The host owns atomic claim, provisioning, executor submission, lease heartbeat, settlement, and recovery; the runner owns attempt feedback, validation, checkpoint selection, and lifecycle close."
				}
			],
			"children": []
		},
		"b-40-worker-lifecycle-a-worker-is-a-bounded-de-3": {
			"id": "b-40-worker-lifecycle-a-worker-is-a-bounded-de-3",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Admission uses the epoch-target id as the job dedupe key and the board rank as job priority. The claimed TaskSpec carries compact target context and the current ClaimToken, so the child can work within a precise authority boundary without claiming queue work."
				}
			],
			"children": []
		},
		"b-40-worker-lifecycle-lifecycle-4": {
			"id": "b-40-worker-lifecycle-lifecycle-4",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Lifecycle"
				}
			],
			"children": []
		},
		"b-40-worker-lifecycle-text-20": {
			"id": "b-40-worker-lifecycle-text-20",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Worker lifecycle",
						"steps": [
							{
								"text": "Claim",
								"steps": [
									{
										"text": "Admit one worker slot job for the epoch target, using the epoch-target id as the dedupe key and board rank as priority"
									},
									{
										"text": "Atomically claim the worker job and epoch target"
									},
									{
										"text": "Creates the active target claim, running worker state, lease, and current `ClaimToken`",
										"kind": "note"
									}
								]
							},
							{
								"text": "Provision",
								"steps": [
									{
										"text": "Provision an isolated worker worktree from the claim-time base revision — the newest committed integration tree, captured once at job claim"
									},
									{
										"text": "Write `TaskSpec` with target identity, compact context, resources, approved write set, and claim authority"
									},
									{
										"text": "Submit `job-runner worker-task --task-file …` through `WorkerExecutor`"
									}
								]
							},
							{
								"text": "Attempt",
								"steps": [
									{
										"text": "Collect target evidence and choose capabilities for one grounded hypothesis"
									},
									{
										"text": "Edit only paths authorized by the current claim"
									},
									{
										"text": "Return a checkpoint note or reach a turn boundary for runner validation"
									},
									{
										"text": "An out-of-set need is handed to Write Safety; widening is not decided here",
										"kind": "note"
									}
								]
							},
							{
								"text": "Validate",
								"steps": [
									{
										"text": "Diff the touched set against the pre-worker source snapshot"
									},
									{
										"text": "Run target and scope-following compile checks, objdiff, QA lint, post-return checks, and baseline comparison"
									},
									{
										"text": "Record the checkpoint and deterministically select the best eligible checkpoint"
									},
									{
										"text": "An exact score that fails a hard gate is repair evidence, not a selectable exact result",
										"kind": "note"
									}
								]
							},
							{
								"text": "Continue or close",
								"steps": [
									{
										"text": "Close immediately when an exact checkpoint passes every hard gate"
									},
									{
										"text": "Return repair or continuation feedback to the same worker session while its attempt budget remains"
									},
									{
										"text": "A banked improvement does not close the worker; the checkpoint is durable and each strictly new best extends the budget",
										"kind": "note"
									},
									{
										"text": "On budget exhaustion or claim deadline, preserve the best prior selectable checkpoint or the baseline"
									},
									{
										"text": "On provider, infrastructure, tool, build, parse, or session failure, close as error while preserving prior selectable evidence"
									}
								]
							},
							{
								"text": "Settle or recover",
								"steps": [
									{
										"text": "Close the worker state and target claim, finish the target, enqueue worker knowledge processing, and enqueue one integration job (dedupe key: the checkpoint id) for any selected checkpoint"
									},
									{
										"text": "Settle the worker job and wake the Run Loop"
									},
									{
										"text": "If a claim is interrupted, host recovery closes it as error and re-admits only when no selectable checkpoint can settle the target"
									}
								]
							}
						]
					}
				]
			},
			"children": []
		},
