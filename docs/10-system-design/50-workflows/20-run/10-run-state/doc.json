			"props": {},
			"text": [
				{
					"insert": "A target claim is the ownership boundary for one worker state. "
				},
				{
					"insert": "Write Safety",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows/20-run/40-workers/30-write-safety"
