		"b-10-run-state-control-page-42": {
			"id": "b-10-run-state-control-page-42",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "RunState",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " is the durable control object for one autonomous scheduling effort. It lives in "
				},
				{
					"insert": "Harness State",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/30-harness/20-harness-state"
						}
					}
				},
				{
					"insert": " and keeps immutable activation inputs, the moving cycle-head mirror, scheduler position, progress, and subordinate run records under one "
				},
				{
					"insert": "run_id",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ". Pause, recovery, and upstream application preserve that identity and its evidence timeline."
				}
			],
			"children": []
		},
		"b-10-run-state-run-identity-and-inputs-2": {
			"id": "b-10-run-state-run-identity-and-inputs-2",
