			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "RunState indexes durable evidence instead of embedding every subordinate row. Dispatch status answers whether queued work can execute; the record families below answer what was admitted, attempted, validated, integrated, or recovered."
				}
