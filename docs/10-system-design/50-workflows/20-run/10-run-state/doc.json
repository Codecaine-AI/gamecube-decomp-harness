		"b-10-run-state-control-status-is-the-so-17": {
			"id": "b-10-run-state-control-status-is-the-so-17",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Control status is the only run lifecycle vocabulary. Scheduler activity, process liveness, validation state, and progress events describe different concerns and never substitute for a status edge."
				}
			],
			"children": []
		},
