				"level": 2
			},
			"text": [
				{
					"insert": "Run Shape"
				}
			],
			"children": []
		},
		"b-restored-run-state-shape-20260814": {
			"id": "b-restored-run-state-shape-20260814",
			"type": "state-shape",
			"props": {
				"description": "Run control, scheduling position, progress, queue summaries, references, and tracing.",
				"example": "{\n  \"run_id\": \"run-2026-08-11-01\",\n  \"game_id\": \"melee\",\n  \"cycle_id\": \"cycle-7\",\n  \"revision\": 288,\n  \"inputs\": {\n    \"base_revision\": \"upstream-9ac4\",\n    \"policy_revision\": \"policy-42\",\n    \"starting_knowledge_revision\": \"knowledge-375\",\n    \"configuration_snapshot\": {\n      \"desired_workers\": 64\n    }\n  },\n  \"head_revision\": \"upstream-9ba1\",\n  \"control\": {\n    \"status\": \"active\",\n    \"stop_request\": null\n  },\n  \"scheduling\": {\n    \"desired_workers\": 64,\n    \"scheduler_condition\": \"boundary\"\n  },\n  \"progress\": {\n    \"baseline_score\": 72.642,\n    \"confirmed_score\": 73.147,\n    \"tentative_changes\": 2,\n    \"confirmed_changes\": 31,\n    \"regressed_changes\": 1\n  },\n  \"job_ids\": [\n    \"job-worker-501\",\n    \"job-integration-88\"\n  ],\n  \"integration_outcome_ids\": [\n    \"integration-outcome-88\"\n  ],\n  \"epoch_ids\": [\n    \"epoch-18\",\n    \"epoch-19\"\n  ],\n  \"remote_application_ids\": [\n    \"remote-application-3\"\n  ],\n  \"worker_state_ids\": [\n    \"worker-state-501\",\n    \"worker-state-502\"\n  ],\n  \"checkpoint_ids\": [\n    \"checkpoint-88\"\n  ],\n  \"active_operation_ids\": [],\n  \"latest_event_sequence\": 92811,\n  \"blockers\": []\n}",
				"fields": [
					{
						"name": "run_id",
						"type": "RunId"
					},
					{
						"name": "game_id",
						"type": "GameId"
					},
					{
						"name": "cycle_id",
						"type": "CycleId",
						"description": "Owning cycle container."
					},
					{
						"name": "revision",
						"type": "integer"
					},
					{
						"name": "inputs",
						"type": "RunInputs",
						"fields": [
							{
								"name": "base_revision",
								"type": "SourceRevision",
								"description": "Original baseline. Immutable — upstream arrives as remote-application boundaries, never by rewriting this."
							},
							{
								"name": "policy_revision",
								"type": "PolicyRevision",
								"description": "Immutable after activation."
							},
							{
								"name": "starting_knowledge_revision",
								"type": "KnowledgeRevision"
							},
							{
								"name": "configuration_snapshot",
								"type": "RunConfiguration"
							}
						]
					},
					{
						"name": "head_revision",
						"type": "SourceRevision",
						"description": "Mirror of the owning cycle's head, which the scheduler plans against. The cycle owns head lineage; equals base_revision until a remote-application boundary advances it."
					},
					{
						"name": "control",
						"type": "RunControl",
						"fields": [
							{
								"name": "status",
								"type": "\"draft\" | \"ready\" | \"active\" | \"paused\" | \"completed\" | \"failed\" | \"cancelled\""
							},
							{
								"name": "stop_request",
								"type": "{ mode: \"hard_stop\"; reason: string } | null",
								"required": false
							},
							{
								"name": "terminal_reason",
								"type": "string",
								"required": false
							}
						]
					},
					{
						"name": "scheduling",
						"type": "RunScheduling",
						"fields": [
							{
								"name": "desired_workers",
								"type": "integer"
							},
							{
								"name": "scheduler_condition",
								"type": "\"idle\" | \"planning\" | \"dispatching\" | \"waiting\" | \"boundary\" | \"blocked\""
							}
						]
					},
					{
						"name": "progress",
						"type": "RunProgress",
						"fields": [
							{
								"name": "baseline_score",
								"type": "number"
							},
							{
								"name": "confirmed_score",
								"type": "number"
							},
							{
								"name": "tentative_changes",
								"type": "integer"
							},
							{
								"name": "confirmed_changes",
								"type": "integer"
							},
							{
								"name": "regressed_changes",
								"type": "integer"
							}
						]
					},
					{
						"name": "job_ids",
						"type": "JobId[]",
						"description": "Worker and integration dispatch records associated with this run."
					},
					{
						"name": "integration_outcome_ids",
						"type": "IntegrationOutcomeId[]",
						"description": "Domain outcomes referenced by settled integration jobs."
					},
					{
						"name": "epoch_ids",
						"type": "EpochId[]"
					},
					{
						"name": "remote_application_ids",
						"type": "RemoteApplicationId[]",
						"description": "Remote-application boundaries in timeline order, each recording prior head, applied upstream revision, resolved conflicts, and score delta."
					},
					{
						"name": "worker_state_ids",
						"type": "WorkerStateId[]"
					},
					{
						"name": "checkpoint_ids",
						"type": "CheckpointId[]"
					},
					{
						"name": "active_operation_ids",
						"type": "OperationId[]"
					},
					{
						"name": "latest_event_sequence",
						"type": "integer"
					},
					{
						"name": "blockers",
						"type": "Blocker[]"
					}
				],
				"name": "RunState"
			},
			"children": []
		},
		"b-10-run-state-a-run-is-one-autonomous-3": {
			"id": "b-10-run-state-a-run-is-one-autonomous-3",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Activation freezes "
				},
				{
					"insert": "base_revision",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "policy_revision",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "starting_knowledge_revision",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", and the configuration snapshot. "
				},
				{
					"insert": "head_revision",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " remains mutable because it mirrors the owning cycle head used for later planning; applying upstream work advances that mirror without rewriting the original baseline."
				}
			],
			"children": []
		},
