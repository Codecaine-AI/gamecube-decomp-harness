		"b-50-run-state-harnessstate-activates-a-25": {
			"id": "b-50-run-state-harnessstate-activates-a-25",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Run lifecycle",
						"steps": [
							{
								"text": "Admit work",
								"steps": [
									{
										"text": "Activate a `ready` run under the expected aggregate revision and dispatch lease"
									},
									{
										"text": "Plan against `head_revision` and record the knowledge revision consumed"
									},
									{
										"text": "Admit the full eligible board once at epoch open"
									}
								]
							},
							{
								"text": "Execute epochs",
								"steps": [
									{
										"text": "Claim jobs and epoch targets atomically, composing target claims and worker states"
									},
									{
										"text": "Append runner-owned checkpoints under ClaimToken authority"
									},
									{
										"text": "Integrate selectable work tentatively and classify it at the boundary"
									},
									{
										"text": "Close the epoch and advance cycle and run head mirrors together after integration"
									}
								]
							},
							{
								"text": "Stop and recover",
								"steps": [
									{
										"text": "Request a managed stop with a 30-second grace"
									},
									{
										"text": "Cancel remaining work and reconcile leases after grace"
									},
									{
										"text": "Settle the same run as `paused` before resume"
									}
								]
							},
							{
								"text": "Reconcile pending integration",
								"steps": [
									{
										"text": "Inspect pending rows before dispatch acquisition or epoch open"
									},
									{
										"text": "Finish or reject the interrupted Git/state boundary from durable evidence"
									}
								]
							},
							{
								"text": "Close the run",
								"steps": [
									{
										"text": "Settle the active epoch, jobs, claims, operations, and integration lane"
									},
									{
										"text": "Run required boundary confirmation and capture the save point"
									},
									{
										"text": "Commit terminal status and release dispatch authority"
									},
									{
										"text": "Retain terminal RunState for lineage after the active workflow slot clears"
									}
								]
							}
						]
					}
				]
			},
			"children": []
		},
