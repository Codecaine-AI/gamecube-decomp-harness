    "b-10-run-state-runstate-is-the-durable-1": {
      "id": "b-10-run-state-runstate-is-the-durable-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "RunState is the durable identity and control envelope for one autonomous run in the game workflow cycle. It freezes the run's starting inputs, records its authority state, preserves its identity through pause and recovery, and carries the pending-integration evidence needed to reconcile Git and game lineage after a crash."
        }
      ],
      "children": []
    },
    "b-10-run-state-run-identity-and-inputs-2": {
      "id": "b-10-run-state-run-identity-and-inputs-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Run Identity and Inputs"
        }
      ],
      "children": []
    },
    "b-10-run-state-a-run-is-one-autonomous-3": {
      "id": "b-10-run-state-a-run-is-one-autonomous-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A run is one autonomous scheduling effort inside a cycle. Every run-scoped epoch, target, claim, worker state, checkpoint, output integration, and event is addressed by "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "cycle_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names the containing cycle rather than standing in for the run. The run identity survives pause, recovery, and sync so all evidence remains on one timeline."
        }
      ],
      "children": []
    },
    "b-10-run-state-runinputs-binds-the-effo-4": {
      "id": "b-10-run-state-runinputs-binds-the-effo-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "RunInputs binds the effort to its original starting conditions. Activation freezes the complete input object:"
        }
      ],
      "children": []
    },
