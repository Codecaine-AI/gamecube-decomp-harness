    "b-10-run-state-sync-does-not-replace-or-15": {
      "id": "b-10-run-state-sync-does-not-replace-or-15",
      "type": "quote",
      "props": {},
      "text": [
        {
          "insert": "Sync does not replace or close an interrupted run. Upstream changes enter game lineage through the remote-application boundary while "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the original "
        },
        {
          "insert": "base_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remain fixed."
        }
      ],
      "children": []
    },
    "b-10-run-state-control-status-16": {
      "id": "b-10-run-state-control-status-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Control Status"
        }
      ],
      "children": []
    },
    "b-10-run-state-control-status-is-the-so-17": {
      "id": "b-10-run-state-control-status-is-the-so-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Control status is the sole run lifecycle vocabulary. Scheduler activity, process liveness, and progress events never substitute for it."
        }
      ],
      "children": []
    },
    "b-10-run-state-status-meaning-sta-18": {
      "id": "b-10-run-state-status-meaning-sta-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Status | Meaning | Stable invariant |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "draft",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Required inputs or configuration are incomplete. | No scheduler or worker may start. |\n| "
        },
        {
          "insert": "ready",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Readiness gates pass and activation may be requested. | Activation cannot alter RunInputs. |\n| "
        },
        {
          "insert": "active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Autonomous scheduling authority is enabled. | The run occupies the HarnessState workflow slot and holds the game dispatch lease. |\n| "
        },
        {
          "insert": "draining",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | New admission is disabled while existing work settles. | No new claims are created. |\n| "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Scheduling is disabled and the run remains resumable. | Work has settled or recovery recorded its cancellations. |\n| "
        },
        {
          "insert": "completed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Autonomous work closed normally. | The run is terminal. |\n| "
        },
        {
          "insert": "failed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The runner cannot continue safely. | Recovery returns the same run to "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". |\n| "
        },
        {
          "insert": "cancelled",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The operator abandoned the effort. | The run is terminal and its evidence remains readable. |"
        }
      ],
      "children": []
    },
    "b-10-run-state-scheduler-condition-is-19": {
      "id": "b-10-run-state-scheduler-condition-is-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "scheduler_condition",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is an observability mirror of scheduler activity inside the control state. It does not grant dispatch authority, replace status, or create another lifecycle."
        }
      ],
      "children": []
    },
    "b-10-run-state-condition-observed-a-20": {
      "id": "b-10-run-state-condition-observed-a-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Condition | Observed activity |\n| --- | --- |\n| "
        },
        {
          "insert": "idle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | No scheduler operation is executing. |\n| "
        },
        {
          "insert": "planning",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Candidate evidence is becoming an admission decision. |\n| "
        },
        {
          "insert": "dispatching",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Admitted work is being assigned to queue capacity. |\n| "
        },
        {
          "insert": "waiting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The active run is sleeping for a durable wake event. |\n| "
        },
        {
          "insert": "boundary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Confirmation, integration, report refresh, or save-point work is executing. |\n| "
        },
        {
          "insert": "blocked",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Progress requires recovery or operator action. |"
        }
      ],
      "children": []
    },
    "b-10-run-state-progress-events-record-a-21": {
      "id": "b-10-run-state-progress-events-record-a-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Progress events record accepted facts without pretending that the run crossed a status edge. If a progress fact revises durable state, that revision receives exactly one event and one revision increment."
        }
      ],
      "children": []
    },
    "b-10-run-state-pause-and-recovery-22": {
      "id": "b-10-run-state-pause-and-recovery-22",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Pause and Recovery"
        }
      ],
      "children": []
    },
    "b-10-run-state-pause-is-drain-based-an-23": {
      "id": "b-10-run-state-pause-is-drain-based-an-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pause is drain-based. An "
        },
        {
          "insert": "active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " → "
        },
        {
          "insert": "draining",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " request stops new admission, lets existing claims and boundary work settle, and then records "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A confirmed hard stop may cancel outstanding subjects through recovery before reaching the same resumable state."
        }
      ],
      "children": []
    },
    "b-10-run-state-recovery-never-creates-a-24": {
      "id": "b-10-run-state-recovery-never-creates-a-24",
      "type": "quote",
      "props": {},
      "text": [
        {
          "insert": "Recovery never creates a successor run. A failed run returns to "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the same "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; only "
        },
        {
          "insert": "completed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "cancelled",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are terminal."
        }
      ],
      "children": []
    },
    "b-10-run-state-recovery-repairs-durable-25": {
      "id": "b-10-run-state-recovery-repairs-durable-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Recovery repairs durable boundaries before changing run control:"
        }
      ],
      "children": []
    },
    "b-10-run-state-reconcile-pending-epoch-26": {
      "id": "b-10-run-state-reconcile-pending-epoch-26",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Reconcile pending epoch integrations."
        }
      ],
      "children": []
    },
    "b-10-run-state-settle-or-cancel-orphane-27": {
      "id": "b-10-run-state-settle-or-cancel-orphane-27",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Settle or cancel orphaned claims and operations."
        }
      ],
      "children": []
    },
    "b-10-run-state-break-a-stale-game-di-28": {
      "id": "b-10-run-state-break-a-stale-game-di-28",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Break a stale game dispatch lease when it remains held."
        }
      ],
      "children": []
    },
    "b-10-run-state-emit-run-recovered-wit-29": {
      "id": "b-10-run-state-emit-run-recovered-wit-29",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Emit "
        },
        {
          "insert": "run.recovered",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with every cancelled subject identifier."
        }
      ],
      "children": []
    },
    "b-10-run-state-commit-failed-pause-30": {
      "id": "b-10-run-state-commit-failed-pause-30",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Commit "
        },
        {
          "insert": "failed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " → "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the existing "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-run-state-the-operator-resumes-pa-31": {
      "id": "b-10-run-state-the-operator-resumes-pa-31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The operator resumes "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " → "
        },
        {
          "insert": "active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through the normal workflow-slot and dispatch-lease acquisition path. Recovery history remains attached to the original evidence timeline."
        }
      ],
      "children": []
    },
    "b-10-run-state-sync-continuity-32": {
      "id": "b-10-run-state-sync-continuity-32",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Sync Continuity"
        }
      ],
      "children": []
    },
    "b-10-run-state-run-continuity-separates-33": {
      "id": "b-10-run-state-run-continuity-separates-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run continuity separates the effort's fixed origin from the head it plans against. The sync workflow owns "
        },
        {
          "insert": "remote_application",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " recording and the transaction that publishes an applied upstream revision into game lineage. RunState consumes the resulting cycle head and updates its "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " mirror without changing RunInputs or writing a second remote-application boundary."
        }
      ],
      "children": []
    },
    "b-10-run-state-pending-integration-34": {
      "id": "b-10-run-state-pending-integration-34",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Pending Integration"
        }
      ],
      "children": []
    },
    "b-10-run-state-epoch-publication-crosse-35": {
      "id": "b-10-run-state-epoch-publication-crosse-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Epoch publication crosses a Git commit boundary and a durable state transaction. The pending-integration protocol leaves enough evidence to reconcile the commit-without-lineage crash window:"
        }
      ],
      "children": []
    },
    "b-10-run-state-before-the-git-integrati-36": {
      "id": "b-10-run-state-before-the-git-integrati-36",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Before the Git integration commit, the runner commits a "
        },
        {
          "insert": "pending_integrations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row keyed by "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "epoch_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the branch, parent revision, and expected message marker."
        }
      ],
      "children": []
    },
    "b-10-run-state-the-integration-commit-c-37": {
      "id": "b-10-run-state-the-integration-commit-c-37",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The integration commit carries the stable "
        },
        {
          "insert": "Epoch-Integration: <epoch_id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " trailer, which identifies the boundary independently of process memory."
        }
      ],
      "children": []
    },
    "b-10-run-state-the-epoch-close-transact-38": {
      "id": "b-10-run-state-the-epoch-close-transact-38",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The epoch-close transaction records epoch completion, advances the cycle and run head mirrors, and deletes the pending row in the same commit."
        }
      ],
      "children": []
    },
    "b-10-run-state-process-startup-and-run-39": {
