    "b-10-run-state-control-page-42": {
      "id": "b-10-run-state-control-page-42",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This page defines the run-phase control model: lifecycle status, the scheduler activity mirror, and crash evidence for pending integration. "
        },
        {
          "insert": "Run Workflow State",
          "attributes": {
            "link": "../../../40-harness-state/10-state-composition/50-run-state"
          }
        },
        {
          "insert": " is the canonical source for RunState shape, composition, and flows."
        }
      ],
      "children": []
    },
    "b-10-run-state-run-identity-and-inputs-2": {
      "id": "b-10-run-state-run-identity-and-inputs-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Run Identity and Inputs"
        }
      ],
      "children": []
    },
    "b-10-run-state-a-run-is-one-autonomous-3": {
      "id": "b-10-run-state-a-run-is-one-autonomous-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A run is one autonomous scheduling effort inside a cycle. Every run-scoped epoch, target, claim, worker state, checkpoint, output integration, and event is addressed by "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "cycle_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " names the containing cycle rather than standing in for the run. The run identity survives pause, recovery, and sync so all evidence remains on one timeline."
        }
      ],
      "children": []
    },
    "b-10-run-state-frozen-inputs-43": {
      "id": "b-10-run-state-frozen-inputs-43",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Activation freezes "
        },
        {
          "insert": "inputs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (RunInputs): "
        },
        {
          "insert": "base_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "policy_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "starting_knowledge_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the "
        },
        {
          "insert": "configuration_snapshot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". These fields remain the immutable starting conditions; see "
        },
        {
          "insert": "Run Workflow State",
          "attributes": {
            "link": "../../../40-harness-state/10-state-composition/50-run-state"
          }
        },
        {
          "insert": " for the field-by-field shape."
        }
      ],
      "children": []
    },
    "b-10-run-state-mutable-head-44": {
      "id": "b-10-run-state-mutable-head-44",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not part of frozen RunInputs. It is a top-level mutable RunState field that mirrors the owning cycle's head for subsequent planning."
        }
      ],
      "children": []
    },
    "b-10-run-state-control-status-16": {
      "id": "b-10-run-state-control-status-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Control Status"
        }
      ],
      "children": []
    },
    "b-10-run-state-control-status-is-the-so-17": {
      "id": "b-10-run-state-control-status-is-the-so-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Control status is the sole run lifecycle vocabulary. Scheduler activity, process liveness, and progress events never substitute for it."
        }
      ],
      "children": []
    },
    "b-10-run-state-status-meaning-sta-18": {
      "id": "b-10-run-state-status-meaning-sta-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Status | Meaning | Stable invariant |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "draft",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Required inputs or configuration are incomplete. | No scheduler or worker may start. |\n| "
        },
        {
          "insert": "ready",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Readiness gates pass and activation may be requested. | Activation cannot alter RunInputs. |\n| "
        },
        {
          "insert": "active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Autonomous scheduling authority is enabled. | The run occupies the HarnessState workflow slot and holds the game dispatch lease. |\n| "
        },
        {
          "insert": "draining",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | New admission is disabled while existing work settles. | No new claims are created. |\n| "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Scheduling is disabled and the run remains resumable. | Work has settled or recovery recorded its cancellations. |\n| "
        },
        {
          "insert": "completed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Autonomous work closed normally. | The run is terminal. |\n| "
        },
        {
          "insert": "failed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The runner cannot continue safely. | Recovery returns the same run to "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". |\n| "
        },
        {
          "insert": "cancelled",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The operator abandoned the effort. | The run is terminal and its evidence remains readable. |"
        }
      ],
      "children": []
    },
    "b-10-run-state-scheduler-condition-is-19": {
      "id": "b-10-run-state-scheduler-condition-is-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "scheduler_condition",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is an observability mirror of scheduler activity inside the control state. It does not grant dispatch authority, replace status, or create another lifecycle; it mirrors the condition introduced by the "
        },
        {
          "insert": "director loop",
          "attributes": {
            "link": "../20-director-loop"
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-run-state-condition-observed-a-20": {
      "id": "b-10-run-state-condition-observed-a-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Condition | Observed activity |\n| --- | --- |\n| "
        },
        {
          "insert": "idle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | No scheduler operation is executing. |\n| "
        },
        {
          "insert": "planning",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Candidate evidence is becoming an admission decision. |\n| "
        },
        {
          "insert": "dispatching",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Admitted work is being assigned to queue capacity. |\n| "
        },
        {
          "insert": "waiting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | The active run is sleeping for a durable wake event. |\n| "
        },
        {
          "insert": "boundary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Confirmation, integration, report refresh, or save-point work is executing. |\n| "
        },
        {
          "insert": "blocked",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Progress requires recovery or operator action. |"
        }
      ],
      "children": []
    },
    "b-10-run-state-progress-events-record-a-21": {
      "id": "b-10-run-state-progress-events-record-a-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Progress events record accepted facts without pretending that the run crossed a status edge. If a progress fact revises durable state, that revision receives exactly one event and one revision increment."
        }
      ],
      "children": []
    },
    "b-10-run-state-pause-recovery-summary-45": {
      "id": "b-10-run-state-pause-recovery-summary-45",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pause is drain-based, and recovery returns the same "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "Run Workflow State",
          "attributes": {
            "link": "../../../40-harness-state/10-state-composition/50-run-state"
          }
        },
        {
          "insert": " and its workflow-slot and dispatch-lease path own the detailed recovery flow."
        }
      ],
      "children": []
    },
    "b-10-run-state-sync-summary-46": {
      "id": "b-10-run-state-sync-summary-46",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync applies upstream revisions through its own boundary while "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the original "
        },
        {
          "insert": "base_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stay fixed; RunState only updates its "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " mirror, as detailed by "
        },
        {
          "insert": "Run Workflow State",
          "attributes": {
            "link": "../../../40-harness-state/10-state-composition/50-run-state"
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-run-state-pending-integration-34": {
      "id": "b-10-run-state-pending-integration-34",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Pending Integration"
        }
      ],
      "children": []
    },
    "b-10-run-state-epoch-publication-crosse-35": {
      "id": "b-10-run-state-epoch-publication-crosse-35",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pending-integration protocol preserves evidence across the Git-commit and durable-state crash window. "
        },
        {
          "insert": "Durable State Records",
          "attributes": {
            "link": "../../../40-harness-state/40-durable-records"
          }
        },
        {
          "insert": " defines the subordinate records."
        }
      ],
      "children": []
    },
    "b-10-run-state-before-the-git-integrati-36": {
      "id": "b-10-run-state-before-the-git-integrati-36",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Before the Git integration commit, the runner writes a "
        },
        {
          "insert": "pending_integrations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row keyed by "
        },
        {
          "insert": "run_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "epoch_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", recording the branch, parent revision, and expected message marker."
        }
      ],
      "children": []
    },
    "b-10-run-state-the-integration-commit-c-37": {
      "id": "b-10-run-state-the-integration-commit-c-37",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The integration commit carries the stable "
        },
        {
          "insert": "Epoch-Integration: <epoch_id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " trailer, which identifies the boundary independently of process memory."
        }
      ],
      "children": []
    },
    "b-10-run-state-the-epoch-close-transact-38": {
      "id": "b-10-run-state-the-epoch-close-transact-38",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The epoch-close transaction records epoch completion, advances the cycle and run head mirrors, and deletes the pending row in the same commit."
        }
      ],
      "children": []
    },
    "b-10-run-state-reconciliation-searches-40": {
      "id": "b-10-run-state-reconciliation-searches-40",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "At process startup and during run recovery, reconciliation searches the recorded parent-to-branch history for the trailer before dispatch authority is acquired or claims are settled. A found commit completes the epoch-close transaction; a missing commit closes the epoch as an integration error and removes the stale row."
        }
      ],
      "children": []
    }
  }
}
