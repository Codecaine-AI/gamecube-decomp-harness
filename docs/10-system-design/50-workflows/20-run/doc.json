    "b-20-run-overview-1": {
      "id": "b-20-run-overview-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run phase is the autonomous execution stage of the game workflow. A run occupies the HarnessState workflow slot and holds the game dispatch lease while active, while "
        },
        {
          "insert": "Run State",
          "attributes": {
            "link": "./10-run-state"
          }
        },
        {
          "insert": " provides its durable identity and control envelope, including control status and pending integration."
        }
      ],
      "children": []
    },
    "b-20-run-run-process-canvas-14": {
      "id": "b-20-run-run-process-canvas-14",
      "type": "canvas",
      "props": {
        "src": "./assets/canvases/run-process.canvas.json",
        "title": "Run process"
      },
      "children": []
    },
    "b-20-run-epoch-heading-2": {
      "id": "b-20-run-epoch-heading-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How an Epoch Turns"
        }
      ],
      "children": []
    },
    "b-20-run-wake-snapshot-3": {
      "id": "b-20-run-wake-snapshot-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "Director Loop",
          "attributes": {
            "link": "./20-director-loop"
          }
        },
        {
          "insert": " is the scheduler for the run. It sleeps until a durable wake event arrives, then wakes and takes a snapshot of the board."
        }
      ],
      "children": []
    },
    "b-20-run-admit-workers-4": {
      "id": "b-20-run-admit-workers-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "From that snapshot, "
        },
        {
          "insert": "Board Prioritization",
          "attributes": {
            "link": "./30-board-prioritization"
          }
        },
        {
          "insert": " applies policy, evidence, and ranking signals to decide which targets are worth a worker's attempt and admits an epoch of target packets. "
        },
        {
          "insert": "Workers",
          "attributes": {
            "link": "./40-workers"
          }
        },
        {
          "insert": " then attempt those admitted targets in isolated worktrees, each under a bounded claim."
        }
      ],
      "children": []
    },
    "b-20-run-integrate-boundary-5": {
      "id": "b-20-run-integrate-boundary-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Results integrate serially back into game lineage. At the epoch boundary, the run confirms or reverts tentative work, records the integration commit, and repeats the loop until it drains, pauses, or closes."
        }
      ],
      "children": []
    },
    "b-20-run-guardians-6": {
      "id": "b-20-run-guardians-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Process Guardians",
          "attributes": {
            "link": "./50-process-guardians"
          }
        },
        {
          "insert": " wrap the whole process for liveness and crash recovery without becoming a second scheduler or authority path."
        }
      ],
      "children": []
    },
    "b-20-run-details-heading-7": {
      "id": "b-20-run-details-heading-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Where the Details Live"
        }
      ],
      "children": []
    },
    "b-20-run-details-state-8": {
      "id": "b-20-run-details-state-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run State",
          "attributes": {
            "link": "./10-run-state"
          }
        },
        {
          "insert": " defines durable run identity, control status, and pending integration."
        }
      ],
      "children": []
    },
    "b-20-run-details-director-9": {
      "id": "b-20-run-details-director-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Director Loop",
          "attributes": {
            "link": "./20-director-loop"
          }
        },
        {
          "insert": " defines durable wakes, snapshots, epoch orchestration, and checkpoints."
        }
      ],
      "children": []
    },
    "b-20-run-details-board-10": {
      "id": "b-20-run-details-board-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Board Prioritization",
          "attributes": {
            "link": "./30-board-prioritization"
          }
        },
        {
          "insert": " defines the evidence, ranking signals, and policy used for target admission."
        }
      ],
      "children": []
    },
    "b-20-run-details-workers-11": {
      "id": "b-20-run-details-workers-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Workers",
          "attributes": {
            "link": "./40-workers"
          }
        },
        {
          "insert": " defines bounded claims, isolated worktrees, and safe target execution."
        }
      ],
      "children": []
    },
    "b-20-run-details-guardians-12": {
      "id": "b-20-run-details-guardians-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Process Guardians",
          "attributes": {
            "link": "./50-process-guardians"
          }
        },
        {
          "insert": " defines liveness monitoring and crash recovery around the scheduler."
        }
      ],
      "children": []
    }
  }
