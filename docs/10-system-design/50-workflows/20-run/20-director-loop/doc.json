    "b-10-run-director-loop-the-run-loop-is-the-non-19": {
      "id": "b-10-run-director-loop-the-run-loop-is-the-non-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run loop is the non-agent host for scheduling and consumption. It enqueues admitted slot jobs, hosts the per-kind worker pool, evaluates shouldClaim against run and dispatch state, heartbeats leases while children execute, and handles onJobSettled from durable worker-state rows. It also drains integration work, reaps expired jobs and target claims, runs maintenance cadence checks, and sleeps until durable state or cadence makes another pass useful."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-the-scheduler-does-not-p-20": {
      "id": "b-10-run-director-loop-the-scheduler-does-not-p-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scheduler does not perform source archaeology or source edits. Workers own\ntarget-local source work; the scheduler owns target admission, claim pressure,\nrefresh cadence, boundary routing, and process realization."
        }
      ],
      "children": []
    },
