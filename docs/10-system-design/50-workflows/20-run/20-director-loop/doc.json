    "b-10-run-director-loop-the-scheduler-s-decision-16": {
      "id": "b-10-run-director-loop-the-scheduler-s-decision-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scheduler’s decisions are reproducible from durable state and operator\nconfiguration. Every scheduler decision and worker packet records the "
        },
        {
          "insert": "knowledge_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " it actually consumed,\nso replay and diagnosis bind each result to the same knowledge snapshot. Graph\nscores can rank candidates, but admission and wake-event handling follow\ndeterministic policy."
        }
      ],
      "children": []
    },
