    "b-10-run-director-loop-unclaimed-epoch-targets-11": {
      "id": "b-10-run-director-loop-unclaimed-epoch-targets-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The kernel claim and claimNextEpochTarget commit atomically, so a job cannot become claimed without its epoch target and two consumers cannot acquire the same job."
        }
