    "b-10-run-director-loop-the-runner-records-worke-52": {
      "id": "b-10-run-director-loop-the-runner-records-worke-52",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The runner records worker progress as validation checkpoints. Scoped checks\ncan bank a checkpoint as tentative; the epoch confirmation pass later records\nwhether it is confirmed or regressed:"
        }
      ],
      "children": []
