    "b-10-run-director-loop-a-scheduler-tick-handles-47": {
      "id": "b-10-run-director-loop-a-scheduler-tick-handles-47",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A scheduler tick handles one wake event by refreshing deterministic epoch state,\nrecording the result, and marking the event handled. If no schedulable board\nwork exists, the scheduler records claim pressure and backs off according to\npolicy rather than spinning or falling back to a model-driven replan."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-worker-delegation-48": {
      "id": "b-10-run-director-loop-worker-delegation-48",
