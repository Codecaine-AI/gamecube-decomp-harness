    "b-10-run-director-loop-deterministic-run-schedu-2": {
      "id": "b-10-run-director-loop-deterministic-run-schedu-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Deterministic run scheduling through the durable job queue, including epoch admission, worker settlement, integration drain, lease reaping, and epoch boundaries."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-the-run-scheduler-is-the-3": {
      "id": "b-10-run-director-loop-the-run-scheduler-is-the-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run scheduler is the board-level control loop. It reads durable run state,\nrefreshes "
        },
        {
          "insert": "epoch-target priorities",
          "attributes": {
            "link": "../30-board-prioritization"
          }
        },
        {
          "insert": " from the ranked board and admits deterministic work as worker jobs. The run loop hosts the worker consumer pool, classifies settled jobs from durable worker-state evidence, drains integration work, reaps expired leases, and invokes the epoch boundary without a board-level model session in the hot path."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-behavior-4": {
