      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Validation state (tentative, confirmed, or regressed), score movement,\nexactness, scoped-check result, and hard-gate result."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-patch-diff-and-validatio-54": {
      "id": "b-10-run-director-loop-patch-diff-and-validatio-54",
