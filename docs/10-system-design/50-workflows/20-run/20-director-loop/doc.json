    "b-10-run-director-loop-the-run-scheduler-is-the-3": {
      "id": "b-10-run-director-loop-the-run-scheduler-is-the-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run scheduler is the board-level control loop. It reads durable run state,\nrefreshes epoch-target priorities from the ranked board, admits deterministic\nwork, starts workers through target claims, and handles wake events without\nrequiring a model-driven scheduling agent session in the hot path."
        }
      ],
      "children": []
    },
