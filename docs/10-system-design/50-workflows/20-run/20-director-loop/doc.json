    "b-10-run-director-loop-a-worker-state-closes-as-43": {
      "id": "b-10-run-director-loop-a-worker-state-closes-as-43",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A worker state closes as exact, timeout, error, or cancellation. When\n--merge-on-finish is enabled, a hard-gate-passing checkpoint enters serial\nintegration immediately: a clean application extends the cycle ancestry as a\ntentative change. A conflict routes to the conflict-resolver agent, and an\nunresolved conflict remains operator-visible. The flag defaults off, retaining\nboundary-time application."
        }
      ],
      "children": []
    },
