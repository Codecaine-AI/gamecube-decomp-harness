    "b-10-run-director-loop-maintenance-records-a-p-33": {
      "id": "b-10-run-director-loop-maintenance-records-a-p-33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "   integrations when the global comparison is clean, and attributes any\n   regression across the tentative window. The guilty integration is reverted,\n   marked regressed, and routed to repair priority; unaffected integrations are\n   confirmed. The boundary then runs full maintenance, records a progress save\n   point, removes exact matches from future scheduling, and admits the next\n   epoch from the refreshed board."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-three-sizes-stay-distinc-34": {
