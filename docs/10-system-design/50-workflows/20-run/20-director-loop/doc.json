    "b-10-run-director-loop-an-epoch-boundary-pause-46": {
      "id": "b-10-run-director-loop-an-epoch-boundary-pause-46",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An epoch boundary, pause, retry, or stop condition is recorded."
        }
