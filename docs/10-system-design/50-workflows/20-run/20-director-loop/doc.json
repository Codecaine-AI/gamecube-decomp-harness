    "b-10-run-director-loop-the-run-loop-is-the-non-19": {
      "id": "b-10-run-director-loop-the-run-loop-is-the-non-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run loop is the non-agent process component that gives the scheduler a\nresting shape. It checks durable events, runs one deterministic scheduler tick\nwhen an unhandled event exists, keeps worker slots filled from admitted epoch\ntargets, runs maintenance cadence checks, and then sleeps without keeping a\nboard-level model agent session alive."
        }
      ],
      "children": []
    },
    "b-10-run-director-loop-the-scheduler-does-not-p-20": {
      "id": "b-10-run-director-loop-the-scheduler-does-not-p-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scheduler does not perform source archaeology or source edits. Workers own\ntarget-local source work; the scheduler owns target admission, claim pressure,\nrefresh cadence, boundary routing, and process realization."
        }
      ],
      "children": []
    },
