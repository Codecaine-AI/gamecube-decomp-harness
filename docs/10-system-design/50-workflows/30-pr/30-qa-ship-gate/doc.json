		"b-qa-repair-outline": {
			"id": "b-qa-repair-outline",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Sweep candidate files for deterministic and file-backed review findings"
					},
					{
						"text": "Create one repair item per finding with an authorized write set"
					},
					{
						"text": "Attempt a source-level repair before a minimal revert",
						"steps": [
							{
								"text": "Return blocked_needs_cross_file when a clean fix needs an unauthorized path"
							}
						]
					},
					{
						"text": "Rebuild and rerun score, regression, lint, and adversarial checks"
					},
					{
						"text": "Record an explicit disposition for every finding"
					},
					{
						"text": "Emit the ship filter",
						"steps": [
							{
								"text": "Exclude queued, blocked, false-positive-under-review, and clean-lower-score files unless the operator explicitly accepts the allowed outcome"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-60-score-and-pr-handoff-adversarial-cleanup-and-59": {
			"id": "b-60-score-and-pr-handoff-adversarial-cleanup-and-59",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "A valid cleanup may lower fuzzy score or lose an exact match when it removes prohibited source shape. The cleaned result is reported and carried forward; the banned tactic is not restored to preserve a metric."
				}
			],
			"children": []
		},
