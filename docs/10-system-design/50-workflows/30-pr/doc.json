    "b-30-pr-the-pr-workflow-is-the-r-1": {
      "id": "b-30-pr-the-pr-workflow-is-the-r-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR workflow is the review-and-shipping phase of the game workflow cycle. It occupies a workflow slot in "
        },
        {
          "insert": "HarnessState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", may hold the dispatch lease during active PR work, and runs reviewer, fixer, splitter, and QA-repair agents as queue workers. Score and QA gates decide what ships, while one durable PR campaign owns the resulting review series from a stable split point through operator-confirmed closure."
        }
      ],
      "children": []
    },
