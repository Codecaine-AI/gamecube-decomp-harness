      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Remote status and feedback may enter campaign state without dispatch authority."
        }
      ],
      "children": []
    },
    "b-30-pr-publishing-fixing-spli-11": {
      "id": "b-30-pr-publishing-fixing-spli-11",
