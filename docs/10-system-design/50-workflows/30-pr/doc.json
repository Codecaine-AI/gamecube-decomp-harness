		"b-30-pr-process-classification-26": {
			"id": "b-30-pr-process-classification-26",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The promotion gate separates pr_ready work from local_only evidence and blocked results. The QA gate then removes score-inflating or unreviewable source before the surviving ship set is split."
				}
			],
			"children": []
		},
		"b-30-pr-process-campaign-28": {
			"id": "b-30-pr-process-campaign-28",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The campaign publishes operator-approved batches, accepts remote observations while dormant, and reactivates under the dispatch lease for feedback repair or validation. Closure is an explicit operator decision after every series reaches a terminal outcome or the remaining work is abandoned."
				}
			],
			"children": []
		},
