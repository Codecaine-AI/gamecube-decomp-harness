		"b-30-pr-the-pr-workflow-is-the-r-1": {
			"id": "b-30-pr-the-pr-workflow-is-the-r-1",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The PR workflow turns boundary-confirmed exact matches into a bounded review campaign. Score and QA gates own eligibility; one durable campaign owns review series from a stable split point through terminal upstream outcomes."
				}
			],
			"children": []
		},
		"b-30-pr-phase-boundary-2": {
			"id": "b-30-pr-phase-boundary-2",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Phase Boundary"
				}
			],
			"children": []
		},
		"b-pr-phase-boundary-outline": {
			"id": "b-pr-phase-boundary-outline",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Classify the run boundary",
						"steps": [
							{
								"text": "Exact matches may proceed; improvements and blocked work remain durable local evidence"
							}
						]
					},
					{
						"text": "Pass score integration and QA gates",
						"steps": [
							{
								"text": "Only clean, boundary-confirmed files enter split planning"
							}
						]
					},
					{
						"text": "Cut review-sized series from one stable point",
						"steps": [
							{
								"text": "A game has at most one open campaign"
							}
						]
					},
					{
						"text": "Operate the campaign",
						"steps": [
							{
								"text": "Observe remote evidence without a lease"
							},
							{
								"text": "Publish, fix, split, and validate only in an operator-entered activation"
							}
						]
					},
					{
						"text": "Confirm terminal campaign closure"
					}
				]
			},
			"children": []
		},
		"b-30-pr-process-overview-25": {
			"id": "b-30-pr-process-overview-25",
			"type": "heading",
			"props": {
