		"b-30-pr-the-pr-phase-schedules-i-13": {
			"id": "b-30-pr-the-pr-phase-schedules-i-13",
			"type": "structured-table",
			"props": {
				"title": "PR workers",
				"columns": [
					"Worker",
					"Responsibility",
					"Authority",
					"Write scope"
				],
				"rows": [
					[
						"Splitter",
						"Propose semantic, review-sized series from the deterministic ship set.",
						"Cannot change eligibility or file coverage.",
						"Split plan only"
					],
					[
						"Reviewer",
						"Perform adversarial preship and draft review.",
						"Reports findings; cannot publish or repair.",
						"Review evidence"
					],
					[
						"Fixer",
						"Resolve claimed maintainer feedback on an existing series.",
						"Requires campaign activation and lease-fenced claim.",
						"Claimed series workspace"
					],
					[
						"QA repair",
						"Repair or dispose of ship-blocking findings.",
						"Requires verified activation ownership.",
						"Authorized write set"
					]
				],
				"density": "compact"
			},
			"children": []
		},
