    "b-30-pr-the-pr-workflow-is-the-r-1": {
      "id": "b-30-pr-the-pr-workflow-is-the-r-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR workflow is the review-and-shipping phase of the game workflow cycle. It occupies a workflow slot in "
        },
        {
          "insert": "HarnessState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", may hold the "
        },
        {
          "insert": "dispatch lease",
          "attributes": {
            "link": "../../40-harness-state/20-dispatch-authority"
          }
        },
        {
          "insert": " during active PR work, and runs reviewer, fixer, splitter, and QA-repair agents as queue workers. Score and QA gates decide what ships, while one "
        },
        {
          "insert": "durable PR campaign",
          "attributes": {
            "link": "./40-campaign-and-tracking"
          }
        },
        {
          "insert": " owns the resulting review series from a stable split point through operator-confirmed closure."
        }
      ],
      "children": []
    },
    "b-30-pr-phase-boundary-2": {
      "id": "b-30-pr-phase-boundary-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Phase Boundary"
        }
      ],
      "children": []
    },
    "b-30-pr-score-integration-and-qa-3": {
      "id": "b-30-pr-score-integration-and-qa-3",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Score integration and QA establish the eligible ship set."
        }
      ],
      "children": [
        "b-30-pr-only-boundary-confirmed-4",
        "b-30-pr-improvements-and-blocked-5"
      ]
    },
    "b-30-pr-only-boundary-confirmed-4": {
      "id": "b-30-pr-only-boundary-confirmed-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Only boundary-confirmed exact matches that pass regression and QA gates may enter PR preparation."
        }
      ],
      "children": []
    },
    "b-30-pr-improvements-and-blocked-5": {
      "id": "b-30-pr-improvements-and-blocked-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Improvements and blocked candidates remain durable local evidence for later run work."
        }
      ],
      "children": []
    },
    "b-30-pr-a-stable-split-point-tra-6": {
      "id": "b-30-pr-a-stable-split-point-tra-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A stable split point transfers eligible work into one durable PR campaign."
        }
      ],
      "children": [
        "b-30-pr-the-campaign-owns-public-7",
        "b-30-pr-a-game-has-at-most-on-8"
      ]
    },
    "b-30-pr-the-campaign-owns-public-7": {
      "id": "b-30-pr-the-campaign-owns-public-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The campaign owns publication order, upstream identities, review state, feedback work, validation evidence, and terminal outcomes."
        }
      ],
      "children": []
    },
    "b-30-pr-a-game-has-at-most-on-8": {
      "id": "b-30-pr-a-game-has-at-most-on-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A game has at most one open campaign."
        }
      ],
      "children": []
    },
    "b-30-pr-pr-execution-is-separate-9": {
      "id": "b-30-pr-pr-execution-is-separate-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "PR execution is separate from background review observation."
        }
      ],
      "children": [
        "b-30-pr-remote-status-and-feedba-10",
        "b-30-pr-publishing-fixing-spli-11"
      ]
    },
    "b-30-pr-remote-status-and-feedba-10": {
