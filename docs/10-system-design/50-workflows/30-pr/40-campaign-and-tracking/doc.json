		"b-20-operator-flow-and-pr-tracking-a-pr-campaign-owns-the-o-1": {
			"id": "b-20-operator-flow-and-pr-tracking-a-pr-campaign-owns-the-o-1",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "One PR campaign owns every review series cut from one immutable stable point. It remains durable throughout upstream review but executes only during operator-entered activations that hold the dispatch lease."
				}
			],
			"children": []
		},
