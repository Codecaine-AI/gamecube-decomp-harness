		"b-pr-campaign-lifecycle-outline": {
			"id": "b-pr-campaign-lifecycle-outline",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Open the campaign from the stable handoff point and record prepared series in order"
					},
					{
						"text": "Activate the campaign and acquire the dispatch lease"
					},
					{
						"text": "Confirm and publish the next bounded batch",
						"steps": [
							{
								"text": "Record upstream identities and return the campaign to in_review"
							}
						]
					},
					{
						"text": "Observe remote review while dormant",
						"steps": [
							{
								"text": "Advance series status and ingest deduplicated pending feedback"
							}
						]
					},
					{
						"text": "Reactivate for repair or validation",
						"steps": [
							{
								"text": "Claim fenced work, push resolved revisions, and settle every in-progress item before release"
							}
						]
					},
					{
						"text": "Confirm completion after all series are merged or closed, or explicitly abandon remaining work"
					}
				]
			},
			"children": []
		},
		"b-20-operator-flow-and-pr-tracking-activations-and-timeline-29": {
