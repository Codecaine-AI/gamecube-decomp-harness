		"b-20-operator-flow-and-pr-tracking-an-activation-is-the-lea-30": {
			"id": "b-20-operator-flow-and-pr-tracking-an-activation-is-the-lea-30",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Each activation is a lease-holding interval. The owning cycle records pr_phase timeline boundaries at acquisition and release, and every publication, fixer, and QA command verifies the current campaign lease before protected work."
				}
			],
			"children": []
		},
