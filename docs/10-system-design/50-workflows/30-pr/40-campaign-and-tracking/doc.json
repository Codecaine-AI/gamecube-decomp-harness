		"b-20-operator-flow-and-pr-tracking-review-latency-is-extern-9": {
			"id": "b-20-operator-flow-and-pr-tracking-review-latency-is-extern-9",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Review latency is external and irregular, so dormant campaigns preserve one review narrative without occupying execution authority. Entry from Run first stops the Run and records the durable handoff before PR acquires the lease."
				}
			],
			"children": []
		},
