		"b-20-operator-flow-and-pr-tracking-campaign-closure-is-an-o-59": {
			"id": "b-20-operator-flow-and-pr-tracking-campaign-closure-is-an-o-59",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Closure is operator-confirmed. completed requires every series to be merged or closed; abandoned records that remaining work will not proceed. Both outcomes preserve readable evidence and permanently disable publication and revision."
				}
			],
			"children": []
