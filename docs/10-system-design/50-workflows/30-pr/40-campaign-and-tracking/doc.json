			"id": "b-20-operator-flow-and-pr-tracking-legacy-split-pr-records-54",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The pre-campaign adoption command creates the deterministic anchored campaign and imports existing branch order, manifests, upstream identities, validation, review outcomes, and feedback without republishing. Retries return the same durable objects."
				}
			],
			"children": []
		},
