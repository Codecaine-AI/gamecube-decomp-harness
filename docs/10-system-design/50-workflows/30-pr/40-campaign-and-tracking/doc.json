		"b-pr-campaign-boundary-table": {
			"id": "b-pr-campaign-boundary-table",
			"type": "structured-table",
			"props": {
				"title": "Campaign invariants",
				"columns": [
					"Concern",
					"Invariant",
					"Purpose"
				],
				"rows": [
					[
						"Source anchor",
						"Immutable after the cut.",
						"Later upstream movement blocks stale work instead of rewriting history."
					],
					[
						"Open campaign",
						"At most one per game.",
						"Publication decisions and review learning cannot interleave across baselines."
					],
					[
						"Publication policy",
						"Ordered, operator-approved batches; default batch size is four.",
						"Reviewers receive bounded work."
					],
					[
						"Release",
						"No series revising and no work item in_progress.",
						"Lease transfer cannot orphan mutable review work."
					]
				],
