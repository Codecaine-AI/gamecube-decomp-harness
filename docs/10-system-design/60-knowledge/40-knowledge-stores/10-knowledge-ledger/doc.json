      "type": "quote",
      "props": {},
      "text": [
        {
          "insert": "The knowledge ledger is its own append-only store with a curator-owned write path (pattern: "
        },
        {
          "insert": "appendCuratedKnowledgeRecords",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), not a new "
        },
        {
          "insert": "CuratedKnowledgeRecord",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " kind and not graph-native nodes. A new "
        },
        {
          "insert": "builders/learnings.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " consumes it at rebuild time, emitting "
        },
        {
          "insert": "HAS_LEARNING",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " edges and flipping "
        },
        {
          "insert": "status",
          "attributes": {
            "code": true
