    "b-30-smashwiki-corpus-worker-searchable-yes-10": {
      "id": "b-30-smashwiki-corpus-worker-searchable-yes-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker-searchable: yes. Resolved page titles and search commands are injected at boot; keyword search and section fetch happen on demand; content is never injected wholesale. The formal corpus operations ("
        },
        {
          "insert": "searchCorpus",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "fetchSection",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "resolveCrosswalk",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") are cataloged on the crosswalk store file."
        }
      ],
      "children": []
