    "b-10-agent-runs-there-is-no-separate-obs-3": {
      "id": "b-10-agent-runs-there-is-no-separate-obs-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no separate observer/observatory module — the inspection surface is the "
        },
        {
          "insert": "Kernel Agent Viewer",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "GET /api/kernel/agents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", built from "
        },
        {
          "insert": "kernel-preview.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), which renders every agent's model, thinking level, tools, and fully rendered system/user prompts from sample fixtures. The librarian shows up there the moment its catalog entry lands — review happens before any run. ("
        },
        {
          "insert": "AGENT_KERNEL_OBSERVER_URL",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is only an external trace-link template.)"
        }
      ],
      "children": []
    },
    "b-10-agent-runs-ts-4": {
      "id": "b-10-agent-runs-ts-4",
      "type": "code",
      "props": {
        "language": "ts"
      },
      "text": [
        {
          "insert": "// agents/knowledge/librarian/agent.ts — proposed definition\nexport default defineAgent({\n  name: \"librarian\",\n  description: \"Condenses inbound material (transcripts+checkpoints, PRs, discord) into attempts and learnings; catalogs into the knowledge ledger.\",\n  model: \"codex-lb/gpt-5.6-sol\",   // judgment-heavy: same tier as workers, not curator's 5.5\n  thinking: \"medium\",               // \"high\" for the corroboration pass\n  coreTools: [\"read\", \"grep\", \"code_graph_search\", \"past_prs_search\", \"ledger_append\", \"ledger_search\"],\n  extensions: false,\n  canSpawnSubagent: false,\n  runInBackground: true,\n});\n// schema.json: learning proposals (subject+scope, origin, statement, evidence[], confidence)\n//            + attempt overlays (checkpoint_id, tactics[{tactic, outcome, at}])\n//            + verdicts on existing learnings (confirm | refute)"
        }
      ],
      "children": []
    },
    "b-10-agent-runs-cli-provider-model-5": {
      "id": "b-10-agent-runs-cli-provider-model-5",
      "type": "quote",
      "props": {},
      "text": [
        {
          "insert": "CLI "
        },
        {
          "insert": "--provider/--model/--thinking-level",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " globally override every agent's "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " model ("
        },
        {
          "insert": "spawn-agent.ts:91-116",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Backfill invocations must omit those flags (or match intentionally) or the librarian's config is silently replaced."
        }
      ],
      "children": []
    },
