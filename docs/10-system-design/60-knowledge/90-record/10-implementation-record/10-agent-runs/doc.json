    "b-10-agent-runs-total-roughly-2-400-4-12": {
      "id": "b-10-agent-runs-total-roughly-2-400-4-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Total: roughly 2,400–4,900 librarian calls; ~8–17 hours wall-clock at jobs=16",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — comfortably a weekend run, or split per source across evenings. The raw-discord row dominates the uncertainty; the distillate cross-check pass can ship first and the raw repull can re-run later without redoing anything else (present-anchored batches are independent)."
        }
      ],
      "children": []
