    "b-10-agent-runs-worker-95-history-836-b-11": {
      "id": "b-10-agent-runs-worker-95-history-836-b-11",
      "type": "quote",
      "props": {},
      "text": [
        {
          "insert": "worker&#95;history 836 batches (3,460 of 3,987 workers have checkpoints, 836 distinct targets) · past&#95;prs 1,168 · discord 1 (one month synced so far) — ~2,005 backfill calls plus the corroboration pass, the low end of the estimate band. Operational note: worker_history planning requires "
        },
        {
          "insert": "--game melee",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or the default state dir resolves to an empty stub and plans zero batches."
        }
      ],
      "children": []
