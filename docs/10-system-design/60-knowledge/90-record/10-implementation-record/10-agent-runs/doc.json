    "b-10-agent-runs-the-machinery-already-ex-7": {
      "id": "b-10-agent-runs-the-machinery-already-ex-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The machinery already exists: the curator path runs batches through "
        },
        {
          "insert": "mapLimit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "--curator-agent-jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (default 16) — it is just unreachable from the run-loop because the flags are not forwarded. The backfill therefore runs as a "
        },
        {
          "insert": "standalone CLI job",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " (new "
        },
        {
          "insert": "job-runner kg-librarian-backfill --source <s> --jobs N",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), not inside the run-loop: no forwarding gap, no competition with live workers, and the harness can stay paused during big passes."
        }
      ],
      "children": []
    },
