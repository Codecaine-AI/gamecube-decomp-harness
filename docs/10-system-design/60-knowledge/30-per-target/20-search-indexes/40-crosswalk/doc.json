      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A mechanical path → wiki-page-titles table: a generated data table under "
        },
        {
          "insert": "games/melee/knowledge/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a proposed resolver in the server's boot-injection assembly, resolving target path → page titles at prompt-build time. Derived (mechanical) regime. Exists today: no code counterpart. Per the "
        },
        {
          "insert": "crosswalk-scope decision",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-knowledge/90-record/30-open-questions"
            }
          }
        },
        {
          "insert": ", coverage extends beyond "
        },
        {
          "insert": "ft",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " characters to "
        },
        {
          "insert": "gr*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stage pages and "
        },
        {
          "insert": "it*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " item pages — same mechanical table format; no "
        },
        {
          "insert": "if",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "mn",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "lb",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sweep, those areas have weak or no wiki counterparts. The mirror itself is reviewed as a "
        },
        {
          "insert": "source",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-knowledge/40-knowledge-stores/30-smashwiki-corpus"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-55-kgr-35-70-3": {
      "id": "b-55-kgr-35-70-3",
      "type": "state-shape",
      "props": {
        "description": "proposal",
        "example": "{\n  \"path_prefix\": \"src/melee/ft/chara/ftKirby/\",\n  \"page_titles\": [\n    \"Kirby (SSBM)\",\n    \"Kirby (SSBM)/Up special\"\n  ],\n  \"family\": \"ft\"\n}",
        "fields": [
          {
            "name": "path_prefix",
            "type": "string",
            "required": true,
            "description": "e.g. src/melee/ft/chara/ftKirby/"
          },
          {
            "name": "page_titles",
            "type": "string[]",
            "required": true
          },
          {
            "name": "family",
            "type": "\"ft\" | \"gr\" | \"it\"",
            "required": true,
            "description": "decision: extend to stages/items"
          }
        ],
        "name": "CrosswalkEntry"
      },
      "children": []
    },
    "b-55-kgr-35-70-4": {
      "id": "b-55-kgr-35-70-4",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "upstream wiki sync refreshes the mirror (staleness vs upstream tolerable)"
          },
          {
            "text": "crosswalk table regenerated from path conventions"
          },
          {
            "text": "boot injection resolves target path → page titles + search commands (pointers only)"
          },
          {
            "text": "worker fetches sections on demand"
          },
          {
            "text": "fetched sections become learning evidence refs"
          }
        ]
      },
      "children": []
    },
    "b-55-kgr-35-70-5": {
      "id": "b-55-kgr-35-70-5",
      "type": "interaction-surface",
      "props": {
        "operations": [
          {
            "name": "resolveCrosswalk",
            "kind": "query",
            "params": [
              {
                "name": "path",
                "type": "string"
              }
            ],
            "returns": "wiki page titles (boot, mechanical)"
          },
          {
            "name": "searchCorpus",
            "kind": "query",
            "params": [
              {
                "name": "keywords",
                "type": "string[]"
              }
            ],
            "returns": "matching sections"
          },
          {
            "name": "fetchSection",
            "kind": "query",
            "params": [
              {
                "name": "page",
                "type": "string"
              },
              {
                "name": "section",
                "type": "string"
              }
            ],
            "returns": "raw text (never injected wholesale)"
          }
        ],
        "title": "What agents get from the corpus"
      },
      "children": []
    }
  }
