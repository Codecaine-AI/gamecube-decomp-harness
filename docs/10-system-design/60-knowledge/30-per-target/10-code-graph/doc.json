        {
          "insert": "builders/code-graph.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This is the base layer: the base walkability everything else attaches to — search indexes, attempt-ledger slices, and knowledge all hang off its target nodes. The store is graph entities plus edges, swapped whole on every rebuild — the rebuild is the audit, so there is zero drift. Derived regime. Exists today: partial — "
        },
        {
          "insert": "COMPILES_TO",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "CONTAINS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only. The decided "
        },
        {
          "insert": "graph-extension scope",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/60-knowledge/30-per-target/20-search-indexes"
            }
          }
        },
        {
          "insert": " adds "
        },
        {
          "insert": "CALLS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "REFERENCES_DATA",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from a heuristic extraction pass, with "
        },
        {
          "insert": "USES_TYPE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " deferred."
        }
