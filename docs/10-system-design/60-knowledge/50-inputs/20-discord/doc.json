      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Discord archive preserves community and developer conversations as evidence for proposed learnings. This document defines its extraction path, graph role, and prohibition on direct worker search."
        }
      ],
      "children": []
    },
    "b-20-discord-what-it-is-2": {
