      "props": {},
      "text": [
        {
          "insert": "Every knowledge execution class uses one durable job vocabulary so queueing, ownership, retry, and terminal attempts remain inspectable. A processor lease makes one attempt authoritative while preserving retry history."
        }
      ],
      "children": []
    },
