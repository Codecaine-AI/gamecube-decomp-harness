      "text": [
        {
          "insert": "Durable state is memory for the orchestrator: run envelopes, epochs, claims, checkpoints, scheduler wake requests, accepted project events, facts, and artifacts preserve scheduling truth between processes. This parent keeps the section map compact; each child owns one state or event contract."
        }
      ],
      "children": []
    },
