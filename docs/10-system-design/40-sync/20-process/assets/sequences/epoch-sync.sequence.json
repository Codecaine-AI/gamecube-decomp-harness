      "kind": "participant"
    },
    {
      "id": "knowledge",
      "name": "Knowledge intake",
      "kind": "participant"
    },
    {
      "id": "state",
      "name": "Harness State",
      "kind": "participant"
    },
    {
      "id": "librarian",
      "name": "Librarian",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "note",
      "id": "n1",
      "anchor": "run",
      "side": "over",
      "text": "Epoch settled; Run retains its dispatch lease"
    },
    {
      "kind": "message",
      "id": "m1",
      "from": "run",
      "to": "checkout",
      "text": "Fetch upstream; apply merge policy if changed",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "run",
      "to": "checkout",
      "text": "Recompute report and build evidence",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "checkout",
      "to": "run",
      "text": "Verified head and report",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m4",
      "from": "run",
      "to": "knowledge",
      "text": "Reconcile report and attempts; run configured source pipeline",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m5",
      "from": "knowledge",
      "to": "run",
      "text": "Required sources ready; tasks queued",
      "line": "return"
    },
    {
      "kind": "message",
      "id": "m6",
      "from": "run",
      "to": "knowledge",
      "text": "Refresh graph and search artifacts",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m7",
      "from": "run",
      "to": "state",
      "text": "Save pr_sync evidence; publish accepted head and sync_completed",
      "line": "sync"
    },
    {
      "kind": "message",
      "id": "m8",
      "from": "librarian",
      "to": "knowledge",
      "text": "Consume queued tasks; validate and apply proposals",
      "line": "sync"
    },
    {
      "kind": "note",
      "id": "n2",
      "anchor": "run",
      "side": "over",
      "text": "Further boundary gates must pass before admission resumes"
    }
  ],
