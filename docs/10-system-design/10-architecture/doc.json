		"b-20-architecture-decision-target-arch-7": {
			"id": "b-20-architecture-decision-target-arch-7",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Target-changing workers execute in per-claim Daytona micro-VM sandboxes. The sandbox bounds file and command access without granting scheduling or publication authority."
				}
			],
			"children": []
		},
		"b-20-architecture-shared-knowledge-8": {
			"id": "b-20-architecture-shared-knowledge-8",
