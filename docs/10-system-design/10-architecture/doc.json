			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Shared Knowledge Base"
				}
			],
			"children": []
		},
		"b-20-architecture-every-worker-and-support-9": {
			"id": "b-20-architecture-every-worker-and-support-9",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The shared knowledge system holds durable findings, target evidence, worker results, and the indexes derived from them. Every agent searches it before acting and contributes through governed processing and publication paths; "
				},
				{
					"insert": "Knowledge System",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/40-knowledge"
						}
					}
				},
				{
					"insert": " defines those stores and worker-facing surfaces."
				}
			],
			"children": []
		},
		"b-20-architecture-dispatch-authority-10": {
			"id": "b-20-architecture-dispatch-authority-10",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Coordination and Dispatch"
				}
			],
			"children": []
		},
		"b-20-architecture-a-fenced-dispatch-lease-11": {
			"id": "b-20-architecture-a-fenced-dispatch-lease-11",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The scheduler turns durable evidence into reproducible work selection. A fenced dispatch lease is the sole authority for spawning workers, so concurrent workflows cannot dispatch overlapping work; "
				},
				{
					"insert": "Dispatch Authority",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/30-harness/50-dispatch-authority"
						}
					}
				},
				{
					"insert": " defines acquisition, handoff, release, and recovery."
				}
			],
			"children": []
		},
		"b-20-architecture-system-boundary-12": {
			"id": "b-20-architecture-system-boundary-12",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "System Boundary"
				}
			],
			"children": []
		},
		"b-architecture-boundary-intro": {
			"id": "b-architecture-boundary-intro",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The boundary separates global coordination from bounded execution. This separation permits worker scale without allowing local reasoning to mutate global truth directly."
				}
			],
			"children": []
		},
