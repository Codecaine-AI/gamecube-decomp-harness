    "b-20-operator-flow-and-pr-tracking-a-pr-campaign-owns-the-o-1": {
      "id": "b-20-operator-flow-and-pr-tracking-a-pr-campaign-owns-the-o-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A PR campaign owns the operational review cycle for every series cut from one stable point. It persists while upstream review is in progress, but it holds execution authority only during operator-entered activations. This document defines that campaign lifecycle, including publication, observation, feedback, closure, and adoption of legacy split series."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-decision-2026-08-11-pr-work-is-operator--2": {
      "id": "b-20-operator-flow-and-pr-tracking-decision-2026-08-11-pr-work-is-operator--2",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Decision (2026-08-11) — PR work is operator-entered, never preempts a run",
        "tone": "success"
      },
      "text": [
        {
          "insert": "Review evidence is accepted at any time, but work that publishes or changes a series waits for an operator-entered activation. Mid-run entry first drains the run at its current epoch boundary."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-authority-between-runs-a-3": {
      "id": "b-20-operator-flow-and-pr-tracking-authority-between-runs-a-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Authority Between Runs and PR Work"
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-pr-work-yields-to-an-act-4": {
      "id": "b-20-operator-flow-and-pr-tracking-pr-work-yields-to-an-act-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "PR work yields to an active run because evidence collection does not need execution authority:"
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-remote-review-state-and-5": {
      "id": "b-20-operator-flow-and-pr-tracking-remote-review-state-and-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Remote review state and feedback continue to enter durable campaign state while the run owns dispatch."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-publishing-fixing-and-6": {
      "id": "b-20-operator-flow-and-pr-tracking-publishing-fixing-and-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Publishing, fixing, and validating wait until the operator enters PR work and the campaign acquires the dispatch lease."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-an-explicit-mid-run-hand-7": {
      "id": "b-20-operator-flow-and-pr-tracking-an-explicit-mid-run-hand-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An explicit mid-run handoff drains the run at its epoch boundary before transferring dispatch, so PR work never preempts active worker execution. This v1 exclusivity is a worker-capacity and operational-simplicity constraint, not a source-truth requirement: PR workspaces share no mutable state with the session source."
        }
      ],
      "children": []
    },
    "b-gap-pr-future-concurrency": {
      "id": "b-gap-pr-future-concurrency",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Running PR work and run processing concurrently is an explicitly desired future relaxation. Any concurrency design must revisit the single dispatch-lease decision and define separate capacity and authority boundaries instead of silently weakening the lease."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-why-entry-is-explicit-8": {
      "id": "b-20-operator-flow-and-pr-tracking-why-entry-is-explicit-8",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Why Entry Is Explicit"
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-review-latency-is-extern-9": {
      "id": "b-20-operator-flow-and-pr-tracking-review-latency-is-extern-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Review latency is external and irregular, while a run produces value continuously. Explicit entry keeps the active workflow legible and lets the operator choose when reviewer feedback is important enough to stop admitting run work."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-decision-2026-08-12-one-durable-prcampai-10": {
      "id": "b-20-operator-flow-and-pr-tracking-decision-2026-08-12-one-durable-prcampai-10",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Decision (2026-08-12) — one durable PrCampaign spans the review cycle",
        "tone": "success"
      },
      "text": [
        {
          "insert": "Each stable-point split has one durable campaign, and a project has at most one open campaign. The campaign holds the dispatch lease only inside operator-entered activations."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-durable-campaign-boundar-11": {
      "id": "b-20-operator-flow-and-pr-tracking-durable-campaign-boundar-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Durable Campaign Boundary"
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-the-campaign-is-the-dura-12": {
      "id": "b-20-operator-flow-and-pr-tracking-the-campaign-is-the-dura-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The campaign is the durable parent of the split series and their review work:"
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-its-source-anchor-is-the-13": {
      "id": "b-20-operator-flow-and-pr-tracking-its-source-anchor-is-the-13",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Its source anchor is the clean, named stable point from which every series was cut, so later sync evidence blocks stale work instead of rewriting campaign history."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-its-publication-policy-a-14": {
      "id": "b-20-operator-flow-and-pr-tracking-its-publication-policy-a-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Its publication policy assigns series to ordered batches, while each series retains its branch, upstream identity, validation evidence, blockers, and feedback work items."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-its-open-lifetime-spans-15": {
      "id": "b-20-operator-flow-and-pr-tracking-its-open-lifetime-spans-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Its open lifetime spans preparation, publication, review, revision, and terminal observation, even though no campaign process runs for most of that time."
        }
      ],
      "children": []
    },
    "b-20-operator-flow-and-pr-tracking-its-single-open-invarian-16": {
      "id": "b-20-operator-flow-and-pr-tracking-its-single-open-invarian-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Its single-open invariant prevents two stable-point splits from interleaving publication decisions and review learning for the same project."
        }
      ],
      "children": []
    },
    "b-gap-pr-campaign-shape": {
      "id": "b-gap-pr-campaign-shape",
      "type": "state-shape",
      "props": {
        "description": "Durable campaign identity, immutable stable-point source, publication policy, and activation history.",
        "fields": [
          {
            "name": "save_point_id",
            "type": "SavePointId",
