    "sd-opening": {
      "id": "sd-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each game owns its configuration, checkout, knowledge base, and runtime state. Shared tooling operates on that game scope. Start with what a game contains, then learn how knowledge is stored and how the harness uses it."
        }
      ],
      "children": []
    },
    "sd-map-h": {
      "id": "sd-map-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How the Pieces Connect"
        }
      ],
      "children": []
    },
    "b-system-shared-knowledge-canvas": {
      "id": "b-system-shared-knowledge-canvas",
