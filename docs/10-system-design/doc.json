    "b-00-overview-d-comp-orchestrator-syst-2": {
      "id": "b-00-overview-d-comp-orchestrator-syst-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "D-Comp Orchestrator system design map."
        }
      ],
      "children": []
    },
    "b-00-overview-d-comp-orchestrator-is-a-3": {
      "id": "b-00-overview-d-comp-orchestrator-is-a-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "D-Comp Orchestrator is an event-driven coordination system for decompilation\nwork. A thin runner owns durable state transitions, deterministic scheduling,\nand agent invocation. Pi agents own bounded target-local or boundary-specific\nreasoning. The board is the shared medium between those two worlds.\nAn optional guardian process can wrap the decomp system process to handle\noperational health events, recovery, and restart without becoming a second\nboard scheduler."
        }
      ],
      "children": []
    },
    "b-00-overview-architecture-map-4": {
      "id": "b-00-overview-architecture-map-4",
