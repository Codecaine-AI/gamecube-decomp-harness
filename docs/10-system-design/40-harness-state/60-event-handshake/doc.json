    "b-index-events-are-the-handshake-1": {
      "id": "b-index-events-are-the-handshake-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Scheduler wake events are the handshake between workers, the runner, and the sleeping scheduler loop. They are durable work-queue signals, not accepted game facts. A producer writes a wake request with payload and provenance; the runner handles the oldest relevant unhandled request and marks it handled only after the resulting decision or state transition is stored."
        }
      ],
      "children": []
    },
    "b-index-accepted-run-transitions-2": {
      "id": "b-index-accepted-run-transitions-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When a wake request leads to an accepted run transition, the transition appends one "
        },
        {
          "insert": "game event",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "docs/10-system-design/40-harness-state/50-game-events.mdx",
              "label": "game event"
            }
          }
        },
        {
          "insert": " and updates RunState under its expected revision in one transaction. The transition increments revision once and points "
        },
        {
          "insert": "caused_by_event_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at that event; a stale revision refuses the state write, event, and publication work together. Scheduler-condition updates stay outside this accepted-fact transaction because they are observability only."
        }
      ],
      "children": []
    },
