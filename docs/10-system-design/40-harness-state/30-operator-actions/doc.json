    },
    "b-30-operator-actions-the-builder-reads-canoni-9": {
      "id": "b-30-operator-actions-the-builder-reads-canoni-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The builder reads canonical state once and projects summaries, dispatch queue order, knowledge freshness, active operations, bounded recent history, and action guards at the same game revision. Disabled actions remain present with explicit blockers. Operator clients consume the projection exactly and never infer enablement, confirmation policy, or dispatch authority."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-operations-10": {
      "id": "b-30-operator-actions-operations-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Operations"
        }
      ],
      "children": []
    },
    "b-30-operator-actions-each-action-projection-n-11": {
      "id": "b-30-operator-actions-each-action-projection-n-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each action projection names its subject, enabled state, blockers, expected transition, and confirmation requirement. Command routes re-derive availability and reject disabled actions rather than trusting the client projection."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-open-decision-55": {
      "id": "b-30-operator-actions-open-decision-55",
      "type": "callout",
      "props": {
        "title": "Open decision: no game.create / cycle.open action",
        "tone": "decision"
      },
      "text": [
        {
          "insert": "The 21-action operator surface has no game.create or cycle.open action, so the registration and cycle-open entry path described by "
        },
        {
          "insert": "registration and setup",
          "attributes": {
            "link": "../../30-games/20-registration-and-setup"
          }
        },
        {
          "insert": " is currently outside this surface. The open decision is whether those actions join it or whether registration remains a separate entry path."
        }
      ],
      "children": []
    },
