    "b-30-operator-actions-harnessstateview-is-the-1": {
      "id": "b-30-operator-actions-harnessstateview-is-the-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessState",
          "attributes": {
            "link": "../10-state-composition/10-harness-state"
          }
        },
        {
          "insert": "View is the server-owned projection of current harness state and operator authority. It exposes the canonical state summary first, then the complete v1 inventory of 21 projected actions; clients render these decisions without recomputing authority."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-state-2": {
      "id": "b-30-operator-actions-state-2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "State"
        }
      ],
      "children": []
    },
    "b-30-operator-actions-text-3": {
      "id": "b-30-operator-actions-text-3",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "HarnessStateView\n  game_id: GameId\n  game_revision: integer\n  cycle: CycleSummary | null\n    active-cycle identity\n    head revision\n    latest timeline entry\n  active_workflow: ActiveWorkflowSummary | null\n    kind: run | pr | sync\n    workflow_id\n    status: acquiring | active | draining | blocked | releasing\n    headline: string\n    blockers: Blocker[]\n  queued_dispatch_requests: DispatchRequest[]\n  run: RunSummary | null\n  pr_work: PrWorkflowSummary[]\n  knowledge: KnowledgeFreshnessSummary\n  sync: SyncSummary | null\n  active_operations: OperationSummary[]\n  recent_events: EventSummary[]\n  available_actions: ActionProjection[21]\n  compatibility_actions: ActionProjection[]\n\nActionProjection\n  action_id\n  subject_kind\n  subject_id\n  enabled\n  blocked_by: Blocker[]\n  expected_transition\n  confirmation_required"
        }
      ],
      "children": []
    },
    "b-30-operator-actions-game-revision-ident-4": {
      "id": "b-30-operator-actions-game-revision-ident-4",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies the canonical state revision used for the complete projection."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-active-workflow-identi-5": {
      "id": "b-30-operator-actions-active-workflow-identi-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "active_workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies the dispatch-lease holder and is null while dispatch authority is free."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-recent-events-is-bound-6": {
      "id": "b-30-operator-actions-recent-events-is-bound-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "recent_events",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is bounded accepted-fact history; canonical state and "
        },
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remain authoritative."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-compatibility-actions-7": {
      "id": "b-30-operator-actions-compatibility-actions-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "compatibility_actions",
          "attributes": {
