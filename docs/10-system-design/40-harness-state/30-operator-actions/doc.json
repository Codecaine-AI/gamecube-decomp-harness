            "code": true
          }
        },
        {
          "insert": "; these never enter the 21-action inventory."
        }
      ],
      "children": []
    },
    "b-30-operator-actions-projection-rules-8": {
      "id": "b-30-operator-actions-projection-rules-8",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
