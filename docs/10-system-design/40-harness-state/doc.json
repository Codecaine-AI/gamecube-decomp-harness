      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessState composes the durable workflow state for one game. A fenced dispatch lease is the sole authority to dispatch workers or mutate checkout surfaces; the remaining contracts define the operator projection, durable records, accepted facts, and wake-up handshake around that authority."
        }
      ],
      "children": []
    },
