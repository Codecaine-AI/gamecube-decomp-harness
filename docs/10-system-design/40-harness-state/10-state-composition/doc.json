    "b-10-state-composition-harness-state-is-read-fr-1": {
      "id": "b-10-state-composition-harness-state-is-read-fr-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessState is one composed aggregate read at a single game revision. The canonical game aggregate and domain records explain workflow truth, while the shared jobs table records dispatch truth for worker, knowledge_absorption, sync_publication, and integration work. A job points through result_ref to domain evidence instead of embedding that evidence in queue state."
        }
      ],
      "children": []
    },
    "b-10-state-composition-composition-at-a-glance-17": {
      "id": "b-10-state-composition-composition-at-a-glance-17",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Composition at a Glance"
        }
      ],
      "children": []
    },
    "b-10-state-composition-composition-tree-18": {
      "id": "b-10-state-composition-composition-tree-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The composition tree runs HarnessState through dispatch authority and the five domain views. The jobs table is the durable cross-workflow dispatch ledger beside those views; the dispatch lease authorizes host dispatch, while a claimed worker job mints the ClaimToken that fences worker-state writes."
        }
      ],
      "children": []
    },
    "b-10-state-composition-state-composition-tree-20": {
      "id": "b-10-state-composition-state-composition-tree-20",
      "type": "canvas",
