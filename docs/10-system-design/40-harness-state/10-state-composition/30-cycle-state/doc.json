    "b-30-cycle-state-projectcycle-is-the-1": {
      "id": "b-30-cycle-state-projectcycle-is-the-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "CycleState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the durable state structure for one bounded period of game work. It carries the baseline-to-head lineage and ordered workflow timeline while "
        },
        {
          "insert": "HarnessState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exposes the one current cycle slot. "
        },
        {
          "insert": "Game Cycles",
          "attributes": {
            "link": "../../../30-games/30-cycles"
          }
        },
        {
          "insert": " owns cycle behavior and close policy; this page defines the state shape that supports them."
        }
      ],
      "children": []
    },
    "b-30-cycle-state-base-class-2": {
      "id": "b-30-cycle-state-base-class-2",
