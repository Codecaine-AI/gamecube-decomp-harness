      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An operator close action changes "
        },
        {
          "insert": "status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from "
        },
        {
          "insert": "active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "closing",
          "attributes": {
            "code": true
          }
