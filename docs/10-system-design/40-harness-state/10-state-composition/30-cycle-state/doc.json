    "b-30-cycle-state-container-slot-9": {
      "id": "b-30-cycle-state-container-slot-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The behavioral contract — durable container, single active cycle, and ordered timeline — is defined by the "
        },
        {
          "insert": "Cycles page",
          "attributes": {
            "link": "../../../30-games/30-cycles"
          }
        },
        {
          "insert": "; this page defines only the durable shape."
        }
      ],
      "children": []
    },
    "b-30-cycle-state-activate-21": {
      "id": "b-30-cycle-state-activate-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The three-value "
        },
        {
          "insert": "CycleState.status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enum is authoritative for durable lifecycle state. The "
        },
        {
          "insert": "event catalog",
          "attributes": {
            "link": "../../50-game-events/20-registry-and-catalog"
          }
        },
        {
          "insert": " records the closing transition through "
        },
        {
          "insert": "cycle.complete",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and reports running and PR phase progress within that lifecycle; those progress facts do not expand the enum."
        }
      ],
      "children": []
    },
