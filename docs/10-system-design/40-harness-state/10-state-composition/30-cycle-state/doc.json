        {
          "insert": "Base Class"
        }
      ],
      "children": []
    },
    "b-30-cycle-state-cycle-state-extends-th-3": {
      "id": "b-30-cycle-state-cycle-state-extends-th-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Cycle state extends the "
        },
        {
          "insert": "workflow slot envelope",
          "attributes": {
            "link": "../20-workflow-slot"
          }
        },
        {
          "insert": " with cycle-owned lineage, timeline, and lifecycle fields. The envelope supplies shared identity, revision, timestamps, trace provenance, and blockers."
        }
      ],
      "children": []
    },
