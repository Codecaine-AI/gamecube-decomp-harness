    "b-30-cycle-state-prepare-18": {
      "id": "b-30-cycle-state-prepare-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Cycle opening allocates the envelope, captures and verifies the baseline outside the active slot, then durably installs the active state. The "
        },
        {
          "insert": "registration and setup procedure",
          "attributes": {
            "link": "../../../30-games/20-registration-and-setup"
          }
        },
        {
          "insert": " owns the worktree and opening sequence."
        }
      ],
      "children": []
    },
