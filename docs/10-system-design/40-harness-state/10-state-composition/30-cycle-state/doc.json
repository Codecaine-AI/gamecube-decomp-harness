    "b-30-cycle-state-the-cycle-close-operat-30": {
      "id": "b-30-cycle-state-the-cycle-close-operat-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The cycle-close operation records the final evidence boundary, changes "
        },
        {
          "insert": "status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "closed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and clears the current "
        },
