    "b-restored-cycle-state-shape-20260814": {
      "id": "b-restored-cycle-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Durable container owning the worktree, head lineage, timeline, and child workflows of one cycle.",
        "example": "{\n  \"cycle_id\": \"cycle-7\",\n  \"game_id\": \"melee\",\n  \"revision\": 3104,\n  \"status\": \"active\",\n  \"original_baseline_revision\": \"upstream-9ac4\",\n  \"head_revision\": \"upstream-9ba1\",\n  \"timeline\": [\n    {\n      \"entry_kind\": \"epoch_completed\",\n      \"entry_id\": \"epoch-19\",\n      \"occurred_at\": \"2026-08-11T17:55:00Z\"\n    },\n    {\n      \"entry_kind\": \"remote_application\",\n      \"entry_id\": \"remote-application-3\",\n      \"occurred_at\": \"2026-08-11T19:10:00Z\"\n    }\n  ],\n  \"workflow_ids\": [\n    \"run-2026-08-11-01\",\n    \"sync-2026-08-11-02\"\n  ],\n  \"created_at\": \"2026-08-01T09:00:00Z\",\n  \"trace_id\": \"trace-cycle-7\",\n  \"blockers\": []\n}",
        "fields": [
          {
            "name": "cycle_id",
            "type": "CycleId"
          },
          {
            "name": "game_id",
            "type": "GameId"
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "status",
            "type": "\"active\" | \"closing\" | \"closed\"",
            "description": "Only one cycle may be active per game; closing is an explicit operator action."
          },
          {
            "name": "original_baseline_revision",
            "type": "SourceRevision",
            "description": "The baseline sync that opened the cycle. Immutable."
          },
          {
            "name": "head_revision",
            "type": "SourceRevision",
            "description": "Canonical cycle head. Only epoch integrations and remote-application boundaries advance it."
          },
          {
            "name": "timeline",
            "type": "TimelineEntry[]",
            "description": "Ordered head-lineage record. Head-advancing entries are transactional with their commits; save points are evidence anchors pinned to existing commits. See the timeline entry-kind table below.",
            "fields": [
              {
                "name": "entry_kind",
                "type": "\"epoch_completed\" | \"remote_application\" | \"pr_phase\" | \"save_point\""
              },
              {
                "name": "entry_id",
                "type": "string"
              },
              {
                "name": "occurred_at",
                "type": "timestamp"
              }
            ]
          },
          {
            "name": "workflow_ids",
            "type": "WorkflowId[]",
            "description": "Child run, PR, and sync workflows in creation order."
          },
          {
            "name": "created_at",
            "type": "timestamp"
          },
          {
            "name": "closed_at",
            "type": "timestamp",
            "required": false
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          }
        ],
        "name": "CycleState"
      },
      "children": []
    },
