        "fields": [
          {
            "name": "jobs",
            "type": "BackgroundKnowledgeJobRecord[]",
            "description": "Durable artifact-processing records carrying lifecycle, fencing, provenance, publication, and failure evidence.",
            "fields": [
              {
                "name": "job_id",
                "type": "KnowledgeJobId",
                "description": "Stable durable job identity."
              },
              {
                "name": "worker_state_id",
                "type": "WorkerStateId",
