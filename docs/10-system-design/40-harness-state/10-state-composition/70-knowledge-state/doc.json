      "props": {
        "description": "Knowledge dispatch projected from the shared jobs table together with accepted publication evidence and game-level freshness.",
        "example": "{\n  \"jobs\": [\n    {\n      \"job_id\": \"job-knowledge-absorption-worker-1842\",\n      \"kind\": \"knowledge_absorption\",\n      \"dedupe_key\": \"worker-1842\",\n      \"worker_state_id\": \"worker-1842\",\n      \"game_id\": \"melee\",\n      \"run_id\": \"run-2026-08-11-01\",\n      \"revision\": 2,\n      \"status\": \"running\",\n      \"execution_class\": \"local\",\n      \"attempts\": 1,\n      \"next_attempt_at\": null,\n      \"lease_id\": \"knowledge-lease-44\",\n      \"lease_expires_at\": \"2026-08-12T18:43:08Z\",\n      \"result_ref\": null,\n      \"trace_id\": \"trace-worker-1842\",\n      \"caused_by_event_id\": \"event-92811\",\n      \"created_at\": \"2026-08-12T18:42:08Z\",\n      \"updated_at\": \"2026-08-12T18:42:10Z\",\n      \"completed_at\": null\n    }\n  ],\n  \"published_revision\": \"knowledge-381\",\n  \"queued\": 6,\n  \"running\": 1,\n  \"waiting\": 1,\n  \"failed\": 1,\n  \"oldest_pending_at\": \"2026-08-12T18:35:12Z\",\n  \"active_lease\": {\n    \"id\": \"knowledge-lease-44\",\n    \"expires_at\": \"2026-08-12T18:43:08Z\"\n  },\n  \"retry\": {\n    \"next_attempt_at\": \"2026-08-12T18:45:00Z\",\n    \"attempts\": 2\n  },\n  \"recent_failures\": [\n    {\n      \"job_id\": \"job-knowledge-absorption-worker-1819\",\n      \"worker_state_id\": \"worker-1819\",\n      \"error\": \"Materialized evidence failed schema validation.\",\n      \"attempts\": 3,\n      \"updated_at\": \"2026-08-12T18:40:22Z\"\n    }\n  ]\n}",
        "fields": [
          {
            "name": "jobs",
            "type": "JobRecord[]",
            "description": "Knowledge-kind rows projected from the shared jobs table; domain publication evidence remains outside the dispatch record.",
            "fields": [
              {
                "name": "job_id",
                "type": "JobId",
                "description": "Stable durable job identity."
              },
              {
                "name": "kind",
                "type": "\"knowledge_absorption\" | \"sync_publication\"",
                "description": "Descriptor that selects the inline knowledge handler."
              },
              {
                "name": "dedupe_key",
                "type": "string",
                "description": "Worker-state identity for absorption or deterministic sync/source identity for publication."
              },
              {
                "name": "worker_state_id",
                "type": "WorkerStateId",
                "description": "Source worker identity carried by knowledge_absorption jobs."
              },
              {
                "name": "game_id",
                "type": "GameId",
                "description": "Game whose accepted knowledge this job may advance."
              },
              {
                "name": "run_id",
                "type": "RunId",
                "description": "Run that produced the source evidence."
              },
              {
                "name": "revision",
                "type": "integer",
                "description": "Monotonic version incremented for every accepted transition."
              },
              {
                "name": "status",
                "type": "\"queued\" | \"claimed\" | \"running\" | \"waiting\" | \"succeeded\" | \"failed\" | \"cancelled\"",
                "description": "Current lifecycle position of the shared queue job."
              },
              {
                "name": "execution_class",
                "type": "\"local\" | \"sandbox\"",
                "description": "Executor class recorded by the shared queue; both knowledge kinds execute inline locally."
              },
              {
                "name": "source_kind",
                "type": "string",
                "description": "Kind of artifact or event that requested processing."
              },
              {
                "name": "source_id",
                "type": "string",
                "description": "Stable identity of the source artifact for idempotent enqueueing."
              },
              {
                "name": "attempts",
                "type": "integer",
                "description": "Number of accepted processing attempts."
              },
              {
                "name": "next_attempt_at",
                "type": "timestamp | null",
                "description": "Earliest time a waiting job may be claimed again."
              },
              {
                "name": "lease_id",
                "type": "LeaseId | null",
                "description": "Fencing token required from the current processing owner."
              },
              {
                "name": "lease_expires_at",
                "type": "timestamp | null",
                "description": "Time after which the current processing claim may be reclaimed."
              },
              {
                "name": "evidence_provenance",
                "type": "JSON object",
                "description": "Evidence and input lineage that produced the job."
              },
              {
                "name": "publication_provenance",
                "type": "JSON object | null",
                "description": "Accepted output lineage, populated after publication."
              },
              {
                "name": "result_ref",
                "type": "string | null",
                "description": "Reference to accepted domain evidence; sync publication stores its digest here."
              },
              {
                "name": "error",
                "type": "JSON object | null",
                "description": "Failure evidence from the latest unsuccessful attempt."
              },
              {
                "name": "trace_id",
                "type": "TraceId",
                "description": "Trace lineage shared with the work that produced the job."
              },
              {
                "name": "caused_by_event_id",
                "type": "EventId | null",
                "description": "Event whose accepted transition caused the job to exist."
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "description": "Explicit conditions preventing the next job transition."
              },
              {
                "name": "created_at",
                "type": "timestamp",
                "description": "Time the durable job was first enqueued."
              },
              {
                "name": "updated_at",
                "type": "timestamp",
                "description": "Time of the most recent accepted job transition."
              },
              {
                "name": "completed_at",
                "type": "timestamp | null",
                "description": "Time the job reached a terminal lifecycle state."
              }
            ]
          },
          {
            "name": "published_revision",
            "type": "KnowledgeRevision | null"
          },
          {
            "name": "queued",
            "type": "integer"
          },
          {
            "name": "running",
            "type": "integer"
          },
          {
            "name": "waiting",
            "type": "integer"
          },
          {
            "name": "failed",
            "type": "integer"
          },
          {
            "name": "oldest_pending_at",
            "type": "timestamp | null"
          },
          {
            "name": "active_lease",
            "type": "KnowledgeLeaseSummary | null",
            "description": "Current visibility-timeout lease projected from a claimed or running jobs row.",
            "fields": [
              {
                "name": "id",
                "type": "LeaseId"
              },
              {
                "name": "expires_at",
                "type": "timestamp"
              }
            ]
          },
          {
            "name": "retry",
            "type": "KnowledgeRetrySummary | null",
            "description": "Earliest pending retry and its accepted attempt count.",
            "fields": [
              {
                "name": "next_attempt_at",
                "type": "timestamp"
              },
              {
                "name": "attempts",
                "type": "integer"
              }
            ]
          },
          {
            "name": "recent_failures",
            "type": "KnowledgeFailureSummary[]",
            "description": "Bounded operator-facing failure evidence; accepted knowledge remains unchanged.",
            "fields": [
              {
                "name": "job_id",
                "type": "JobId"
              },
              {
                "name": "worker_state_id",
                "type": "WorkerStateId"
              },
              {
                "name": "error",
                "type": "string"
              },
              {
                "name": "attempts",
                "type": "integer"
              },
              {
                "name": "updated_at",
                "type": "timestamp"
              }
            ]
          }
        ],
        "name": "KnowledgeState"
      },
