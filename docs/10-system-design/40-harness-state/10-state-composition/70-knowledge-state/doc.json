    "b-70-knowledge-state-knowledge-state-is-not-a-1": {
      "id": "b-70-knowledge-state-knowledge-state-is-not-a-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge state is not a classic workflow slot. It is a set of durable background job records plus a game-level freshness summary, so it can advance while sync, run, or PR work owns workflow authority. The state exposes publication freshness, queued work, lease ownership, retry timing, and failures without pretending that knowledge processing occupies the shared workflow slot."
        }
      ],
      "children": []
    },
