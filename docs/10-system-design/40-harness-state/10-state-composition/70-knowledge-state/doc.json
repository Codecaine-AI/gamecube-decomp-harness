    "b-70-knowledge-state-knowledge-state-is-not-a-1": {
      "id": "b-70-knowledge-state-knowledge-state-is-not-a-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge state is not a workflow slot. The shared jobs table carries dispatch truth for knowledge_absorption and sync_publication, while domain records and the game-level projection carry accepted knowledge evidence. This separation lets knowledge work advance while sync, run, or PR work owns workflow authority and exposes freshness, queued work, lease ownership, retry timing, and failures without treating queue state as publication evidence."
        }
      ],
      "children": []
    },
