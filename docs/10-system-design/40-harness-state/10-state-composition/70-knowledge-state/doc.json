          "insert": "Serialized acceptance publishes the result idempotently, stores accepted evidence in the knowledge domain, marks the job "
        },
        {
          "insert": "succeeded",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and advances "
        },
        {
          "insert": "published_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
