    "b-70-knowledge-state-process-overview-50": {
      "id": "b-70-knowledge-state-process-overview-50",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge absorption runs through an inline consumer pool with a limit of two jobs. Sync publication uses the same queue kernel but is driven synchronously by staged ingest, keeping publication ordering within the sync pipeline. The design-level enqueue → claim → materialize → publish walkthrough lives in the "
        },
        {
          "insert": "knowledge process overview",
          "attributes": {
            "link": "../../../60-knowledge/05-process-overview"
          }
        },
        {
          "insert": "; the flows below show how that spine changes composed state."
        }
      ],
      "children": []
    },
    "b-70-knowledge-state-enqueue-at-worker-close-34": {
      "id": "b-70-knowledge-state-enqueue-at-worker-close-34",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Enqueue at Worker Close → Claim/Lease → Materialize → Publish"
        }
      ],
      "children": []
    },
    "b-70-knowledge-state-worker-close-durably-enq-35": {
      "id": "b-70-knowledge-state-worker-close-durably-enq-35",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Worker close durably enqueues one knowledge_absorption job per worker_state id."
        }
      ],
      "children": []
    },
    "b-70-knowledge-state-a-processor-atomically-c-36": {
      "id": "b-70-knowledge-state-a-processor-atomically-c-36",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The inline consumer atomically claims eligible work, changes its status to "
        },
        {
          "insert": "running",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", increments attempt state, and records a fenced lease."
        }
      ],
      "children": []
    },
    "b-70-knowledge-state-the-processor-materializ-37": {
      "id": "b-70-knowledge-state-the-processor-materializ-37",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The inline handler materializes the worker evidence while the per-kind pool limits knowledge_absorption concurrency to two."
        }
      ],
      "children": []
    },
    "b-70-knowledge-state-serialized-acceptance-pu-38": {
      "id": "b-70-knowledge-state-serialized-acceptance-pu-38",
