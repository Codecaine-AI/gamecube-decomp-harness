    "b-60-pr-state-pr-campaign-state-is-the-1": {
      "id": "b-60-pr-state-pr-campaign-state-is-the-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "PR campaign state is the durable "
        },
        {
          "insert": "HarnessState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " slice for one review series cut from a stable point. It preserves campaign identity, upstream PR tracking, feedback work, and review-cycle progress while upstream review proceeds. The "
        },
        {
          "insert": "PR Workflow",
          "attributes": {
            "link": "docs/10-system-design/50-workflows/30-pr"
          }
        },
        {
          "insert": " defines the behavior that advances this state."
        }
      ],
      "children": []
    },
