    "b-restored-pr-campaign-state-shape-20260814": {
      "id": "b-restored-pr-campaign-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Durable campaign owning the series split from one stable point and the activations that work them.",
        "example": "{\n  \"campaign_id\": \"pr-campaign-4\",\n  \"game_id\": \"melee\",\n  \"cycle_id\": \"cycle-7\",\n  \"revision\": 57,\n  \"status\": \"in_review\",\n  \"source_anchor\": {\n    \"save_point_id\": \"save-point-12\",\n    \"source_revision\": \"upstream-9ba1\"\n  },\n  \"publication_policy\": {\n    \"batch_size\": 4\n  },\n  \"series_ids\": [\n    \"series-18\",\n    \"series-19\",\n    \"series-20\",\n    \"series-21\",\n    \"series-22\"\n  ],\n  \"activation_ids\": [\n    \"pr-phase-9\",\n    \"pr-phase-10\"\n  ],\n  \"latest_event_sequence\": 93544,\n  \"created_at\": \"2026-08-12T09:00:00Z\",\n  \"trace_id\": \"trace-pr-campaign-4\",\n  \"blockers\": []\n}",
        "fields": [
          {
            "name": "campaign_id",
            "type": "PrCampaignId"
          },
          {
            "name": "game_id",
            "type": "GameId"
          },
          {
            "name": "cycle_id",
            "type": "CycleId",
            "description": "Owning cycle container."
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "status",
            "type": "\"preparing\" | \"in_review\" | \"working\" | \"completed\" | \"abandoned\""
          },
          {
            "name": "source_anchor",
            "type": "SourceAnchor",
            "description": "The stable point the campaign was split from. Immutable — sync invalidations arrive as blockers, never by rewriting the anchor.",
            "fields": [
              {
                "name": "save_point_id",
                "type": "SavePointId"
              },
              {
                "name": "source_revision",
                "type": "SourceRevision",
                "description": "Cycle head at the split."
              }
            ]
          },
          {
            "name": "publication_policy",
            "type": "PublicationPolicy",
            "description": "Publication is operator-gated per batch; preparing more series never opens them.",
            "fields": [
              {
                "name": "batch_size",
                "type": "integer",
                "description": "Series opened per operator-approved batch so reviewers are not swamped."
              }
            ]
          },
          {
            "name": "series_ids",
            "type": "PrSeriesId[]",
            "description": "Every series in the campaign, published or not, in batch order."
          },
          {
            "name": "activation_ids",
            "type": "PrPhaseId[]",
            "description": "Lease-holding activations; each is mirrored as a pr_phase entry in the cycle timeline."
          },
          {
            "name": "latest_event_sequence",
            "type": "integer"
          },
          {
            "name": "created_at",
            "type": "timestamp"
          },
          {
            "name": "closed_at",
            "type": "timestamp",
            "required": false
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          }
        ],
        "name": "PrCampaignState"
      },
      "children": []
    },
    "b-restored-pr-series-state-shape-20260814": {
      "id": "b-restored-pr-series-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "One reviewable PR: branch, upstream identity, feedback work items, and validation evidence.",
        "example": "{\n  \"series_id\": \"series-20\",\n  \"campaign_id\": \"pr-campaign-4\",\n  \"revision\": 12,\n  \"batch_index\": 0,\n  \"status\": \"changes_requested\",\n  \"branch\": \"pr/cycle-7-lbvector\",\n  \"upstream_pr_number\": 2850,\n  \"target_units\": [\n    \"melee/lb/lbvector.c\"\n  ],\n  \"work_items\": [\n    {\n      \"item_id\": \"work-item-77\",\n      \"source_kind\": \"review_comment\",\n      \"source_id\": \"review-comment-19442\",\n      \"status\": \"pending\",\n      \"summary\": \"Declaration style rejected by upstream lint\"\n    }\n  ],\n  \"last_validation\": {\n    \"validated_at\": \"2026-08-10T21:14:00Z\",\n    \"source_revision\": \"upstream-9ba1\",\n    \"result\": \"clean\"\n  },\n  \"updated_at\": \"2026-08-12T15:02:11Z\",\n  \"trace_id\": \"trace-series-20\",\n  \"blockers\": []\n}",
        "fields": [
          {
            "name": "series_id",
            "type": "PrSeriesId"
          },
          {
            "name": "campaign_id",
            "type": "PrCampaignId"
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "batch_index",
            "type": "integer",
            "description": "Publication batch this series belongs to; batches open in order, each on explicit operator go."
          },
          {
            "name": "status",
            "type": "\"prepared\" | \"published\" | \"changes_requested\" | \"revising\" | \"approved\" | \"merged\" | \"closed\""
          },
          {
            "name": "branch",
            "type": "BranchRef"
          },
          {
            "name": "upstream_pr_number",
            "type": "integer",
            "required": false,
            "description": "Absent until the series is published."
          },
          {
            "name": "target_units",
            "type": "string[]",
            "description": "Primary translation units motivating the series; cross-module edits are allowed when they serve these targets."
          },
          {
            "name": "work_items",
            "type": "PrWorkItem[]",
            "description": "Durable feedback items; ingestion is background-safe and never waits for the lease.",
            "fields": [
              {
                "name": "item_id",
                "type": "PrWorkItemId"
              },
              {
                "name": "source_kind",
                "type": "string"
              },
              {
                "name": "source_id",
                "type": "string"
              },
              {
                "name": "status",
                "type": "\"pending\" | \"in_progress\" | \"resolved\" | \"declined\""
              },
              {
                "name": "summary",
                "type": "string"
              }
            ]
          },
          {
            "name": "last_validation",
            "type": "ValidationRecord",
            "required": false,
            "description": "Most recent gate validation of the series branch.",
            "fields": [
              {
                "name": "validated_at",
                "type": "timestamp"
              },
              {
                "name": "source_revision",
                "type": "SourceRevision"
              },
              {
                "name": "result",
                "type": "string"
              }
            ]
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          }
        ],
        "name": "PrSeriesState"
      },
      "children": []
    },
