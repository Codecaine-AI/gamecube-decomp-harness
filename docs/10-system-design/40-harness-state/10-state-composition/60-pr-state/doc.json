    "b-60-pr-state-prcampaignstate-extend-3": {
      "id": "b-60-pr-state-prcampaignstate-extend-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "PrCampaignState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " extends the "
        },
        {
          "insert": "Workflow State Envelope",
          "attributes": {
            "link": "docs/10-system-design/40-harness-state/10-state-composition/20-workflow-slot"
          }
        },
        {
          "insert": " with PR-specific review state. The shared envelope supplies workflow identity, revision ordering, lifecycle status, trace lineage, blockers, and dispatch-authority linkage; this page defines only the campaign payload stored in that slot."
        }
      ],
      "children": []
    },
