    "b-40-sync-state-syncstate-extends-the-w-3": {
      "id": "b-40-sync-state-syncstate-extends-the-w-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "SyncState extends the "
        },
        {
          "insert": "workflow slot envelope",
          "attributes": {
            "link": "../20-workflow-slot"
          }
        },
        {
          "insert": ". The envelope supplies shared workflow identity, status, revision, trace lineage, event cursor, timestamps, and blockers; SyncState supplies the sync-specific observation, staging, recovery, cancellation, and publication projections."
        }
      ],
      "children": []
    },
    "b-40-sync-state-structure-4": {
