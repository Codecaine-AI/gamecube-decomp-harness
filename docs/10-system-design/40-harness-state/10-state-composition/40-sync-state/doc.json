    "b-40-sync-state-the-workflow-state-keeps-5": {
      "id": "b-40-sync-state-the-workflow-state-keeps-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The workflow state keeps canonical cycle state unchanged while reconciliation is staged. Nullable recovery, cancellation, and publication records distinguish resumable work, a proven pre-publication abort, and the irreversible published boundary."
        }
      ],
      "children": []
    },
