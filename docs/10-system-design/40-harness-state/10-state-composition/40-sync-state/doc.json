    "b-40-sync-state-syncstate-is-the-durable-1": {
      "id": "b-40-sync-state-syncstate-is-the-durable-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "SyncState is the durable state structure for one sync workflow within HarnessState. It records observed intake, isolated reconciliation, recovery and cancellation evidence, and the confirmed publication boundary without restating the sync algorithm."
        }
      ],
      "children": []
    },
