    "b-40-sync-state-recovery-branches-from-b-27": {
      "id": "b-40-sync-state-recovery-branches-from-b-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Recovery branches from blocked or interrupted staging. "
        },
        {
          "insert": "sync.recovered",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records preservation or discard as explicit booleans, the destination status, and the nullable resume stage; resumed work returns to staging, while discard proceeds to a clean restart or cancellation. Publication failure keeps durable recovery state and moves forward under the publication boundary rather than reopening cancellation."
        }
      ],
      "children": []
