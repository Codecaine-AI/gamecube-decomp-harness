          "insert": "The "
        },
        {
          "insert": "Sync Workflow",
          "attributes": {
            "link": "../../../50-workflows/10-sync"
          }
        },
        {
          "insert": " owns reconciliation behavior, validation gates, authority boundaries, and status meanings. This page owns only the durable shape those behaviors game."
        }
      ],
      "children": []
    },
