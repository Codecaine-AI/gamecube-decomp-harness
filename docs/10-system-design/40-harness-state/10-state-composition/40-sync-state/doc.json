    "b-restored-sync-state-shape-20260814": {
      "id": "b-restored-sync-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Sync workflow: intake identity, staging progress, PR-branch reconciliation, and the atomic publication record.",
        "example": "{\n  \"sync_id\": \"sync-2026-08-11-02\",\n  \"game_id\": \"melee\",\n  \"cycle_id\": \"cycle-7\",\n  \"revision\": 41,\n  \"status\": \"reconciling\",\n  \"intake\": {\n    \"upstream_from\": \"upstream-9ac4\",\n    \"upstream_to\": \"upstream-9ba1\",\n    \"merged_pr_ids\": [\n      \"pr-2849\",\n      \"pr-2851\"\n    ],\n    \"corpus_batch_ids\": [\n      \"discord-2026-08\"\n    ],\n    \"knowledge_only\": false\n  },\n  \"staging\": {\n    \"workspace_id\": \"staging-sync-02\",\n    \"epochs_total\": 19,\n    \"epochs_applied\": 9,\n    \"minor_conflicts_resolved\": 3,\n    \"conflicts_awaiting_operator\": 1\n  },\n  \"pr_reconciliation\": [\n    {\n      \"series_id\": \"series-20\",\n      \"result\": \"auto_resolved\",\n      \"pushed\": false\n    }\n  ],\n  \"publication\": null,\n  \"created_at\": \"2026-08-11T19:02:00Z\",\n  \"latest_event_sequence\": 92830,\n  \"trace_id\": \"trace-sync-2026-08-11-02\",\n  \"blockers\": [\n    {\n      \"code\": \"conflict_needs_operator\",\n      \"message\": \"Upstream restructured a header epoch-9 matches depend on.\",\n      \"source_kind\": \"sync\",\n      \"source_id\": \"sync-2026-08-11-02\",\n      \"recoverable\": true\n    }\n  ]\n}",
        "fields": [
          {
            "name": "sync_id",
            "type": "SyncId"
          },
          {
            "name": "game_id",
            "type": "GameId"
          },
          {
            "name": "cycle_id",
            "type": "CycleId",
            "description": "Owning cycle container."
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "status",
            "type": "\"requested\" | \"ingesting\" | \"reconciling\" | \"validating\" | \"validated\" | \"publishing\" | \"published\" | \"blocked\" | \"cancelled\""
          },
          {
            "name": "intake",
            "type": "SyncIntake",
            "description": "What this sync ingests. Captured when the operator starts sync.",
            "fields": [
              {
                "name": "upstream_from",
                "type": "SourceRevision",
                "description": "Cycle head's upstream anchor before sync."
              },
              {
                "name": "upstream_to",
                "type": "SourceRevision",
                "description": "Observed upstream target. Equals upstream_from on a knowledge-only pass."
              },
              {
                "name": "merged_pr_ids",
                "type": "UpstreamPrId[]"
              },
              {
                "name": "corpus_batch_ids",
                "type": "CorpusBatchId[]",
                "description": "Staged corpora such as Discord awaiting publication."
              },
              {
                "name": "knowledge_only",
                "type": "boolean",
                "description": "True when upstream did not move; reconciliation is skipped and only the knowledge revision advances."
              }
            ]
          },
          {
            "name": "staging",
            "type": "StagingProgress | null",
            "description": "Isolated workspace where all reconciliation happens; null on a knowledge-only pass.",
            "fields": [
              {
                "name": "workspace_id",
                "type": "WorkspaceId"
              },
              {
                "name": "epochs_total",
                "type": "integer"
              },
              {
                "name": "epochs_applied",
                "type": "integer"
              },
              {
                "name": "minor_conflicts_resolved",
                "type": "integer"
              },
              {
                "name": "conflicts_awaiting_operator",
                "type": "integer"
              }
            ]
          },
          {
            "name": "pr_reconciliation",
            "type": "PrBranchReconciliation[]",
            "description": "One entry per open PR series rebased alongside the cycle.",
            "fields": [
              {
                "name": "series_id",
                "type": "PrSeriesId"
              },
              {
                "name": "result",
                "type": "\"clean\" | \"auto_resolved\" | \"needs_operator\""
              },
              {
                "name": "pushed",
                "type": "boolean",
                "description": "True once the reconciled branch is pushed to its upstream PR at publish."
              }
            ]
          },
          {
            "name": "publication",
            "type": "PublicationRecord | null",
            "description": "Set by the atomic publish step; null until then.",
            "fields": [
              {
                "name": "remote_application_id",
                "type": "RemoteApplicationId",
                "description": "Boundary recorded in the cycle timeline; absent on a knowledge-only pass."
              },
              {
                "name": "prior_head",
                "type": "SourceRevision"
              },
              {
                "name": "new_head",
                "type": "SourceRevision"
              },
              {
                "name": "knowledge_revision",
                "type": "KnowledgeRevision"
              },
              {
                "name": "invalidated_ids",
                "type": "string[]",
                "description": "Targets, checkpoints, and PR snapshots explicitly invalidated by the boundary."
              }
            ]
          },
          {
            "name": "created_at",
            "type": "timestamp"
          },
          {
            "name": "latest_event_sequence",
            "type": "integer"
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          }
        ],
        "name": "SyncState"
      },
      "children": []
    },
