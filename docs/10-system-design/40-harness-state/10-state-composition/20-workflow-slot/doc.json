    "b-20-workflow-slot-every-durable-session-s-1": {
      "id": "b-20-workflow-slot-every-durable-session-s-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every durable cycle, sync, run, and PR campaign state extends one StateEnvelope. The envelope gives generic consumers stable identity, transition ordering, status, tracing, blockers, and a link to current dispatch authority without replacing domain-owned workflow payloads."
        }
      ],
      "children": []
    },
