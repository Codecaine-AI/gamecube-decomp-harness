      ],
      "children": []
    },
    "b-restored-state-envelope-shape-20260814": {
      "id": "b-restored-state-envelope-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Shared metadata carried by every durable game state object.",
        "example": "{\n  \"id\": \"run-2026-08-11-01\",\n  \"game_id\": \"melee\",\n  \"kind\": \"run\",\n  \"status\": \"draining\",\n  \"revision\": 288,\n  \"created_at\": \"2026-08-11T18:00:00Z\",\n  \"updated_at\": \"2026-08-11T18:42:08Z\",\n  \"trace_id\": \"trace-run-2026-08-11-01\",\n  \"caused_by_event_id\": \"event-92811\",\n  \"blockers\": []\n}",
        "fields": [
          {
            "name": "id",
            "type": "StateObjectId",
            "description": "Stable identity of the state object."
          },
          {
            "name": "game_id",
            "type": "GameId",
            "description": "Owning game."
          },
          {
            "name": "kind",
            "type": "StateKind",
            "description": "Domain state-machine kind."
          },
          {
            "name": "status",
            "type": "domain-specific enum",
            "description": "A value owned by this state kind."
          },
          {
            "name": "revision",
            "type": "integer",
            "description": "Monotonic accepted-transition version."
          },
          {
            "name": "created_at",
            "type": "timestamp"
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "trace_id",
            "type": "TraceId",
            "description": "Root trace for the object."
          },
          {
            "name": "caused_by_event_id",
            "type": "EventId",
            "required": false,
            "description": "Event that produced the current revision."
          },
          {
            "name": "blockers",
            "type": "Blocker[]",
            "fields": [
              {
                "name": "code",
                "type": "string"
              },
              {
                "name": "message",
                "type": "string"
              },
              {
                "name": "source_kind",
                "type": "string"
              },
              {
                "name": "source_id",
                "type": "string"
              },
              {
                "name": "recoverable",
                "type": "boolean"
              }
            ]
          }
        ],
        "name": "StateEnvelope"
      },
      "children": []
    },
    "b-20-workflow-slot-the-domain-object-extend-4": {
      "id": "b-20-workflow-slot-the-domain-object-extend-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The domain object extends this base with its own payload and status enum. Cycle state uses the envelope for durable identity and lineage but does not acquire dispatch authority; its "
        },
        {
          "insert": "authority",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field remains null. Sync, run, and PR state link to the current lease only while they own it."
        }
      ],
      "children": []
    },
