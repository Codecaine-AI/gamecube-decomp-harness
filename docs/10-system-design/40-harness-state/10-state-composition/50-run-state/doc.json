    "b-50-run-state-runstate-is-the-durable-1": {
      "id": "b-50-run-state-runstate-is-the-durable-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "RunState is the durable run workflow object held by HarnessState. It binds one autonomous scheduling effort to immutable starting inputs, current cycle-head lineage, scheduler composition, and the records needed to recover Git and state boundaries. "
        },
        {
          "insert": "Run State",
          "attributes": {
            "link": "../../../50-workflows/20-run/10-run-state"
          }
        },
        {
          "insert": " defines the lifecycle and control semantics; this page defines how that state is composed and situated in the aggregate."
        }
      ],
      "children": []
    },
