    "b-50-run-state-runstate-extends-the-wo-3": {
      "id": "b-50-run-state-runstate-extends-the-wo-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "RunState extends the "
        },
        {
          "insert": "Workflow State Envelope",
          "attributes": {
            "link": "../20-workflow-slot"
          }
        },
        {
          "insert": ". The envelope supplies stable object identity, game ownership, accepted-transition revision, event causation, tracing, dispatch-authority linkage, timestamps, and blockers. RunState supplies the run-specific identity, input snapshot, control payload, scheduling position, progress, and references to subordinate durable records."
        }
      ],
      "children": []
    },
