    "b-restored-run-state-shape-20260814": {
      "id": "b-restored-run-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Run control, scheduling position, progress, queue summaries, references, and tracing.",
        "example": "{\n  \"run_id\": \"run-2026-08-11-01\",\n  \"game_id\": \"melee\",\n  \"cycle_id\": \"cycle-7\",\n  \"revision\": 288,\n  \"inputs\": {\n    \"base_revision\": \"upstream-9ac4\",\n    \"policy_revision\": \"policy-42\",\n    \"starting_knowledge_revision\": \"knowledge-375\",\n    \"configuration_snapshot\": {\n      \"desired_workers\": 64,\n      \"epoch_size\": 64\n    }\n  },\n  \"head_revision\": \"upstream-9ba1\",\n  \"control\": {\n    \"status\": \"draining\",\n    \"stop_request\": {\n      \"target\": \"sync\",\n      \"mode\": \"finish_epoch\"\n    }\n  },\n  \"scheduling\": {\n    \"active_epoch_id\": \"epoch-19\",\n    \"desired_workers\": 64,\n    \"scheduler_condition\": \"boundary\",\n    \"admitted\": 64,\n    \"claimed\": 64,\n    \"running\": 2\n  },\n  \"progress\": {\n    \"baseline_score\": 72.642,\n    \"confirmed_score\": 73.147,\n    \"tentative_changes\": 2,\n    \"confirmed_changes\": 31,\n    \"regressed_changes\": 1\n  },\n  \"integration_queue\": {\n    \"pending\": 1,\n    \"conflicts\": 0\n  },\n  \"epoch_ids\": [\n    \"epoch-18\",\n    \"epoch-19\"\n  ],\n  \"remote_application_ids\": [\n    \"remote-application-3\"\n  ],\n  \"worker_state_ids\": [\n    \"worker-state-501\",\n    \"worker-state-502\"\n  ],\n  \"checkpoint_ids\": [\n    \"checkpoint-88\"\n  ],\n  \"active_operation_ids\": [\n    \"operation-run-drain-44\"\n  ],\n  \"latest_event_sequence\": 92811,\n  \"blockers\": []\n}",
        "fields": [
          {
            "name": "run_id",
            "type": "RunId"
          },
          {
            "name": "game_id",
            "type": "GameId"
          },
          {
            "name": "cycle_id",
            "type": "CycleId",
            "description": "Owning cycle container."
          },
          {
            "name": "revision",
            "type": "integer"
          },
          {
            "name": "inputs",
            "type": "RunInputs",
            "fields": [
              {
                "name": "base_revision",
                "type": "SourceRevision",
                "description": "Original baseline. Immutable — upstream arrives as remote-application boundaries, never by rewriting this."
              },
              {
                "name": "policy_revision",
                "type": "PolicyRevision",
                "description": "Immutable after activation."
              },
              {
                "name": "starting_knowledge_revision",
                "type": "KnowledgeRevision"
              },
              {
                "name": "configuration_snapshot",
                "type": "RunConfiguration"
              }
            ]
          },
          {
            "name": "head_revision",
            "type": "SourceRevision",
            "description": "Mirror of the owning cycle's head, which the scheduler plans against. The cycle owns head lineage; equals base_revision until a remote-application boundary advances it."
          },
          {
            "name": "control",
            "type": "RunControl",
            "fields": [
              {
                "name": "status",
                "type": "\"draft\" | \"ready\" | \"active\" | \"draining\" | \"paused\" | \"completed\" | \"failed\" | \"cancelled\""
              },
              {
                "name": "stop_request",
                "type": "StopRequest",
                "required": false
              },
              {
                "name": "terminal_reason",
                "type": "string",
                "required": false
              }
            ]
          },
          {
            "name": "scheduling",
            "type": "RunScheduling",
            "fields": [
              {
                "name": "active_epoch_id",
                "type": "EpochId | null"
              },
              {
                "name": "desired_workers",
                "type": "integer"
              },
              {
                "name": "scheduler_condition",
                "type": "\"idle\" | \"planning\" | \"dispatching\" | \"waiting\" | \"boundary\" | \"blocked\""
              },
              {
                "name": "admitted",
                "type": "integer"
              },
              {
                "name": "claimed",
                "type": "integer"
              },
              {
                "name": "running",
                "type": "integer"
              }
            ]
          },
          {
            "name": "progress",
            "type": "RunProgress",
            "fields": [
              {
                "name": "baseline_score",
                "type": "number"
              },
              {
                "name": "confirmed_score",
                "type": "number"
              },
              {
                "name": "tentative_changes",
                "type": "integer"
              },
              {
                "name": "confirmed_changes",
                "type": "integer"
              },
              {
                "name": "regressed_changes",
                "type": "integer"
              }
            ]
          },
          {
            "name": "integration_queue",
            "type": "IntegrationQueueSummary"
          },
          {
            "name": "epoch_ids",
            "type": "EpochId[]"
          },
          {
            "name": "remote_application_ids",
            "type": "RemoteApplicationId[]",
            "description": "Remote-application boundaries in timeline order, each recording prior head, applied upstream revision, resolved conflicts, and score delta."
          },
          {
            "name": "worker_state_ids",
            "type": "WorkerStateId[]"
          },
          {
            "name": "checkpoint_ids",
            "type": "CheckpointId[]"
          },
          {
            "name": "active_operation_ids",
            "type": "OperationId[]"
          },
          {
            "name": "latest_event_sequence",
            "type": "integer"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          }
        ],
        "name": "RunState"
      },
      "children": []
    },
    "b-50-run-state-the-run-owns-the-composi-6": {
      "id": "b-50-run-state-the-run-owns-the-composi-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run owns the composition beneath its control state without embedding every record. "
        },
        {
          "insert": "epoch_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " orders scheduling waves; each epoch owns its target inventory and claims. "
        },
        {
          "insert": "worker_state_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies the runner-owned lifecycle ledger for those claims, while "
        },
        {
          "insert": "checkpoint_ids",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies validation attempts. "
        },
        {
          "insert": "integration_queue",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " summarizes unresolved publication work, and the durable pending-integration records carry the branch and commit evidence required for reconciliation."
        }
      ],
      "children": []
    },
