                "name": "queued",
                "type": "integer"
              },
              {
                "name": "processing",
                "type": "integer"
              },
              {
                "name": "waiting",
                "type": "integer"
              },
              {
                "name": "failed",
                "type": "integer"
              },
              {
                "name": "oldest_pending_at",
