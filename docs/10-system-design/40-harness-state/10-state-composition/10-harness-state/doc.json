              {
                "name": "retry",
                "type": "KnowledgeRetrySummary | null",
                "fields": [
                  {
                    "name": "next_attempt_at",
                    "type": "timestamp"
                  },
                  {
                    "name": "attempts",
                    "type": "integer"
                  }
                ]
              },
              {
                "name": "recent_failures",
                "type": "KnowledgeFailureSummary[]",
                "fields": [
                  {
                    "name": "job_id",
                    "type": "KnowledgeJobId"
                  },
                  {
                    "name": "worker_state_id",
                    "type": "WorkerStateId"
                  },
                  {
                    "name": "error",
                    "type": "string"
                  },
                  {
                    "name": "attempts",
                    "type": "integer"
                  },
                  {
                    "name": "updated_at",
                    "type": "timestamp"
                  }
                ]
              }
            ]
          },
          {
            "name": "trace",
            "type": "TraceCursor",
            "fields": [
              {
                "name": "trace_id",
                "type": "TraceId"
              },
              {
                "name": "latest_event_sequence",
                "type": "integer"
              },
              {
                "name": "active_operation_ids",
                "type": "OperationId[]"
              }
            ]
          },
          {
            "name": "updated_at",
            "type": "timestamp"
