            ]
          },
          {
            "name": "pr",
            "type": "WorkflowSlot | null",
            "description": "Envelope-level mirror of the current PrCampaignState; series detail stays in the campaign.",
            "fields": [
              {
                "name": "id",
                "type": "StateObjectId"
              },
              {
                "name": "workflow_id",
                "type": "PrCampaignId"
              },
              {
                "name": "revision",
                "type": "integer"
              },
              {
                "name": "status",
                "type": "PrCampaignStatus"
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "fields": [
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  },
                  {
                    "name": "source_kind",
