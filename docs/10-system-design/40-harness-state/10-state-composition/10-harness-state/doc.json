    "b-10-harness-state-harnessstate-is-the-cano-1": {
      "id": "b-10-harness-state-harnessstate-is-the-cano-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "HarnessState is the canonical aggregate for one game's current coordination state. It composes the current cycle, sync, run, PR campaign, and background knowledge summaries at one "
        },
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " while each child state object remains authoritative for its own detail."
        }
      ],
      "children": []
    },
