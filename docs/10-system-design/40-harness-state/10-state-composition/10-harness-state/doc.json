    "b-10-harness-state-the-session-and-workflow-4": {
      "id": "b-10-harness-state-the-session-and-workflow-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The cycle and workflow slots mirror identity, status, and the minimum lineage needed for an at-a-glance game read. CycleState, SyncState, RunState, and PrCampaignState remain canonical for domain payloads, local revisions, and status transitions. A null slot means no corresponding object exists; "
        },
        {
          "insert": "active_workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " may be null while all existing workflow slots remain durable and visible."
        }
      ],
      "children": []
    },
    "b-10-harness-state-dispatch-authority-and-5": {
      "id": "b-10-harness-state-dispatch-authority-and-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Dispatch Authority and Handoffs",
          "attributes": {
            "link": "../../20-dispatch-authority"
          }
        },
        {
          "insert": " owns lease exclusivity, fencing, and handoff semantics. "
        },
        {
          "insert": "Operator Action Contract",
          "attributes": {
            "link": "../../30-operator-actions"
          }
        },
        {
          "insert": " owns the server-projected commands and blockers derived from this aggregate."
        }
      ],
      "children": []
    },
    "b-10-harness-state-revision-contract-6": {
      "id": "b-10-harness-state-revision-contract-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Revision Contract"
        }
      ],
      "children": []
    },
    "b-10-harness-state-game-revision-advan-7": {
      "id": "b-10-harness-state-game-revision-advan-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " advances once for each accepted transaction that changes the aggregate view. A reader uses it as the version of the complete composition, and a writer presents the expected revision so a command derived from stale state is refused."
        }
      ],
      "children": []
    },
    "b-10-harness-state-child-revisions-remain-l-8": {
      "id": "b-10-harness-state-child-revisions-remain-l-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Child revisions remain local to their state objects. HarnessState records one coherent aggregate revision after the child transition and its accepted event commit; it does not replace workflow-local ordering or event lineage."
        }
      ],
      "children": []
    },
    "b-10-harness-state-consumer-reads-9": {
      "id": "b-10-harness-state-consumer-reads-9",
      "type": "heading",
      "props": {
        "level": 2
      },
