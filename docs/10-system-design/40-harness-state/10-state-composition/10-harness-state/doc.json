      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Read HarnessState once at a named "
        },
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-harness-state-use-its-slots-to-identif-11": {
      "id": "b-10-harness-state-use-its-slots-to-identif-11",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Use its slots to identify current objects and summarize their statuses."
        }
      ],
      "children": []
    },
    "b-10-harness-state-resolve-the-canonical-ch-12": {
      "id": "b-10-harness-state-resolve-the-canonical-ch-12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Resolve the canonical child state when domain payload or transition detail is required."
        }
      ],
      "children": []
    },
    "b-10-harness-state-use-active-workflow-on-13": {
      "id": "b-10-harness-state-use-active-workflow-on-13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Use "
        },
        {
          "insert": "active_workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " only to determine which workflow holds dispatch authority."
        }
      ],
      "children": []
    },
    "b-10-harness-state-consume-the-server-owned-14": {
      "id": "b-10-harness-state-consume-the-server-owned-14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Consume the server-owned action projection instead of deriving authority from status on the client."
        }
      ],
      "children": []
    },
    "b-10-harness-state-operator-and-api-consume-15": {
      "id": "b-10-harness-state-operator-and-api-consume-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Operator and API consumers receive summaries built from this coherent read rather than independent storage reads. Recent events may accompany the projection as bounded accepted-fact history, but HarnessState and "
        },
        {
          "insert": "game_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remain authoritative for current state."
        }
      ],
      "children": []
    }
