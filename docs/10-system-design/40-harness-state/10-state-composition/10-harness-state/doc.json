    "b-restored-harness-state-shape-20260814": {
      "id": "b-restored-harness-state-shape-20260814",
      "type": "state-shape",
      "props": {
        "description": "Canonical game aggregate: envelope-level workflow slots, dispatch-lease ownership and queueing, background knowledge freshness, and trace position at one game revision.",
        "example": "{\n  \"game_id\": \"melee\",\n  \"game_revision\": 1842,\n  \"cycle\": {\n    \"id\": \"cycle-state-7\",\n    \"cycle_id\": \"cycle-7\",\n    \"revision\": 3104,\n    \"status\": \"active\",\n    \"head_revision\": \"upstream-9ba1\",\n    \"blockers\": []\n  },\n  \"sync\": {\n    \"id\": \"sync-state-2026-08-11-02\",\n    \"workflow_id\": \"sync-2026-08-11-02\",\n    \"revision\": 41,\n    \"status\": \"requested\",\n    \"blockers\": []\n  },\n  \"run\": {\n    \"id\": \"run-state-2026-08-11-01\",\n    \"workflow_id\": \"run-2026-08-11-01\",\n    \"revision\": 288,\n    \"status\": \"draining\",\n    \"blockers\": []\n  },\n  \"pr\": {\n    \"id\": \"pr-campaign-state-4\",\n    \"workflow_id\": \"pr-campaign-4\",\n    \"revision\": 57,\n    \"status\": \"in_review\",\n    \"blockers\": []\n  },\n  \"active_workflow\": {\n    \"kind\": \"run\",\n    \"workflow_id\": \"run-2026-08-11-01\",\n    \"lease_id\": \"lease-7f3b\",\n    \"status\": \"draining\",\n    \"acquired_at\": \"2026-08-11T18:00:00Z\",\n    \"heartbeat_at\": \"2026-08-11T18:42:08Z\",\n    \"requested_handoff\": {\n      \"target_kind\": \"sync\",\n      \"target_workflow_id\": \"sync-2026-08-11-02\",\n      \"reason\": \"upstream PRs merged\",\n      \"requested_at\": \"2026-08-11T18:41:30Z\"\n    },\n    \"blockers\": [\n      {\n        \"code\": \"active_claims\",\n        \"message\": \"Two worker claims must settle before sync.\",\n        \"source_kind\": \"run\",\n        \"source_id\": \"run-2026-08-11-01\",\n        \"recoverable\": true\n      }\n    ]\n  },\n  \"queued_dispatch_requests\": [\n    {\n      \"request_id\": \"dispatch-request-sync-02\",\n      \"target_kind\": \"sync\",\n      \"target_workflow_id\": \"sync-2026-08-11-02\",\n      \"reason\": \"upstream PRs merged\",\n      \"requested_at\": \"2026-08-11T18:41:30Z\"\n    }\n  ],\n  \"knowledge\": {\n    \"published_revision\": \"knowledge-381\",\n    \"queued\": 6,\n    \"processing\": 1,\n    \"waiting\": 1,\n    \"failed\": 0,\n    \"oldest_pending_at\": \"2026-08-11T18:35:12Z\",\n    \"active_lease\": {\n      \"id\": \"knowledge-lease-44\",\n      \"expires_at\": \"2026-08-11T18:43:08Z\"\n    },\n    \"retry\": {\n      \"next_attempt_at\": \"2026-08-11T18:45:00Z\",\n      \"attempts\": 2\n    },\n    \"recent_failures\": []\n  },\n  \"trace\": {\n    \"trace_id\": \"trace-game-melee\",\n    \"latest_event_sequence\": 92811,\n    \"active_operation_ids\": [\n      \"operation-run-drain-44\"\n    ]\n  },\n  \"updated_at\": \"2026-08-11T18:42:08Z\"\n}",
        "fields": [
          {
            "name": "game_id",
            "type": "GameId",
            "description": "Stable game identity."
          },
          {
            "name": "game_revision",
            "type": "integer",
            "description": "Monotonic aggregate revision for coherent reads and stale-write rejection."
          },
          {
            "name": "cycle",
            "type": "CycleSlot | null",
            "description": "Envelope-level mirror of the current CycleState plus its minimum head lineage.",
            "fields": [
              {
                "name": "id",
                "type": "StateObjectId"
              },
              {
                "name": "cycle_id",
                "type": "CycleId"
              },
              {
                "name": "revision",
                "type": "integer"
              },
              {
                "name": "status",
                "type": "CycleStatus"
              },
              {
                "name": "head_revision",
                "type": "SourceRevision"
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "fields": [
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  },
                  {
                    "name": "source_kind",
                    "type": "string"
                  },
                  {
                    "name": "source_id",
                    "type": "string"
                  },
                  {
                    "name": "recoverable",
                    "type": "boolean"
                  }
                ]
              }
            ]
          },
          {
            "name": "sync",
            "type": "WorkflowSlot | null",
            "description": "Envelope-level mirror of the current SyncState; the child object remains canonical.",
            "fields": [
              {
                "name": "id",
                "type": "StateObjectId"
              },
              {
                "name": "workflow_id",
                "type": "SyncId"
              },
              {
                "name": "revision",
                "type": "integer"
              },
              {
                "name": "status",
                "type": "SyncStatus"
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "fields": [
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  },
                  {
                    "name": "source_kind",
                    "type": "string"
                  },
                  {
                    "name": "source_id",
                    "type": "string"
                  },
                  {
                    "name": "recoverable",
                    "type": "boolean"
                  }
                ]
              }
            ]
          },
          {
            "name": "run",
            "type": "WorkflowSlot | null",
            "description": "Envelope-level mirror of the current RunState; the child object remains canonical.",
            "fields": [
              {
                "name": "id",
                "type": "StateObjectId"
              },
              {
                "name": "workflow_id",
                "type": "RunId"
              },
              {
                "name": "revision",
                "type": "integer"
              },
              {
                "name": "status",
                "type": "RunStatus"
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "fields": [
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  },
                  {
                    "name": "source_kind",
                    "type": "string"
                  },
