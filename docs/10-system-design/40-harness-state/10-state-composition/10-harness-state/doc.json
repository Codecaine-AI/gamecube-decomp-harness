                  },
                  {
                    "name": "recoverable",
                    "type": "boolean"
                  }
                ]
              }
            ]
          },
          {
            "name": "active_workflow",
            "type": "DispatchLease | null",
            "description": "Current dispatch-lease holder. Null means authority is free; durable workflow slots remain visible.",
            "fields": [
              {
                "name": "kind",
                "type": "\"run\" | \"pr\" | \"sync\""
              },
              {
                "name": "workflow_id",
                "type": "WorkflowId",
                "description": "Owning domain workflow."
              },
              {
                "name": "lease_id",
                "type": "LeaseId",
                "description": "Fencing token minted at acquisition; every worker-dispatch and source-mutation command must present the current lease id, so stale actors from a previous activation are refused."
              },
              {
                "name": "status",
                "type": "\"acquiring\" | \"active\" | \"draining\" | \"blocked\" | \"releasing\""
              },
              {
                "name": "acquired_at",
                "type": "timestamp"
              },
              {
                "name": "heartbeat_at",
                "type": "timestamp",
                "description": "Liveness evidence used during recovery."
              },
              {
                "name": "requested_handoff",
                "type": "HandoffRequest",
                "required": false,
                "description": "Queued transition that begins after the current owner settles.",
                "fields": [
                  {
                    "name": "target_kind",
                    "type": "\"run\" | \"pr\" | \"sync\""
                  },
                  {
                    "name": "target_workflow_id",
                    "type": "WorkflowId"
                  },
                  {
                    "name": "reason",
                    "type": "string"
                  },
                  {
                    "name": "requested_at",
                    "type": "timestamp"
                  }
                ]
              },
              {
                "name": "blockers",
                "type": "Blocker[]",
                "description": "Reasons the owner cannot settle or release authority.",
                "fields": [
                  {
                    "name": "code",
                    "type": "string"
                  },
                  {
                    "name": "message",
                    "type": "string"
                  },
                  {
                    "name": "source_kind",
                    "type": "string"
                  },
                  {
                    "name": "source_id",
                    "type": "string"
                  },
                  {
                    "name": "recoverable",
                    "type": "boolean"
                  }
                ]
              }
            ]
          },
          {
            "name": "queued_dispatch_requests",
            "type": "DispatchRequest[]",
            "description": "Operator workflows waiting for the current dispatch lease to settle and release.",
            "fields": [
              {
                "name": "request_id",
                "type": "DispatchRequestId"
              },
              {
                "name": "target_kind",
                "type": "\"run\" | \"pr\" | \"sync\""
              },
              {
                "name": "target_workflow_id",
                "type": "WorkflowId"
              },
              {
                "name": "reason",
                "type": "string"
              },
              {
                "name": "requested_at",
                "type": "timestamp"
              }
            ]
          },
          {
            "name": "knowledge",
            "type": "KnowledgeFreshnessSummary",
