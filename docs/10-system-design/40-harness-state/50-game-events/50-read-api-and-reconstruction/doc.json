    "b-index-inclusive-from-sequence-11": {
      "id": "b-index-inclusive-from-sequence-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "inclusive "
        },
        {
          "insert": "from_sequence",
          "attributes": {
