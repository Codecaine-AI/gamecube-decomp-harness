    "b-index-get-api-events-and-g-4": {
      "id": "b-index-get-api-events-and-g-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "GET /api/events",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "GET /api/events/reconstruct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are the only recognized paths. Both are GET-only; another method returns "
        },
        {
          "insert": "405",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Allow: GET",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "{ \"error\": \"method not allowed\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". An unrecognized path is left to the outer router and does not produce a route-local 404."
        }
      ],
      "children": []
    },
    "b-index-the-canonical-game-an-5": {
      "id": "b-index-the-canonical-game-an-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical game and state directory come from server request context. Path, database, graph-database, repository, state-directory, raw-payload, and include-payload override spellings are rejected with "
        },
        {
          "insert": "400",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "{ \"error\": \"Game path and raw payload overrides are not supported\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Invalid game context returns "
        },
        {
          "insert": "400",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "{ \"error\": \"Invalid game context\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
