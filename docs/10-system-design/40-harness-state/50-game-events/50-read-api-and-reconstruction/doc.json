    "b-index-the-event-read-surface-e-2": {
      "id": "b-index-the-event-read-surface-e-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The event read surface exposes bounded, game-scoped summaries and lifecycle reconstruction without exposing raw payloads or caller-controlled storage paths. Both routes use the same ordered query and safe projection layer."
        }
      ],
      "children": []
    },
    "b-index-implementation-facing-contract-27": {
      "id": "b-index-implementation-facing-contract-27",
      "type": "callout",
      "props": {
        "title": "Implementation-facing contract",
        "tone": "note"
      },
      "text": [
        {
          "insert": "This page specifies an implementation-facing contract (read API) hosted under Harness State for now; a later pass may relocate it to the implementation tier."
        }
      ],
      "children": []
    },
