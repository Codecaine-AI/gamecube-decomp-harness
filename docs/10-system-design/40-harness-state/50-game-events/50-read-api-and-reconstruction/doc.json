    "b-index-supplying-only-one-subje-14": {
      "id": "b-index-supplying-only-one-subje-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Supplying only one subject field or a range with "
        },
        {
          "insert": "from_sequence > to_sequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns "
        },
        {
          "insert": "400",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Sequence values are decimal-digit safe integers from "
        },
        {
          "insert": "0",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "Number.MAX_SAFE_INTEGER",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "limit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a decimal-digit safe integer from "
        },
        {
          "insert": "1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "200",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", defaults to "
        },
        {
          "insert": "50",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and is never clamped."
        }
      ],
      "children": []
    },
    "b-index-results-are-game-scop-15": {
      "id": "b-index-results-are-game-scop-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Results are game-scoped and ordered by "
        },
        {
          "insert": "sequence ASC",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The server reads "
        },
        {
          "insert": "limit + 1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", returns at most "
        },
        {
          "insert": "limit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and responds with "
        },
        {
          "insert": "{ events, has_more, next_after_sequence }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "next_after_sequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the last returned sequence only when another row exists; otherwise it is null. A "
        },
        {
          "insert": "sync_workflow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " subject query also reads legacy "
        },
        {
          "insert": "sync",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows and normalizes their public subject kind. The virtual game subject includes "
        },
        {
          "insert": "game.dispatch_*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " facts stored on run, sync, sync-workflow, or PR-campaign subjects once."
        }
      ],
      "children": []
    },
    "b-index-safe-summary-projection-16": {
      "id": "b-index-safe-summary-projection-16",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Safe summary projection"
        }
      ],
      "children": []
    },
    "b-index-each-event-exposes-even-17": {
      "id": "b-index-each-event-exposes-even-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each event exposes "
        },
        {
          "insert": "event_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", sequence, type, schema version, game, subject, correlation, causation, trace, span and parent span, actor, occurrence time, and "
        },
        {
          "insert": "payload_summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Raw "
        },
        {
          "insert": "payload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is never returned."
        }
      ],
      "children": []
    },
    "b-index-the-summary-admits-only-18": {
      "id": "b-index-the-summary-admits-only-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The summary admits only safe keys and suffixes. Credential-shaped values and filesystem fields become "
        },
        {
          "insert": "[REDACTED]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "[REDACTED_PATH]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Projection is capped at depth 4, 64 total entries, 256 characters per string, and 4096 serialized bytes; capped summaries add "
        },
        {
          "insert": "_truncated: true",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Invalid stored payload JSON produces the sanitized route-level read failure."
        }
      ],
      "children": []
    },
    "b-index-reconstruction-19": {
      "id": "b-index-reconstruction-19",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Reconstruction"
        }
      ],
      "children": []
    },
    "b-index-api-events-reconstruct-20": {
      "id": "b-index-api-events-reconstruct-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "/api/events/reconstruct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " requires nonblank "
        },
        {
          "insert": "correlation_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and accepts only the same bounded "
        },
        {
          "insert": "after_sequence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "limit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " controls. It returns "
        },
        {
          "insert": "{ game_id, correlation_id, events, has_more, next_after_sequence, kernel_traces }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in ascending sequence order. Empty correlation history is "
        },
        {
          "insert": "200",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with empty events and traces, "
        },
        {
          "insert": "has_more: false",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a null cursor; this route has no 404 outcome."
        }
      ],
      "children": []
    },
    "b-index-every-reconstructed-even-21": {
      "id": "b-index-every-reconstructed-even-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every reconstructed event has "
        },
        {
          "insert": "caused_by",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A causation identity found as an event in the same game becomes "
        },
        {
          "insert": "{ kind: \"event\", event_id, sequence, event_type, correlation_id, subject_kind, subject_id }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", even when it belongs to another correlation or page. Otherwise it becomes "
        },
        {
          "insert": "{ kind: \"command\", command_id }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", including an event identity that exists only in another game. "
        },
        {
          "insert": "kernel_traces",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " carries zero, one, or many server-projected links."
        }
      ],
      "children": []
    },
    "b-index-exact-response-outcomes-22": {
      "id": "b-index-exact-response-outcomes-22",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Exact response outcomes"
        }
      ],
      "children": []
    },
    "b-index-request-and-query-valida-23": {
      "id": "b-index-request-and-query-valida-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Request and query validation failures return "
        },
        {
          "insert": "400",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Unsafe override parameters and invalid game context use the exact sanitized bodies above; missing reconstruction correlation returns "
        },
        {
          "insert": "{ \"error\": \"correlation_id is required\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; a recognized validation error uses its specific message; and an unclassified request-parsing failure returns "
        },
        {
          "insert": "{ \"error\": \"Invalid game event request\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-index-there-is-no-route-local-24": {
      "id": "b-index-there-is-no-route-local-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no route-local "
        },
        {
          "insert": "404",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": empty reconstruction is "
        },
        {
          "insert": "200",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and an unknown path is left to the outer router. A non-GET request returns "
        },
        {
          "insert": "405",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "{ \"error\": \"method not allowed\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Allow: GET",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Any non-validation query, stored-payload, linkage, or reconstruction failure returns "
        },
        {
          "insert": "500",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "{ \"error\": \"Game event read failed\" }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". No internal path, database, payload, or credential detail crosses the boundary."
        }
      ],
      "children": []
    },
    "b-index-recent-events-uses-the-25": {
      "id": "b-index-recent-events-uses-the-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "recent_events",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " uses the same filters and summary projection, with the ordering reversed to "
        },
        {
          "insert": "sequence DESC",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; it contains the newest 20 accepted events by default."
        }
      ],
      "children": []
    }
  }
