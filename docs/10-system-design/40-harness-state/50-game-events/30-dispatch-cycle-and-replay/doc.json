{
  "schemaVersion": 1,
  "id": "10-system-design-40-harness-state-50-game-events-30-dispatch-cycle-and-replay",
  "title": "Dispatch, Cycle, and Replay Events",
  "root": "b-index-root-19",
  "blocks": {
