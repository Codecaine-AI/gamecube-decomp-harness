          }
        }
      ],
      "children": []
    },
    "b-index-failures-are-game-ev-17": {
      "id": "b-index-failures-are-game-ev-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Failures are "
        },
        {
          "insert": "Game events could not be loaded: …",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Lifecycle could not be loaded: …",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "More lifecycle events could not be loaded: …",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; each presents the retry action for the request that failed."
        }
      ],
      "children": []
    },
    "b-index-continuation-says-the-s-18": {
      "id": "b-index-continuation-says-the-s-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Continuation says "
        },
        {
          "insert": "The selected event is beyond the loaded lifecycle page. Load one bounded page at a time until it appears.",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " Missing says "
        },
        {
          "insert": "The selected event is not present in this correlation reconstruction.",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " Continuation never becomes missing until the bounded reconstruction proves absence."
        }
      ],
      "children": []
    }
  }
