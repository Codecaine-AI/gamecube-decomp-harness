    "b-index-loading-text-distinguish-15": {
      "id": "b-index-loading-text-distinguish-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Loading text distinguishes "
        },
        {
          "insert": "Loading",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Loading more",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "Loading the first … game events…",
          "attributes": {
