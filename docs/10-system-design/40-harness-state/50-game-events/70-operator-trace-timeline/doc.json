          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "Loading the first … lifecycle events…",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A deep-linked correlation absent from the first discovery page shows "
        },
        {
          "insert": "Loading linked workflow…",
          "attributes": {
