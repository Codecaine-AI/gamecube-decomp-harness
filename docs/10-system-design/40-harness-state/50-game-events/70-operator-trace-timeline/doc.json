    "b-index-empty-states-are-exactly-16": {
      "id": "b-index-empty-states-are-exactly-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Empty states are exactly "
        },
        {
          "insert": "No accepted game events yet.",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "No run, sync, campaign, or cycle workflow is present in the loaded events.",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "This correlation has no accepted lifecycle events.",
          "attributes": {
