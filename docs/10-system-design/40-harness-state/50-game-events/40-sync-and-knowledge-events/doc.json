    "b-index-sync-events-distinguish-2": {
      "id": "b-index-sync-events-distinguish-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sync events distinguish upstream observation, staged reconciliation, recovery, cancellation proof, publication, and knowledge-job execution. The contracts keep integer progress, blocker provenance, untouched-source evidence, and actor authority explicit."
        }
      ],
      "children": []
    },
    "b-index-ingestion-authority-3": {
      "id": "b-index-ingestion-authority-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Ingestion authority"
        }
      ],
      "children": []
    },
    "b-index-the-registry-permits-exa-4": {
      "id": "b-index-the-registry-permits-exa-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The registry permits exactly "
        },
        {
          "insert": "operator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "runner",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to emit "
        },
        {
          "insert": "sync.ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "guardian",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not ingestion authority. A delayed babysit or process-exit handoff is two accepted actions. Guardian settlement emits "
        },
        {
          "insert": "game.dispatch_released",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "run.paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the settlement command and settlement root span. The successor emits "
        },
        {
          "insert": "game.dispatch_acquired",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "sync.ingesting",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the original queued operator "
        },
        {
          "insert": "sync.start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " command and root span, with "
        },
        {
          "insert": "operator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as actor. Their causation is release event to acquired event to ingesting event, while correlation and trace identities remain local to the outgoing and successor workflows. Immediate "
        },
        {
          "insert": "sync.start",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " uses the same operator provenance."
        }
      ],
      "children": []
    },
