    "b-index-the-complete-pr-and-corp-8": {
      "id": "b-index-the-complete-pr-and-corp-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The complete PR and corpus identity sets describe the accepted observation. "
        },
        {
          "insert": "external_observer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " may emit this progress event alongside "
