    "b-gap-sync-state-projections-lead": {
      "id": "b-gap-sync-state-projections-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Staging progress and publication events game their resumable detail into SyncState. Staging progress stays separate from per-series reconciliation outcomes, while publication identifies the cycle-timeline boundary created from the validated staging result."
        }
      ],
      "children": []
    },
    "b-gap-sync-state-projections-shape": {
      "id": "b-gap-sync-state-projections-shape",
      "type": "state-shape",
      "props": {
        "description": "Durable staging, per-series reconciliation, and publication fields projected by sync events.",
        "example": "{\n  \"staging\": {\n    \"workspace_id\": \"staging-sync-02\",\n    \"epochs_total\": 19,\n    \"epochs_applied\": 9,\n    \"minor_conflicts_resolved\": 3,\n    \"conflicts_awaiting_operator\": 1\n  },\n  \"pr_reconciliation\": [\n    {\n      \"series_id\": \"series-20\",\n      \"result\": \"auto_resolved\",\n      \"pushed\": false\n    }\n  ],\n  \"publication\": {\n    \"remote_application_id\": \"remote-application-3\"\n  }\n}",
        "fields": [
          {
            "name": "staging",
            "type": "StagingProgress",
            "fields": [
              {
                "name": "workspace_id",
                "type": "WorkspaceId"
              },
              {
                "name": "epochs_total",
                "type": "integer"
              },
              {
                "name": "epochs_applied",
                "type": "integer"
              },
              {
                "name": "minor_conflicts_resolved",
                "type": "integer"
              },
              {
                "name": "conflicts_awaiting_operator",
                "type": "integer"
              }
            ]
          },
          {
            "name": "pr_reconciliation",
            "type": "PrBranchReconciliation[]",
            "description": "Contains exactly one entry for every open PR series reconciled by the sync.",
            "fields": [
              {
                "name": "series_id",
                "type": "PrSeriesId"
              },
              {
                "name": "result",
                "type": "clean | auto_resolved | needs_operator",
                "description": "Closed per-series reconciliation outcome."
              },
              {
                "name": "pushed",
                "type": "boolean",
                "description": "Starts false and becomes true only when atomic publication pushes the reconciled branch to its upstream PR."
              }
            ]
          },
          {
            "name": "publication",
            "type": "PublicationRecord",
            "fields": [
              {
                "name": "remote_application_id",
                "type": "RemoteApplicationId",
                "required": false,
                "description": "Names the source-changing boundary recorded in the cycle timeline; omitted for a knowledge-only pass."
              }
            ]
          }
        ],
        "name": "SyncState reconciliation projections"
      },
      "children": []
    },
