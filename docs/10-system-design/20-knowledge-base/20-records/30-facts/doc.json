    "b-sks-rc-fact-intro": {
      "id": "b-sks-rc-fact-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the current interpretation of one subject: a "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or an "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It records the claim in "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the argument in "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and belief strength in "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Its "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows identify supporting observations. Together, a subject's live facts form its knowledge record."
        }
      ],
      "children": []
    },
    "b-sks-rc-fact-epistemology": {
      "id": "b-sks-rc-fact-epistemology",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Facts express inferred meaning. They do not carry a separate observed-versus-inferred category. A plausible upstream name still needs an argument and evidence; "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records how strongly the librarian believes the claim."
        }
      ],
      "children": []
    },
    "b-sks-rc-fact-writer-invariant": {
      "id": "b-sks-rc-fact-writer-invariant",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "One Writer, Overwrite in Place",
        "tone": "success"
      },
      "text": [
        {
          "insert": "The librarian proposes facts and evidence through the validated apply path. A changed claim overwrites the live row for that subject and "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", replacing its evidence rows in the same write. Clearing the claim deletes both the fact and its evidence. Provenance lives in "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the citations."
        }
      ],
      "children": []
    },
    "b-sks-rc-fact-shape-heading": {
      "id": "b-sks-rc-fact-shape-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
    "b-sks-rc-fact-shape-body": {
      "id": "b-sks-rc-fact-shape-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Exactly one of "
        },
        {
          "insert": "target_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "entity_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is set: a fact is about a report item or about a curated subject, never both, never neither. Uniqueness is enforced: exactly one live row per (subject, "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), so a subject has at most six facts and the row to overwrite is always uniquely addressable. A changed claim overwrites its row; a multi-part claim is one longer "
        },
        {
          "insert": "value",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never a neighbour row."
        }
      ],
      "children": []
    },
    "b-sks-rc-fact-shape": {
      "id": "b-sks-rc-fact-shape",
      "type": "state-shape",
      "props": {
        "description": "One row per live claim. Overwritten in place; at most one live row per (subject, `type`).",
        "example": "{\n  \"id\": \"fact-01j9x2\",\n  \"target_id\": \"tgt-ftco-800bffd0\",\n  \"entity_id\": null,\n  \"type\": \"purpose\",\n  \"value\": \"Applies knockback decay to the fighter's velocity each frame while in hitstun.\",\n  \"rationale\": \"The loop scales vel.x and vel.y by the same decay constant the hitstun state dispatch loads; the unit sits in the ftCommon group and the only caller is the hitstun handler.\",\n  \"confidence\": 0.8,\n  \"updated_at\": \"2026-08-12T04:31:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "fact id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "required": false,
            "description": "The subject when the claim is about a report item; exactly one of `target_id` and `entity_id` is set"
          },
          {
            "name": "entity_id",
            "type": "entity id",
            "required": false,
            "description": "The subject when the claim is about a curated subject (translation unit, struct, struct field, game concept, parameter, pattern)"
          },
          {
            "name": "type",
            "type": "purpose | inferred_name | inferred_type | data_flow | state_behavior | game_mapping",
            "description": "Which kind of claim this is; unique per subject"
          },
          {
            "name": "value",
            "type": "string",
            "description": "The claim, as long as it needs to be"
          },
          {
            "name": "rationale",
            "type": "string",
            "description": "The deriving agent's argument from the cited evidence to the value, addressed to the next reader"
          },
          {
            "name": "confidence",
            "type": "number 0..1",
            "description": "How sure we are of this claim"
          },
          {
            "name": "updated_at",
            "type": "timestamp",
            "description": "When this row was last written"
          }
        ],
        "name": "fact"
      },
      "children": []
    },
