    "b-sks-rc-fact-names-body-detail-1": {
      "id": "b-sks-rc-fact-names-body-detail-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Omit unsupported names or clear their existing fact. Also omit or clear a name that already equals "
        },
        {
          "insert": "target.symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The apply layer rejects malformed or redundant names with repair instructions. Worker projections display inferred names as guesses with confidence; "
        },
        {
          "insert": "target.symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remains the name the worker may write into source."
        }
      ],
      "children": []
