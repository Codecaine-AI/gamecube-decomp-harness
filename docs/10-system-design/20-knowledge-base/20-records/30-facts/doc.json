    "b-sks-rc-fact-names-body": {
      "id": "b-sks-rc-fact-names-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " value contains the proposed name only. Functions, structs, fields, and parameters require one C identifier. Translation units, aggregate data sections, game concepts, and patterns may use a short label or filename. Put uncertainty, alternatives, and the argument in "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A useful reading name does not assert recovery of the original spelling."
        }
