    "lifecycle-b-sks-lifecycle-process": {
      "id": "lifecycle-b-sks-lifecycle-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Maintain a fact",
            "steps": [
              {
                "text": "Derived",
                "steps": [
                  {
                    "text": "The librarian derives a claim while indexing a closed worker run, an imported PR, or wiki or Discord material. It drafts `value`, `rationale`, `confidence`, and evidence rows. Each row contains a locator into a knowledge source plus a `why`"
                  }
                ]
              },
              {
                "text": "Written",
                "steps": [
                  {
                    "text": "The resolver checks each drafted evidence row for locator grammar, source-row existence, and the digest for `code`. The claim becomes a live `fact` row under one subject and `type`, with its `evidence` rows written in the same write"
                  }
                ]
              },
              {
                "text": "Revised",
                "steps": [
                  {
                    "text": "A changed claim overwrites the live row in place, replacing its `evidence` rows wholesale"
                  }
                ]
              },
              {
                "text": "Cleared",
                "steps": [
                  {
                    "text": "A claim no longer believed is cleared: a plain row DELETE that removes the `fact` row and its `evidence` rows in the same write"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "lifecycle-b-sks-lifecycle-process-note": {
      "id": "lifecycle-b-sks-lifecycle-process-note",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "There is no candidate queue, no dispute state, and no refuted record: a claim either is a live fact or it is gone. A tested interpretation that did not work never becomes a fact. It lives on the ledger side, in "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " hypothesis and outcome columns. It can be cited as "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence when a later claim leans on it."
        }
      ],
      "children": []
    },
    "lifecycle-b-sks-lifecycle-gates": {
      "id": "lifecycle-b-sks-lifecycle-gates",
      "type": "heading",
      "props": {
