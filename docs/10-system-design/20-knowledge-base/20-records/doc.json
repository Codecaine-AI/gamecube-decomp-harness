    "b-sks-rc-overview-intro": {
      "id": "b-sks-rc-overview-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The knowledge base separates subjects, claims, and attempt history. A "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies a function or scored data section from the game's build report. An "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " identifies a related subject, such as a translation unit, struct, game concept, or pattern. Facts describe what the librarian currently believes about either kind of subject."
        }
      ],
      "children": []
    },
    "b-sks-rc-overview-intro-continued": {
      "id": "b-sks-rc-overview-intro-continued",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Evidence connects claims to captured sources or revision-pinned code. Links connect subjects to one another. Worker attempts and PR outcomes preserve what happened, so later reasoning can use those results without treating an outcome as a semantic claim. Each child page defines its records and JSON examples."
        }
      ],
      "children": []
    },
