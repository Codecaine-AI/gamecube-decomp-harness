    "b-sks-rc-overview-invariant": {
      "id": "b-sks-rc-overview-invariant",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Record Separation",
        "tone": "success"
      },
      "text": [
        {
          "insert": "An improved score or integration conflict is an outcome, not a claim about meaning. The librarian can use that outcome as evidence when proposing a fact, but the proposal must state what it implies and why. Runtime queues, leases, retries, and epoch control remain in harness runtime state."
        }
      ],
