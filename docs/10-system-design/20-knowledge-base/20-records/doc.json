    "b-sks-rc-overview-example-process": {
      "id": "b-sks-rc-overview-example-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Preserve evidence across integration",
            "steps": [
              {
                "text": "Capture the completed run and scored submissions. Summarization supplies a narrative; semantic curation is a separate librarian task."
              },
              {
                "text": "Record the integration conflict on the run. A matching submission can still fail to integrate."
              },
              {
                "text": "Update target_status from the checkout's actual scored report. A 100% worker submission does not by itself make the integrated checkout 100%."
              },
              {
                "text": "The librarian cites the matched submission through an attempt locator. The apply path validates and writes the fact and its evidence together."
              },
              {
                "text": "The next worker's card shows current report status, the conflicted attempt, and live facts."
              }
            ]
          }
        ]
      },
      "children": []
    },
