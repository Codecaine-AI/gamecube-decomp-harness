    "b-sks-rc-patterns-intro": {
      "id": "b-sks-rc-patterns-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": ""
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
