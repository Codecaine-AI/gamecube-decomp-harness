      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Seeing a pattern across the codebase is a query over "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, never a dedicated table. Each row carries a "
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a one-line "
        },
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and an inline "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " + "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " citation like every link. Roles are short free text; these are the conventional ones here:"
        }
      ],
      "children": []
    },
