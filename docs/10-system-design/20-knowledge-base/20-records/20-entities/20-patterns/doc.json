    "b-sks-rc-patterns-freeform": {
      "id": "b-sks-rc-patterns-freeform",
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Freeform on Purpose",
        "tone": "success"
      },
      "text": [
        {
          "insert": "There are no pattern-specific fact types. The type enum stays exactly the six in "
        },
        {
          "insert": "Fact",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-knowledge-base/20-records/30-facts",
              "label": "Fact"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "purpose",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "inferred_name",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "inferred_type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "data_flow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "state_behavior",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "game_mapping",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A pattern's substance is ordinary prose facts, typically "
        },
        {
          "insert": "purpose",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with confidence, a rationale, and evidence like any claim. The former "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pattern_example",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "target_pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " tables are gone: pattern entities plus "
        },
        {
