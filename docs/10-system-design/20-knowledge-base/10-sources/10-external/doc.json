    "external-opening": {
      "id": "external-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pull requests, Discord messages, and wiki pages originate outside the harness. Each game's source configuration selects what to capture. Import stores those captures inside the game's knowledge base so agents can search and cite them."
        }
      ],
      "children": []
    },
    "external-captures": {
      "id": "external-captures",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Imported captures preserve their citation identities. An upstream edit or a later download creates new captured material rather than silently replacing the evidence behind an existing claim. These archived citations do not need the code source's drift digest."
        }
      ],
      "children": []
    },
