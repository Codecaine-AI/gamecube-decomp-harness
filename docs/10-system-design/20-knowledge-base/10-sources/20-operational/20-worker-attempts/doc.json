    "b-ks2-src-attempts-intro": {
      "id": "b-ks2-src-attempts-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The attempt source provides evidence from the target ledger. "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, their submissions, and their archived transcripts are the store behind "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators. This operational source grows with every run. Rows and artifacts are immutable once written, so an attempt locator cannot drift and carries no digest."
        }
      ],
      "children": []
    },
    "b-ks2-src-attempts-grammar-heading": {
      "id": "b-ks2-src-attempts-grammar-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Locator Grammar"
        }
      ],
      "children": []
    },
    "b-ks2-src-attempts-grammar-body": {
      "id": "b-ks2-src-attempts-grammar-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "attempt://run/<worker_run.id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to the run itself. Appending "
        },
        {
          "insert": "/submission/<seq>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " narrows to one submission by its sequence within the run; appending "
        },
        {
          "insert": "/transcript/<span>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " narrows to a span of the run's archived transcript. The grammar is closed: the resolver rejects any other shape, and rejects a submission or span the run does not have."
        }
      ],
      "children": []
    },
    "b-ks2-src-attempts-ownership": {
      "id": "b-ks2-src-attempts-ownership",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The tables and artifacts are owned by the target ledger: shape, writers, and lifecycle live in "
        },
        {
          "insert": "Worker Runs",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-knowledge-base/20-records/70-attempt-history/10-worker-runs-and-submissions",
              "label": "Worker Runs"
            }
          }
        },
        {
          "insert": ". This page defines only how the knowledge graph cites into them."
        }
      ],
      "children": []
    },
    "b-ks2-src-attempts-search-heading": {
      "id": "b-ks2-src-attempts-search-heading",
      "type": "heading",
