      "text": [
        {
          "insert": "Search Surface"
        }
      ],
      "children": []
    },
    "b-ks2-src-attempts-search-body": {
      "id": "b-ks2-src-attempts-search-body",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Attempt retrieval starts with structured filters by target, outcome, score trajectory, and epoch because queries usually concern a known target. BM25 runs over hypotheses and transcripts for other queries. Retrieval supports structured and keyword search. There is no vector search. Adding it requires evidence that lexical retrieval misses relevant results."
        }
      ],
      "children": []
    },
