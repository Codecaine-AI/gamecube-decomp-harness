    "kb-opening": {
      "id": "kb-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The knowledge base connects a game's source material, code identities, attempt history, and evidence-backed interpretations. Each game owns its stores and indexes. Workers read this knowledge while working on targets; librarians propose updates from new source material and completed attempts."
        }
      ],
      "children": []
    },
    "kb-flow": {
      "id": "kb-flow",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Maintain the knowledge base",
            "steps": [
              {
                "text": "Capture sources and identify game subjects"
              },
              {
                "text": "Store evidence and attempt history under stable identities"
              },
              {
                "text": "Research subjects through backfill or active librarian tasks"
              },
              {
                "text": "Validate proposals and apply supported facts and relationships"
              },
              {
                "text": "Retrieve the updated knowledge for later work"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "kb-ownership": {
      "id": "kb-ownership",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Importers and code reconciliation maintain source records and mechanical identities. Librarians propose semantic changes, and the apply layer validates their scope and citations before writing. Queued work is distinct from completed curation. Standards are authored rules alongside this flow and are never evidence for a fact."
        }
      ],
      "children": []
    },
