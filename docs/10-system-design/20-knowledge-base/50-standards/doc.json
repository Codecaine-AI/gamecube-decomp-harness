      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A standard is an authored rule for the source workers produce. It states the required form, its applicability, and how compliance is checked. Standards constrain work; they are not facts inferred from successful attempts and are never citable knowledge evidence."
        }
      ],
      "children": []
    },
