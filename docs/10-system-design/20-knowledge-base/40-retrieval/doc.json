    "retrieval-opening": {
      "id": "retrieval-opening",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Retrieval turns stored records and derived indexes into evidence an agent or operator can inspect. Search results locate material; resolving the source supplies the evidence used for a citation. Target cards are bounded views of current knowledge, not another authoritative store."
        }
      ],
      "children": []
    },
