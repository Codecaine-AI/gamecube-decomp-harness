          "Limit"
        ],
        "rows": [
          [
            "source",
            "The function body located in the unit file at the checkout revision, comment-sanitized, as a code:// span plus text",
            "200 lines; fail-soft reasons such as symbol not found or ambiguous symbol match"
          ],
          [
            "analogs",
            "opseq analogs, callers, and callees from the legacy graph, each with match_pct and whether it already has facts",
            "8"
          ]
