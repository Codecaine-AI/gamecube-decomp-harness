    "b-bl-tools-p": {
      "id": "b-bl-tools-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The librarian profile. The prompt's per-subject loop is: kv2_attempt_search, kv2_pr_search, kv2_discord_search, kv2_wiki_search for text; graph_related_functions for analogs, then kv2_subject_record on them; kv2_entity_lookup before admitting any entity; kv2_resolve_locator in full before citing."
        }
      ],
      "children": []
    },
    "b-bl-out-h": {
      "id": "b-bl-out-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Output"
        }
      ],
      "children": []
    },
    "b-bl-envelope": {
      "id": "b-bl-envelope",
      "type": "code",
      "props": {
        "language": "json",
        "annotations": [
          {
            "lines": "2",
            "label": "facts",
            "note": "One item per (subject, type). op write overwrites the live fact and replaces its evidence set; op clear removes it."
          },
          {
            "lines": "4",
            "label": "subject",
            "note": "Exactly one of target_stable_key or entity_locator."
          },
          {
            "lines": "8",
            "label": "confidence",
            "note": "0 to 1 as a judgment; the apply layer clamps anything above 0.99."
          },
          {
            "lines": "9",
            "label": "evidence",
            "note": "Every item resolves through the locator grammar before the fact is written; a code:// item gets its digest here."
          },
          {
            "lines": "11",
            "label": "links",
            "note": "Rejected as duplicate when an identical (from, to, role, locator) row exists."
          },
          {
            "lines": "12",
            "label": "entities",
            "note": "Only game_concept and pattern may be admitted; the mechanical kinds come from the extractor."
          },
          {
            "lines": "13",
            "label": "merges",
            "note": "Both sides must be curated kinds; a mechanical merge is rejected."
          }
        ]
      },
      "text": [
        {
          "insert": "{\n  \"facts\": [{\n    \"subject\": {\"target_stable_key\": \"main/melee/ft/ftcommon:ftCo_800BFFD0\"},\n    \"type\": \"purpose\", \"op\": \"write\",\n    \"value\": \"...\", \"rationale\": \"...\",\n    \"confidence\": 0.7,\n    \"evidence\": [{\"kind\": \"pr\", \"locator\": \"pr://1234/comment/2\", \"why\": \"...\"}]\n  }],\n  \"links\": [{\"from\": {}, \"to\": {}, \"role\": \"...\", \"why\": \"...\", \"kind\": \"code\", \"locator\": \"code://<rev>/<path>#L10-L20\"}],\n  \"entities\": [{\"kind\": \"game_concept\", \"locator\": \"...\", \"note\": \"...\"}],\n  \"merges\": [{\"loser_locator\": \"...\", \"winner_locator\": \"...\", \"why\": \"...\"}]\n}"
        }
      ],
      "children": []
    },
    "b-bl-out-p": {
      "id": "b-bl-out-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The goal is stated against the live record: preserve supported knowledge and fill its gaps, revise changed claims, clear claims the evidence no longer supports. A subject with nothing supportable contributes no facts. Sibling functions are research material, never fill-out subjects."
        }
      ],
      "children": []
    },
    "b-bl-runs-h": {
      "id": "b-bl-runs-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "When It Runs"
        }
      ],
      "children": []
    },
    "b-bl-runs-po": {
      "id": "b-bl-runs-po",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "kg2-prioritize ranks every target: direct score = runs x3 + submissions x1 + PRs x4 + Discord mentions x5 + events x2; inherited score from the unit's PRs and mentions breaks ties only"
          },
          {
            "text": "The runner takes targets never indexed, above --min-direct-score when set, up to --limit, striped by --shard i/n"
          },
          {
            "text": "Lanes (default 4) claim targets from a shared cursor, polling the stop file <stateDir>/knowledge_v2/backfill/<runId>.stop on every claim"
          },
          {
            "text": "Per target: build the pass context, run the model (900 s timeout), apply without a required citation, stamp the target always and each linked entity only when a fact or link landed on it"
          },
          {
            "text": "The artifact goes to <stateDir>/knowledge_v2/backfill/<runId>/<target>.json with context, proposal, apply report, and timings; a run-log line and a summary JSON follow"
          },
          {
            "text": "Five consecutive failures abort the run; --dry-run runs the model and simulates the apply without stamping"
          }
        ]
      },
      "children": []
    },
    "b-bl-order-p": {
      "id": "b-bl-order-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sort order after the never-indexed filter: match rank (100 percent first), linked, named symbol, higher unit named ratio, direct score, inherited score, stable key. Symbols like lbl_, fn_, unk_, and bare hex chunks do not count as named."
        }
      ],
      "children": []
    },
