      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Dispatched by the run scheduler loop during the running phase: one session per claimed target, working in a per-claim detached worktree, with the context budget degrading across retries. On finish, its best checkpoint is enqueued into the worker-output integration queue, and with --worker-summary on, a worker_summary job narrates the run for the knowledge system."
        }
      ],
      "children": []
