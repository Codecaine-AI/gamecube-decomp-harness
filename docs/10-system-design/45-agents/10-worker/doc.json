      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The worker executes one claimed Melee decomp target ("
        },
        {
          "insert": "unit::symbol",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") toward a 100% objdiff match inside its own detached git worktree; a turn may end short of a full match, and runner-checkable progress is a valid outcome. It edits only its approved write set (initially just the target file) and ends by emitting a free-form "
        },
        {
          "insert": "runner_validation_handoff",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " JSON note, which may carry an evidence-backed "
        },
        {
          "insert": "write_set_widening_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The runner owns checkpoints, validation, and lifecycle."
        }
      ],
      "children": []
    },
