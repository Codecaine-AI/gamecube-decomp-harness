      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A game binds stable identity to the configuration and canonical worktree required for orchestration. Melee is the configured game today, but the contract contains no Melee-specific workflow semantics."
        }
      ],
      "children": []
    },
    "b-10-game-model-game-boundary-3": {
