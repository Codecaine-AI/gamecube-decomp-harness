          "insert": "Game Boundary"
        }
      ],
      "children": []
    },
    "b-10-game-model-a-game-is-the-durable-4": {
      "id": "b-10-game-model-a-game-is-the-durable-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The game boundary answers what the harness may operate on. Runtime ownership, cycles, workflow authority, and source-head advancement belong to the harness placed around this boundary."
        }
      ],
      "children": []
    },
