      "id": "b-10-game-model-the-canonical-worktree-i-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical worktree is the source location the game exposes to the harness as current truth. Registration identifies it and verifies that it matches the configured repository; isolated staging worktrees are temporary workflow resources and never replace the game's identity boundary."
        }
      ],
      "children": []
