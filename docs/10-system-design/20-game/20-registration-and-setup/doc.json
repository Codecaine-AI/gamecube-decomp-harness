{
  "schemaVersion": 1,
  "id": "20-registration-and-setup",
  "title": "Registration and Setup",
  "root": "b-20-registration-root",
  "blocks": {
    "b-20-registration-root": {
      "id": "b-20-registration-root",
      "type": "paragraph",
      "props": {},
      "text": [],
      "children": [
        "b-20-registration-intro",
        "b-20-registration-game-registration-heading",
        "b-20-registration-game-registration-contract",
        "b-registration-contract-table",
        "b-20-registration-worktree-heading",
        "b-20-registration-worktree-provisioning",
        "b-registration-worktree-shape",
        "b-registration-activation-heading",
