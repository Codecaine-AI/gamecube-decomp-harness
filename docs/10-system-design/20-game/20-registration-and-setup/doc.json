    "b-20-registration-intro": {
      "id": "b-20-registration-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Registration binds game-specific configuration to a stable identity and prepares its canonical source boundary. A game becomes available to the harness only after the descriptor and worktree pass validation."
        }
      ],
      "children": []
    },
    "b-20-registration-game-registration-heading": {
      "id": "b-20-registration-game-registration-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Game Registration"
        }
      ],
      "children": []
    },
    "b-20-registration-game-registration-contract": {
      "id": "b-20-registration-game-registration-contract",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The operator supplies the repository, toolkits, policy defaults, "
        },
        {
          "insert": "Knowledge Sources",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-knowledge/10-knowledge-sources"
            }
          }
        },
        {
          "insert": ", and canonical worktree identity. Registration validates that these values are complete, mutually coherent, and usable by the configured sync toolkit."
        }
      ],
      "children": []
    },
    "b-registration-contract-table": {
      "id": "b-registration-contract-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Input",
          "Validation",
          "Result"
        ],
        "rows": [
          [
            "Game identity",
            "Unique and stable",
            "Durable subject for harness records"
          ],
          [
            "Repository",
            "Reachable by the configured source toolkit",
            "Source authority is explicit"
          ],
          [
            "Toolkits",
            "Required commands and capabilities resolve",
            "Workers can receive bounded game-specific tools"
          ],
          [
            "Policy defaults",
            "Schema-valid and compatible with toolkits",
            "Harness initialization has deterministic defaults"
          ],
          [
            "Knowledge inputs",
            "Supported sources with required credentials or paths",
            "Knowledge ingestion can start after sync handoff"
          ]
        ]
      },
      "children": []
    },
    "b-20-registration-worktree-heading": {
      "id": "b-20-registration-worktree-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Worktree Provisioning"
        }
      ],
      "children": []
    },
    "b-20-registration-worktree-provisioning": {
      "id": "b-20-registration-worktree-provisioning",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Provisioning creates or adopts the one canonical worktree named by the game descriptor. Verification confirms its repository identity and source revision before activation; temporary reconciliation worktrees remain outside this contract."
        }
      ],
      "children": []
    },
    "b-registration-worktree-shape": {
      "id": "b-registration-worktree-shape",
      "type": "state-shape",
      "props": {
        "example": "{\n  \"game_id\": \"melee\",\n  \"repository\": \"github.com/doldecomp/melee\",\n  \"worktree_identity\": \"melee-canonical\",\n  \"source_revision\": \"abc123\",\n  \"sync_toolkit\": \"melee-sync\"\n}",
        "fields": [
          {
            "name": "game_id",
            "type": "GameId",
            "description": "Stable game identity."
          },
          {
            "name": "repository",
            "type": "RepositoryLocator",
            "description": "Configured source repository."
          },
          {
            "name": "worktree_identity",
            "type": "WorktreeIdentity",
            "description": "Canonical worktree owned by the game."
          },
          {
            "name": "source_revision",
            "type": "CommitId",
            "description": "Revision verified during setup."
          },
          {
            "name": "sync_toolkit",
            "type": "ToolkitId",
            "description": "Toolkit authorized to inspect and reconcile the source."
          }
        ],
        "name": "RegisteredGameWorktree"
      },
      "children": []
    },
    "b-registration-activation-heading": {
      "id": "b-registration-activation-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Activation"
        }
      ],
      "children": []
    },
    "b-registration-activation-outline": {
      "id": "b-registration-activation-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Register a game",
            "steps": [
              {
                "text": "Prepare the descriptor and canonical worktree"
              },
              {
                "text": "Verify repository identity, revision, toolkits, policy, and knowledge inputs"
              },
              {
                "text": "Activate the game as available to the harness"
              },
              {
                "text": "Emit the durable registration result"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-registration-exchange-heading": {
      "id": "b-registration-exchange-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Setup Exchange"
        }
      ],
      "children": []
    },
    "b-registration-exchange-sequence": {
      "id": "b-registration-exchange-sequence",
      "type": "sequence",
      "props": {
        "sequenceId": "game-registration-setup",
        "title": "Operator and sync toolkit during game setup"
      },
      "children": []
    },
    "b-registration-handoff": {
      "id": "b-registration-handoff",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Activation hands the registered game to the "
        },
        {
          "insert": "Harness process",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/30-harness/10-process-overview"
            }
          }
        },
        {
          "insert": ". Cycle opening, baseline preparation, opening sync, and workflow authority are defined there rather than in game setup."
        }
      ],
      "children": []
    }
  }
}
