    "b-55-kgr-50in-intro": {
      "id": "b-55-kgr-50in-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "True inputs feeding the distillation pipelines: past PRs record code changes, comments, fixes, and learnings — the attempt ledger's upstream-PR intake infers attempts from them; Discord records what people figured out — a daily cron extracts conversations into knowledge proposals; the retired set is parked. The SmashWiki mirror now lives among the knowledge stores; computed artifacts such as Ghidra and opseq are generated, machine-shaped, and live under Per-target."
        }
      ],
      "children": []
    },
