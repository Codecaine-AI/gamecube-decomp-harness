            "text": "daily cron reads new/backlog messages"
          },
          {
            "text": "extraction proposes learnings (statement + message evidence refs)"
          },
          {
            "text": "curator validates + appends as proposed"
          },
          {
            "text": "corroboration/graduation as normal"
          }
        ]
