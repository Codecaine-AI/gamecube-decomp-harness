    "b-55-kgr-35-20si-intro": {
      "id": "b-55-kgr-35-20si-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Computed attachments each target carries, each one a different way to reach related targets: structural similarity (opseq analogs), binary analysis (ghidra), naming (siblings), and wiki mapping (crosswalk). No processing pipelines — every index is regenerated per epoch alongside the code graph."
        }
      ],
      "children": []
