      "props": {
        "title": "Decision (2026-08-10) — graph extension scope",
        "tone": "decision"
      },
      "text": [
        {
          "insert": "Stage the biggest build item: add "
        },
        {
          "insert": "CALLS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "REFERENCES_DATA",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " first — they come out of the same extraction pass (identifier → known function/data symbol) and are what injection ranking needs. Defer "
        },
        {
          "insert": "USES_TYPE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": it requires real type resolution (clang territory) and no worker surface consumes it yet."
        }
      ],
