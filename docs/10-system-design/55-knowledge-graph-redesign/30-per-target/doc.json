        {
          "insert": "Per-target — everything hangs off a target"
        }
      ],
      "children": []
    },
    "b-55-kgr-30pt-intro": {
      "id": "b-55-kgr-30pt-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each epoch the code graph is rebuilt from the actual targets and file names — the base walkability. Every target node then carries the search indexes, its slice of the attempt ledger, and its knowledge slice."
        }
      ],
      "children": []
    },
    "b-55-kgr-30pt-walk": {
      "id": "b-55-kgr-30pt-walk",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The walk from any target: 1-hop peers → analogs and siblings → attempts and tactics on those neighbors → knowledge statements anchored there."
        }
      ],
      "children": []
    },
