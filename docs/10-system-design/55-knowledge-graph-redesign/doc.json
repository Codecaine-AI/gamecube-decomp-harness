    "b-55-kgr-4": {
      "id": "b-55-kgr-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge is divided by who keeps it true, not by topic. It has five maintenance regimes: derived, corpus, ledger (events), learnings (beliefs), and authored. Game understanding enters either as raw corpus or as evidence-backed learnings produced during work, never as unowned summaries."
        }
      ],
      "children": []
    },
