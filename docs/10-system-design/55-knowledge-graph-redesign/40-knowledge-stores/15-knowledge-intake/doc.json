    "b-55-kgr-intake-grounding-p": {
      "id": "b-55-kgr-intake-grounding-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "All of this already exists on disk and in the orchestrator DB today — and none of it is read by the current curator. The librarian's raw material, per worker:"
        }
      ],
      "children": []
    },
