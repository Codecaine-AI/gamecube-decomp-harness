        }
      ],
      "children": []
    },
    "b-20-cycles-a-pr-campaign-can-remain-10": {
      "id": "b-20-cycles-a-pr-campaign-can-remain-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A PR campaign can remain in review while another workflow later receives authority."
        }
      ],
      "children": []
    },
    "b-20-cycles-a-sync-request-can-remai-11": {
      "id": "b-20-cycles-a-sync-request-can-remai-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A sync request can remain durable before the operator starts it."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-game-model-docs-12": {
      "id": "b-20-cycles-the-game-model-docs-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The "
        },
        {
          "insert": "game model",
          "attributes": {
            "link": "docs/10-system-design/30-games/10-game-model"
          }
        },
        {
          "insert": " defines game identity, the canonical worktree, the baseline, and the meaning of "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The cycle applies that model to one bounded period of orchestration."
        }
      ],
      "children": []
    },
    "b-20-cycles-single-active-cycle-ru-13": {
      "id": "b-20-cycles-single-active-cycle-ru-13",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Single Active Cycle Rule"
        }
      ],
      "children": []
    },
    "b-20-cycles-a-game-has-at-most-on-14": {
      "id": "b-20-cycles-a-game-has-at-most-on-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A game has at most one active "
        },
        {
          "insert": "Cycle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The rule ensures that only one durable container owns the canonical worktree and future head lineage."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-active-cycle-persi-15": {
      "id": "b-20-cycles-the-active-cycle-persi-15",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The active cycle persists when no workflow holds dispatch authority."
        }
      ],
      "children": []
    },
    "b-20-cycles-historical-cycles-art-16": {
      "id": "b-20-cycles-historical-cycles-art-16",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Historical cycles, artifacts, PR status, and knowledge remain readable without becoming active."
        }
      ],
      "children": []
    },
    "b-20-cycles-no-automatic-transition-17": {
      "id": "b-20-cycles-no-automatic-transition-17",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "No automatic transition closes a cycle."
        }
      ],
      "children": []
    },
    "b-20-cycles-a-successor-cycle-open-18": {
      "id": "b-20-cycles-a-successor-cycle-open-18",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A successor cycle opens only after the prior cycle closes and a fresh baseline is captured."
        }
      ],
      "children": []
    },
    "b-20-cycles-closing-is-an-operator-g-19": {
      "id": "b-20-cycles-closing-is-an-operator-g-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Closing is an operator-gated transition."
        }
      ],
      "children": []
    },
    "b-20-cycles-no-workflow-may-hold-dis-20": {
      "id": "b-20-cycles-no-workflow-may-hold-dis-20",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "No workflow may hold dispatch authority while closing proceeds."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-canonical-worktree-m-21": {
      "id": "b-20-cycles-the-canonical-worktree-m-21",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The canonical worktree must contain no changes beyond "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-cycles-save-point-evidence-must-22": {
      "id": "b-20-cycles-save-point-evidence-must-22",
