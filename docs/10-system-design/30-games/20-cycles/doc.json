      ],
      "children": []
    },
    "b-20-cycles-the-operator-must-select-23": {
      "id": "b-20-cycles-the-operator-must-select-23",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The operator must select a named save point whose commit equals "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-cycles-ordered-timeline-24": {
      "id": "b-20-cycles-ordered-timeline-24",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Ordered Timeline"
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-timeline-rec-25": {
      "id": "b-20-cycles-the-cycle-timeline-rec-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The cycle timeline records head lineage and workflow evidence in one durable order. Each entry kind has one writer and states whether it can advance "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-cycles-epoch-completed-record-26": {
      "id": "b-20-cycles-epoch-completed-record-26",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "epoch_completed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records a Run integration commit and advances head."
        }
      ],
      "children": [
        "b-20-cycles-the-entry-exists-if-and-27"
      ]
    },
    "b-20-cycles-the-entry-exists-if-and-27": {
      "id": "b-20-cycles-the-entry-exists-if-and-27",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The entry exists if and only if the integration commit exists."
        }
      ],
      "children": []
    },
    "b-20-cycles-remote-application-rec-28": {
      "id": "b-20-cycles-remote-application-rec-28",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "remote_application",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records confirmed source reconciliation and advances head."
        }
      ],
      "children": [
        "b-20-cycles-a-knowledge-only-sync-re-29"
      ]
    },
    "b-20-cycles-a-knowledge-only-sync-re-29": {
      "id": "b-20-cycles-a-knowledge-only-sync-re-29",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A knowledge-only sync records no source boundary and does not advance head."
        }
      ],
      "children": []
    },
    "b-20-cycles-pr-phase-records-pr-ca-30": {
      "id": "b-20-cycles-pr-phase-records-pr-ca-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "pr_phase",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records PR campaign activations and releases without advancing head."
        }
      ],
      "children": []
    },
    "b-20-cycles-save-point-pins-report-31": {
      "id": "b-20-cycles-save-point-pins-report-31",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "save_point",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pins reports, board state, and score evidence to an existing commit without advancing head."
        }
      ],
      "children": []
    },
    "b-20-cycles-recovery-reads-the-sessi-32": {
      "id": "b-20-cycles-recovery-reads-the-sessi-32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Recovery reads the cycle and its timeline rather than reconstructing current state from dashboard logs or transient workflow events. Head-changing boundaries record their timeline entry and "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " update as one recoverable operation."
        }
      ],
      "children": []
    },
    "b-20-cycles-workflow-authority-33": {
      "id": "b-20-cycles-workflow-authority-33",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Workflow Authority"
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-can-retain-r-34": {
      "id": "b-20-cycles-the-cycle-can-retain-r-34",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The cycle can retain Run, PR campaign, and sync state at the same time, but exactly zero or one child workflow holds dispatch authority. Authority permits worker dispatch and mutation of that workflow's allowed checkout surfaces."
        }
      ],
      "children": []
    },
    "b-20-cycles-run-releases-authority-t-35": {
      "id": "b-20-cycles-run-releases-authority-t-35",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Run releases authority through an explicit stop or drain boundary."
        }
      ],
      "children": []
    },
    "b-20-cycles-pr-work-acquires-authori-36": {
      "id": "b-20-cycles-pr-work-acquires-authori-36",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "PR work acquires authority for bounded campaign activity and releases it without closing the cycle."
        }
      ],
      "children": []
    },
    "b-20-cycles-observing-upstream-chang-37": {
      "id": "b-20-cycles-observing-upstream-chang-37",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Observing upstream changes can record a requested sync but cannot start reconciliation."
        }
      ],
      "children": []
    },
    "b-20-cycles-an-operator-started-sync-38": {
      "id": "b-20-cycles-an-operator-started-sync-38",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An operator-started sync waits for Run to drain before acquiring authority."
        }
      ],
      "children": []
    },
    "b-20-cycles-sync-prepares-reconcilia-39": {
      "id": "b-20-cycles-sync-prepares-reconcilia-39",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Sync prepares reconciliation outside the canonical worktree and changes cycle lineage only at confirmed publication."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-authority-handoff-ch-40": {
      "id": "b-20-cycles-the-authority-handoff-ch-40",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The authority handoff changes which workflow may act. It does not change the cycle identity or discard inactive workflow state."
        }
      ],
      "children": []
    },
    "b-20-cycles-run-to-pr-lifecycle-41": {
      "id": "b-20-cycles-run-to-pr-lifecycle-41",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Run-to-PR Lifecycle"
        }
      ],
      "children": []
    },
    "b-20-cycles-the-normal-lifecycle-mov-42": {
      "id": "b-20-cycles-the-normal-lifecycle-mov-42",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The normal lifecycle moves game work from a Run boundary into PR preparation while keeping both phases inside one cycle."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-opens-on-a-c-43": {
      "id": "b-20-cycles-the-cycle-opens-on-a-c-43",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The cycle opens on a captured baseline and matching "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-cycles-run-dispatches-epochs-an-44": {
      "id": "b-20-cycles-run-dispatches-epochs-an-44",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Run dispatches epochs and records each completed integration boundary on the cycle timeline."
        }
      ],
      "children": []
    },
    "b-20-cycles-run-stops-or-drains-and-45": {
      "id": "b-20-cycles-run-stops-or-drains-and-45",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Run stops or drains and releases dispatch authority."
        }
      ],
      "children": []
    },
    "b-20-cycles-pr-work-starts-from-the-46": {
      "id": "b-20-cycles-pr-work-starts-from-the-46",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "PR work starts from the cycle's current head, builds the ship set, runs QA, and prepares reviewable slices."
        }
      ],
      "children": []
    },
    "b-20-cycles-pr-phases-and-save-point-47": {
      "id": "b-20-cycles-pr-phases-and-save-point-47",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "PR phases and save points record shipping progress and evidence without replacing the cycle lineage."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-either-retur-48": {
      "id": "b-20-cycles-the-cycle-either-retur-48",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The cycle either returns to Run or another child workflow, or closes through the explicit close gate."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-lifecycle-is-not-a-o-49": {
      "id": "b-20-cycles-the-lifecycle-is-not-a-o-49",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The lifecycle is not a one-way state machine. Review can remain durable while Run or sync later holds authority, although a campaign normally concludes before the next Run batch so review learning enters that batch cleanly."
        }
      ],
      "children": []
    },
    "b-20-cycles-cycle-invariants-50": {
      "id": "b-20-cycles-cycle-invariants-50",
      "type": "heading",
      "props": {
