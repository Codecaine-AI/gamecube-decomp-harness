    },
    "b-20-cycles-gamecycle-is-the-2": {
      "id": "b-20-cycles-gamecycle-is-the-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Cycle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the durable container for one period of work on a game. It owns the active baseline-to-head lineage, preserves an ordered timeline across Run, PR, and sync activity, and remains inspectable after explicit close."
        }
      ],
      "children": []
    },
    "b-20-cycles-durable-container-3": {
      "id": "b-20-cycles-durable-container-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Durable Container"
        }
      ],
      "children": []
    },
    "b-20-cycles-a-cycle-gives-every-wo-4": {
      "id": "b-20-cycles-a-cycle-gives-every-wo-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A cycle gives every workflow acting on a game one durable identity and one ordered record."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-captures-the-5": {
      "id": "b-20-cycles-the-cycle-captures-the-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The cycle captures the immutable opening baseline and the game policy in force at that boundary."
        }
      ],
      "children": []
    },
    "b-20-cycles-the-cycle-stores-the-c-6": {
      "id": "b-20-cycles-the-cycle-stores-the-c-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The cycle stores the current "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and verifies that the canonical worktree agrees with it at durable boundaries."
        }
      ],
      "children": []
    },
    "b-20-cycles-run-pr-campaign-and-sy-7": {
      "id": "b-20-cycles-run-pr-campaign-and-sy-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Run, PR campaign, and sync remain durable child workflows even while inactive."
        }
      ],
      "children": []
    },
    "b-20-cycles-workflow-state-does-not-8": {
      "id": "b-20-cycles-workflow-state-does-not-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Workflow state does not become the cycle itself."
        }
      ],
      "children": [
        "b-20-cycles-a-run-can-stop-while-the-9",
        "b-20-cycles-a-pr-campaign-can-remain-10",
        "b-20-cycles-a-sync-request-can-remai-11"
