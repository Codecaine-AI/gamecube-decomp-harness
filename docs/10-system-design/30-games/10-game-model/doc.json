      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical worktree is the source position the orchestrator treats as the game's current truth. A "
        },
        {
          "insert": "Cycle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has exclusive ownership of that worktree while the cycle is active, including intervals when no child workflow holds dispatch authority."
