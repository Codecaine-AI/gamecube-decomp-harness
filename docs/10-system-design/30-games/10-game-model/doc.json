    "b-10-game-model-any-game-the-orchestrato-2": {
      "id": "b-10-game-model-any-game-the-orchestrato-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Any game the orchestrator can operate on is a game. A game binds game-specific configuration to one canonical worktree and gives every cycle a stable baseline and "
        },
        {
          "insert": "head_revision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lineage; Melee is the configured game today, not a special case in the model."
        }
      ],
      "children": []
    },
    "b-10-game-model-game-boundary-3": {
