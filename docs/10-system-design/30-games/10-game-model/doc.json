      "id": "b-10-game-model-a-game-is-the-durable-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A game is the durable unit an operator opens and the orchestrator acts on."
        }
      ],
      "children": []
    },
