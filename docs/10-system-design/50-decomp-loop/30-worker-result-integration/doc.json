    "compat": {
      "id": "compat",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The outcome status enum retains historical resolver values for stored compatibility. Those values do not imply a live resolver producer. Blocking outcomes remain visible until explicitly settled."
        }
      ],
