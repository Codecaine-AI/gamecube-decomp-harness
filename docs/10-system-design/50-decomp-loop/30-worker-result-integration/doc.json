    "knowledge": {
      "id": "knowledge",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Code and Knowledge Leave the Worker Separately"
        }
      ],
      "children": []
    },
    "knowledge-prose": {
      "id": "knowledge-prose",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Required artifacts and transcript evidence are downloaded before worker closure and sandbox deletion. Integration consumes the selected code patch. When enabled, the summary processor turns closed-worker evidence into a structured account and the librarian consumer accepts reusable knowledge. Failures and non-improvements can still teach later workers."
        }
      ],
      "children": []
    },
