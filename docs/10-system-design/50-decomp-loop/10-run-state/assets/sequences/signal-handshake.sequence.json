{
  "version": 1,
  "id": "signal-handshake",
  "title": "Signal Handshake",
  "style": {},
  "participants": [
    {
      "id": "p1",
      "name": "Worker",
      "kind": "participant"
    },
    {
      "id": "p2",
      "name": "Wake queue",
      "kind": "participant"
    },
    {
      "id": "p3",
      "name": "Runner",
      "kind": "participant"
    },
    {
      "id": "p4",
      "name": "Scheduler",
      "kind": "participant"
    },
    {
      "id": "p5",
      "name": "Run state",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "m1",
      "from": "p1",
      "to": "p2",
      "line": "sync",
      "text": "Persist completion or failure signal"
    },
    {
      "kind": "message",
      "id": "m2",
      "from": "p3",
      "to": "p2",
      "line": "sync",
      "text": "Read next unhandled signal"
    },
    {
      "kind": "message",
      "id": "m3",
      "from": "p3",
      "to": "p4",
      "line": "sync",
      "text": "Evaluate scheduling work"
    },
    {
      "kind": "message",
      "id": "m4",
      "from": "p4",
      "to": "p5",
      "line": "sync",
      "text": "Reconcile epoch and target state"
    },
    {
      "kind": "message",
      "id": "m5",
      "from": "p4",
      "to": "p2",
      "line": "sync",
      "text": "Mark signal handled"
    },
    {
      "kind": "message",
      "id": "m6",
      "from": "p4",
      "to": "p3",
      "line": "return",
      "text": "Return scheduling result"
    }
  ]
}
