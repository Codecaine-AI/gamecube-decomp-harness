    "b-day-img-1": {
      "id": "b-day-img-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A sandbox combines a prepared image for one game, the shared GameCube toolpack, and a revision seed for one claim. The host selects and transfers these inputs before starting the worker. The agent and model loop, knowledge database, raw source archives, credentials, and harness state remain on the host."
        }
      ],
      "children": []
    },
    "provision-claim": {
      "id": "provision-claim",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host first claims the queue job and target together, creates worker state, and records image provenance. Provisioning runs outside the database transaction. Once the workspace is ready, the host records its sandbox ID under the current ClaimToken and launches the worker."
        }
      ],
      "children": []
    },
