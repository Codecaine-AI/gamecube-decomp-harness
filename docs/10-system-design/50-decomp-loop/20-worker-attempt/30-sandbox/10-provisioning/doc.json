    "b-day-img-5": {
      "id": "b-day-img-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The image is configured and built for Linux before snapshot acceptance. Prepared objects and a populated compiler cache allow incremental builds in new sandboxes. The image recipe and toolpack are shared, but each game's checkout, inputs, compiler requirements, and target artifacts make its finished image game-specific."
        }
      ],
      "children": []
    },
    "b-day-img-6": {
      "id": "b-day-img-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Layer 2, the Per-Claim Seed"
        }
      ],
      "children": []
    },
    "b-day-img-7": {
      "id": "b-day-img-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The host records "
        },
        {
          "insert": "base_rev",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when it claims the worker job and target. Provisioning uses that recorded commit even if the host advances while the sandbox is starting. The host transfers commits from its game checkout, including local commits that may not be published upstream. The sandbox does not select or pull a remote branch."
        }
      ],
      "children": []
    },
    "b-day-img-8": {
      "id": "b-day-img-8",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Provision a worker sandbox",
            "steps": [
              {
                "text": "Create the sandbox from the claim's configured snapshot",
                "steps": [
                  {
                    "text": "Use the recorded game profile, snapshot name, baked revision, workspace, and resources."
                  }
                ]
              },
              {
                "text": "Supply the exact claim revision",
                "steps": [
                  {
                    "text": "If base_rev equals the baked revision, verify that commit exists. Otherwise the host uploads a self-contained Git bundle of the claim revision and its reachable history. This avoids requiring ancestors absent from a shallow image checkout. The sandbox verifies and fetches the bundle."
                  }
                ]
              },
              {
                "text": "Check out the claim base",
                "steps": [
                  {
                    "text": "Force a detached checkout at base_rev. A missing or invalid revision transfer fails provisioning."
                  }
                ]
              },
              {
                "text": "Refresh the shared toolpack and seed report artifacts",
                "steps": [
                  {
                    "text": "Compare the sandbox's .ready stamp with the host toolpack content. Upload and extract the toolpack only when they differ. Upload the supplied claim report artifacts and verify required executables."
                  }
                ]
              },
              {
                "text": "Start worker execution",
                "steps": [
                  {
                    "text": "The host worker uses the prepared sandbox workspace. Commands and file operations carry per-session environment settings."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "sandbox-revision-example": {
      "id": "sandbox-revision-example",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An image baked at "
        },
        {
          "insert": "commit-A",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " can serve a claim at "
        },
        {
          "insert": "commit-D",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The host transfers the required commits and the sandbox checks out "
        },
        {
          "insert": "commit-D",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Later host commits do not replace that claim's base, and the original snapshot remains at "
        },
        {
          "insert": "commit-A",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Ordinary epoch source changes therefore do not require rebuilding the image."
        }
      ],
      "children": []
    },
    "sandbox-rebuild-boundary": {
      "id": "sandbox-rebuild-boundary",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A new image is needed when the prepared game inputs, native tools, compiler, or build environment no longer support the selected target. Refreshing a compatible image can also reduce startup work as its baked revision ages."
        }
      ],
      "children": []
    },
    "sandbox-sleep-link": {
      "id": "sandbox-sleep-link",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Sleep and Wake",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-decomp-loop/20-worker-attempt/30-sandbox/30-sleep-and-wake"
            }
          }
        },
        {
          "insert": " resumes the same claim workspace with its edits and build state intact. Waking a stopped sandbox does not reseed its revision or refresh the toolpack. Provisioning applies to a newly created sandbox, including a replacement after failure."
        }
      ],
      "children": []
    },
