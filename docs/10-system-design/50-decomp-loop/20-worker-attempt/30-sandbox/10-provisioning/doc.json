    "b-day-img-10": {
      "id": "b-day-img-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Inbound, every agent tool call and runner validation command arrives as an exec or file-API call. The prompt and the model never touch the sandbox."
        }
      ],
      "children": []
    },
    "b-day-img-11": {
      "id": "b-day-img-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Outbound, command output streams back per call, objdiff verdicts return per attempt, and the runner downloads required checkpoint patches and validation artifacts before worker-state close. The workspace itself is never copied out."
        }
      ],
      "children": []
    }
