{
  "version": 1,
  "id": "sandbox-cleanup",
  "title": "Retain Evidence Before Deletion",
  "style": {},
  "participants": [
    {
      "id": "worker",
      "name": "Worker Runner",
      "kind": "participant"
    },
    {
      "id": "host",
      "name": "Host",
      "kind": "participant"
    },
    {
      "id": "sandbox",
      "name": "Daytona Sandbox",
      "kind": "participant"
    },
    {
      "id": "knowledge",
      "name": "Knowledge Jobs",
      "kind": "participant"
    }
  ],
  "items": [
    {
      "kind": "message",
      "id": "c1",
      "from": "worker",
      "to": "sandbox",
      "line": "sync",
      "text": "Download required patches and validation artifacts"
    },
    {
      "kind": "message",
      "id": "c2",
      "from": "sandbox",
      "to": "worker",
      "line": "return",
      "text": "Required evidence retained on host"
    },
    {
      "kind": "message",
      "id": "c3",
      "from": "worker",
      "to": "worker",
      "line": "sync",
      "text": "Finalize sleep controller and statistics"
    },
    {
      "kind": "message",
      "id": "c4",
      "from": "worker",
      "to": "host",
      "line": "sync",
      "text": "Close worker state"
    },
    {
      "kind": "message",
      "id": "c5",
      "from": "host",
      "to": "sandbox",
      "line": "sync",
      "text": "Delete sandbox: settlement"
    },
    {
      "kind": "message",
      "id": "c6",
      "from": "sandbox",
      "to": "host",
      "line": "return",
      "text": "Deletion confirmed or already absent"
    },
    {
      "kind": "message",
      "id": "c7",
      "from": "host",
      "to": "host",
      "line": "sync",
      "text": "Record sandbox.deleted"
    },
    {
      "kind": "note",
      "id": "c8",
      "anchor": "knowledge",
      "side": "over",
      "text": "Enabled summary and librarian jobs consume host evidence independently of deletion"
    }
  ]
}
