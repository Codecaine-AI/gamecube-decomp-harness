    "b-40-worker-lifecycle-when-the-runner-rejects-64": {
      "id": "b-40-worker-lifecycle-when-the-runner-rejects-64",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Continuation feedback returns to the same worker session and names the validation failure, QA finding, non-exact score, categorized out-of-set paths, and continuation reason. The worker refines the same evidence context instead of self-classifying its durable outcome."
        }
      ],
      "children": []
    },
    "gate-integration": {
      "id": "gate-integration",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker Result Integration",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-decomp-loop/30-worker-result-integration"
            }
          }
        },
        {
          "insert": " consumes the selected checkpoint after the attempt closes. Scoped validation remains tentative until the epoch-wide build checks the integrated result."
        }
      ],
      "children": []
