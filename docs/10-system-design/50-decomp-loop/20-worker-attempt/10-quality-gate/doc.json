    "b-40-worker-lifecycle-runner-validation-is-the-27": {
      "id": "b-40-worker-lifecycle-runner-validation-is-the-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Runner validation is the source of truth for progress. It captures every attempt, including failed and neutral checks, while selectable and selected flags make the best durable integration candidate explicit."
        }
      ],
      "children": []
    },
