        "columns": [
          "Check (in order)",
          "Decision",
          "Reason"
        ],
        "rows": [
          [
            "A selectable exact checkpoint passed every hard gate",
            "Stop; the accepted exact checkpoint is selected.",
            [
              {
                "insert": "accepted_exact",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Dry run",
            "Stop after the single probe attempt.",
            [
              {
                "insert": "dry_run",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Claim deadline reached",
            "Stop regardless of pending repair reasons; keep the best selectable checkpoint.",
            [
              {
                "insert": "claim_deadline",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Attempts used reached the attempt budget",
            "Stop; the only exhaustion reason.",
            [
              {
                "insert": "attempt_budget_exhausted",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Budget remains",
            "Continue the same worker with a continuation request.",
            [
              {
                "insert": "attempt_budget_available",
                "attributes": {
                  "code": true
                }
              }
            ]
          ]
        ]
      },
      "children": []
    },
