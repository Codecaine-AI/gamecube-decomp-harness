      "children": []
    },
    "b-45-worker-capabilities-rule-coverage-13": {
      "id": "b-45-worker-capabilities-rule-coverage-13",
      "type": "structured-table",
      "props": {
        "columns": [
          "Rule",
          "Deterministic coverage"
        ],
        "rows": [
          [
            [
              {
                "insert": "define_alias",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Rejects identifier aliases and function-like macro shims that redirect a canonical symbol or signature."
          ],
          [
            [
              {
                "insert": "bare_local_prototype",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Rejects non-static, non-extern file-scope prototypes in .c files that shadow the owning interface."
          ],
          [
            [
              {
                "insert": "numeric_literal_to_symbol",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Consults symbols.txt section and type; mutable-data and function symbols do not produce literal-promotion findings."
          ]
        ]
      },
      "children": []
    },
    "gate-lint-context": {
      "id": "gate-lint-context",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "These checks reject source tricks that would make a measured match unsuitable for integration. Passing lint alone is insufficient: the compilation, score, write-scope, and configured validation checks must also pass."
        }
      ],
      "children": []
    },
