	"id": "10-system-design-40-knowledge-70-execution-classes-and-jobs-20-job-lifecycle-and-leasing-doc-json",
	"title": "Knowledge Job Lifecycle and Leasing",
	"root": "b-doc-root-5",
	"blocks": {
		"b-doc-root-5": {
			"id": "b-doc-root-5",
			"type": "paragraph",
			"props": {},
			"children": [
				"b-doc-every-knowledge-executio-1",
				"b-doc-status-vocabulary-2",
