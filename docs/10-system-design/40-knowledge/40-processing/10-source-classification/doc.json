			"props": {},
			"text": [
				{
					"insert": "A knowledge source's class follows the authority needed to process and publish it, not its topic. Classification determines where material may stage and which boundary may accept it; execution details remain in the lifecycle and publication contracts."
				}
			],
			"children": []
		},
