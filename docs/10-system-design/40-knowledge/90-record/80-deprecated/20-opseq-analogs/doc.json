      "text": [
        {
          "insert": "Opseq similarity compares per-function instruction sequences and attaches scored ANALOGOUS_TO relationships to targets. The live builder reads the configured opseq indexes during graph maintenance and exposes each analog's current match status."
        }
      ],
      "children": []
    },
    "b-55-kgr-35-20-3": {
      "id": "b-55-kgr-35-20-3",
      "type": "state-shape",
      "props": {
        "name": "AnalogEntry",
        "fields": [
          {
            "name": "symbol",
            "type": "string"
          },
          {
            "name": "analog_symbol",
            "type": "string"
          },
          {
            "name": "similarity",
            "type": "number",
            "description": "0–1 instruction-sequence similarity."
          },
          {
            "name": "analog_match_status",
            "type": "\"exact\" | \"fuzzy\" | \"unmatched\""
          }
        ]
      },
      "children": []
    },
    "b-55-kgr-35-20-4": {
      "id": "b-55-kgr-35-20-4",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Build opseq analogs",
            "steps": [
              {
                "text": "Read per-function instruction-sequence indexes"
              },
              {
                "text": "Score and retain high-similarity pairs"
              },
              {
                "text": "Emit ANALOGOUS_TO edges and profiles"
              },
              {
                "text": "Include analogs and match status in target queries"
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-55-kgr-35-20-5": {
