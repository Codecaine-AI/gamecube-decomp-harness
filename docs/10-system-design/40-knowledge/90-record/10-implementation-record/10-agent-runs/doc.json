		"b-10-agent-runs-there-is-no-separate-obs-3": {
			"id": "b-10-agent-runs-there-is-no-separate-obs-3",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The Kernel Agent Viewer (`GET /api/kernel/agents`) is the review surface for the librarian’s model, tools, and hydrated prompts. The catalog exposes one librarian with condense, curation, and PR-indexing doors; deterministic extraction and graph construction remain code."
				}
			],
			"children": []
		},
		"b-10-agent-runs-ts-4": {
			"id": "b-10-agent-runs-ts-4",
			"type": "state-shape",
			"props": {
				"name": "LibrarianKernelConfig",
				"description": "As-built kernel catalog contract.",
				"fields": [
					{
						"name": "name",
						"type": "\"librarian\""
					},
					{
						"name": "model",
						"type": "string",
						"description": "Judgment-capable configured model; CLI overrides must be intentional."
					},
					{
						"name": "thinking",
						"type": "string",
						"description": "Medium for intake; higher reasoning may be selected for corroboration."
					},
					{
						"name": "doors",
						"type": "array",
						"fields": [
							{
								"name": "kind",
								"type": "\"condense\" | \"curation\" | \"pr_indexing\""
							}
						]
					},
					{
						"name": "tools",
						"type": "array",
						"description": "Includes code graph, past PRs, SmashWiki, ledger search, and ledger write surfaces."
					},
					{
						"name": "runInBackground",
						"type": "boolean"
					}
				],
				"example": "{\n  \"name\": \"librarian\",\n  \"thinking\": \"medium\",\n  \"doors\": [\n    {\n      \"kind\": \"condense\"\n    },\n    {\n      \"kind\": \"curation\"\n    },\n    {\n      \"kind\": \"pr_indexing\"\n    }\n  ],\n  \"runInBackground\": true\n}"
			},
			"children": []
		},
