    "b-ks2-src-discord-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "DISCORD — The Discord source is the archival store behind "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators: community discussion landed from chat exports as "
        },
        {
          "insert": "discord_message",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows. Archival class — a new export appends rows and gets them indexed; a row never changes after insert, so a locator into it cannot drift and carries no digest. Display resolves the locator and shows "
        },
        {
          "insert": "content",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " at read time; nothing is snapshotted onto the citing row."
        }
      ],
      "id": "b-ks2-src-discord-intro",
      "children": []
    },
    "b-ks2-src-discord-shape-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Table "
        },
        {
          "insert": "discord_message",
          "attributes": {
            "code": true
          }
        }
      ],
      "id": "b-ks2-src-discord-shape-heading",
      "children": []
    },
    "b-ks2-src-discord-shape": {
      "type": "state-shape",
      "props": {
        "name": "discord_message",
        "description": "One row per ingested message; immutable after insert.",
        "example": "{\n  \"id\": \"1123581321\",\n  \"channel\": \"matching\",\n  \"author\": \"ansem\",\n  \"posted_at\": \"2026-08-10T22:14:00Z\",\n  \"content\": \"pretty sure 800BFFD0 is the hitstun decay helper\",\n  \"thread_id\": null,\n  \"ingested_at\": \"2026-08-11T03:00:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "discord message id",
            "description": "Primary key; the payload of a `discord://message/` locator"
          },
          {
            "name": "channel",
            "type": "string"
          },
          {
            "name": "author",
            "type": "string"
          },
          {
            "name": "posted_at",
            "type": "timestamp",
            "description": "When the message was written on Discord"
          },
          {
            "name": "content",
            "type": "string"
          },
          {
            "name": "thread_id",
            "type": "discord message id",
            "description": "Present when the message sits in a thread",
            "required": false
          },
          {
            "name": "ingested_at",
            "type": "timestamp",
            "description": "When the export landed the row here"
          }
        ]
      },
      "id": "b-ks2-src-discord-shape",
      "children": []
    },
    "b-ks2-src-discord-shape-example-note-1": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the locator "
        },
        {
          "insert": "discord://message/1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to this row; two facts citing the same message each carry their own evidence row pointing here — the message row is the shared thing."
        }
      ],
      "id": "b-ks2-src-discord-shape-example-note-1",
      "children": []
    },
    "b-ks2-src-discord-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "thread_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": null here — the message sits directly in "
        },
        {
          "insert": "channel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not in a thread."
        }
      ],
      "id": "b-ks2-src-discord-shape-example-note-2",
      "children": []
    },
    "b-ks2-src-discord-parsing": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Parsing: in "
        },
        {
          "insert": "discord://message/1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the scheme is "
        },
        {
          "insert": "discord://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the payload "
        },
        {
          "insert": "1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a "
        },
        {
          "insert": "discord_message.id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The resolver checks the scheme against the citing row's "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then looks the payload up as the primary key; any other shape — extra path segments, a payload that is not a message id — is rejected."
        }
      ],
      "id": "b-ks2-src-discord-parsing",
      "children": []
    },
