    "b-ks2-src-discord-fk-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "None, in either direction. "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows cite a message by "
        },
        {
          "insert": "(kind, locator)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", not by foreign key: the five sources are heterogeneous, and one pointer mechanism spans them all. Reverse lookup — what stands on this message — is an indexed query on "
        },
        {
          "insert": "(kind, locator)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The table references nothing."
        }
      ],
      "id": "b-ks2-src-discord-fk-body",
      "children": []
