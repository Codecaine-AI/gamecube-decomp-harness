    "b-ks2-arch-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "ARCHIVAL SOURCES — The archival class holds raw inputs frozen once ingested: Discord, pull requests, and the wiki. New material appends rows and gets them indexed; existing rows never change. Because a row cannot change, a locator into an archival source cannot drift — archival citations carry no "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
