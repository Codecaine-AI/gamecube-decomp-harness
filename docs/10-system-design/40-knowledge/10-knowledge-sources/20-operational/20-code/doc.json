    "b-ks2-src-code-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "CODE — The code source is the one kind with no store row: the checkout itself is the store. A "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locator names a line span in the checkout at a pinned revision. Operational class, and the only source that drifts — the checkout moves with every merge — so this is the one kind whose citations carry a required "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-ks2-src-code-intro",
      "children": []
    },
    "b-ks2-src-code-grammar-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Locator grammar"
        }
      ],
      "id": "b-ks2-src-code-grammar-heading",
      "children": []
    },
    "b-ks2-src-code-grammar-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "code://<revision>/<path>#L<start>-L<end>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " resolves to the lines "
        },
        {
          "insert": "<start>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "<end>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of "
        },
        {
          "insert": "<path>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the checkout at "
        },
        {
          "insert": "<revision>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". There is no store row to look up; resolution reads the checkout. The grammar is closed — the resolver rejects any other shape, a path missing at the revision, or a line range past the end of the file."
        }
      ],
      "id": "b-ks2-src-code-grammar-body",
      "children": []
    },
    "b-ks2-src-code-drift-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Digest and drift"
        }
      ],
      "id": "b-ks2-src-code-drift-heading",
      "children": []
    },
    "b-ks2-src-code-drift-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every code citation — an "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row or a "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "kind = code",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — carries a "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text, fixing what was actually read at citation time. The resolver verifies the span and its digest when the citing row is written; reconciliation re-resolves "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators later and flags claims whose spans no longer match. Drift detection applies to this source alone — archival and attempt locators are never rechecked, because their stores are immutable."
        }
      ],
      "id": "b-ks2-src-code-drift-body",
      "children": []
    },
    "b-ks2-src-code-search-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Search surface"
        }
      ],
      "id": "b-ks2-src-code-search-heading",
      "children": []
    },
    "b-ks2-src-code-search-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Graph only: symbol lookup, xrefs, and grep over the checkout. Navigation is deterministic and unranked — no BM25, no vectors. The code graph the harness already derives is the surface; there is no separate index to build."
        }
      ],
      "id": "b-ks2-src-code-search-body",
      "children": []
    },
