    "b-ks2-oper-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "OPERATIONAL SOURCES — The operational class holds sources that grow as agents run. Attempts are the target ledger wearing its evidence hat: runs, submissions, and transcripts accumulate with every run, and rows are immutable once written. Code is the active checkout — the only drifting source, so every "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " citation carries a required "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text."
        }
      ],
      "id": "b-ks2-oper-intro",
      "children": []
    },
