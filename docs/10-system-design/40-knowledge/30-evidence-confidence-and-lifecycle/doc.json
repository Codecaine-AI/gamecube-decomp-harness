    "b-sks-lifecycle-confidence-p": {
      "id": "b-sks-lifecycle-confidence-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every fact is AI-inferred; the game is not decompiled, so nothing here is ground truth and there is no observed-versus-inferred category on a claim (formerly the "
        },
        {
          "insert": "basis",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " column). "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alone carries how sure we are. The number is a judgment, and everything it should be weighed against stays visible on the record itself rather than being folded into the number."
        }
      ],
      "children": []
    },
