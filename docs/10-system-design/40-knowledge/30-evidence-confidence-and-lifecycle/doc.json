                }
              },
              {
                "insert": " row's digest matches the span; a citation that fails resolution blocks the write"
              }
            ]
          ],
          [
            "Support",
            [
              {
                "insert": "Each evidence row's "
              },
              {
                "insert": "why",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " says what its record shows; the "
              },
              {
                "insert": "rationale",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " must argue from those observations to the "
              },
              {
                "insert": "value",
                "attributes": {
