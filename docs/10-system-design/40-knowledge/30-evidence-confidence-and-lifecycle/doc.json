                }
              }
            ]
          ],
          [
            "Deduplication",
            [
              {
                "insert": "A changed claim overwrites its row rather than adding a neighbour; at most one live row per subject and "
              },
              {
                "insert": "type",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " is enforced"
              }
            ]
          ],
          [
            "Naming policy",
            [
              {
                "insert": "An "
              },
              {
                "insert": "inferred_name",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " fact is a guess and every worker-facing projection shows it as one, with its confidence; the "
              },
              {
