    "b-ks2-path-runphase-intro": {
      "id": "b-ks2-path-runphase-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "RUN — The run-close phase: fires when a worker run closes. One pathway carries it. The worker summary agent writes the run object — the "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row and its "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows — advances the "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " watermark, and enqueues a "
        },
        {
          "insert": "run_closed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " index task; the librarian decides, per touched target and entity, whether facts change, citing "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". During the run itself only workers act, and an integration failure never invokes an agent: the run-loop inserts the "
        },
        {
          "insert": "regression",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " event ("
        },
        {
          "insert": "cause",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "merge_conflict",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and re-queues the target deterministically. The summary agent still runs, so the knowledge is not wasted."
        }
      ],
      "children": []
    },
