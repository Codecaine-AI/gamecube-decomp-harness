    "b-ks2-path-run-coverage-p": {
      "id": "b-ks2-path-run-coverage-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The summary agent advances the "
        },
        {
          "insert": "attempt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row of "
        },
        {
          "insert": "source_watermark",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — "
        },
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the closed run's id — and inserts one "
        },
        {
          "insert": "index_task",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "pathway",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "run_closed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and a "
        },
        {
          "insert": "payload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " naming the "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row. The librarian claims the task ("
        },
        {
          "insert": "started_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") and completes it ("
        },
        {
          "insert": "done_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") — status is derived from the timestamps, there is no status column — and stamps "
        },
        {
          "insert": "subject_index_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a fresh "
        },
        {
          "insert": "indexed_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the run's target and any entity the pass covered. A run whose task has no "
        },
        {
          "insert": "done_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is unprocessed by definition; nothing else tracks it."
        }
      ],
      "children": []
    },
