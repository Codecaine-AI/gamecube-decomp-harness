    "b-ks2-path-drift-intro": {
      "id": "b-ks2-path-drift-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "DRIFT RECHECK — Retired 2026-09-02 as an epoch-boundary pathway. Drift now lives inside the pr_imported and run_closed passes: report reconciliation carries renames forward whenever the checkout head moves ("
        },
        {
          "insert": "identity_status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " "
        },
        {
          "insert": "moved",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "target.moved_to_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", rows re-pointed in one transaction) and enqueues nothing; the flagger re-resolves each "
        },
        {
          "insert": "code://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " citation at the current head and classifies it "
        },
        {
          "insert": "unchanged | drifted | unresolvable",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the context carries "
        },
        {
          "insert": "renamed_from",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the drift report per touched subject; and the consumer's drift gate re-runs the flagger after apply — clean completes, one release for a retry, a second miss completes with a recorded warning. The "
        },
        {
          "insert": "drift_recheck",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pathway value survives only for the manual job kg2-drift-scan, which flags the whole store and enqueues one "
        },
        {
          "insert": "drift_recheck",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " task per unit listing the drifted subjects, deduplicated against pending tasks — for use after a large upstream jump. Only code drifts; archival and attempt citations never do."
        }
      ],
      "children": []
    },
