    "b-kg2-drift-loop-h": {
      "id": "b-kg2-drift-loop-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Why it cannot loop"
        }
      ],
      "children": []
    },
    "b-kg2-drift-loop-reconcile": {
      "id": "b-kg2-drift-loop-reconcile",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Reconciliation never enqueues tasks."
        }
      ],
      "children": []
    },
    "b-kg2-drift-loop-retry": {
      "id": "b-kg2-drift-loop-retry",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The gate retries exactly once. It stores drift_attempts in the task payload and checks it before release."
        }
      ],
      "children": []
    },
    "b-kg2-drift-loop-complete": {
      "id": "b-kg2-drift-loop-complete",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "A second miss completes the task, so a PR whose citations can never resolve, such as one that deleted the cited file, cannot pin the queue."
        }
      ],
      "children": []
    },
    "b-kg2-drift-loop-scan": {
      "id": "b-kg2-drift-loop-scan",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The manual scan deduplicates tasks per unit."
        }
      ],
      "children": []
    },
    "b-kg2-drift-loop-warning": {
      "id": "b-kg2-drift-loop-warning",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The warning line tells the operator to inspect the subject."
        }
      ],
      "children": []
    },
    "b-kg2-drift-quality-h": {
      "id": "b-kg2-drift-quality-h",
      "type": "heading",
