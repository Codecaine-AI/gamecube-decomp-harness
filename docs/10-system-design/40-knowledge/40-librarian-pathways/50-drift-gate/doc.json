      "children": []
    },
    "b-kg2-drift-quality-p": {
      "id": "b-kg2-drift-quality-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The shape is the same: a mechanical check after the agent's output, a bounded retry, and explicit completion with a warning. The subject differs: citations instead of a build."
        }
      ],
      "children": []
    },
    "b-kg2-drift-open-h": {
