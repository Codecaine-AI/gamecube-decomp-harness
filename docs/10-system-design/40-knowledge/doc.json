			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "A worker enters the knowledge system through one target. From that target it walks the code graph, computed search indexes, prior attempts, and anchored learnings, then reaches shared stores and the standing intake pipeline only when the task requires them."
				}
			],
			"children": []
		},
		"b-knowledge-target-first-transition": {
			"id": "b-knowledge-target-first-transition",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The target-scoped walk is defined in "
				},
				{
					"insert": "Per-Target Knowledge",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/40-knowledge/10-per-target"
						}
					}
				},
				{
					"insert": ". Shared stores, inputs, processing, and worker surfaces expand the same path outward."
				}
			],
			"children": []
		},
