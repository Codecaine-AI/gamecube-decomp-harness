    "b-kn-loop": {
      "id": "b-kn-loop",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Resolve the worker target against the build report and load its linked entities: translation unit, structs, fields, game concepts, patterns"
          },
          {
            "text": "Load the target card: live facts with confidence and rationale, linked entities, and the full target ledger, newest first"
          },
          {
            "text": "Chase code, assembly, graph, PR, worker-run, or wiki evidence only when the task needs detail"
          },
          {
            "text": "Record the run outcome as a worker_run with its submissions, separate from knowledge"
          },
          {
            "text": "The librarian indexes the run into facts, entities, links, and evidence; rebuild affected projections for later workers"
          }
        ]
      },
      "children": []
    },
