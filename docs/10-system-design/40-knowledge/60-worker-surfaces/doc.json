    "b-ws-tools-p": {
      "id": "b-ws-tools-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Eleven of the worker's 31 tools read knowledge. The six kv2_* tools read the V2 store directly, read-only; the four graph tools read the legacy code graph, which is kept outside the V2 store; past_prs_search reads the past-PRs archive. The V2 target card still arrives pre-rendered at boot. ledger_search was retired on 2026-09-03."
        }
      ],
      "children": []
    },
