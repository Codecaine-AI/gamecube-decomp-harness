    "b-ws-intro": {
      "id": "b-ws-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A worker receives a bounded projection of the knowledge system at boot, queries deeper evidence through its tool profile only when the task needs it, and never writes knowledge. Its feedback reaches the store after the run closes, through the summarizer job and the librarian. Code: "
        },
        {
          "insert": "worker/context.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/agent-catalog/agents/running/worker/context.ts",
              "label": "worker/context.ts"
            }
          }
        },
        {
          "insert": " assembles the boot context; "
        },
        {
          "insert": "profiles/defaults.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/tools/profiles/defaults.ts",
              "label": "profiles/defaults.ts"
            }
          }
        },
        {
          "insert": " names the tools."
        }
      ],
      "children": []
    },
    "b-ws-boot-h": {
      "id": "b-ws-boot-h",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Boot Context"
        }
      ],
      "children": []
    },
    "b-ws-boot-p": {
      "id": "b-ws-boot-p",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The rendered context is three blocks in order: the packet context, the legacy graph file card, and the V2 target card. The last two appear only when their data exists."
        }
      ],
      "children": []
    },
