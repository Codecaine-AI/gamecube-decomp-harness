{
  "version": 1,
  "id": "worker-ship-gate",
  "participants": [
    { "id": "p1", "name": "worker", "kind": "actor", "label": "Worker" },
    { "id": "p2", "name": "qa", "kind": "participant", "label": "QA ship gate" },
    { "id": "p3", "name": "attempts", "kind": "participant", "label": "Attempt ledger" },
    { "id": "p4", "name": "standards", "kind": "participant", "label": "Standards" },
    { "id": "p5", "name": "knowledge", "kind": "participant", "label": "Knowledge ledger" }
  ],
  "items": [
    { "kind": "message", "id": "m1", "from": "p1", "to": "p2", "line": "sync", "text": "submit candidate change" },
    {
      "kind": "fragment",
      "id": "f1",
      "op": "alt",
      "operands": [
        {
          "guard": "accepted",
          "items": [
            { "kind": "message", "id": "m2", "from": "p2", "to": "p1", "line": "return", "text": "ship approved" },
            { "kind": "message", "id": "m3", "from": "p1", "to": "p5", "line": "async", "text": "submit learning candidate with evidence" }
          ]
        },
        {
          "guard": "rejected",
          "items": [
            { "kind": "message", "id": "m4", "from": "p2", "to": "p3", "line": "async", "text": "append failed attempt" },
            { "kind": "message", "id": "m5", "from": "p2", "to": "p4", "line": "async", "text": "attach VIOLATES example" },
            { "kind": "message", "id": "m6", "from": "p2", "to": "p1", "line": "return", "text": "return actionable rejection" }
          ]
        }
      ]
    }
  ],
  "style": { "accent": "#C77D2E" }
}
