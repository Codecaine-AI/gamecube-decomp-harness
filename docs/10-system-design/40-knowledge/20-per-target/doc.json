    "b-55-kgr-30pt-intro": {
      "id": "b-55-kgr-30pt-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each epoch the code graph is rebuilt from the actual targets and file names — the base walkability. Every target node then carries the search indexes, its slice of the attempt ledger, and its knowledge slice."
        }
      ],
      "children": []
    },
    "b-55-kgr-30pt-walk": {
      "id": "b-55-kgr-30pt-walk",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The walk from any target: 1-hop peers → analogs and siblings → attempts and tactics on those neighbors → knowledge statements anchored there."
        }
      ],
      "children": []
    },
    "b-55-kgr-35s-layers": {
      "id": "b-55-kgr-35s-layers",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "What it is",
          "Build verb",
          "Tied to a target?"
        ],
        "rows": [
          [
            "code graph",
            "base walkability — targets, file names, CONTAINS/CALLS/DATA_REFS edges",
            "computed each epoch",
            "it IS the targets"
          ],
          [
            "search indexes",
            "opseq · ghidra · siblings · crosswalk — alternate sweep axes",
            "computed each epoch",
            "yes — attached per target"
          ],
          [
            "attempt ledger",
            "events: everything tried, observed or inferred; tactics as a view",
            "appended",
            "yes — each target has its ledger slice"
          ],
          [
            "knowledge",
            "beliefs: human knowledge store + AI-inferred, one ledger, two origins",
            "distilled (extract → corroborate → graduate)",
            "yes — anchored by subject"
          ]
        ],
        "title": "The four layers"
      },
      "children": []
    },
    "b-55-kgr-30pt-standards-note": {
