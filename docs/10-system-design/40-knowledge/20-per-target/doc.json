      "props": {},
      "text": [
        {
          "insert": "Standards are the deliberate exception: authored and global, not attached per target — cataloged under "
        },
        {
          "insert": "Knowledge stores",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-knowledge/30-knowledge-stores"
