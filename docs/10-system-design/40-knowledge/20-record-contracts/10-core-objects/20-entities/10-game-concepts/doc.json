    "b-sks-rc-concepts-grounding-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Grounding and locator"
        }
      ],
      "id": "b-sks-rc-concepts-grounding-heading",
      "children": []
    },
    "b-sks-rc-concepts-grounding-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A game concept exists so code can be tied to game meaning: shielding, wavedashing, hitlag, a character. The "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a curated slug — "
        },
        {
          "insert": "concept:shield",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "concept:wavedash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — or a wiki locator when one pins the subject better. Its natural grounding is the wiki corpus: facts on a "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " typically cite "
        },
        {
          "insert": "wiki://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " evidence, and the wiki importer is the usual seeder. Code reaches the concept through "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows from the targets and entities that realize it; a "
        },
        {
          "insert": "game_mapping",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fact on a target names the concept from the code side, and the link makes the join queryable from either end."
        }
      ],
      "id": "b-sks-rc-concepts-grounding-body",
      "children": []
    },
    "b-sks-rc-concepts-links-heading": {
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Seen through links"
