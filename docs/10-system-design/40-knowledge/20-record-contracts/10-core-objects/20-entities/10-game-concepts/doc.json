    "b-sks-rc-concepts-grouping": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Grouping is links too: concepts cluster into subsystems through entity→entity rows — "
        },
        {
          "insert": "concept:shield",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "concept:powershield",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "concept:shield-break",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " joined with "
        },
        {
          "insert": "role",
          "attributes": {
            "code": true
          }
