    "b-sks-rc-concepts-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "GAME CONCEPTS — "
        },
        {
          "insert": "game_concept",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " kind that pins an idea from the game rather than a shape in the code: a move, a state, a mechanic, a character ("
        },
        {
          "insert": "concept:shield",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). It exists so code can be tied to game meaning. A concept row is an ordinary "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row: the same table, the same merge lifecycle, the same curated admission documented in "
        },
        {
          "insert": "Entities",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-knowledge/20-record-contracts/10-core-objects/20-entities",
              "label": "Entities"
            }
          }
        },
        {
          "insert": ". Nothing on this page adds a column, a table, or a fact type. The other larger-idea kind, "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", has its own page: "
        },
        {
          "insert": "Patterns",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-knowledge/20-record-contracts/10-core-objects/20-entities/20-patterns",
              "label": "Patterns"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-sks-rc-concepts-intro",
      "children": []
    },
