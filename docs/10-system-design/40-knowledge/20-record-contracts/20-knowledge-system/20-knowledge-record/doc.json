            "Live facts",
            [
              {
                "insert": "fact",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " WHERE the subject key matches, grouped by "
              },
              {
                "insert": "type",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "What we currently think: one claim per "
              },
              {
                "insert": "type",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", each with its "
