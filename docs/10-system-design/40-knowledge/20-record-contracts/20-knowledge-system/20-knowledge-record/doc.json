    "b-sks-rc-know-example-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Nothing below is a stored object; it is what the query returns for one "
        },
        {
          "insert": "function",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " target with two live facts and three "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, one of them to a pattern entity. Shape is illustrative, not a contract."
        }
      ],
      "id": "b-sks-rc-know-example-body",
      "children": []
    },
    "b-sks-rc-know-example-code": {
      "type": "code",
      "props": {
        "language": "json"
      },
      "text": [
        {
          "insert": "{\n  \"subject\": {\n    \"target_id\": \"tgt-ftco-800bffd0\",\n    \"kind\": \"function\",\n    \"stable_key\": \"main/melee/ft/ftcommon:ftCo_800BFFD0\"\n  },\n  \"facts\": {\n    \"purpose\": [\n      {\n        \"value\": \"Applies knockback decay to the fighter's velocity each frame while in hitstun.\",\n        \"confidence\": 0.8,\n        \"rationale\": \"The loop scales vel.x and vel.y by the decay constant the hitstun state dispatch loads; the only caller is the hitstun handler.\",\n        \"evidence\": [\n          {\n            \"kind\": \"code\",\n            \"locator\": \"code://abc1234/src/melee/ft/ftcommon.c#L210-L242\",\n            \"digest\": \"sha256:1f3a9c\",\n            \"why\": \"The decay loop the claim describes\"\n          }\n        ]\n      }\n    ],\n    \"inferred_name\": [\n      {\n        \"value\": \"ftCommon_ApplyKnockbackDecay\",\n        \"confidence\": 0.6,\n        \"rationale\": \"Named for the decay behaviour; a decomp regular referred to this address as the knockback decay helper.\",\n        \"evidence\": [\n          {\n            \"kind\": \"discord\",\n            \"locator\": \"discord://message/1123581321\",\n            \"why\": \"A decomp regular calls this address the knockback decay helper\"\n          }\n        ]\n      }\n    ]\n  },\n  \"links\": [\n    {\n      \"role\": \"parameter\",\n      \"to\": {\"entity_id\": \"ent-param-7f21\", \"locator\": \"main/melee/ft/ftcommon:ftCo_800BFFD0#r3\"},\n      \"why\": \"First argument; the fighter struct pointer\"\n    },\n    {\n      \"role\": \"related\",\n      \"to\": {\"target_id\": \"tgt-ftco-800c0210\"},\n      \"why\": \"Shares the hitstun decay constant\"\n    },\n    {\n      \"role\": \"exhibits\",\n      \"to\": {\"entity_id\": \"ent-pattern-3a90\", \"locator\": \"pattern:decay-constant-preload\"},\n      \"why\": \"Loads the decay constant before the branch, like the other hitstun helpers\"\n    }\n  ]\n}"
        }
      ],
      "id": "b-sks-rc-know-example-code",
      "children": []
    },
    "b-sks-rc-know-reading-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The view is assembled wherever a subject is shown. For a target it is the knowledge half of the target card, which stacks it with "
        },
        {
          "insert": "target_status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the derived target-ledger view ("
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ⋈ "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entries, "
        },
        {
          "insert": "event",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows)"
        },
        {
          "insert": " — see the Record Contracts overview's derived views. For an entity it is the whole page: entities have no status and no ledger."
        }
      ],
      "id": "b-sks-rc-know-reading-body",
      "children": []
    },
    "b-sks-rc-know-patterns-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Patterns need no join table of their own: a pattern is an entity of kind "
        },
        {
          "insert": "pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a subject that shows one carries an ordinary "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row to it (roles like "
        },
        {
          "insert": "exhibits",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "uses",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", each with "
        },
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and an inline "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " + "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " citation), so the view surfaces pattern links through the same linked-subjects hop as everything else. The former "
        },
        {
          "insert": "target_pattern",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " join table is retired. Pattern entities are documented in "
        },
        {
          "insert": "Patterns",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/40-knowledge/20-record-contracts/10-core-objects/20-entities/20-patterns",
              "label": "Patterns"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "id": "b-sks-rc-know-patterns-body",
      "children": []
