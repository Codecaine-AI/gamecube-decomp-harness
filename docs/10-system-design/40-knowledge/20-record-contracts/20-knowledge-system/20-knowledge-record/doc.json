              {
                "insert": "link",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " WHERE either end is the subject, one hop out"
              }
            ],
            [
              {
                "insert": "Parameters, members, typed-as structs, related targets, patterns exhibited — each with its "
              },
              {
                "insert": "role",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " and "
              },
              {
                "insert": "why",
                "attributes": {
                  "code": true
                }
              }
            ]
          ],
          [
            "Cited observations",
            [
              {
                "insert": "evidence",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows joined through "
              },
              {
                "insert": "evidence.fact_id",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Each citation's "
              },
              {
                "insert": "kind",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", "
              },
              {
                "insert": "locator",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", and "
              },
              {
                "insert": "why",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "; the pointed-at content is resolved from its knowledge source at read time, not stored"
              }
            ]
          ],
          [
            "Patterns",
            [
              {
                "insert": "link",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " rows whose other end is an entity of kind "
