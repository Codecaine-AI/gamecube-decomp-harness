    "b-sks-rc-know-intro": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "KNOWLEDGE RECORD — Not a table. The knowledge record is the name of a derived view: the assembled page of all live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows for one subject — a "
        },
        {
          "insert": "target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or an "
        },
        {
          "insert": "entity",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — grouped by "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with linked subjects one hop out via "
        },
        {
          "insert": "link",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and every cited observation resolved through "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A subject \"has a knowledge record\" when facts exist for it; there is no row to create, no revision to supersede, no status to carry. This is a query, never a row."
        }
      ],
      "id": "b-sks-rc-know-intro",
      "children": []
    },
    "b-sks-rc-know-view-invariant": {
      "type": "callout",
      "props": {
        "kind": "decision",
        "title": "Invariant — a query, never a row",
        "tone": "success"
      },
      "text": [
        {
          "insert": "Nothing on this page is stored. The former "
        },
        {
          "insert": "knowledge_record",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " table — one revisioned row per target with typed fact columns — is retired; its columns became "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows; the revision chain is gone — a changed claim overwrites its row in place. Any schema element named "
        },
        {
          "insert": "knowledge_record",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a bug. The name survives because the assembled page is still how a worker meets a subject."
        }
      ],
      "id": "b-sks-rc-know-view-invariant",
      "children": []
    },
