    "b-sks-rc-evidence-grammar-body": {
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The grammar is closed: the resolver rejects a "
        },
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that does not match its "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "'s form, and rejects a kind/scheme mismatch. The payload is the source row's primary key; "
        },
        {
          "insert": "code",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the one kind with no source row — the checkout at "
        },
        {
          "insert": "<revision>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the source, which is why a "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of the span text is required there and nowhere else."
        }
      ],
      "id": "b-sks-rc-evidence-grammar-body",
      "children": []
    },
