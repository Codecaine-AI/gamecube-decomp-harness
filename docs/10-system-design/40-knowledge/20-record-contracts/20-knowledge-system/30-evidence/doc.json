    "b-sks-rc-evidence-shape": {
      "type": "state-shape",
      "props": {
        "name": "evidence",
        "description": "Fact-owned citations; each row belongs to exactly one fact and dies with it.",
        "example": "{\n  \"id\": \"ev-01j9x4\",\n  \"fact_id\": \"fact-7c21e0\",\n  \"kind\": \"discord\",\n  \"locator\": \"discord://message/1123581321\",\n  \"why\": \"The author identifies 800BFFD0 as the hitstun decay helper after matching it\",\n  \"captured_at\": \"2026-08-10T22:14:00Z\"\n}",
        "fields": [
          {
            "name": "id",
            "type": "evidence id",
            "description": "Primary key; a plain surrogate id"
          },
          {
            "name": "fact_id",
            "type": "fact id",
            "description": "The owning claim; required"
          },
          {
            "name": "kind",
            "type": "pr | discord | attempt | wiki | code"
          },
          {
            "name": "locator",
            "type": "typed source locator",
            "description": "Must match `kind`'s closed grammar and resolve; the payload is the source row's id"
          },
          {
            "name": "digest",
            "type": "digest",
            "description": "Of the span text; required when `kind` is `code`, absent otherwise",
            "required": false
          },
          {
            "name": "why",
            "type": "string",
            "description": "Why this pointed-at record supports the fact"
          },
          {
            "name": "captured_at",
            "type": "timestamp"
          }
        ]
      },
      "id": "b-sks-rc-evidence-shape",
      "children": []
    },
    "b-sks-rc-evidence-shape-example-note-1": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "fact_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the owning claim — this row was written in the same write as that fact, and an overwrite or clear of the fact replaces or deletes it."
        }
      ],
      "id": "b-sks-rc-evidence-shape-example-note-1",
      "children": []
    },
    "b-sks-rc-evidence-shape-example-note-2": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "locator",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": the payload "
        },
        {
          "insert": "1123581321",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a "
        },
        {
          "insert": "discord_message.id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; no "
        },
        {
          "insert": "digest",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because the Discord archive is immutable — the locator cannot drift."
        }
      ],
      "id": "b-sks-rc-evidence-shape-example-note-2",
      "children": []
    },
    "b-sks-rc-evidence-shape-example-note-3": {
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "why",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": what this one message shows; the owning fact's "
        },
        {
          "insert": "rationale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " argues the claim across all of its citations."
        }
      ],
      "id": "b-sks-rc-evidence-shape-example-note-3",
      "children": []
