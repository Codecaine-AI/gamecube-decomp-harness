    "b-sks-rc-events-shape": {
      "id": "b-sks-rc-events-shape",
      "type": "state-shape",
      "props": {
        "name": "event",
        "description": "Exceptions only; append-only: a row is never edited or removed. No outcome column — outcomes live on worker_run.final_outcome and pull_request.outcome.",
        "fields": [
          {
            "name": "id",
            "type": "event id",
            "description": "Primary key"
          },
          {
            "name": "target_id",
            "type": "target id",
            "description": "FK → target; whose ledger"
          },
          {
            "name": "kind",
            "type": "regression | note",
            "description": "What happened; see the enum table below — only `note` is written today"
          },
          {
            "name": "cause",
            "type": "merge_conflict | upstream_change",
            "required": false,
            "description": "Why the regression; present exactly when `kind` is `regression`, absent on a `note`; see the enum table below"
          },
          {
            "name": "summary",
            "type": "string",
            "description": "One line addressed to the next worker, templated from the event's refs — never model-written; shown highlighted in the derived ledger view"
          },
          {
            "name": "created_at",
            "type": "timestamp",
            "description": "Ledger order; the derived view sorts newest first"
          }
        ],
        "example": "[\n  {\n    \"id\": \"evt-000358\",\n    \"target_id\": \"tgt-ftCo_800BFFD0\",\n    \"kind\": \"regression\",\n    \"cause\": \"merge_conflict\",\n    \"summary\": \"you got 100 % in wr-ftCo_800BFFD0-0007, then the epoch-9 boundary merge conflicted on ftcommon.c and undid it; blend that run's code back into the current tree\",\n    \"created_at\": \"2026-08-14T09:02:11Z\"\n  },\n  {\n    \"id\": \"evt-000420\",\n    \"target_id\": \"tgt-ftCo_800BFFD0\",\n    \"kind\": \"note\",\n    \"summary\": \"the guard order here mirrors ftCo_800C0F44; check that function's submissions before reworking the branches\",\n    \"created_at\": \"2026-08-19T16:44:07Z\"\n  }\n]"
      },
      "children": []
    },
