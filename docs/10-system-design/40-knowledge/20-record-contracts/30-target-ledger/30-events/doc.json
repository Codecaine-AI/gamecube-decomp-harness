      "text": [
        {
          "insert": "The ledger a worker reads is a derived view, never rows: "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows joined to their "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, merged with the "
        },
        {
          "insert": "pull_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows and the "
        },
        {
          "insert": "event",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows, newest first, conflicted runs highlighted with their conflict paths (up to 10). The target card shows this view FIRST. An event is one line — "
        },
        {
          "insert": "created_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and its "
        },
        {
          "insert": "event_ref",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ids — and the worker follows an event's "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ref into the "
        },
        {
          "insert": "worker_run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "submission",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows when it needs the scored tries. Storing an event does not make it knowledge: what a break taught becomes a live "
        },
        {
          "insert": "fact",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row for the target — the librarian overwrites the row in place, and the fact's "
        },
        {
          "insert": "evidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows carry the citations: "
        },
        {
          "insert": "attempt://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "pr://",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " locators into the runs and PRs, never the event row itself."
        }
      ],
