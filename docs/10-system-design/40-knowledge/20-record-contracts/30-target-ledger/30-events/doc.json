    "b-sks-rc-events-example-heading": {
      "id": "b-sks-rc-events-example-heading",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example — 100 % match, then a conflicted integration at the boundary"
        }
      ],
      "children": []
    },
    "b-sks-rc-events-example-process": {
      "id": "b-sks-rc-events-example-process",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "The run closes at 100 % match",
            "steps": [
              {
                "text": "The summary agent inserts `worker_run` A for target X and its `submission` rows; `final_outcome` `match`."
              },
              {
                "text": "No `event` row: the good news is visible in `target_status` and in A's submissions.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The boundary merge conflicts on X's file",
            "steps": [
              {
                "text": "The run-closed writer records the result on A itself: `integration` `conflicted` and `integration_detail` { `status` `resolved`, `disposition`, `conflict_paths` [\"src/melee/ft/ftcommon.c\"], `failure_reasons` [], `resolved_at` }, derived from run state's integration rows. No `event` row is inserted; the run-loop requeues X for the next epoch."
              },
              {
                "text": "No agent attempts an in-flight fix. The conflicted hunks, the queue state, and the requeue are run state, not rows here.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The next scored report upserts `target_status` for X; the ledger view still shows A as the latest run."
          },
          {
            "text": "The next worker reads X's derived ledger first",
            "steps": [
              {
                "text": "Newest entry: A, shown conflicted with its conflict paths. It follows A's `submission` rows, takes the working code, and blends it into the current tree instead of re-deriving it.",
                "kind": "note"
              }
            ]
          },
          {
            "text": "The librarian reads A (its `integration_detail` is in the run_closed digest) and X's `note` rows; if the break revealed reusable knowledge, it overwrites the affected live `fact` rows for X in place. A confident claim about why the match was fragile is a `state_behavior` or `purpose` fact with a rationale and evidence citations."
          }
        ]
      },
      "children": []
    },
