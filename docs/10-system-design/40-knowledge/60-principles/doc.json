					"Drift model"
				],
				"rows": [
					[
						"Derived",
						"Code graph, computed indexes, and target profiles",
						"Current inputs plus deterministic builders",
						"Rebuild replaces the projection"
					],
					[
						"Corpus",
						"Raw mirrored SmashWiki text",
						"Upstream source as captured by sync",
						"Only staleness against upstream"
					],
					[
						"Events",
