		},
		"b-55-kgr-35-50-2": {
			"id": "b-55-kgr-35-50-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "For one target, the attempt ledger retrieves prior upstream-PR, worker-run, and QA-repair work together with the tactics tried and their graded outcomes. Attempts are append-only evidence; tactics are re-extractable views over that evidence, not a separate store."
				}
			],
			"children": []
		},
		"b-attempt-intake-table": {
			"id": "b-attempt-intake-table",
			"type": "structured-table",
			"props": {
				"columns": [
					"Attempt kind",
					"Provenance",
					"Source evidence"
				],
				"rows": [
					[
						"upstream_pr",
						"inferred",
						"Final diff, PR description, review comments, and postmortem; intermediate failures may be absent"
					],
					[
						"worker_run",
						"observed",
						"Worker checkpoints, transcript, scores, diffs, and run state"
					],
					[
						"qa_repair",
						"observed",
						"Repair checkpoints, transcript, gate results, and diff"
					]
				]
			},
			"children": []
		},
		"b-55-kgr-35-50-4": {
			"id": "b-55-kgr-35-50-4",
			"type": "state-shape",
			"props": {
				"name": "AttemptRecord",
				"fields": [
					{
						"name": "id",
						"type": "string"
					},
					{
						"name": "kind",
						"type": "\"upstream_pr\" | \"worker_run\" | \"qa_repair\""
					},
					{
						"name": "provenance",
						"type": "\"observed\" | \"inferred\""
					},
					{
						"name": "actor",
						"type": "string"
					},
					{
						"name": "at",
						"type": "string"
					},
					{
						"name": "targets",
						"type": "TargetResult[]"
					},
					{
						"name": "outcome",
						"type": "\"merged\" | \"rejected\" | \"partial\" | \"failed\" | \"abandoned\""
					},
					{
						"name": "failure_class",
						"type": "string | null"
					},
					{
						"name": "tactics",
						"type": "TacticOutcome[]",
						"fields": [
							{
								"name": "tactic",
								"type": "string"
							},
							{
								"name": "outcome",
								"type": "\"failed\" | \"partial\" | \"success\""
							},
							{
								"name": "at",
								"type": "string"
							},
							{
								"name": "evidence",
								"type": "string"
							}
						]
					},
					{
						"name": "learnings_produced",
						"type": "string[]"
					},
					{
						"name": "learnings_relied_on",
						"type": "LearningVerdict[]"
					},
					{
						"name": "evidence_refs",
						"type": "string[]"
					},
					{
						"name": "extraction",
						"type": "object",
						"fields": [
							{
								"name": "by",
								"type": "string"
							},
							{
								"name": "at",
								"type": "string"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-attempt-tactics-heading": {
			"id": "b-attempt-tactics-heading",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Tactic View"
				}
			],
			"children": []
		},
		"b-attempt-tactic-shape": {
			"id": "b-attempt-tactic-shape",
			"type": "state-shape",
			"props": {
				"name": "Tactic",
				"fields": [
					{
						"name": "id",
						"type": "string"
					},
					{
						"name": "category",
						"type": "string"
					},
					{
						"name": "signature",
						"type": "string"
					},
					{
						"name": "description",
						"type": "string"
					},
					{
						"name": "validated_on",
						"type": "TacticValidation[]",
						"fields": [
							{
								"name": "attempt",
								"type": "string"
							},
							{
								"name": "outcome",
								"type": "\"failed\" | \"partial\" | \"success\""
							}
						]
					},
					{
						"name": "efficacy",
						"type": "number"
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-50-5": {
			"id": "b-55-kgr-35-50-5",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Maintain attempts and tactic views",
						"steps": [
							{
								"text": "Normalize PR, worker-run, and QA-repair evidence into AttemptRecord"
							},
							{
								"text": "Append the attempt to every named target slice"
							},
							{
								"text": "Re-extract tactic views from all graded outcomes"
							},
							{
								"text": "Rank tactics with failed, partial, and successful attempts in the denominator"
							},
							{
								"text": "Serve target- and symptom-keyed retrieval"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-50-6": {
			"id": "b-55-kgr-35-50-6",
			"type": "interaction-surface",
			"props": {
				"title": "Attempt and tactic queries",
				"operations": [
					{
						"name": "attemptDigest",
						"kind": "query",
						"params": [
							{
								"name": "target",
								"type": "string"
							}
						],
						"returns": "attempts for the target, siblings, and analogs"
					},
					{
						"name": "deepEvidence",
						"kind": "query",
						"params": [
							{
								"name": "attemptId",
								"type": "string"
							}
						],
						"returns": "PR comments, transcripts, checkpoints, and diffs"
					},
					{
						"name": "tacticLookup",
						"kind": "query",
						"params": [
							{
								"name": "failureClass",
								"type": "string"
							},
							{
								"name": "signature",
								"type": "string"
							}
						],
						"returns": "tactics, validating attempts, and graded efficacy"
					},
					{
						"name": "reportTactics",
						"params": [
							{
								"name": "report",
								"type": "TacticOutcome[]"
							}
						],
						"returns": "filed attempt evidence"
					}
				]
			},
			"children": []
		},
		"b-attempt-current-grounding": {
			"id": "b-attempt-current-grounding",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Worker checkpoints provide the observed score and gate history for run and repair attempts. The mismatch-pattern builder remains a weaker keyword view over curated prose; the librarian's attempt condensation supplies the tactic-to-score association used by the canonical view."
				}
			],
			"children": []
		}
	}
}
