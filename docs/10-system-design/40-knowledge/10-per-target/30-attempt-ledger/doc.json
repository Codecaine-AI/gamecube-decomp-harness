	"id": "10-system-design-40-knowledge-20-per-target-30-attempt-ledger",
	"title": "Attempt ledger",
	"root": "b-55-kgr-35-50-root",
	"blocks": {
		"b-55-kgr-35-50-root": {
			"id": "b-55-kgr-35-50-root",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": ""
				}
			],
			"children": [
				"b-55-kgr-35-50-2",
				"b-attempt-intake-table",
				"b-55-kgr-35-50-4",
				"b-attempt-tactics-heading",
				"b-attempt-tactic-shape",
