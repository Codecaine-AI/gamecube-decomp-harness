			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The code graph is the rebuildable projection that makes a target walkable. It is rebuilt from the checkout, splits, linker map, object-diff report, tool indexes, game rules, and latest ledger records; agents query it but do not write it."
				}
			],
			"children": []
		},
		"b-55-kgr-35-10-3": {
			"id": "b-55-kgr-35-10-3",
			"type": "state-shape",
			"props": {
				"name": "GraphEdge",
				"source": {
					"path": "apps/server/src/core/knowledge/graph/types.ts"
				},
				"fields": [
					{
						"name": "id",
						"type": "string"
					},
					{
						"name": "edgeType",
						"type": "\"COMPILES_TO\" | \"CONTAINS\" | \"CALLS\" | \"REFERENCES_DATA\" | \"ANALOGOUS_TO\" | \"SIBLING_OF\" | \"HAS_LEARNING\""
					},
					{
						"name": "fromEntityId",
						"type": "string"
					},
					{
						"name": "toEntityId",
						"type": "string"
					},
					{
						"name": "sourceVersionId",
						"type": "string"
					},
					{
						"name": "evidenceRef",
						"type": "string"
					},
					{
						"name": "weight",
						"type": "number"
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-10-4": {
			"id": "b-55-kgr-35-10-4",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Rebuild the target graph",
						"steps": [
							{
								"text": "Read checkout, split, map, report, configured indexes, and ledger inputs"
							},
							{
								"text": "Emit entities, facts, search chunks, and uniquely resolved edges"
							},
							{
								"text": "Swap the graph store as one projection"
							},
							{
								"text": "Derive target cards and related-function digests for workers"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-10-5": {
			"id": "b-55-kgr-35-10-5",
			"type": "interaction-surface",
			"props": {
				"title": "Code-graph queries",
				"operations": [
					{
						"name": "targetCard",
						"kind": "query",
						"params": [
							{
								"name": "file",
								"type": "string"
							}
						],
						"returns": "functions, match state, editability, and attached facts"
					},
					{
						"name": "oneHopDigest",
						"kind": "query",
						"params": [
							{
								"name": "symbol",
								"type": "string"
							}
						],
						"returns": "callers, callees, data refs, analogs, and siblings"
					},
					{
						"name": "multiHopWalk",
						"kind": "query",
						"params": [
							{
								"name": "symbol",
								"type": "string"
							},
							{
								"name": "edgeKinds",
								"type": "string[]"
							},
							{
								"name": "depth",
								"type": "number"
							}
						],
						"returns": "evidence-bearing graph paths"
					}
				]
