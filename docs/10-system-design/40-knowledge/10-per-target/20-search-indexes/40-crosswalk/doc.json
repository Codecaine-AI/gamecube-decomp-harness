		"b-55-kgr-35-70-2": {
			"id": "b-55-kgr-35-70-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The crosswalk mechanically maps target path families to SmashWiki page titles. It covers fighter, stage, and item families; weakly mapped if, mn, and lb areas stay outside the table."
				}
			],
			"children": []
		},
		"b-crosswalk-scope-table": {
			"id": "b-crosswalk-scope-table",
			"type": "structured-table",
			"props": {
				"columns": [
					"Family",
					"Included",
					"Excluded"
				],
				"rows": [
					[
						"ft",
						"Character directories and move-specific page titles",
						"Non-character ft paths without stable wiki counterparts"
					],
					[
						"gr",
						"Stage paths with stable stage pages",
						"Unmapped stage support paths"
					],
					[
						"it",
						"Item paths with stable item pages",
						"Internal item helpers without stable pages"
					]
				]
			},
			"children": []
		},
		"b-55-kgr-35-70-3": {
			"id": "b-55-kgr-35-70-3",
			"type": "state-shape",
			"props": {
				"name": "CrosswalkEntry",
				"fields": [
					{
						"name": "path_prefix",
						"type": "string"
					},
					{
						"name": "page_titles",
						"type": "string[]"
					},
					{
						"name": "family",
						"type": "\"ft\" | \"gr\" | \"it\""
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-70-4": {
			"id": "b-55-kgr-35-70-4",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Resolve corpus context for a target",
						"steps": [
							{
								"text": "Refresh the local wiki mirror during sync"
							},
							{
								"text": "Regenerate crosswalk rows from path conventions"
							},
							{
								"text": "Resolve the target path to page titles at boot"
							},
							{
								"text": "Fetch only relevant sections on demand"
							},
							{
								"text": "Attach fetched sections as learning evidence"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-70-5": {
			"id": "b-55-kgr-35-70-5",
			"type": "interaction-surface",
			"props": {
				"title": "Corpus and crosswalk queries",
				"operations": [
					{
						"name": "resolveCrosswalk",
						"kind": "query",
						"params": [
							{
								"name": "path",
								"type": "string"
							}
						],
						"returns": "SmashWiki page titles"
					},
					{
						"name": "searchCorpus",
						"kind": "query",
						"params": [
							{
								"name": "keywords",
								"type": "string[]"
							}
						],
						"returns": "matching sections"
					},
					{
						"name": "fetchSection",
						"kind": "query",
						"params": [
							{
								"name": "page",
								"type": "string"
							},
							{
								"name": "section",
								"type": "string"
							}
						],
						"returns": "raw section text"
					}
				]
			},
			"children": []
		}
	}
}
