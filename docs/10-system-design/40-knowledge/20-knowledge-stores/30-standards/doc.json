			"props": {},
			"text": [
				{
					"insert": "Standards are QA-owned, deliberately authored rules injected at worker boot and enforced at the ship gate. Their enforcement loop makes stale guidance visible when a real patch violates or outgrows a rule."
				}
			],
			"children": []
		},
		"b-55-kgr-35-80-3": {
			"id": "b-55-kgr-35-80-3",
			"type": "state-shape",
			"props": {
				"name": "Standard",
				"fields": [
					{
						"name": "id",
						"type": "string"
					},
					{
						"name": "statement",
						"type": "string"
					},
					{
						"name": "owner",
						"type": "string"
					},
					{
						"name": "examples",
						"type": "Example[]",
						"fields": [
							{
								"name": "kind",
								"type": "\"preferred\" | \"rejected\""
							},
							{
								"name": "source_ref",
								"type": "string"
							},
							{
								"name": "note",
								"type": "string",
								"required": false
							}
						]
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-80-4": {
			"id": "b-55-kgr-35-80-4",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Apply and improve standards",
						"steps": [
							{
								"text": "Inject global standards into the worker context"
							},
							{
								"text": "Enforce mechanical rules at the ship gate"
							},
							{
								"text": "Record rejected patterns as evidence-bearing examples"
							},
							{
								"text": "A recurring tactic may motivate a human-authored standard"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-55-kgr-35-80-5": {
			"id": "b-55-kgr-35-80-5",
			"type": "interaction-surface",
			"props": {
				"title": "Standards surfaces",
				"operations": [
					{
						"name": "globalStandards",
						"kind": "query",
						"returns": "standards injected at boot"
					},
					{
						"name": "shipGate",
						"kind": "event",
						"params": [
							{
								"name": "diff",
								"type": "string"
							}
						],
						"returns": "pass or rejection with an attempt and example"
					}
				]
			},
			"children": []
		},
