		"b-30-smashwiki-corpus-this-document-defines-th-1": {
			"id": "b-30-smashwiki-corpus-this-document-defines-th-1",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The SmashWiki corpus is a local mirror of raw upstream pages searched directly by workers. Sync refreshes the mirror; workers resolve likely titles at boot, search by keyword, and fetch only relevant sections as evidence."
				}
			],
			"children": []
		},
		"b-smashwiki-drift": {
			"id": "b-smashwiki-drift",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Raw page text is stored verbatim, so its only drift mode is staleness against upstream. The corpus is not transformed into a second semantic store; interpreted claims belong in the knowledge ledger with section references."
				}
			],
			"children": []
		},
		"b-smashwiki-operations": {
			"id": "b-smashwiki-operations",
			"type": "interaction-surface",
			"props": {
				"title": "SmashWiki corpus operations",
				"operations": [
					{
						"name": "smashwiki_search",
						"kind": "query",
						"params": [
							{
								"name": "query",
								"type": "string"
							}
						],
						"returns": "matching pages and sections"
					},
					{
						"name": "smashwiki_get_page",
						"kind": "query",
						"params": [
							{
								"name": "page",
								"type": "string"
							},
							{
								"name": "section",
								"type": "string",
								"required": false
							}
						],
						"returns": "raw page or section text"
					}
				]
			},
			"children": []
		}
	}
}
