		"b-10-knowledge-ledger-this-document-defines-th-1": {
			"id": "b-10-knowledge-ledger-this-document-defines-th-1",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The knowledge ledger is the live durable source of truth for human-extracted and AI-inferred statements. Its JSONL records feed the librarian, SQLite FTS5 search, collection and detail APIs, the dashboard, and target-anchored graph projection."
				}
			],
			"children": []
		},
		"b-10-knowledge-ledger-state-shape-block-35": {
			"id": "b-10-knowledge-ledger-state-shape-block-35",
			"type": "state-shape",
			"props": {
				"name": "LearningRecord",
				"source": {
					"path": "apps/server/src/core/knowledge/ledger.ts",
					"symbol": "LearningRecord"
				},
				"fields": [
					{
