						"type": "string"
					},
					{
						"name": "statement",
						"type": "string"
					},
					{
						"name": "subject",
						"type": "object",
						"fields": [
							{
								"name": "scope",
								"type": "\"symbol\" | \"file\" | \"area\" | \"general\""
							},
							{
								"name": "symbol",
								"type": "string",
								"required": false
							},
							{
								"name": "file",
								"type": "string",
								"required": false
							},
							{
