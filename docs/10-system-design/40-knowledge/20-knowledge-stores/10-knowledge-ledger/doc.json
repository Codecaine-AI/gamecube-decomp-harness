		"b-ledger-facts-heading": {
			"id": "b-ledger-facts-heading",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Reusable Fact Taxonomy"
				}
			],
			"children": []
		},
		"b-ledger-facts-intro": {
			"id": "b-ledger-facts-intro",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Facts are provenance-tagged statements accepted into target packets and ledger evidence. Rejected or uncertain observations remain visible so later workers can avoid repeating low-value guesses."
				}
			],
			"children": []
		},
		"b-ledger-facts-table": {
			"id": "b-ledger-facts-table",
			"type": "structured-table",
			"props": {
				"columns": [
					"Fact type",
					"Meaning"
				],
				"rows": [
					[
						"asm_duplicate_group",
						"Normalized assembly group with matched references and unmatched candidates"
					],
					[
						"source_shape_pattern",
						"Declaration order, branch shape, helper inline shape, loop form, or pragma behavior that improved a target"
					],
					[
						"type_or_field_hint",
						"Struct field, accessor, callback signature, table type, or data-ownership statement"
					],
					[
						"negative_result",
						"Capability or hypothesis that preserved a mismatch or caused regressions"
					],
					[
						"integration_fact",
						"Accepted patch, score delta, validation commands, and affected graph neighbors"
					]
				]
			},
			"children": []
		},
		"b-ledger-controls-heading": {
			"id": "b-ledger-controls-heading",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Drift and Acceptance Controls"
				}
			],
			"children": []
		},
		"b-ledger-controls-table": {
			"id": "b-ledger-controls-table",
			"type": "structured-table",
			"props": {
				"columns": [
					"Control",
					"Contract"
				],
				"rows": [
					[
						"Evidence",
						"Every accepted statement carries inspectable evidence references"
					],
					[
						"Anchor",
						"Symbol and file statements carry current subjects and may carry content hashes"
					],
					[
						"Lifecycle",
						"Proposed records become corroborated, refuted, or stale through librarian judgment and rebuild checks"
					],
					[
						"Projection",
						"Refuted records are excluded; unresolved present anchors project as stale"
					],
					[
						"Graduation",
						"The type reserves graduated for knowledge hardened into upstream code, but the operative automated lifecycle does not assign it"
					]
				]
			},
			"children": []
		},
		"b-10-knowledge-ledger-process-outline-block-41": {
			"id": "b-10-knowledge-ledger-process-outline-block-41",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Publish and consume a learning",
						"steps": [
							{
								"text": "Classify a human-extracted or AI-inferred statement and attach evidence"
							},
							{
								"text": "The librarian validates and writes the latest record"
							},
							{
								"text": "Refresh FTS when searchable freshness is required"
							},
							{
								"text": "Rebuild target projection and mark unresolved anchors stale"
							},
							{
								"text": "Workers retrieve digests, search results, or complete evidence"
							}
						]
					}
				]
			},
			"children": []
		},
		"b-10-knowledge-ledger-interaction-surface-blo-49": {
			"id": "b-10-knowledge-ledger-interaction-surface-blo-49",
			"type": "interaction-surface",
			"props": {
				"title": "Knowledge-ledger surfaces",
				"operations": [
					{
						"name": "learningsDigest",
						"kind": "query",
						"params": [
							{
								"name": "file",
								"type": "string"
							}
						],
						"returns": "statements, confidence, status, and evidence pointers"
					},
					{
						"name": "ledger_search",
						"kind": "query",
						"params": [
							{
								"name": "query",
								"type": "string"
							},
							{
								"name": "scope",
								"type": "string",
								"required": false
							}
						],
						"returns": "FTS-ranked latest records"
					},
					{
						"name": "evidenceChase",
						"kind": "query",
						"params": [
							{
								"name": "learningId",
								"type": "string"
							}
						],
						"returns": "latest record and resolved evidence"
					},
					{
						"name": "emitLearnings",
						"params": [
							{
								"name": "report",
								"type": "object"
							}
						],
						"returns": "librarian intake"
					},
					{
						"name": "emitVerdicts",
						"params": [
							{
								"name": "report",
								"type": "object"
							}
						],
						"returns": "confirm or refute intake"
					}
				]
			},
			"children": []
		},
		"b-10-knowledge-ledger-as-built-ledger-storag-50": {
			"id": "b-10-knowledge-ledger-as-built-ledger-storag-50",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Storage, Search, API, and Dashboard"
				}
			],
			"children": []
		},
		"b-10-knowledge-ledger-the-ledger-is-the-durabl-51": {
			"id": "b-10-knowledge-ledger-the-ledger-is-the-durabl-51",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Readers collapse JSONL rows by ID in file order, so the latest valid record controls search and projection. Standard writes compact to one latest row per ID, while the detail API can expose multiple raw versions when they exist."
				}
			],
			"children": []
		},
		"b-ledger-live-surfaces": {
			"id": "b-ledger-live-surfaces",
			"type": "structured-table",
			"props": {
				"columns": [
					"Surface",
					"Present behavior"
				],
				"rows": [
					[
						"SQLite FTS5",
						"Indexes statement, subject fields, and evidence references; an existing index must be rebuilt after ledger changes"
					],
					[
						"Collection API",
						"Filters by text, subject, scope, origin, status, and limit"
					],
					[
						"Detail API",
						"Returns the latest record and every raw version present"
					],
					[
						"Dashboard",
						"Searches and facets records, groups by subject, and expands evidence and version details"
					]
				]
			},
			"children": []
		}
	}
