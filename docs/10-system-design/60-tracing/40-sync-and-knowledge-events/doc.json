			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Sync and knowledge events reconstruct observed inputs, staged work, blocking evidence, recovery, cancellation proof, and publication. The "
				},
				{
					"insert": "Sync Workflow",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows/10-sync"
						}
					}
				},
				{
					"insert": " worker owns its staged state copy; this page owns only the accepted facts needed to replay and explain that work."
				}
			],
			"children": []
		},
