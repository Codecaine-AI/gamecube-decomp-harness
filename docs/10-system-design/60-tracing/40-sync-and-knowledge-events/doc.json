		"b-sync-ingestion-sequence": {
			"id": "b-sync-ingestion-sequence",
			"type": "process-outline",
			"props": {
				"steps": [
					{
						"text": "Guardian settles the outgoing lease",
						"steps": [
							{
								"text": "Append game.dispatch_released and run.paused under settlement lineage."
							}
						]
					},
					{
						"text": "Successor acquires the lease",
						"steps": [
							{
								"text": "Append game.dispatch_acquired under the queued workflow lineage."
							}
						]
					},
					{
						"text": "Operator or runner begins ingestion",
						"steps": [
							{
								"text": "Append sync.ingesting; guardian is not an allowed actor."
							}
						]
					}
				]
			},
			"children": []
		},
