				"columns": [
					"Record",
					"Purpose",
					"Durable meaning"
				],
				"rows": [
					[
						"Wake event",
						"Prompt the runner to reconsider work.",
						"A handled queue signal; not an accepted game fact."
					],
					[
						"Game event",
						"Explain an accepted durable transition.",
						"Immutable registered fact joined to one state revision."
					],
					[
