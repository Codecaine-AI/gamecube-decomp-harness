		},
		"b-index-every-game-event-is-one-2": {
			"id": "b-index-every-game-event-is-one-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Every game event is one durable, game-scoped fact with workflow identity, immediate causation, accountable authorship, and trace lineage. Consumers reconstruct accepted history from events while durable state remains authoritative for the current snapshot."
				}
			],
			"children": []
		},
		"b-index-envelope-3": {
			"id": "b-index-envelope-3",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Envelope"
				}
			],
			"children": []
		},
		"b-envelope-state-shape": {
			"id": "b-envelope-state-shape",
			"type": "state-shape",
			"props": {
				"name": "GameEventEnvelope",
				"description": "The immutable header stored with every accepted game fact.",
				"fields": [
					{
						"name": "event_id",
						"type": "EventId"
					},
					{
						"name": "sequence",
						"type": "integer",
						"description": "Monotonic within one game event log."
					},
					{
						"name": "event_type",
						"type": "registered string"
					},
					{
						"name": "schema_version",
						"type": "positive integer"
					},
					{
						"name": "game_id",
						"type": "GameId"
					},
					{
						"name": "subject_kind",
						"type": "registered string"
					},
					{
						"name": "subject_id",
						"type": "string"
					},
					{
						"name": "correlation_id",
						"type": "CorrelationId"
					},
					{
						"name": "causation_id",
						"type": "CommandId | EventId"
					},
					{
						"name": "trace_id",
						"type": "TraceId"
					},
					{
						"name": "span_id",
						"type": "SpanId"
					},
					{
						"name": "parent_span_id",
						"type": "SpanId | null"
					},
					{
						"name": "actor",
						"type": "operator | runner | agent | guardian | external_observer"
					},
					{
						"name": "occurred_at",
						"type": "timestamp"
					},
					{
						"name": "payload",
						"type": "registered closed object"
					}
