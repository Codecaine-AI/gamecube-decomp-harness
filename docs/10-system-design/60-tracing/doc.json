    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Tracing connects the game's accepted history to the execution that produced it. Harness State records the current durable position. Game events explain accepted changes, and Agent Kernel records execution detail such as agent sessions, tools, and operation spans."
        }
      ],
      "children": []
    },
    "b-tracing-map": {
      "id": "b-tracing-map",
      "type": "canvas",
      "props": {
