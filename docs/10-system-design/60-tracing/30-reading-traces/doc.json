    "b-intro": {
      "id": "b-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Open the selected game's Trace page to inspect Agent Kernel execution detail. The page uses the shared "
        },
        {
          "insert": "KernelTraceViewer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for spans, agent sessions, tools, and usage."
        }
      ],
      "children": []
    },
    "b-reading-outline": {
      "id": "b-reading-outline",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "Read an execution trace",
            "steps": [
              {
                "text": "Select the game and open Trace",
                "steps": [
                  {
                    "text": "The page checks Agent Kernel availability and loads trace sessions for the selected game."
                  }
                ]
              },
              {
                "text": "Choose a trace",
                "steps": [
                  {
                    "text": "A requested trace ID takes precedence. Otherwise the page selects a running trace, then the first available trace."
                  }
                ]
              },
              {
                "text": "Inspect the execution",
                "steps": [
                  {
                    "text": "Select the relevant container and inspect its spans, agent activity, and usage in the shared viewer."
                  }
                ]
              },
              {
                "text": "Check accepted state when the outcome is unclear",
                "steps": [
                  {
                    "text": "Use the game event history and Harness State to distinguish execution activity from an accepted result."
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
    "b-selection": {
      "id": "b-selection",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Trace navigation preserves trace and container identity in the URL. The viewer builds spans from trace events, Pi sessions, and agent runs, and displays the selected container subtree. If no sessions exist for the game, the page shows "
        },
        {
          "insert": "No kernel traces recorded for this game.",
          "attributes": {
            "code": true
          }
        }
      ],
      "children": []
    },
    "b-event-api": {
      "id": "b-event-api",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Inspecting Accepted Game History"
        }
      ],
      "children": []
    },
    "b-api": {
      "id": "b-api",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The separate "
        },
        {
          "insert": "GET /api/events",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " API returns bounded, game-scoped event summaries. "
        },
        {
          "insert": "GET /api/events/reconstruct",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " requires a "
        },
        {
          "insert": "correlation_id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and adds cause information and available kernel links. These APIs support accepted-history inspection; the Trace page itself loads Agent Kernel sessions."
        }
      ],
      "children": []
    },
    "b-pagination": {
      "id": "b-pagination",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Use the returned pagination fields to continue a bounded query. The event reader supports sequence cursors and ordering. Summary payloads redact sensitive values and cap detail, so they are not raw event payload exports."
        }
      ],
      "children": []
    },
    "b-events-link": {
      "id": "b-events-link",
      "type": "paragraph",
      "props": {},
      "text": [
