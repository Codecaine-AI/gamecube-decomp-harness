		"b-index-game-event-read-api-a-1": {
			"id": "b-index-game-event-read-api-a-1",
			"type": "heading",
			"props": {
				"level": 1
			},
			"text": [
				{
					"insert": "Game Event Read API and Reconstruction"
				}
			],
			"children": []
		},
		"b-index-the-event-read-surface-2": {
			"id": "b-index-the-event-read-surface-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Trace inspection starts with bounded, game-scoped summaries and correlation reconstruction. The HTTP boundary exposes the same ordered query and safe projection without raw payloads or caller-controlled storage paths."
				}
			],
			"children": []
		},
		"b-trace-inspection-heading": {
			"id": "b-trace-inspection-heading",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Trace Inspection"
				}
			],
			"children": []
		},
		"b-query-filters-table": {
			"id": "b-query-filters-table",
			"type": "structured-table",
			"props": {
				"title": "Event query filters",
				"columns": [
					"Parameter",
					"Constraint",
					"Behavior"
				],
				"rows": [
					[
						"correlation_id",
						"Nonblank.",
						"Select one workflow lineage."
					],
					[
						"subject_kind + subject_id",
						"Both present; registered kind and nonblank identity.",
						"Select one subject stream."
					],
					[
						"event_type_prefix",
						"Nonblank literal.",
						"Select registered event families by prefix."
					],
					[
						"from_sequence + to_sequence",
						"Inclusive safe integers; from ≤ to.",
						"Bound a sequence range."
					],
					[
						"after_sequence",
						"Nonnegative safe integer.",
						"Continue after the prior page."
					],
					[
						"limit",
						"1–200; default 50.",
						"Return at most limit events; never clamp."
					]
				],
				"density": "compact"
			},
			"children": []
		},
		"b-page-shape": {
			"id": "b-page-shape",
			"type": "state-shape",
			"props": {
				"name": "EventPage",
				"description": "The bounded ordered projection returned by event inspection.",
				"fields": [
					{
						"name": "events",
						"type": "SafeEventSummary[]"
					},
					{
						"name": "has_more",
						"type": "boolean"
					},
					{
						"name": "next_after_sequence",
						"type": "integer | null"
					}
				],
				"example": "{\n  \"events\": [],\n  \"has_more\": false,\n  \"next_after_sequence\": null\n}"
			},
			"children": []
		},
		"b-query-ordering": {
			"id": "b-query-ordering",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Queries are game-scoped and ordered by sequence ascending. The reader fetches limit + 1 rows, returns at most limit, and exposes the last returned sequence only when another row exists."
				}
			],
			"children": []
		},
		"b-index-safe-summary-projection-10": {
			"id": "b-index-safe-summary-projection-10",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Safe Summary Projection"
				}
			],
			"children": []
		},
		"b-summary-shape": {
			"id": "b-summary-shape",
			"type": "state-shape",
			"props": {
				"name": "SafeEventSummary",
				"description": "A redacted event header plus bounded payload summary.",
				"fields": [
					{
						"name": "event_id",
						"type": "EventId"
					},
					{
						"name": "sequence",
						"type": "integer"
					},
					{
						"name": "event_type",
						"type": "string"
					},
					{
						"name": "subject",
						"type": "SubjectIdentity"
					},
					{
						"name": "correlation_id",
						"type": "CorrelationId"
					},
					{
						"name": "causation_id",
						"type": "CommandId | EventId"
					},
					{
						"name": "trace",
						"type": "TraceLineage"
					},
					{
						"name": "actor",
						"type": "Actor"
					},
					{
						"name": "occurred_at",
						"type": "timestamp"
					},
					{
						"name": "payload_summary",
						"type": "redacted object"
					}
				]
			},
			"children": []
		},
		"b-index-the-summary-admits-only-12": {
			"id": "b-index-the-summary-admits-only-12",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Credential-shaped values and filesystem fields are redacted. Projection is capped at depth 4, 64 entries, 256 characters per string, and 4096 serialized bytes; capped summaries carry _truncated: true."
				}
			],
			"children": []
		},
		"b-index-reconstruction-13": {
			"id": "b-index-reconstruction-13",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "Correlation Reconstruction"
				}
			],
			"children": []
		},
		"b-cause-shape": {
			"id": "b-cause-shape",
			"type": "state-shape",
			"props": {
				"name": "caused_by",
				"description": "Same-game event identities resolve to event causes; every other causation token remains a command cause.",
				"fields": [
					{
						"name": "event",
						"type": "{ kind: event, event_id, sequence, event_type, correlation_id, subject_kind, subject_id }"
					},
					{
						"name": "command",
						"type": "{ kind: command, command_id }"
					}
				]
			},
			"children": []
		},
		"b-reconstruction-contract": {
			"id": "b-reconstruction-contract",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Reconstruction requires correlation_id, preserves ascending order, and returns zero, one, or many kernel links. Empty history is a successful empty page, not a missing-resource response."
				}
			],
			"children": []
		},
		"b-index-route-boundary-3": {
			"id": "b-index-route-boundary-3",
			"type": "heading",
			"props": {
				"level": 2
			},
			"text": [
				{
					"insert": "HTTP Boundary"
				}
			],
			"children": []
		},
		"b-response-outcomes": {
			"id": "b-response-outcomes",
			"type": "structured-table",
			"props": {
				"title": "Exact response outcomes",
				"columns": [
					"Outcome",
					"Status",
					"Body or behavior"
				],
				"rows": [
					[
						"Valid query or empty reconstruction",
						"200",
						"Bounded projection; empty events and traces are valid."
					],
					[
						"Invalid context, filter, cursor, or unsafe override",
						"400",
						"Sanitized specific validation error."
					],
					[
						"Recognized route with non-GET method",
						"405",
						"method not allowed plus Allow: GET."
					],
					[
						"Unknown path",
						"outer router",
						"No route-local 404."
					],
					[
						"Storage, payload, linkage, or reconstruction failure",
						"500",
						"Game event read failed; no internal detail."
					]
				],
				"density": "compact"
			},
			"children": []
		}
	}
