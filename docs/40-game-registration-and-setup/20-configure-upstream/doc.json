    "checkout-intro": {
      "id": "checkout-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Clone the required upstream decompilation repository into the game's checkout directory. Follow that project's build instructions to produce a local baseline, then register the paths and build settings in "
        },
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Use the Game Model's configuration contract when filling in these settings."
        }
      ],
      "children": []
    },
    "checkout-sms-branch": {
      "id": "checkout-sms-branch",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Set "
        },
        {
          "insert": "baseRef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to the upstream branch used by the selected project. Keep the harness game ID separate from the upstream build target ID, which may identify a particular region and revision. Do not copy another game's target, compiler pins, or build commands without checking them."
        }
      ],
      "children": []
    },
    "adb714cc-946d-49f9-824e-9f68a10462dc": {
      "id": "adb714cc-946d-49f9-824e-9f68a10462dc",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two build conventions are derived rather than configured. The build layout (object paths under "
        },
        {
          "insert": "build/<version>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", plus "
        },
        {
          "insert": "config/<version>/symbols.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "splits.txt",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") comes from the directory of "
        },
        {
          "insert": "validation.reportPath",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so "
        },
        {
          "insert": "build/GMSJ01/report.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " yields "
        },
        {
          "insert": "build/GMSJ01/src/...o",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The default "
        },
        {
          "insert": "configure.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " command comes from the game "
        },
        {
          "insert": "kind",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "doldecomp-melee",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps "
        },
        {
          "insert": "python3 configure.py --require-protos",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; other kinds use "
        },
        {
          "insert": "python3 configure.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Wrapper flags such as "
        },
        {
          "insert": "--wrapper build/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are appended by the tool platform. Explicit run settings ("
        },
        {
          "insert": "workerConfigureCommand",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "epochConfigureCommand",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") override the derived default. These derivations are computed at call time and do not change the pinned configuration revision."
        }
      ],
      "children": []
    },
    "sweep-83863eb80867423a": {
      "id": "sweep-83863eb80867423a",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Descriptor Discovery"
        }
      ],
      "children": []
    },
    "sweep-d9b2806681f14780": {
      "id": "sweep-d9b2806681f14780",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Create "
        },
        {
          "insert": "games/<id>/game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with a matching "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "resolveGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selects an explicit game ID, the configured "
        },
        {
          "insert": "defaultGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or the sole descriptor directory. Multiple candidates without a default fail. A directory without "
        },
        {
          "insert": "game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not a registered game."
        }
      ],
      "children": []
    },
    "739f7623-c162-46ea-aa27-e2f011beb5e9": {
      "id": "739f7623-c162-46ea-aa27-e2f011beb5e9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Before registering a second game, set "
        },
        {
          "insert": "games/config.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to preserve the intended "
        },
        {
          "insert": "defaultGame",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A workspace with one descriptor can resolve that game implicitly. Adding another descriptor without a default makes implicit resolution fail, including dashboard default-game lookup. Keep existing processes on their explicit game ID and preserve their checkout and runtime paths."
        }
      ],
      "children": []
    },
    "sweep-eaa29256ae6d47d5": {
      "id": "sweep-eaa29256ae6d47d5",
      "type": "structured-table",
      "props": {
        "columns": [
          "Layer",
          "Resolution"
        ],
        "rows": [
          [
            "game.json and config references",
            "Build, sandbox, and tools references load from game-relative files. Inline section values override referenced values. config.build hydrates validation."
          ],
          [
            "config/local.json",
            "Optional local overrides merge over the descriptor."
          ],
          [
            "Explicit overrides",
            "Highest precedence. Explicit path overrides resolve from explicitOverrideBaseDir or the current directory."
          ]
        ]
      },
      "children": []
    },
    "sweep-b95135d32c45403f": {
      "id": "sweep-b95135d32c45403f",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Resolved Configuration"
        }
      ],
      "children": []
    },
    "sweep-2e832693ab9f4e5d": {
      "id": "sweep-2e832693ab9f4e5d",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Descriptor-relative paths resolve against the game directory. Defaults are "
        },
        {
          "insert": "workspace/checkout",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "runtime/state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "knowledge/graph/graph.sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "config/local.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Required consumers use these resolved paths rather than guessing another checkout or store."
        }
      ],
      "children": []
    },
    "sweep-b52402a0c9e64f32": {
      "id": "sweep-b52402a0c9e64f32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The process name defaults to "
        },
        {
          "insert": "<gameId>-live",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "baseRef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defaults to "
        },
        {
          "insert": "origin/master",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Set an explicit base ref when the upstream project uses a different branch. Runtime consumers receive explicit resolved checkout, state, graph, environment, and tool-data paths."
        }
      ],
      "children": []
    },
    "sweep-911f6c86cc964f3c": {
      "id": "sweep-911f6c86cc964f3c",
