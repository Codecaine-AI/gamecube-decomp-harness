    "pm-msxhz2hq-733-450uag": {
      "id": "pm-msxhz2hq-733-450uag",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Gamecube Decomp Harness, is a purpose built multi agent system designed to complete decompilation of gamecube games"
        }
      ],
      "children": []
    },
    "b-00-overview-north-star-4": {
      "id": "b-00-overview-north-star-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "North Star"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-734-17j4tk": {
      "id": "pm-msxhz2hq-734-17j4tk",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The only objective we care about is Exact Code match percentage, all work should be moving towards getting a game to 100% exact match code"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-735-mlspqp": {
      "id": "pm-msxhz2hq-735-mlspqp",
      "type": "heading",
      "props": {
        "level": 1
      },
      "text": [
        {
          "insert": "Core Idea"
        }
      ],
      "children": []
    },
    "b-10-core-idea-intelligent-brute-force-13": {
      "id": "b-10-core-idea-intelligent-brute-force-13",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Intelligent Brute Force"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-736-n81hwo": {
      "id": "pm-msxhz2hq-736-n81hwo",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "This system is heavily inspired by the work the brought about Project Glasswing"
        }
      ],
      "children": [
        "pm-msxhz2hq-737-18bov2",
        "pm-msxhz2hq-738-476b9r"
      ]
    },
    "pm-msxhz2hq-737-18bov2": {
      "id": "pm-msxhz2hq-737-18bov2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "How do you use a huge number of agents to complete a very low level hard to complete task"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-738-476b9r": {
      "id": "pm-msxhz2hq-738-476b9r",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Mythos / Glasswing was security, this system is decompiling code"
        }
      ],
      "children": []
    },
    "b-10-core-idea-the-idea-here-is-we-can-14": {
      "id": "b-10-core-idea-the-idea-here-is-we-can-14",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The idea here is we can \"brute force\" this problem by running a large number of parallel agents on the code"
        }
      ],
      "children": [
        "pm-msxhz2hq-739-h1t6l2",
        "pm-msxhz2hq-740-y91ypy"
      ]
    },
    "pm-msxhz2hq-739-h1t6l2": {
      "id": "pm-msxhz2hq-739-h1t6l2",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Many agents will find nothing, some will find a match or improvement"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-740-y91ypy": {
      "id": "pm-msxhz2hq-740-y91ypy",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Loop this enough times and you should achieve 100%"
        }
      ],
      "children": []
    },
    "b-10-core-idea-think-like-sudoku-2": {
      "id": "b-10-core-idea-think-like-sudoku-2",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Think Like Sudoku"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-741-7cqyrm": {
      "id": "pm-msxhz2hq-741-7cqyrm",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The key design decision that this system implements is to treat the process of Decomp like completing a sudoku puzzle"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-742-vzlwc5": {
      "id": "pm-msxhz2hq-742-vzlwc5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "This in the sense that you cannot force figuring out a square in Sudoku without finding out other information on the board"
        }
      ],
      "children": [
        "pm-msxhz2hq-743-kbappw"
      ]
    },
    "pm-msxhz2hq-743-kbappw": {
      "id": "pm-msxhz2hq-743-kbappw",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The idea here that seemingly unconnected sections of the board massively influence eachother / provide information about each other"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-744-oh6y89": {
      "id": "pm-msxhz2hq-744-oh6y89",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Moving this logic to decomp"
        }
      ],
      "children": [
        "pm-msxhz2hq-745-6nrndq",
        "pm-msxhz2hq-746-ilfici",
        "pm-msxi7m2v-11-7hod6w",
        "pm-msxi8u7y-14-bo85nt"
      ]
    },
    "pm-msxhz2hq-745-6nrndq": {
      "id": "pm-msxhz2hq-745-6nrndq",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "There are hundreds of files and thousands of targets / functions within those files"
        }
      ],
      "children": []
    },
    "pm-msxhz2hq-746-ilfici": {
      "id": "pm-msxhz2hq-746-ilfici",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Finding a match in a given file may then give information of a completely disjoint file"
        }
      ],
      "children": [
        "pm-msxhz2hq-747-v52c58"
      ]
    },
    "pm-msxhz2hq-747-v52c58": {
      "id": "pm-msxhz2hq-747-v52c58",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Naming conventions, data control, etc "
        }
      ],
      "children": []
    },
    "pm-msxi7m2v-11-7hod6w": {
      "id": "pm-msxi7m2v-11-7hod6w",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Pairing this with a shared knowledge base, the workers can find new facts and find bits of improvement each round"
        }
      ],
      "children": []
    },
    "pm-msxi8u7y-14-bo85nt": {
      "id": "pm-msxi8u7y-14-bo85nt",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Think of this like a death of thousand cuts "
        }
      ],
      "children": []
    },
    "b-10-core-idea-process-4": {
      "id": "b-10-core-idea-process-4",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Process in Detail"
        }
      ],
      "children": []
    },
    "b-10-core-idea-humans-have-patterns-tha-5": {
      "id": "b-10-core-idea-humans-have-patterns-tha-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Humans have patterns that we operate in"
        }
      ],
      "children": [
        "b-10-core-idea-ex-humans-will-copy-and-6"
      ]
    },
    "b-10-core-idea-ex-humans-will-copy-and-6": {
      "id": "b-10-core-idea-ex-humans-will-copy-and-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "EX, humans will copy and paste code, use the same formatting for writing different functions"
        }
      ],
      "children": []
    },
    "b-10-core-idea-a-worker-agent-will-proc-7": {
      "id": "b-10-core-idea-a-worker-agent-will-proc-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A worker agent will process and get a new match / improvement"
        }
      ],
      "children": [
        "b-10-core-idea-a-worker-finding-a-fact-8",
        "b-10-core-idea-a-struct-field-source-s-9"
      ]
    },
    "b-10-core-idea-a-worker-finding-a-fact-8": {
      "id": "b-10-core-idea-a-worker-finding-a-fact-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A worker finding a fact does not always finish the file it is holding."
        }
      ],
      "children": []
    },
    "b-10-core-idea-a-struct-field-source-s-9": {
      "id": "b-10-core-idea-a-struct-field-source-s-9",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A struct field, source shape, duplicate pattern, naming convention, etc"
        }
      ],
      "children": []
    },
    "b-10-core-idea-this-then-can-be-used-to-10": {
      "id": "b-10-core-idea-this-then-can-be-used-to-10",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "This then can be used to inform the other functions / targets"
        }
      ],
      "children": []
    },
    "b-10-core-idea-we-build-a-shared-knowle-11": {
      "id": "b-10-core-idea-we-build-a-shared-knowle-11",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "We build a shared knowledge base that all the workers can access"
        }
      ],
      "children": [
        "b-10-core-idea-they-search-for-useful-i-12"
      ]
    },
    "b-10-core-idea-they-search-for-useful-i-12": {
      "id": "b-10-core-idea-they-search-for-useful-i-12",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "They search for useful info from files that seem disjoint, but contain information that allows for the system find matches"
        }
      ],
      "children": []
    }
  }
}
