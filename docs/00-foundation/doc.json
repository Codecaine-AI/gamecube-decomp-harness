      "children": []
    },
    "b-00-overview-d-comp-orchestrator-coor-3": {
      "id": "b-00-overview-d-comp-orchestrator-coor-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "D-Comp Orchestrator coordinates Melee decompilation work across a durable board\nof targets, facts, leases, and agent reports. It is not a replacement for the\nMelee toolchain. It is the runtime that decides which bounded unit of work is\nworth attempting next, records what happened, and keeps useful evidence moving\nthrough the run."
        }
      ],
      "children": []
    },
    "b-00-overview-north-star-4": {
      "id": "b-00-overview-north-star-4",
      "type": "heading",
