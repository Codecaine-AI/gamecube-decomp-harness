    "b-00-overview-d-comp-orchestrator-purp-2": {
      "id": "b-00-overview-d-comp-orchestrator-purp-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "D-Comp Orchestrator purpose, principles, and non-goals."
