        }
      ],
      "children": []
    },
    "b-doc-knowledge-freshness-show-2": {
      "id": "b-doc-knowledge-freshness-show-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge freshness shows the published revision and queued, processing, and failed work. Event rows explain accepted history while the state revision remains the source of current truth. Stale snapshots trigger refresh instead of local reconciliation."
        }
      ],
      "children": []
    }
  }
}
