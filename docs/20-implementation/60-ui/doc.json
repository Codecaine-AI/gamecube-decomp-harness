    "b-hsw-role-2": {
      "id": "b-hsw-role-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The harness state workspace hydrates the server-owned HarnessStateView and renders current authority, freshness, and operator controls without re-deriving state."
        }
      ],
      "children": []
    },
    "b-hsw-dto-heading-7": {
      "id": "b-hsw-dto-heading-7",
      "type": "heading",
      "props": {
        "level": 3
