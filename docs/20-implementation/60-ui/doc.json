          "insert": "DTO and Client Model"
        }
      ],
      "children": []
    },
    "b-hsw-dto-decision-8": {
      "id": "b-hsw-dto-decision-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — The workspace hydrates HarnessStateView as the canonical typed client snapshot — game_revision, nullable summaries, queue order, blockers, freshness, operations, recent accepted events, and action projections — and refresh replaces the snapshot coherently as one unit."
        }
      ],
      "children": []
    },
    "b-hsw-dto-why-9": {
      "id": "b-hsw-dto-why-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — Rejected: client types inferring action authority or lease ownership from process flags. A revision-coherent snapshot keeps the server the only source of authority."
        }
      ],
      "children": []
    },
    "b-hsw-dto-applies-10": {
      "id": "b-hsw-dto-applies-10",
