    "b-10-operator-runbook-column-the-epoch-cycle-14": {
      "id": "b-10-operator-runbook-column-the-epoch-cycle-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "   column; the epoch cycle commits and re-reports as batches drain. Worker\n   count controls live claims/processes, while compile-heavy validation and\n   tool calls queue through their own slot pools, so \"active workers\" can be\n   higher than simultaneous MWCC compiles."
        }
      ],
      "children": []
