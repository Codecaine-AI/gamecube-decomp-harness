    "b-10-operator-runbook-the-left-rail-is-control-4": {
      "id": "b-10-operator-runbook-the-left-rail-is-control-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The left rail is controls; the right rail is the view. The "
        },
        {
          "insert": "Status",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " panel\nanswers \"where are we\", the "
        },
        {
          "insert": "Actions",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " panel answers \"what can I do\", and\nthe Logs tab's activity card answers \"what is happening right now\". This\nrunbook walks one full session cycle through those three surfaces."
        }
      ],
      "children": []
    },
    "b-10-operator-runbook-the-canonical-lifecycle-5": {
      "id": "b-10-operator-runbook-the-canonical-lifecycle-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canonical lifecycle these panels drive — and the pipeline-rail layout the\nsidebar is converging on (stages with their own buttons, plus a PR board) —\nis specified in\n"
        },
        {
          "insert": "operator flow and PR tracking",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-ship-and-pr/20-operator-flow-and-pr-tracking",
              "label": "operator flow and PR tracking"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-10-operator-runbook-reading-the-stage-rail-6": {
      "id": "b-10-operator-runbook-reading-the-stage-rail-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
