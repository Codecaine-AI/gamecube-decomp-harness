          "insert": "Reconcile",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " or drop the\n   offending slice and re-run) or if there is nothing to ship yet (Resume and\n   keep working)."
        }
      ],
      "children": []
    },
