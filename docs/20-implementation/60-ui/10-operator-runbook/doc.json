    "b-10-operator-runbook-prepare-handoff-th-16": {
      "id": "b-10-operator-runbook-prepare-handoff-th-16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Prepare Handoff",
          "attributes": {
