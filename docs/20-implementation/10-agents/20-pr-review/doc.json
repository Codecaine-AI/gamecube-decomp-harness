    },
    "b-20-pr-review-the-pr-reviewer-is-the-a-20": {
      "id": "b-20-pr-review-the-pr-reviewer-is-the-a-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR reviewer is the adversarial pre-ship review layer in the QA ship gate\n(see "
        },
        {
          "insert": "score and PR handoff",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-ship-and-pr/10-score-and-pr-handoff",
              "label": "score and PR handoff"
            }
          }
        },
        {
          "insert": ").\nThe reviewer judges the slice diff plus loaded evidence injected by\n"
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": global decomp standards, deterministic L1/L2 lint findings for\nthe slice, targeted examples, the output schema, and curated maintainer-rejection\nexhibits. An unavailable scanner becomes a context note that increases\nsuspicion; it is not approval."
        }
      ],
      "children": []
    },
    "b-20-pr-review-output-follows-melee-pr-21": {
      "id": "b-20-pr-review-output-follows-melee-pr-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Output follows "
        },
        {
          "insert": "melee_pr_preship_review_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": per-finding "
        },
        {
          "insert": "{file, line,\nstandard_id, verdict: \"reject\"|\"warn\", rationale, suggested_fix}",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus a\ntop-level "
        },
        {
          "insert": "slice_verdict: \"approve\"|\"reject\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "confidence",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ".\nInvalid or unparseable output is an infrastructure error, not approval."
        }
      ],
      "children": []
    },
    "b-20-pr-review-invocation-is-the-pr-pr-22": {
      "id": "b-20-pr-review-invocation-is-the-pr-pr-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Invocation is the "
        },
        {
          "insert": "pr-preship-review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " server job, one agent call per planned\nPR slice at handoff time. Per-slice artifacts land under\n"
        },
        {
          "insert": "state_dir/preship_reviews/<run-id>/<slice-id>/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The command fails closed:\nany "
        },
        {
          "insert": "reject",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finding, any "
        },
        {
          "insert": "reject",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " slice verdict, or any infrastructure\nfailure exits 1 and blocks the handoff."
        }
      ],
      "children": []
    },
    "b-20-pr-review-pr-draft-qa-embeds-the-23": {
      "id": "b-20-pr-review-pr-draft-qa-embeds-the-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "pr-draft-qa",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " embeds the same preship mode inside the opened draft PR\nlifecycle. Scanner findings plus file-backed preship findings are routed\nthrough the deterministic QA repair lane ("
        },
        {
          "insert": "qa-repair",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") when "
        },
        {
          "insert": "--run-agents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is\nset. Human maintainer comments and review-thread feedback belong to the\nopened-PR fixer ("
        },
        {
          "insert": "pr-fixer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), which returns edit evidence or manual-review\nnotes. Findings that cannot be automatically cleared become commentable\nmanual-review items after repair attempts."
        }
      ],
      "children": []
    },
    "b-20-pr-review-worker-output-integratio-24": {
      "id": "b-20-pr-review-worker-output-integratio-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Worker-output integration conflicts before PR handoff are not handled here.\nThose belong to the running-phase "
        },
        {
          "insert": "integration-resolver",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " agent, which processes\ncompleted worker checkpoint conflict queue items before any PR slice exists."
        }
      ],
      "children": []
    },
    "b-20-pr-review-knowledge-relationship-25": {
      "id": "b-20-pr-review-knowledge-relationship-25",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Knowledge Relationship"
        }
      ],
      "children": []
    },
    "b-20-pr-review-the-pr-indexer-is-the-kn-26": {
      "id": "b-20-pr-review-the-pr-indexer-is-the-kn-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR indexer is the knowledge-facing PR agent. Historical PR data lives under\n"
        },
        {
          "insert": "projects/melee/knowledge/sources/code_context/past_prs/data/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the indexer\nturns raw slices from that corpus into postmortem records that the knowledge\ncurator can reduce into graph-safe lessons and proposal-only source updates."
        }
      ],
      "children": []
    },
    "b-20-pr-review-the-postmortem-builder-s-27": {
      "id": "b-20-pr-review-the-postmortem-builder-s-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The postmortem builder supports pending-only discovery. "
        },
        {
          "insert": "kg-maintain",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " calls the\nbuilder with "
        },
        {
          "insert": "--pending-only",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so newly fetched PRs are auto-discovered from\nthe active PR corpus and only missing "
        },
        {
          "insert": "postmortem/postmortem.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records are\nqueued. Direct "
        },
        {
          "insert": "kg-maintain",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " enables model-reviewed postmortems with\n"
        },
        {
          "insert": "--run-pr-agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; otherwise deterministic scaffold records keep the corpus\nindexable."
        }
      ],
      "children": []
    },
    "b-20-pr-review-the-default-live-indexin-28": {
      "id": "b-20-pr-review-the-default-live-indexin-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The default live indexing runtime is provider "
        },
        {
          "insert": "codex-lb",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", model "
        },
        {
          "insert": "gpt-5.5",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and\nthinking "
        },
        {
          "insert": "medium",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Root "
        },
        {
          "insert": "local.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " remains supported, and selected projects\ncan load their configured ignored "
        },
        {
          "insert": "localEnv",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " file so PR indexing can be\nattributed separately from other projects."
        }
      ],
      "children": []
    },
