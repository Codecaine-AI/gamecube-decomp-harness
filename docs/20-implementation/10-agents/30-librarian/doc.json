		"b-30-librarian-decision-doors-18": {
			"id": "b-30-librarian-decision-doors-18",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — One librarian agent with three context doors ("
				},
				{
					"insert": "condense",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "curation",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "pr_indexing",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ") and one shared "
				},
				{
					"insert": "librarian_v1",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " output contract, instead of separate condenser, curator, and indexer agents. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected per-task knowledge agents; one contract and one tool surface keep every knowledge path parseable by the same pipeline. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/knowledge/librarian",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/knowledge/librarian",
							"label": "apps/server/src/core/agent-catalog/agents/knowledge/librarian"
						}
					}
				},
				{
					"insert": "; a new knowledge task becomes a door, not a new agent."
				}
			],
			"children": []
		},
		"b-30-librarian-decision-writer-19": {
			"id": "b-30-librarian-decision-writer-19",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — The deterministic reducer is the canonical graph writer; librarian output that would mutate source-owned material stays "
				},
				{
					"insert": "proposal_only",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " until owner review applies it. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected agent-direct graph and source writes; model output must not silently rewrite corpora or data sheets. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/knowledge",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/knowledge",
							"label": "apps/server/src/core/knowledge"
						}
					}
				},
				{
					"insert": " (reducer and graph emit) and any future knowledge writer."
				}
			],
			"children": []
