		"b-30-librarian-opening-2": {
			"id": "b-30-librarian-opening-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The librarian is the single knowledge agent: the model-reviewed layer between messy evidence and graph-owned knowledge. It turns raw harness, PR, and community material into evidence-backed, graph-safe records, emitting one "
				},
				{
					"insert": "librarian_v1",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " JSON object per run, and never mutates corpora, indexes, graph databases, or source files itself. One agent serves three entry doors — "
				},
				{
					"insert": "condense",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "curation",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "pr_indexing",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " — and it is the only catalog agent that runs in the background."
				}
			],
			"children": []
		},
