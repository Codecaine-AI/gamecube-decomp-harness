      "text": [
        {
          "insert": "QA repair fixes deterministic QA-scan findings in one PR-bound candidate source file with minimal edits, reporting finding-by-finding dispositions and a score impact ("
        },
        {
          "insert": "melee_qa_repair_result_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "); validation stays with the runner. Writes are rung-gated to the runner-authorized write set — touching anything beyond it requires a structured, evidence-backed "
        },
        {
          "insert": "widening_request",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rather than local shims."
        }
      ],
      "children": []
    },
