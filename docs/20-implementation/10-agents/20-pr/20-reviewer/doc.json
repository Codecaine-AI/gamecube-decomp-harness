    "b-20-reviewer-tools-body-7": {
      "id": "b-20-reviewer-tools-body-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "None. The core-tool profile is empty by design and the callers additionally pin an empty tool profile at invocation; it is a pure diff-in, JSON-out judge with no write access."
        }
      ],
      "children": []
    },
    "b-20-reviewer-runs-heading-8": {
