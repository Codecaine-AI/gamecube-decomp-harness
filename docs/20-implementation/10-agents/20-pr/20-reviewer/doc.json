      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The PR reviewer is the adversarial pre-ship judge of one PR slice diff: it hunts for every reason the upstream maintainer would reject the slice, judging only the diff it is given. Findings are restricted to an allowlisted set of standards and rule families, and it may sketch "
        },
        {
          "insert": "proposed_rules",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for missing deterministic lint checks — proposal-only, never gating. Its "
        },
        {
          "insert": "melee_pr_preship_review_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " verdict feeds the draft-PR QA round loop."
        }
      ],
      "children": []
    },
