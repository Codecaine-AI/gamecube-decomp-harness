    "b-20-reviewer-runs-body-9": {
      "id": "b-20-reviewer-runs-body-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Once per planned slice in the draft-PR QA round loop (preship review, then QA scan, then repair, then commenting unresolved findings), and as a per-finding confirmation pass over saved slice diffs that fails closed — an unreadable diff, missing line, or agent error leaves the finding confirmed. Also a standalone CLI job; it is not part of PR handoff preparation."
        }
      ],
      "children": []
