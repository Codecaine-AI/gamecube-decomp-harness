			"text": [
				{
					"insert": "The PR splitter turns the deterministic seed split plan into ordered, review-sized PR slices, regrouping changed files without altering lane assignment or ship-set facts. Its "
				},
				{
					"insert": "melee_pr_splitter_plan_v1",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " proposal is re-validated against the seed plan — unknown files, duplicate ids, lane mixing, and oversized slices are hard errors — and branch creation and validation stay runner-owned."
				}
			],
			"children": []
		},
