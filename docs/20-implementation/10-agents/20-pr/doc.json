		"b-20-pr-decision-separate-roles-14": {
			"id": "b-20-pr-decision-separate-roles-14",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — Split planning, pre-ship review, opened-PR feedback repair, deterministic QA repair, and bundle-wide reconcile are separate agents with separate runtime ids ("
				},
				{
					"insert": "pr-splitter",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "pr-reviewer",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "pr-fixer",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "qa-repair",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "reconcile",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": "), not modes of one PR agent. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected a single multi-mode PR agent; separate tool profiles, schemas, and prompt tests keep each output contract independently testable. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/pr",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/pr",
							"label": "apps/server/src/core/agent-catalog/agents/pr"
						}
					}
				},
				{
					"insert": ", including any future PR-phase responsibility, which gets its own slice and id."
				}
			],
			"children": []
		},
		"b-20-pr-decision-fail-closed-15": {
			"id": "b-20-pr-decision-fail-closed-15",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — PR agents propose; deterministic code decides. Splitter output never changes ship-set membership or lane facts, reviewer findings route to repair or manual review, and invalid or unparseable agent output fails closed (the deterministic plan is kept, or the handoff is blocked) — it is never treated as approval. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected agent-authoritative outputs; a malformed model response must not be able to ship code. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/pr",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/pr",
							"label": "apps/server/src/core/agent-catalog/agents/pr"
						}
					}
				},
				{
					"insert": " and the PR-phase jobs in "
				},
				{
					"insert": "apps/server/src/core/cycle-runtime/phases",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/cycle-runtime/phases",
							"label": "apps/server/src/core/cycle-runtime/phases"
						}
					}
				},
				{
					"insert": "."
				}
			],
			"children": []
		},
		"b-20-pr-decision-indexing-16": {
			"id": "b-20-pr-decision-indexing-16",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — PR indexing is not a PR-phase agent; it is the librarian's PR-indexing door on the knowledge side. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — indexing serves the knowledge corpus, not PR shipping, so it lives with the knowledge agent rather than duplicating a PR role. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/knowledge/librarian",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/knowledge/librarian",
							"label": "apps/server/src/core/agent-catalog/agents/knowledge/librarian"
						}
					}
				},
				{
					"insert": " (see "
				},
				{
					"insert": "Librarian",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "20-implementation/10-agents/30-librarian",
							"label": "Librarian"
						}
					}
				},
