    "b-50-reconcile-opening-2": {
      "id": "b-50-reconcile-opening-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reconcile is bundle-wide boundary repair at a hard cycle boundary, in two modes: "
        },
        {
          "insert": "ship-validate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " clears the saved-baseline regression gate so the handoff bundle ships zero regressions, and "
        },
        {
          "insert": "sync-merge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reconciles local carry-forward work against freshly pulled upstream master. It has whole-checkout scope — unlike a worker — but may only change what the gate requires (regressions, conflicts, duplicate resolutions, build errors), and only while worker intake is locked. It returns "
        },
        {
          "insert": "reconcile_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " gate evidence with a "
        },
        {
          "insert": "pr_ready",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "retry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "/"
        },
        {
          "insert": "escalate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " recommendation."
        }
      ],
      "children": []
    },
