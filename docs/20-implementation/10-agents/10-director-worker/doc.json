          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Defines kernel metadata and wires the worker prompt, context, and tools. |\n| "
        },
        {
          "insert": "apps/server/src/core/agent-catalog/agents/running/worker/prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Owns the PromptKit system prompt and checkpoint-note guidance. |\n| "
        },
        {
          "insert": "apps/server/src/core/agent-catalog/agents/running/worker/context.ts",
          "attributes": {
            "code": true
          }
