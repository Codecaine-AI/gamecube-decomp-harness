          "insert": "integration-resolver",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and uses kernel spawn kind "
        },
        {
          "insert": "worker-integration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " so\nTrace places the agent session under the running epoch. The runner remains the owner\nof integration mutation, tentative acceptance, and boundary confirmation after\nthe agent returns."
