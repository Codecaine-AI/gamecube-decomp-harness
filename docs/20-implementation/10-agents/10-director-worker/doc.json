    "b-10-director-worker-the-integration-resolver-11": {
      "id": "b-10-director-worker-the-integration-resolver-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The integration resolver runs after worker completion and before PR mode. A\nconflict from the default integration queue or from flag-on merge-on-finish\nbecomes an explicit integration conflict item, not a PR review item. The item\ncontains failed apply evidence, selected worker checkpoint metadata, patch\npaths, conflict paths, and write sets. The agent resolves only that conflict\ngroup, returns "
        },
        {
          "insert": "melee_integration_resolver_result_v1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and records how each\nworker output was applied, partially applied, dropped, or superseded. An\nunresolved conflict remains operator-visible."
        }
      ],
      "children": []
    },
    "b-10-director-worker-text-12": {
      "id": "b-10-director-worker-text-12",
      "type": "process-outline",
      "props": {
        "steps": [
          {
            "text": "worker_state closes",
            "steps": [
              {
                "text": "selected worker_checkpoint",
                "steps": [
                  {
                    "text": "serial integration: merge-on-finish or default epoch queue",
                    "steps": [
                      {
                        "text": "clean apply",
                        "steps": [
                          {
                            "text": "tentative integration in cycle ancestry"
                          },
                          {
                            "text": "runner records applied disposition"
                          }
                        ]
                      },
                      {
                        "text": "failed apply or conflict group",
                        "steps": [
                          {
                            "text": "integration-resolve job",
                            "steps": [
                              {
                                "text": "integration-resolver agent"
                              },
                              {
                                "text": "resolved source in current root"
                              },
                              {
                                "text": "runner records dispositions and validation evidence"
                              },
                              {
                                "text": "unresolved conflict remains operator-visible"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": []
    },
