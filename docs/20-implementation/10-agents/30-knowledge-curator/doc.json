    "b-25-knowledge-curator-the-knowledge-curator-ag-4": {
      "id": "b-25-knowledge-curator-the-knowledge-curator-ag-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The knowledge-curator agent is the model-reviewed layer between messy evidence\nand graph-owned knowledge. V1 uses a deterministic reducer as the canonical\nwriter, and the agent can optionally add proposal-only source updates."
        }
      ],
      "children": []
    },
