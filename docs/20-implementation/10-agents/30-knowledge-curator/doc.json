    "b-25-knowledge-curator-kg-curate-rewrites-pr-8": {
      "id": "b-25-knowledge-curator-kg-curate-rewrites-pr-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "kg-curate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rewrites\n"
        },
        {
          "insert": "games/melee/knowledge/resource_graph/enrichments/knowledge_curator_updates.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nfrom persisted worker states, selected checkpoints, and PR postmortems.\n"
        },
        {
          "insert": "kg-maintain",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs pending PR postmortem indexing first, then curation,\noptional "
        },
        {
          "insert": "--run-curator-agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and graph rebuild."
        }
      ],
      "children": []
    },
    "b-25-knowledge-curator-when-model-reviewed-cura-9": {
      "id": "b-25-knowledge-curator-when-model-reviewed-cura-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When model-reviewed curation is enabled, the curator samples deterministic\nrecords with "
        },
        {
          "insert": "--curator-agent-record-limit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", splits them with\n"
        },
        {
          "insert": "--curator-agent-batch-size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and runs independent batches with\n"
        },
        {
          "insert": "--curator-agent-jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (default "
        },
        {
          "insert": "16",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). Batch outputs are collected first, then\nproposal-only source updates are appended in deterministic ID order. The live\nagent uses the shared defaults unless overridden: provider "
        },
        {
          "insert": "codex-lb",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", model\n"
        },
        {
          "insert": "gpt-5.5",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", thinking "
        },
        {
          "insert": "medium",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "local.env",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " sets\n"
        },
        {
          "insert": "PI_CODING_AGENT_DIR=.pi-agent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so auth is loaded from ignored repo-local\n"
        },
        {
          "insert": ".pi-agent/models.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", matching the PR indexer path."
        }
      ],
      "children": []
    },
    "b-25-knowledge-curator-workers-and-pr-agents-co-10": {
      "id": "b-25-knowledge-curator-workers-and-pr-agents-co-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Workers and PR agents contribute evidence. The curator decides whether that\nevidence becomes an accepted graph lesson or a proposal-only source update.\nData-sheet and source-corpus changes stay proposals until source-specific\nvalidation applies them. Tool cache or index refresh decisions stay with the\nowning tool suite."
        }
      ],
      "children": []
