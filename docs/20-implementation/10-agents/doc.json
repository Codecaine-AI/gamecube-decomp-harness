    "b-00-overview-apps-server-src-core-ag-30": {
      "id": "b-00-overview-apps-server-src-core-ag-30",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "apps/server/src/core/agent-catalog/kernel-catalog.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the app-owned kernel\ncatalog conversion for the backend Pi roles. Each role owns the canonical\n"
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " files: "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " defines\nkernel metadata, "
        },
        {
          "insert": "prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the stable PromptKit system prompt and prompt\nbundle entrypoint, "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " declares loader inputs and builds the rendered\nruntime context packet, and "
        },
        {
          "insert": "tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " declares the role tool surface. Each\nphase job or backend command builds the same "
        },
        {
          "insert": "PiPromptBundle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " used for artifacts\nand previews. Prompt builders attach "
        },
        {
          "insert": "kernelContext",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " inputs from the context\nmodule to that bundle, and the catalog converts those inputs into a kernel\n"
        },
        {
          "insert": "AgentContextResolver",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " alongside the "
        },
        {
          "insert": "ParsedAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " system prompt."
        }
      ],
      "children": []
    },
    "b-00-overview-live-db-backed-spawns-pa-31": {
      "id": "b-00-overview-live-db-backed-spawns-pa-31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Live DB-backed spawns pass the resolver through the server kernel bridge into\n"
        },
        {
          "insert": "createSpawnAgent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The kernel resolves "
        },
        {
          "insert": "melee-session-context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus the\nrole-specific inline inputs, emits context lifecycle events, injects the\nassembled context as an "
        },
        {
          "insert": "agent-context",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " custom message, and runs a short first\nturn prompt that points at the injected context. The rendered context packet is\nthe audit artifact and dashboard preview context. Direct fallback paths that\ncannot inject kernel context compose the rendered context with the short turn\nprompt so dry-run and preview behavior still expose the full packet."
        }
      ],
      "children": []
    },
