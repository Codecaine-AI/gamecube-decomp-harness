          "insert": "Agents",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/45-agents",
              "label": "Agents"
            }
          }
        },
        {
          "insert": "; this page records only how the runtime and the catalog are structured."
        }
      ],
      "children": []
    },
