    "b-00-overview-decision-catalog-11": {
      "id": "b-00-overview-decision-catalog-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — Every agent is a vertical-slice directory under "
        },
        {
          "insert": "agents/<area>/<name>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (areas: "
        },
        {
          "insert": "running",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pr",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "knowledge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") carrying its own "
        },
        {
          "insert": "agent.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "prompt.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "context.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "tools.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and output schema, registered in "
        },
        {
          "insert": "registry.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — rejected scattering prompt builders across phase runtimes; keeping prompt, schema, context, and tools adjacent keeps live runs, dry runs, artifacts, and dashboard previews aligned. "
        },
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " — "
        },
        {
          "insert": "apps/server/src/core/agent-catalog",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "apps/server/src/core/agent-catalog",
              "label": "apps/server/src/core/agent-catalog"
            }
          }
        },
        {
          "insert": ", including every future agent directory."
        }
      ],
