			"props": {},
			"text": [
				{
					"insert": "The conflict resolver resolves exactly one merge-on-finish worker-output conflict inside a runner-created isolated worktree. It never edits the cycle integration checkout: it returns a "
				},
				{
					"insert": "melee_conflict_resolver_result_v1",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " result whose patch the runner check-applies and commits under the integration lease. Any failure fails closed into an operator-visible conflict disposition."
				}
			],
			"children": []
		},
