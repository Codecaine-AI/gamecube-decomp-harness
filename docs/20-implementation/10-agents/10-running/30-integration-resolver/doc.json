			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "The integration resolver resolves one queued running-phase integration conflict item so worker output still lands before PR handoff. Unlike the "
				},
				{
					"insert": "Conflict Resolver",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "20-implementation/10-agents/10-running/20-conflict-resolver"
						}
					}
				},
				{
					"insert": " it edits the cycle checkout directly, making the smallest conflict-resolution edits, and may return "
				},
				{
					"insert": "resolved",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "needs_rework",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "blocked",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", or "
				},
				{
					"insert": "rejected",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ". The runner validates its "
				},
				{
					"insert": "melee_integration_resolver_result_v1",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " output (its schema is the group's only "
				},
				{
					"insert": "schema.json",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ") and owns queue dispositions."
				}
			],
			"children": []
		},
