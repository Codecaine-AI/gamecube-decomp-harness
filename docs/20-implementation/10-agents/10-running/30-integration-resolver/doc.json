      "text": [
        {
          "insert": "A resolved outcome is terminal. The harness commits the resolver's hand-merged tree from the cycle checkout ("
        },
        {
          "insert": "commitResolvedIntegration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in apps/server/src/core/cycle-runtime/phases/running/integration/integration-resolve.ts), recording a "
        },
        {
          "insert": "resolution",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " discriminator of committed, no_tree_change, or commit_failed, and never re-applies the original worker patch — the resolver's tree is the resolution. The resolution commit also advances the base revision that newly provisioned sandbox workers start from."
        }
      ],
      "children": []
