		"b-10-running-decision-scheduler-14": {
			"id": "b-10-running-decision-scheduler-14",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — Board-level target selection is deterministic scheduler code, not an agent; a worker session receives exactly one already-claimed epoch target. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected a director agent with a board-level prompt; deterministic ranking is auditable and does not spend model calls on routing. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/running/worker",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/running/worker",
							"label": "apps/server/src/core/agent-catalog/agents/running/worker"
						}
					}
				},
				{
					"insert": ", "
				},
				{
					"insert": "apps/server/src/core/cycle-runtime/phases",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/cycle-runtime/phases",
							"label": "apps/server/src/core/cycle-runtime/phases"
						}
					}
				},
				{
					"insert": ", and any future run-phase agent, which must also receive claimed work rather than choose it."
				}
			],
			"children": []
		},
		"b-10-running-decision-write-set-15": {
			"id": "b-10-running-decision-write-set-15",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — The worker stays inside its target claim and category-typed write set; widening happens only through an evidence-backed checkpoint-note request that the runner decides, and validation state is runner-owned. "
				},
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — rejected agent self-widening and agent-owned validation; "
				},
				{
					"insert": "Write Safety",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "10-system-design/50-workflows/20-run/40-workers/30-write-safety"
						}
					}
				},
				{
					"insert": " and durable evidence stay with deterministic code. "
				},
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — "
				},
				{
					"insert": "apps/server/src/core/agent-catalog/agents/running/worker",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/core/agent-catalog/agents/running/worker",
							"label": "apps/server/src/core/agent-catalog/agents/running/worker"
						}
					}
				},
				{
					"insert": " (checkpoint-note parsing, review lint, runner validation) and any future agent that edits game source."
				}
			],
			"children": []
		},
		"b-10-running-decision-resolvers-16": {
			"id": "b-10-running-decision-resolvers-16",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision — Worker-output conflicts that clean patch application cannot handle go to one dedicated resolver agent, the integration-resolver, bounded to one supplied conflict item; it edits the cycle checkout directly, and the runner owns acceptance, validation, and dispositions. An earlier inline merge-on-finish conflict-resolver was deleted along with that mode. Why — rejected letting workers or PR-phase agents resolve integration conflicts; conflicts are a distinct bounded task, not an extension of authoring. Applies to — apps/server/src/core/agent-catalog/agents/running/integration-resolver."
				}
			],
			"children": []
		}
	}
