      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Traces one pointer register through a function's generated assembly and records every load and store by offset, access size, and kind, then emits a candidate C struct skeleton. The output is layout evidence, not naming proof."
        }
      ],
      "children": []
    },
