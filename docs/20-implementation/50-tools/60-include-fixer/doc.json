      "text": [
        {
          "insert": "Non-mutating missing-include preview: it runs a clang syntax-only check, extracts undeclared-identifier diagnostics, searches headers for the missing declarations, and returns proposed include lines plus a unified diff. The upstream tool writes to files; this suite previews only, so workers apply the minimum justified edit themselves."
        }
      ],
      "children": []
    },
