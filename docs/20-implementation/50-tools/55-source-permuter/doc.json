			"id": "b-55-source-permuter-opening-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Bounded source-shape search over the real C translation unit: it compiles candidate permutations with the same MWCC rule as the game build and scores them through objdiff, with replay of saved recipes and compile-free mutation previews. Defaults are conservative — candidates are not applied to source, and busy permuter slots fail fast with "
				},
				{
					"insert": "queue_busy",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " instead of blocking."
				}
			],
			"children": []
		},
		"b-55-source-permuter-inputs-3": {
			"id": "b-55-source-permuter-inputs-3",
			"type": "list-item",
			"props": {
				"ordered": false
			},
			"text": [
				{
					"insert": "Inputs",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — the current translation unit and target function; optionally a saved recipe to replay or mutation steps to preview."
				}
			],
			"children": []
		},
		"b-55-source-permuter-outputs-4": {
			"id": "b-55-source-permuter-outputs-4",
			"type": "list-item",
			"props": {
				"ordered": false
			},
			"text": [
				{
					"insert": "Outputs",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": " — the best candidate diff, its score delta, and a replay recipe."
				}
			],
			"children": []
		},
		"b-55-source-permuter-when-5": {
			"id": "b-55-source-permuter-when-5",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Workers reach for it when a near match is stuck and a mechanical candidate search may reveal the shape. The result is a hypothesis: apply a small understood edit by hand, then verify with "
				},
				{
					"insert": "Checkdiff",
					"attributes": {
						"reference": {
							"kind": "doc",
							"path": "20-implementation/50-tools/10-checkdiff"
						}
					}
				},
				{
					"insert": " or objdiff."
				}
			],
			"children": []
		},
