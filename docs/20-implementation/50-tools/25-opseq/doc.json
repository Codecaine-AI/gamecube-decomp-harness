      "text": [
        {
          "insert": "Opcode-sequence evidence generator that links similar matched and unmatched functions. It extracts one normalized opcode fingerprint per function from the build's assembly and persists fingerprints plus top-K neighbor evidence, so an already-matched analog can explain the source shape of an unmatched function."
        }
      ],
      "children": []
    },
