    "b-00-overview-compile-heavy-tool-apis-19": {
      "id": "b-00-overview-compile-heavy-tool-apis-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Compile-heavy tool APIs queue through epoch/worktree-scoped slot directories\ninstead of launching unbounded MWCC processes from every active worker. The\nshared helper "
        },
        {
          "insert": "toolpacks/gamecube-decomp/_shared/toolpack_runtime.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " wraps\ntool-local API commands in "
        },
        {
          "insert": "worker_tool_slot",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-default-tool-slot-limits-20": {
