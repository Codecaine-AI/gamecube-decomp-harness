    "b-00-overview-callable-decomp-tools-ar-4": {
      "id": "b-00-overview-callable-decomp-tools-ar-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Callable decomp tools are resolved through a toolpack/game binding runtime.\nReusable GameCube decomp tool contracts, default Python APIs, runners, recipes,\nand shared helper modules live in "
        },
        {
          "insert": "toolpacks/gamecube-decomp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A game\nselects that pack from "
        },
        {
          "insert": "games/<id>/game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and owns its bindings,\nstable generated tool data, and mutable worktree output."
        }
      ],
      "children": []
    },
    "b-00-overview-apps-server-owns-the-r-5": {
      "id": "b-00-overview-apps-server-owns-the-r-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "apps/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the resolver and agent-facing wrappers only. It does not own\nor mirror a server-local tool resource tree; callable tool definitions,\nimplementations, runner scripts, and tests belong to the toolpack selected by\nthe game descriptor."
        }
      ],
      "children": []
    },
    "b-00-overview-knowledge-sources-and-to-6": {
      "id": "b-00-overview-knowledge-sources-and-to-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Knowledge sources and tools are separate surfaces. Knowledge sources store\nsearchable or injectable facts. Tools execute lookup, validation, compiler,\nsource-editing, and conversion operations against a resolved game/worktree\ncontext."
        }
      ],
      "children": []
    },
