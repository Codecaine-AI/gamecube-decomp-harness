    "b-00-overview-reusable-gamecube-decomp-2": {
      "id": "b-00-overview-reusable-gamecube-decomp-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Reusable GameCube decomp toolpack, game tool bindings, agent tool wrappers, validation tools, and scoped tool data."
        }
