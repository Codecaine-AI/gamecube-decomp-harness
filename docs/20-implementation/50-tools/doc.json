    "b-00-overview-surface-path-owner-8": {
      "id": "b-00-overview-surface-path-owner-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Surface | Path | Owner |\n| --- | --- | --- |\n| Toolpack descriptor | "
        },
        {
          "insert": "toolpacks/gamecube-decomp/toolpack.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Reusable GameCube decomp pack metadata. |\n| Tool registry | "
        },
        {
          "insert": "toolpacks/gamecube-decomp/registry.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Stable tool ids, paths, categories, usage metadata. |\n| Tool slices | "
        },
        {
          "insert": "toolpacks/gamecube-decomp/<category>/<tool_id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Default APIs, runners, descriptors, tests, and docs. |\n| Shared helper code | "
        },
        {
          "insert": "toolpacks/gamecube-decomp/_shared",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Toolpack-level Python support helpers. |\n| Shared implementation modules | "
        },
        {
          "insert": "toolpacks/gamecube-decomp/_impl/gamecube",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Toolpack-owned implementation helpers used by public tool APIs. |\n| Game binding root | "
        },
        {
          "insert": "games/<id>/tool-bindings/<tool_id>.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Enablement, overrides, and per-game roots. |\n| Shared game tool data | "
        },
        {
          "insert": "games/<id>/shared/tool-data/<tool_id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Stable indexes/cache tied to a game binary or base checkout. |\n| Worktree tool cache | "
        },
        {
          "insert": "games/<id>/worktrees/<worktree_id>/tool-cache/<tool_id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Mutable validation, compiler, editing, and candidate output for one active worktree. |"
        }
      ],
      "children": []
    },
