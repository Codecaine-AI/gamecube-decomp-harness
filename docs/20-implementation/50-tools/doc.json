    "b-00-overview-tool-role-default-27": {
      "id": "b-00-overview-tool-role-default-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Tool | Role | Default use |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "checkdiff",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Focused compile/checkdiff validation. | Attempt evaluation feedback. |\n| "
        },
        {
          "insert": "review_lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Source review anti-pattern scan. | Attempt evaluation feedback and QA gates. |\n| "
        },
        {
          "insert": "include_fixer",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Missing include preview. | Conditional feedback after declaration diagnostics. |\n| "
        },
        {
          "insert": "objdiff_score",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Candidate object scoring. | Conditional feedback when a candidate object exists. |\n| "
        },
        {
          "insert": "mwcc_debug",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Compiler stack/regflow/inline diagnosis. | Conditional feedback after shape-specific validation symptoms. |\n| "
        },
        {
          "insert": "ghidra",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Binary symbol/address lookup. | On-demand research. |\n| "
        },
        {
          "insert": "opseq",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Similar function lookup. | On-demand research before inventing source shape. |\n| "
        },
        {
          "insert": "mismatch_db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Known mismatch tactic lookup. | On-demand after first mismatch evidence. |\n| "
        },
        {
          "insert": "m2c_decomp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Control-flow scaffold generation. | On-demand for understanding asm only. |\n| "
        },
        {
          "insert": "type_oracle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Expression type lookup. | On-demand before type-sensitive rewrites. |\n| "
        },
        {
          "insert": "source_permuter",
          "attributes": {
            "code": true
          }
        },
