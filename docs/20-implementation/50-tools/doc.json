    "b-00-overview-the-merged-tool-context-16": {
      "id": "b-00-overview-the-merged-tool-context-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The merged tool context contains the API path, tool root, game repo root,\ngame state dir, shared data root, worktree cache root, implementation root,\nand a command environment. Agent wrappers call tools by stable ids such as\n"
        },
        {
          "insert": "checkdiff",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "ghidra",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "review_lint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; they do not hardcode physical script\npaths."
        }
      ],
      "children": []
    },
    "b-00-overview-when-games-id-stat-17": {
      "id": "b-00-overview-when-games-id-stat-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When "
        },
        {
          "insert": "games/<id>/state/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exists, the resolver exports it to tool\nAPIs as "
        },
        {
          "insert": "MWCC_WIBO",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Toolpack helpers also auto-discover the same state install\nfrom worker worktree paths. This makes wibo the preferred MWCC process runner\nfor checkdiff, direct compile, source permutation, and mwcc debug operations.\nWine remains a fallback for hosts or debug modes where wibo is unavailable or a\nspecific tool path requests it."
        }
      ],
      "children": []
    },
