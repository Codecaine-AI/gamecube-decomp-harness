      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Operation family | Default concurrent slots |\n| --- | --- |\n| "
        },
        {
          "insert": "source_permuter:run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "source_permuter:replay",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | 1 |\n| "
        },
        {
          "insert": "checkdiff:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | 12 |\n| "
        },
        {
          "insert": "m2c_decomp:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | 8 |\n| "
        },
        {
          "insert": "mwcc_debug:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | 2 |\n| Other tool APIs | 16 |"
        }
      ],
      "children": []
    },
    "b-00-overview-source-permuter-run-repl-22": {
      "id": "b-00-overview-source-permuter-run-repl-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Source-permuter run/replay calls use a fail-fast policy: if all configured\nsource-permuter slots are full, the API returns "
        },
        {
          "insert": "queue_busy",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " instead of waiting\nbehind them. The outer source-permuter slot is separate from the permuter's\ninternal worker count; "
        },
        {
          "insert": "ORCH_SOURCE_PERMUTER_MAX_JOBS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " caps requested internal\njobs and defaults to "
        },
        {
          "insert": "1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-00-overview-operators-can-tune-the-p-23": {
      "id": "b-00-overview-operators-can-tune-the-p-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Operators can tune the pool with environment variables:"
        }
      ],
      "children": []
    },
    "b-00-overview-variable-effect-24": {
      "id": "b-00-overview-variable-effect-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Variable | Effect |\n| --- | --- |\n| "
        },
        {
          "insert": "ORCH_TOOL_CONCURRENCY_<TOOL>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Per-tool override, where "
        },
        {
          "insert": "<TOOL>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the uppercase operation prefix such as "
        },
        {
          "insert": "CHECKDIFF",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "SOURCE_PERMUTER",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "MWCC_DEBUG",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". |\n| "
        },
        {
          "insert": "ORCH_WORKER_TOOL_CONCURRENCY_<TOOL>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Worker-specific per-tool override. |\n| "
        },
        {
          "insert": "ORCH_WORKER_TOOL_CONCURRENCY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Shared default for all worker tool pools without a per-tool override. |\n| "
        },
        {
          "insert": "ORCH_TOOL_QUEUE_DISABLED",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " / "
        },
        {
          "insert": "ORCH_WORKER_TOOL_QUEUE_DISABLED",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Disable queueing for diagnosis only. |"
        }
      ],
      "children": []
    },
    "b-00-overview-runner-owned-validation-25": {
      "id": "b-00-overview-runner-owned-validation-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Runner-owned validation has a separate shared compile pool for "
        },
        {
          "insert": "ninja",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " commands\nexecuted during worker checkpoint validation and MWCC/wibo direct compile\nhelpers. Set "
        },
        {
          "insert": "ORCH_WORKER_COMPILE_CONCURRENCY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to tune it, or\n"
        },
        {
          "insert": "ORCH_WORKER_NINJA_CONCURRENCY",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as a compatibility fallback; the default is\n"
        },
        {
          "insert": "12",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The worker count can therefore be higher than the number of simultaneous\nlocal compiles."
        }
      ],
      "children": []
    },
