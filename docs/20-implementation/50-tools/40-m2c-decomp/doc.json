      "text": [
        {
          "insert": "Generates a rough C scaffold for a function's assembly through the vendored m2c fork. The scaffold is a reading aid for control flow, temporaries, and data movement — never pasted into reviewable code; names, types, fields, and structure are recovered from local source evidence instead."
        }
      ],
      "children": []
    },
