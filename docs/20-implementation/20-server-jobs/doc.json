    "b-00-overview-job-owner-purpose-9": {
      "id": "b-00-overview-job-owner-purpose-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Job | Owner | Purpose |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "init-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/service",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Creates run state, stores the run checkpoint goal, loads board data, admits initial epoch target candidates, and writes the initial board snapshot. |\n| "
        },
        {
          "insert": "tick",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/scheduler",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Handles one unhandled wake event with the deterministic scheduler, epoch target admission, and worker wake logic. |\n| "
        },
        {
          "insert": "worker",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/workers",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Claims one epoch target, runs the worker session, validates checkpoints, and closes worker state with runner-owned lifecycle state. |\n| "
        },
        {
          "insert": "integration-resolve",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/integration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Spawns the running-phase "
        },
        {
          "insert": "integration-resolver",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " agent for one worker-output integration conflict queue item supplied by "
        },
        {
          "insert": "--item-file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". |\n| "
        },
        {
          "insert": "run-loop",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/scheduler",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Resting deterministic scheduler loop that handles wake events, keeps epoch work moving, starts workers up to capacity, and sleeps when the board is quiet. |\n| "
        },
        {
          "insert": "babysit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Guardian wrapper for the run loop and detached project process lifecycle. |\n| "
        },
        {
          "insert": "recover-claims",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Closes interrupted or expired active target claims and their worker state as runner-owned errors after operator confirmation. |\n| "
        },
        {
          "insert": "epoch-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/running/epochs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Runs one epoch checkpoint cycle: commit validated work, rebuild the report in the epoch worktree, save a boundary point, and route regressions back through epoch target admission. |\n| "
        },
        {
          "insert": "regression-check",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "report-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/validation/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Run saved-baseline report/objdiff validation, QA scan integration, and report artifact generation. |\n| "
        },
        {
          "insert": "checkpoint-run",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "qa-repair",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pr-split-plan",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pr-draft-qa",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pr-preship-review",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "reconcile",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "save-point",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/session-runtime/phases/pr/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Own checkpoint, QA repair, PR split/review, reconcile, and campaign save-point workflows. |\n| "
        },
        {
          "insert": "kg-*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | "
        },
        {
          "insert": "core/knowledge/jobs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Own knowledge source status, maintenance, graph rebuild/search, PR indexing, file-card, and ranking jobs. |"
        }
      ],
      "children": []
    },
    "b-00-overview-run-a-job-with-10": {
      "id": "b-00-overview-run-a-job-with-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run a job with:"
        }
      ],
      "children": []
    },
    "b-00-overview-sh-11": {
      "id": "b-00-overview-sh-11",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun run server:job -- --project melee status\nbun run server:job -- --project melee init-run --desired-workers 16 --goal-kind matched_code_percent --goal-value 72\nbun run server:job -- --project melee babysit --max-workers 16 --idle-sleep-ms 5000"
        }
      ],
      "children": []
    },
    "b-00-overview-qa-repair-is-the-resol-12": {
      "id": "b-00-overview-qa-repair-is-the-resol-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "qa-repair",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the resolver runtime for QA repair queue items. The job builds\n"
        },
        {
          "insert": "queue.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "--run-agents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " launches the "
        },
        {
          "insert": "qa-repair",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " agent over queued\nitems; "
        },
        {
          "insert": "--item-id <id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " narrows the launch to a single queue item while\n"
        },
        {
          "insert": "--max-items <n>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " bounds a batch. The dashboard PR-mode manual handoff actions\ncall "
        },
        {
          "insert": "/api/pr/qa-repair",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which maps to the same runtime and opens the\noperation log while the resolver runs."
        }
      ],
      "children": []
    },
    "b-00-overview-integration-resolve-i-13": {
      "id": "b-00-overview-integration-resolve-i-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "integration-resolve --item-file <path>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the pre-PR worker-output conflict\nresolver runtime. It consumes an explicit integration conflict queue item JSON,\noptionally a "
        },
        {
          "insert": "--queue-summary-file",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and launches role "
        },
        {
          "insert": "integration-resolver",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nwith kernel kind "
        },
        {
          "insert": "worker-integration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It writes parsed output and summary\nartifacts under "
        },
        {
          "insert": "state_dir/integration_resolver/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; the runner owns queue status\nmutation and epoch acceptance after the agent returns."
        }
      ],
      "children": []
    },
    "b-00-overview-boundaries-14": {
      "id": "b-00-overview-boundaries-14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Boundaries"
        }
      ],
