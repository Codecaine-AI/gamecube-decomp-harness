      },
      "text": [
        {
          "insert": "apps/server/src/\n+-- job-runner.ts\n+-- application/\n|   +-- jobs/\n|   |   +-- job-runner.ts\n+-- core/\n|   +-- project-registry/\n|   |   +-- runtime-options.ts\n|   |   +-- runtime-defaults.ts\n|   +-- session-runtime/\n|   |   +-- run-state/\n|   |   +-- phases/\n|   |   |   +-- preparing/\n|   |   |   +-- running/\n|   |   |   |   +-- service/init-run.ts\n|   |   |   |   +-- scheduler/tick.ts\n|   |   |   |   +-- scheduler/run-loop.ts\n|   |   |   |   +-- integration/integration-resolve.ts\n|   |   |   |   +-- workers/worker-cycle.ts\n|   |   |   |   +-- jobs/babysit.ts\n|   |   |   |   +-- jobs/recover-claims.ts\n|   |   |   |   +-- epochs/epoch-run.ts\n|   |   |   +-- pr/jobs/\n|   +-- validation/jobs/\n|   +-- knowledge/jobs/\n+-- infrastructure/\n    +-- env/\n    +-- persistence/sqlite/\n    +-- shell/"
        }
      ],
