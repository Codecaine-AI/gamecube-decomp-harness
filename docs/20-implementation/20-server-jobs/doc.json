        {
          "insert": "games/<id>/local.game.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when present, then applies explicit\n"
        },
        {
          "insert": "--repo-root",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--state-dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and command-level "
        },
        {
          "insert": "--graph-db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides. Game\nmode carries the resolved game id, checkout root, state directory, graph\ndatabase, descriptor path, and local override path through server jobs. Raw path\nmode remains available when "
