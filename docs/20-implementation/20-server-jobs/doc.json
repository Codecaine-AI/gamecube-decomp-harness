    "b-00-overview-the-operator-job-surface-4": {
      "id": "b-00-overview-the-operator-job-surface-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The operator job surface is owned by "
        },
        {
          "insert": "apps/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "apps/server/src/job-runner.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nis a stable executable shim. "
        },
        {
          "insert": "apps/server/src/application/jobs/job-runner.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nparses global game/runtime options, loads game-local env, and dispatches\nto phase-owned job modules or shared core/infrastructure helpers. The deleted\nstandalone command app is not a runtime boundary."
        }
      ],
      "children": []
    },
    "b-00-overview-game-id-selects-5": {
      "id": "b-00-overview-game-id-selects-5",
