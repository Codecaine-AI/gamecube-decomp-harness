    "b-00-overview-the-operator-job-surface-4": {
      "id": "b-00-overview-the-operator-job-surface-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The operator job surface is owned by "
        },
        {
          "insert": "apps/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "apps/server/src/job-runner.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nis a stable executable shim. "
        },
        {
          "insert": "apps/server/src/application/jobs/job-runner.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "\nparses global project/runtime options, loads project-local env, and dispatches\nto phase-owned job modules or shared core/infrastructure helpers. The deleted\nstandalone command app is not a runtime boundary."
        }
      ],
      "children": []
    },
    "b-00-overview-project-id-selects-5": {
      "id": "b-00-overview-project-id-selects-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "--project <id>",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selects "
        },
        {
          "insert": "projects/<id>/project.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", applies ignored\n"
        },
        {
          "insert": "projects/<id>/local.project.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when present, then applies explicit\n"
        },
        {
          "insert": "--repo-root",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "--state-dir",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and command-level "
        },
        {
          "insert": "--graph-db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overrides. Project\nmode carries the resolved project id, checkout root, state directory, graph\ndatabase, descriptor path, and local override path through server jobs. Raw path\nmode remains available when "
        },
        {
          "insert": "--project",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is omitted."
        }
      ],
      "children": []
    },
