      "id": "b-20-current-repo-mechanics-the-orchestrator-prefers-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator prefers wibo for MWCC process execution. A project-local\ninstall at "
        },
        {
          "insert": "projects/<id>/state/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the stable path used by managed\nrun-loop configure commands, worker subprocess environments, and resolver-backed\ntool APIs. When that file exists on macOS or Linux, the run loop passes\n"
        },
        {
          "insert": "--wrapper <state>/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "configure.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and exports "
        },
        {
          "insert": "MWCC_WIBO",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for\nworker tool calls."
        }
      ],
      "children": []
