    "b-20-current-repo-mechanics-artifact-or-command-6": {
      "id": "b-20-current-repo-mechanics-artifact-or-command-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Artifact Or Command | Current Role | Orchestrator Use |\n| --- | --- | --- |\n| "
        },
        {
          "insert": "config/GALE01/config.yml",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Input to DTK's DOL split; points at the original DOL, symbols, and splits. | Read-only provenance for object/unit boundaries and target addresses. |\n| "
        },
        {
          "insert": "python configure.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Generates "
        },
        {
          "insert": "build.ninja",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "objdiff.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and compile commands. | Run during workspace/bootstrap and after source/config changes that require regeneration. |\n| "
        },
        {
          "insert": "python3 configure.py --require-protos --wrapper <state>/tools/wibo",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Generates the same build graph with MWCC invocations routed through wibo. | Preferred orchestrator configure command when project-state wibo is installed. |\n| "
        },
        {
          "insert": "configure.py",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " object flags | "
        },
        {
          "insert": "Object(Matching, ...)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " means linked from rebuilt source; "
        },
        {
          "insert": "NonMatching",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " means diffable but not linked. | Distinguish exact code progress from linked progress. |\n| "
        },
        {
          "insert": "objdiff.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Maps units to original objects, rebuilt objects, source paths, scratch context, and completion metadata. | Primary source for unit metadata, source paths, compiler flags, and write-set derivation. |\n| "
        },
        {
          "insert": "build/GALE01/report.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Generated report with unit/function match metrics. | Main index input for target discovery, progress targets, score deltas, and regression checks. |\n| "
        },
        {
          "insert": "decomp-find",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Candidate ranking helper built from "
        },
        {
          "insert": "report.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". | Internal board-scan signal, not the top-level workflow. |\n| "
        },
        {
          "insert": "tools/table-typer dups",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Finds normalized assembly duplicate groups with matched refs and unmatched candidates. | High-confidence graph edges and duplicate-adaptation worker evidence. |\n| "
        },
        {
          "insert": "decomp-runs/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Existing experiment-bundle convention. | Per-target or per-capability artifact ledger; the orchestrator DB can point into these bundles. |"
        }
      ],
      "children": []
