    "b-50-pi-agent-run-reports-p-confirm-not-used-31": {
      "id": "b-50-pi-agent-run-reports-p-confirm-not-used-31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "  P(confirm | not used)`. "
        },
        {
          "insert": "Correlational, not causal",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": hard targets drag\n  tools used on hard targets negative, and \"% of no-change coverage\" near 100%\n  means a tool is ambient, not discriminative. Use lift to pick exposure\n  experiments, never to declare a tool good/bad by itself. Near-zero usage\n  (the hide/prune tier) is the only safe removal signal."
        }
      ],
      "children": []
