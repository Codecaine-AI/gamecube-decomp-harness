    "b-doc-migration-017-adds-the-d-1": {
      "id": "b-doc-migration-017-adds-the-d-1",
      "type": "state-shape",
      "props": {
        "description": "Migration 017 adds the durable storage used by the knowledge background core under apps/server/src/core/knowledge/background. It records source identity and class, payload and deduplication identity, lifecycle status, availability and retry timing, attempt count, fenced lease ownership and expiry, error state, accepted output revision, provenance, and timestamps.",
        "example": "{\n  \"job_id\": \"knowledge-job-worker-worker-1842\",\n  \"worker_state_id\": \"worker-1842\",\n  \"project_id\": \"melee\",\n  \"run_id\": \"run-2026-08-11-01\",\n  \"revision\": 2,\n  \"status\": \"processing\",\n  \"execution_class\": \"background_safe\",\n  \"source_kind\": \"worker_result\",\n  \"source_id\": \"worker-1842\",\n  \"attempts\": 1,\n  \"next_attempt_at\": null,\n  \"lease_id\": \"knowledge-lease-44\",\n  \"lease_expires_at\": \"2026-08-12T18:43:08Z\",\n  \"evidence_provenance\": {\n    \"worker_state_id\": \"worker-1842\"\n  },\n  \"publication_provenance\": null,\n  \"published_digest\": null,\n  \"error\": null,\n  \"trace_id\": \"trace-worker-1842\",\n  \"caused_by_event_id\": \"event-92811\",\n  \"blockers\": [],\n  \"created_at\": \"2026-08-12T18:42:08Z\",\n  \"updated_at\": \"2026-08-12T18:42:10Z\",\n  \"completed_at\": null\n}",
        "fields": [
          {
            "name": "job_id",
            "type": "KnowledgeJobId",
            "description": "Stable durable job identity."
          },
          {
            "name": "worker_state_id",
            "type": "WorkerStateId",
            "description": "Unique deduplication identity; one background job exists per worker state."
          },
          {
            "name": "project_id",
            "type": "ProjectId"
          },
          {
            "name": "run_id",
            "type": "RunId"
          },
          {
            "name": "revision",
            "type": "integer",
            "description": "Monotonic version incremented for every accepted transition."
          },
          {
            "name": "status",
            "type": "\"queued\" | \"processing\" | \"waiting\" | \"succeeded\" | \"failed\" | \"cancelled\""
          },
          {
            "name": "execution_class",
            "type": "\"background_safe\" | \"sync_stage\""
          },
          {
            "name": "source_kind",
            "type": "string"
          },
          {
            "name": "source_id",
            "type": "string"
          },
          {
            "name": "attempts",
            "type": "integer"
          },
          {
            "name": "next_attempt_at",
            "type": "timestamp | null"
          },
          {
            "name": "lease_id",
            "type": "LeaseId | null",
            "description": "Fencing token required from the current processing owner."
          },
          {
            "name": "lease_expires_at",
            "type": "timestamp | null"
          },
          {
            "name": "evidence_provenance",
            "type": "JSON object",
            "description": "Evidence and input lineage that produced the job."
          },
          {
            "name": "publication_provenance",
            "type": "JSON object | null",
            "description": "Accepted output lineage, populated after publication."
          },
          {
            "name": "published_digest",
            "type": "string | null",
            "description": "Idempotency identity for the accepted output."
          },
          {
            "name": "error",
            "type": "JSON object | null"
          },
          {
            "name": "trace_id",
            "type": "TraceId"
          },
          {
            "name": "caused_by_event_id",
            "type": "EventId | null"
          },
          {
            "name": "blockers",
            "type": "Blocker[]"
          },
          {
            "name": "created_at",
            "type": "timestamp"
          },
          {
            "name": "updated_at",
            "type": "timestamp"
          },
          {
            "name": "completed_at",
            "type": "timestamp | null"
          }
        ],
        "name": "BackgroundKnowledgeJobRecord"
      },
      "children": []
    },
    "b-doc-the-migration-is-registe-2": {
      "id": "b-doc-the-migration-is-registe-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The migration is registered with orchestrator-state storage so existing state directories advance through the same ordered migration path. The schema supports one current job row plus durable attempt and publication evidence; terminal attempts remain inspectable."
        }
      ],
      "children": []
    }
