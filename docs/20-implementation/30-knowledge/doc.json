      "text": [
        {
          "insert": "Key Rules"
        }
      ],
      "children": []
    },
    "rule-one": {
      "id": "rule-one",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Treat generated indexes and tool output as rebuildable evidence, not an independent source of truth."
        }
      ],
      "children": []
    },
    "rule-two": {
      "id": "rule-two",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Preserve evidence references and resource versions when converting source data into facts or edges."
        }
      ],
      "children": []
    },
    "rule-three": {
      "id": "rule-three",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Do not remove a source-specific lookup until the graph exposes an equivalent textual or relationship-aware query."
        }
      ],
      "children": []
    },
