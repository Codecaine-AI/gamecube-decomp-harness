    "b-00-overview-the-package-is-organized-3": {
      "id": "b-00-overview-the-package-is-organized-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The package is organized as a Bun workspace around two first-party apps:\n"
        },
        {
          "insert": "apps/frontend",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for the React/Vite dashboard and "
        },
        {
          "insert": "apps/server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for API routes,\noperator jobs, orchestration, validation, handoff, agents, tools, knowledge,\nproject resolution, and platform helpers. The server owns its Melee-specific\nAgent Kernel runtime bridge under "
        },
        {
          "insert": "apps/server/src/infrastructure/kernel/bridge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ";\nthe external kernel packages live under "
        },
        {
          "insert": "packages/agent-kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Project\ndescriptors and project-local runtime workspaces live under top-level "
        },
        {
          "insert": "projects/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
