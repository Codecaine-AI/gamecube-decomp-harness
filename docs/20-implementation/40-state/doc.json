		"b-authority-role-2": {
			"id": "b-authority-role-2",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "One authority path governs state writes: canonical orchestrator state and server-owned action authority project into one "
				},
				{
					"insert": "HarnessStateView",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": ", and nothing outside that authority path may write state."
				}
			],
			"children": []
		},
		"b-authority-view-decision-8": {
			"id": "b-authority-view-decision-8",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": "
				},
				{
					"insert": "HarnessStateView",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " is assembled in one server-side builder from the canonical stores at one coherent game revision, returning summaries rather than storage rows; API routes return that DTO without composing state themselves."
				}
			],
			"children": []
		},
		"b-authority-view-why-9": {
			"id": "b-authority-view-why-9",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": the rejected alternative was routes or clients assembling views from raw tables, which would spread the read model across handlers and let authority drift into route code."
				}
			],
			"children": []
		},
		"b-authority-view-applies-10": {
			"id": "b-authority-view-applies-10",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": "
				},
				{
					"insert": "apps/server/src/application/dashboard/read-model.ts",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/application/dashboard/read-model.ts",
							"label": "apps/server/src/application/dashboard/read-model.ts"
						}
					}
				},
				{
					"insert": " — including every future state surface: new state joins the builder, not a route handler."
				}
			],
			"children": []
		},
		"b-authority-guards-decision-11": {
			"id": "b-authority-guards-decision-11",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": every operator action is projected server-side against the design "
				},
				{
					"insert": "ActionProjection",
					"attributes": {
						"code": true
					}
				},
				{
					"insert": " contract, and routes re-evaluate guards against current state at execution time — a stale client projection can never authorize a transition."
				}
			],
			"children": []
		},
		"b-authority-guards-why-12": {
			"id": "b-authority-guards-why-12",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": the rejected alternative was trusting the projection the client last fetched, which turns a read-model snapshot into write authority."
				}
			],
			"children": []
		},
		"b-authority-guards-applies-13": {
			"id": "b-authority-guards-applies-13",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Applies to",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": "
				},
				{
					"insert": "apps/server/src/application/dashboard",
					"attributes": {
						"reference": {
							"kind": "source",
							"path": "apps/server/src/application/dashboard",
							"label": "apps/server/src/application/dashboard"
						}
					}
				},
				{
					"insert": " and every route that executes an action — including every future action added to the contract."
				}
			],
			"children": []
		},
		"b-authority-dispatch-decision-14": {
			"id": "b-authority-dispatch-decision-14",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Decision",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": cycle and knowledge routes implement the design dispatch-authority contract instead of creating parallel authority — guarded dispatch and checkout-mutation commands carry the current lease fencing token, and state plus accepted events persist before the view changes. Background-safe worker evidence through the knowledge sink is the one exempt path because it neither dispatches a worker nor mutates checkout state."
				}
			],
			"children": []
		},
		"b-authority-dispatch-why-15": {
			"id": "b-authority-dispatch-why-15",
			"type": "paragraph",
			"props": {},
			"text": [
				{
					"insert": "Why",
					"attributes": {
						"bold": true
					}
				},
				{
					"insert": ": the rejected alternative was route-local dispatch checks, which would fork authority per route and let two workflows mutate the same checkout."
				}
			],
			"children": []
		},
