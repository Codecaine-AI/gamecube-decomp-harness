    "b-00-overview-table-purpose-8": {
      "id": "b-00-overview-table-purpose-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "| Table | Purpose |\n| --- | --- |\n| "
        },
        {
          "insert": "runs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Session-rooted run goal, baseline identity, desired worker count, status, and nullable project metadata. |\n| "
        },
        {
          "insert": "targets",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Board candidate snapshots retained for status and compatibility with run setup. |\n| "
        },
        {
          "insert": "epochs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Active and historical deterministic epoch configuration, status, progress counters, fast-refresh count, and boundary routing summary. |\n| "
        },
        {
          "insert": "epoch_targets",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Fixed epoch membership rows for admitted targets, with lifecycle statuses "
        },
        {
          "insert": "admitted",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "claimed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "finished",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". |\n| "
        },
        {
          "insert": "target_claims",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Active and closed worker ownership records for epoch targets, including explicit write sets and worktree paths. |\n| "
        },
        {
          "insert": "worker_state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | One runner-owned execution summary per target claim: lifecycle status, worker sessions, artifacts, baseline/best scores, exact flag, and timeout/error summaries. |\n| "
        },
        {
          "insert": "worker_checkpoints",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | One row per runner validation attempt, including failed validations, score movement, hard-gate status, selectable/selected flags, artifact paths, and failure reasons. |\n| "
        },
        {
          "insert": "epoch_verdicts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Target-centric epoch gate outcomes linked to epoch targets after boundary validation. |\n| "
        },
        {
          "insert": "events",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Durable wake events and event payloads. |\n| "
        },
        {
          "insert": "pi_sessions",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Worker and review/curation session metadata. |\n| "
        },
        {
          "insert": "director_cycles",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Legacy board-level decision records retained for old state readability. Current scheduling does not write this table. |\n| "
        },
        {
          "insert": "facts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Reusable evidence accepted or tracked by the board. |\n| "
        },
        {
          "insert": "integrations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Score-gate integration records. |\n| "
        },
        {
          "insert": "run_checkpoints",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | End-of-run checkpoint records that separate PR candidates from carried-forward work. |\n| "
        },
        {
          "insert": "checkpoint_items",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Per-worker-state checkpoint items with lifecycle status, PR-candidate disposition, patch path, summary path, and evidence payload. |\n| "
        },
        {
          "insert": "campaigns",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | One canonical campaign per state dir: the long-lived timeline, session branch, and base ref that runs and save points hang off. |\n| "
        },
        {
          "insert": "save_points",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " | Commit-anchored position records: commit/base SHAs, trigger kind, matched-code percent, report/board artifact paths, and dirty/committed flags. Rows with trigger kind "
        },
        {
          "insert": "epoch",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are written automatically by the epoch cycle and form the run's measured progress history. |"
        }
      ],
      "children": []
    },
