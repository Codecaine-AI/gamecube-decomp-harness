    "b-00-overview-the-orchestrator-app-sta-4": {
      "id": "b-00-overview-the-orchestrator-app-sta-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The orchestrator app state lives in "
        },
        {
          "insert": "<stateDir>/orchestrator.sqlite",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The\nshared storage adapter in "
        },
        {
          "insert": "core/orchestrator-state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " opens that database,\nconfigures SQLite, ensures the runtime DDL, and exposes a Drizzle ORM typed over\nevery orchestrator table. Domain slices keep ownership of behavior: project\nsession lifecycle state stays in "
        },
        {
          "insert": "core/project-session",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", run/epoch/worker state\nstays in "
        },
        {
          "insert": "core/session-runtime/run-state",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and PR save-point/checkpoint state\nstays under the PR phase slice. The live worker runtime is session-rooted:\nepochs admit fixed target batches, workers claim epoch targets, and the runner\nmaintains worker states and validation checkpoints."
        }
      ],
      "children": []
    },
