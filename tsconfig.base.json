{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "bun-types"
    ],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/frontend/src/*"
      ],
      "@server/*": [
        "apps/server/src/*"
      ]
    },
    "jsx": "react-jsx"
  }
}
