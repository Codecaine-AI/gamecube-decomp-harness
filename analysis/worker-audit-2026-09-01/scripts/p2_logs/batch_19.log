rows=list(csv.reader(open('scripts/p2_batches/batch_19.tsv'),delimiter='\\t'))
data=json.load(open('phase2_notes/batch_19.json'))
keys={'ws_id','cohort','epoch','target_key','techniques','stall_reason','success_factor','loop_quality','notable'}
assert len(data)==len(rows)==80
assert [x['ws_id'] for x in data]==[r[0] for r in rows]
assert len({x['ws_id'] for x in data})==80
assert all(set(x)==keys for x in data)
assert all(x['loop_quality'] in {'systematic','mixed','shotgun','unknown'} for x in data)
assert all(x['cohort']==r[1] and x['epoch']==int(r[2]) and x['target_key']==r[3] for x,r in zip(data,rows))
assert all(isinstance(x['techniques'],list) and len(x['techniques'])==len(set(x['techniques'])) for x in data)
assert sum(x['cohort']=='exact' for x in data)==6
md=pathlib.Path('phase2_notes/batch_19.md').read_text()
assert len(md.splitlines())<=60
print('PASS: schema, TSV order/metadata, uniqueness, enums, exact count, Markdown limit')
print('DONE',len(data))
