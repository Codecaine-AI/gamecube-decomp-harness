@@ -0,0 +1,58 @@
+import csv, json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+root=Path('/Users/Ford/Github Repos/Codecaine/gamecube-decomp-harness/analysis/worker-audit-2026-09-01')
+parts=[]
+for i in range(1,5):
+    parts += json.loads(Path(f'/tmp/b07_{i}.json').read_text())
+
+# Normalize only clear synonym variants so cohort counts are meaningful.
+aliases = {
+ 'source-permuter':'permuter', 'stack-layout-analysis':'stack-layout-reasoning',
+ 'stack-frame-analysis':'stack-layout-reasoning', 'stack-frame-diagnostics':'stack-layout-reasoning',
+ 'compiler-stack-diagnostics':'stack-layout-reasoning', 'compiler-regflow-diagnostics':'register-flow-diagnostics',
+ 'regflow-diagnostics':'register-flow-diagnostics', 'ledger-history-review':'prior-ledger-lookup',
+ 'past-ledger-lookup':'prior-ledger-lookup', 'checkpoint-history-review':'checkpoint-restore',
+ 'declaration-reordering':'declaration-order-experiments', 'lifetime-manipulation':'variable-lifetime-experiments',
+ 'local-lifetime-experiments':'variable-lifetime-experiments', 'local-lifetime-shaping':'variable-lifetime-experiments',
+ 'variable-lifetime-shaping':'variable-lifetime-experiments', 'stack-padding-experiments':'stack-padding-tuning',
+ 'stack-padding-experiment':'stack-padding-tuning', 'related-function-comparison':'related-function-lookup',
+ 'past-ledger-lookup':'prior-ledger-lookup',
+}
+for r in parts:
+    r['techniques']=list(dict.fromkeys(aliases.get(x,x) for x in r['techniques']))
+
+tsv=list(csv.reader((root/'scripts/p2_batches/batch_07.tsv').open(),delimiter='\t'))
+assert len(parts)==len(tsv)==80
+assert [r['ws_id'] for r in parts]==[x[0] for x in tsv]
+fields={'ws_id','cohort','epoch','target_key','techniques','stall_reason','success_factor','loop_quality','notable'}
+assert all(set(r)==fields for r in parts)
+assert all(r['loop_quality'] in {'systematic','mixed','shotgun','unknown'} for r in parts)
+assert all(r['cohort']==x[1] and str(r['epoch'])==x[2] and r['target_key']==x[3] for r,x in zip(parts,tsv))
+
+out=root/'phase2_notes'
+out.mkdir(exist_ok=True)
+(out/'batch_07.json').write_text(json.dumps(parts,indent=2)+'\n')
+
+by=defaultdict(Counter)
+for r in parts:
+    by[r['cohort']].update(r['techniques'])
+lines=['# Worker-audit Phase 2 — batch 07','',f'Workers: {len(parts)} (near_miss 20, progressed 26, no_progress 34, exact 0).','', '## Technique counts by cohort','']
+for cohort in ['near_miss','progressed','no_progress','exact']:
+    if not by[cohort]:
+        lines.append(f'- **{cohort}:** none')
+    else:
+        lines.append(f'- **{cohort}:** '+', '.join(f'`{k}` {v}' for k,v in by[cohort].most_common()))
+lines += ['', '## Three most interesting exact-worker accounts','', 'No exact workers appear in batch 07, so there are no exact-worker accounts to rank.', '', '## Most common stall reason by cohort','']
+# Exact phrases are mostly unique; report ties honestly.
+for cohort in ['near_miss','progressed','no_progress','exact']:
+    c=Counter(r['stall_reason'] for r in parts if r['cohort']==cohort and r['stall_reason'])
+    if not c: lines.append(f'- **{cohort}:** none')
+    else:
+        m=max(c.values()); vals=[k for k,v in c.items() if v==m]
+        lines.append(f'- **{cohort}:** '+('tie at 1 each across all recorded reasons' if m==1 else f'`{vals[0]}` ({m})'))
+lines += ['', '## Surprises','', '- Register-allocation reasoning dominated every populated cohort; many residuals were operand-coloring problems after instruction/control-flow shape already matched.', '- Workers repeatedly rejected higher-scoring candidates when they were semantically wrong, implausible authored source, or regressed an exact neighbor.', '- Tooling failures were material: several summaries used qemu-i386 workarounds or could not run official validation.', '- The batch has no exact workers despite containing 20 near misses, so it offers stall evidence but no self-reported closing factors.']
+(out/'batch_07.md').write_text('\n'.join(lines)+'\n')
+assert len(lines)<=60
+print(len(parts),len(lines))

