+ 'signedness-experiment':'signedness-experiments', 'inline-helper-experiments':'inline-hypothesis',
+ 'inline-helper':'inline-hypothesis', 'helper-boundary-experiments':'inline-hypothesis',
+ 'past-source-lookup':'historical-source-lookup', 'past-code-pattern-lookup':'historical-source-lookup',
+ 'matched-sibling-lookup':'sibling-function-lookup', 'solved-sibling-lookup':'sibling-function-lookup',
+ 'section-layout-analysis':'section-layout-reconstruction', 'section-layout-validation':'section-layout-reconstruction',
+ 'stack-frame-analysis':'stack-layout-reasoning', 'stack-frame-shaping':'stack-layout-reasoning',
+ 'stack-frame-reduction':'stack-layout-reasoning', 'stack-slot-analysis':'stack-layout-reasoning',
+ 'alignment-attribute':'alignment-matching', 'alignment-tuning':'alignment-matching',
+ 'declaration-reordering':'declaration-order-experiments', 'declaration-scope-experiments':'declaration-order-experiments',
+ 'source-shape-experiments':'type-shape-experiments', 'expression-shape-experiments':'expression-order-experiments',
+ 'control-flow-experiments':'control-flow-restructure', 'loop-shape-experiments':'loop-restructure',
+ 'typed-overlay':'typed-pointer-overlay', 'pointer-overlay-casts':'typed-pointer-overlay',
+ 'local-lifetime-scoping':'local-lifetime-tuning', 'qa-gate-audit':'qa-gate-analysis',
+}
+for r, m in zip(records, manifest):
+    assert r['ws_id'] == m['ws_id'], (r['ws_id'], m['ws_id'])
+    r['epoch'] = int(r['epoch'])
+    seen=[]
+    for t in r['techniques']:
+        t=aliases.get(t,t)
+        if t not in seen: seen.append(t)
