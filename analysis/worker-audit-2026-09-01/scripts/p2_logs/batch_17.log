+
+out = root/'phase2_notes'
+out.mkdir(exist_ok=True)
+(out/'batch_17.json').write_text(json.dumps(records, indent=2) + '\n')
+
+by = defaultdict(Counter)
+for r in records:
+    by[r['cohort']].update(r['techniques'])
+
+def stall_family(s):
+    if not s: return 'none reported'
+    x=s.lower()
+    if any(k in x for k in ('register','regalloc','coloring','allocation','gpr','fpr','r28','r29','r30','r31')): return 'register allocation'
+    if any(k in x for k in ('stack','frame','slot')): return 'stack layout'
+    if any(k in x for k in ('write set','header','ownership','outside')): return 'ownership or write-set constraint'
+    if any(k in x for k in ('schedul','order')): return 'instruction or data ordering'
+    return s
+
+sf=defaultdict(Counter)
+for r in records:
+    if r['cohort']!='exact': sf[r['cohort']][stall_family(r['stall_reason'])]+=1
+
+lines=['# Batch 17 self-summary audit','',f'Workers: {len(records)}. Cohorts: exact 13, near_miss 25, progressed 21, no_progress 21.','', '## Technique counts by cohort','']
+for cohort in ('exact','near_miss','progressed','no_progress'):
+    vals=', '.join(f'`{k}` {v}' for k,v in sorted(by[cohort].items(), key=lambda x:(-x[1],x[0])))
+    lines.append(f'- {cohort}: {vals}')
+lines += ['', '## Three exact-worker accounts', '',
+'- `d9cd08e1-966a-4667-8ce6-6548233612c5`: Moving GObj creation back to the caller restored the caller/callee boundary, then guarded repeated assignment and literal ordering closed allocator and section-order mismatches. The final QA repair was only a helper-parameter rename after a lint false positive.',
+'- `cd4c9889-abad-47f2-aa7f-5badafdda93f`: The worker reconstructed 65 ClassicStageEntry records, four strings, storage scope, and definition order. That placed the jump table correctly and matched all 1,272 data bytes.',
+'- `91264074-9e53-4179-b9f4-849a08d23ef8`: Scoped `u8*` cursor walks and typed byte accesses grew the generating function by exactly 0xB4 bytes. Reaching the target 0x3BA0 function size made extabindex exact.',
+'', '## Most common stall family by cohort', '']
+for cohort in ('near_miss','progressed','no_progress'):
+    fam,n=sf[cohort].most_common(1)[0]
+    lines.append(f'- {cohort}: {fam} ({n}/{sum(sf[cohort].values())})')
+lines += ['- exact: none; exact workers have null stall reasons.','', '## Surprises','',
+'- Several non-exact records describe locally measured 100% candidates that were reverted for ownership, write-set, or source-quality gates. Score alone therefore understates useful diagnosis in this batch.',
+'- `089276d9-6c7a-4187-a0a9-2dffaef44dbb` is labeled near_miss, but its summary says the existing 144-byte BSS was already exact and no edit was needed.',
+'- The dominant failure was register allocation, not missing semantics. Workers often moved one value into the target register only to rotate a larger live-range clique.']
+assert len(lines) <= 60, len(lines)
+(out/'batch_17.md').write_text('\n'.join(lines)+'\n')
+print(len(records), len(lines))

