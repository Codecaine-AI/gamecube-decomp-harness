diff --git a//tmp/build_batch11.mjs b//tmp/build_batch11.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..010d9ea1018008cedb088555143b552c53c89bbd
--- /dev/null
+++ b//tmp/build_batch11.mjs
@@ -0,0 +1,80 @@
+import fs from 'fs';
+
+const base = '/Users/Ford/Github Repos/Codecaine/gamecube-decomp-harness/analysis/worker-audit-2026-09-01';
+const parts = Array.from({length: 8}, (_, i) => `${base}/phase2_notes/.batch_11_part_${String(i + 1).padStart(2, '0')}.json`);
+let rows = parts.flatMap(p => JSON.parse(fs.readFileSync(p, 'utf8')));
+
+const canon = (s) => {
+  const rules = [
+    [/^(allocator-(snapshot|capture|diagnostics|snapshot-analysis)|pcode-lowering-analysis)$/, 'allocator-analysis'],
+    [/^(declaration-(order|ordering|reordering|order-experiments)|initialization-order-tuning)$/, 'declaration-ordering'],
+    [/^(scope-|variable-scope|scoped-lifetime|variable-lifetime|lifetime-shaping|declaration-scope|scope-narrowing|variable-scope-tuning)/, 'lifetime-scope-control'],
+    [/^(stack-padding|stack-padding-tuning|stack-padding-adjustment|stack-padding-removal|stack-padding-experiments)$/, 'stack-padding-tuning'],
+    [/^(stack-layout|aggregate-stack-layout|stack-layout-shaping|stack-layout-reasoning)($|-)/, 'stack-layout-reasoning'],
+    [/^(helper-boundary|helper-shape|inline-helper|helper-extraction|inline-removal|accessor-refactor|inline-accessor-restructure|canonical-inline-restore|inline-helper-extraction)/, 'inline-helper-shaping'],
+    [/^(past-|historical-|same-file-pattern|sibling-|past-function|past-source|past-code)/, 'source-pattern-lookup'],
+    [/^(expression-(shape|regrouping|reassociation|reorder)|operand-order|comparison-operand-reordering|assignment-order|comparator-orientation|comparison-rewrite|loop-comparison-reorder)/, 'expression-shape-experiments'],
+    [/^(pointer-walk|typed-pointer-walk|pointer-advance|pointer-advancement|pointer-stride-loop|pointer-induction-shape)/, 'pointer-loop-restructure'],
+    [/^(relocation-|relocation-analysis|data-section-ownership-analysis|constant-section-ownership|translation-unit-split-diagnosis)/, 'relocation-data-analysis'],
+    [/^(string-pool-analysis|literal-pool-ordering|constant-pool-ordering|sdata2-ordering|sdata2-order-reconstruction|sdata2-order-repair|data-order-reconstruction)$/, 'constant-pool-ordering'],
+    [/^(temporary-elimination|scoped-temporary-removal|local-alias-removal|alias-removal|variable-consolidation|dead-store-removal)$/, 'temporary-elimination'],
+    [/^(type-shape-experiments|typed-data-overlay|typed-overlay|type-overlay-experiments|packed-data-overlay|byte-view-pointer-shape|typed-pointer-view|typed-pointer-alias|typed-row-pointer|typed-field-access|typed-accessor)$/, 'type-shape-experiments'],
+    [/^(register-allocation-reasoning|float-register-reasoning)$/, 'register-allocation-reasoning'],
+    [/^(instruction-scheduling|instruction-scheduling-reasoning)$/, 'instruction-scheduling-reasoning'],
+    [/^(checkpoint-restore|neighbor-regression-check|data-section-preservation)$/, 'checkpoint-regression-check'],
+    [/^(permuter|persistent-objdiff-search)$/, 'permuter'],
+    [/^(inline-hypothesis)$/, 'inline-hypothesis'],
+    [/^(loop-restructure|control-flow-restructure|pointer-walk-loop)$/, 'loop-restructure'],
+  ];
+  for (const [re, out] of rules) if (re.test(s)) return out;
+  return s;
+};
+
+rows = rows.map(r => ({...r, epoch: Number(r.epoch), techniques: [...new Set(r.techniques.map(canon))]}));
+const tsv = fs.readFileSync(`${base}/scripts/p2_batches/batch_11.tsv`, 'utf8').trim().split('\n').map(x => x.split('\t'));
+if (rows.length !== 80) throw new Error(`record count ${rows.length}`);
+for (let i = 0; i < 80; i++) {
+  if (rows[i].ws_id !== tsv[i][0]) throw new Error(`order mismatch row ${i+1}: ${rows[i].ws_id} != ${tsv[i][0]}`);
+  if (rows[i].cohort !== tsv[i][1] || rows[i].target_key !== tsv[i][3]) throw new Error(`metadata mismatch row ${i+1}`);
+}
+fs.writeFileSync(`${base}/phase2_notes/batch_11.json`, JSON.stringify(rows, null, 2) + '\n');
+
+const cohorts = ['exact','near_miss','progressed','no_progress'];
+const counts = {};
+for (const c of cohorts) {
+  const m = new Map();
+  for (const r of rows.filter(x => x.cohort === c)) for (const t of r.techniques) m.set(t, (m.get(t)||0)+1);
+  counts[c] = [...m].sort((a,b) => b[1]-a[1] || a[0].localeCompare(b[0]));
+}
+const category = s => {
+  if (!s) return null;
+  if (/register|GPR|FPR|coloring|coalesc|allocation/i.test(s)) return 'register allocation';
+  if (/stack|frame|slot/i.test(s)) return 'stack layout';
+  if (/relocation|constant.pool|section ownership|symbol/i.test(s)) return 'relocation/data ownership';
+  if (/schedul/i.test(s)) return 'instruction scheduling';
+  if (/prototype|header declaration|signature/i.test(s)) return 'prototype/header mismatch';
+  return s;
+};
+const stalls = {};
+for (const c of cohorts) {
+  const m = new Map();
+  for (const r of rows.filter(x => x.cohort === c)) { const k=category(r.stall_reason); if(k) m.set(k,(m.get(k)||0)+1); }
+  stalls[c] = [...m].sort((a,b)=>b[1]-a[1] || a[0].localeCompare(b[0]))[0] || null;
+}
+const exact = rows.filter(r => r.cohort === 'exact');
+const pickIds = ['93eea2a1-b33b-4c88-a0e1-a40ea1f75fa7','35747593-d2cb-4c74-8cc0-846304c17844','4d365749-1fce-48b7-b930-a9823c9e851c'];
+const selected = pickIds.map(id => exact.find(r=>r.ws_id===id)).filter(Boolean);
+let md = '# Batch 11 Worker Self-Summary Audit\n\n';
+md += `Records: ${rows.length}. Cohorts: ${cohorts.map(c=>`${c} ${rows.filter(r=>r.cohort===c).length}`).join(', ')}.\n\n`;
+md += '## Technique Counts by Cohort\n\n';
+for (const c of cohorts) md += `- ${c}: ${counts[c].map(([k,v])=>`${k} ${v}`).join('; ')}\n`;
+md += '\n## Three Exact-Worker Accounts\n\n';
+for (const r of selected) md += `- ${r.ws_id}: ${r.success_factor}. ${r.notable || 'The worker reported no additional unusual detail.'}\n`;
+md += '\n## Most Common Stall Reason\n\n';
+for (const c of cohorts) md += `- ${c}: ${stalls[c] ? `${stalls[c][0]} (${stalls[c][1]})` : 'none; exact workers reported no stall'}\n`;
+md += '\n## Surprise\n\n';
+md += '- `ac74828b-a06f-49f6-894a-5447e56732c3` is labeled no_progress at 97.870094%, but all five self-summaries claim an exact 100% result. The discrepancy is in the source evidence and should be checked against the scorer history.\n';
+fs.writeFileSync(`${base}/phase2_notes/batch_11.md`, md);
+
+for (const p of parts) fs.unlinkSync(p);
+console.log(JSON.stringify({records: rows.length, exact: exact.length, markdownLines: md.trimEnd().split('\n').length, stalls}, null, 2));

