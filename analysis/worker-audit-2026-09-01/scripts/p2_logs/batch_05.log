keys={'ws_id','cohort','epoch','target_key','techniques','stall_reason','success_factor','loop_quality','notable'}
assert len(data)==80
assert [x['ws_id'] for x in data]==[r[0] for r in tsv]
assert all(set(x)==keys for x in data)
assert all(x['loop_quality'] in {'systematic','mixed','shotgun','unknown'} for x in data)
assert all(isinstance(x['techniques'],list) and len(x['techniques'])==len(set(x['techniques'])) for x in data)
assert all((x['success_factor'] is not None)==(x['cohort']=='exact') for x in data)
lines=sum(1 for _ in open(base+'.md'))
assert lines<=60
print('json_records',len(data))
print('cohorts', {c:sum(x['cohort']==c for x in data) for c in ('exact','near_miss','progressed','no_progress')})
print('md_lines',lines)
