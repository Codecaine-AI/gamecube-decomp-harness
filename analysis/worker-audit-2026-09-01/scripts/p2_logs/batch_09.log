import csv,json,collections
p='phase2_notes/batch_09.json'; d=json.load(open(p)); rows=list(csv.reader(open('scripts/p2_batches/batch_09.tsv'),delimiter='\\t'))
assert len(d)==len(rows)==80 and len({x['ws_id'] for x in d})==80
assert [x['ws_id'] for x in d]==[r[0] for r in rows]
coh=['exact','near_miss','progressed','no_progress']; counts={c:collections.Counter(t for x in d if x['cohort']==c for t in x['techniques']) for c in coh}
tech=sorted(set().union(*counts.values()),key=lambda t:(-sum(counts[c][t] for c in coh),t))
lines=['# Batch 09 Self-Summary Sweep','','## Technique Counts by Cohort','',f'Workers: exact 4, near_miss 17, progressed 40, no_progress 19.','', '| Technique | Exact | Near miss | Progressed | No progress |','|---|---:|---:|---:|---:|']
for t in tech: lines.append('| '+t+' | '+' | '.join(str(counts[c][t]) for c in coh)+' |')
lines += ['','## Three Exact Accounts','','- "'`b9db3bdd-3451-46b9-9806-8aa6fe1c22a5`: The worker traced the gap to three by-value `GXColor` temporaries occupying the wrong stack slots. Two deliberately used padding locals moved them to `0x118`, `0x11C`, and `0x120` and closed the match.'"','- "'`58db912a-2eab-4092-b18b-265938ac6a7b`: A two-instruction mismatch came from condition-register placement, confirmed with PCode counts. A scoped `MUST_MATCH` `u16` copy moved the condition-record update into place.'"','- "'`a9872728-d65f-4b92-8804-86dabc0f33bd`: Ordinary typed pointer forms emitted the wrong address operands. A local pointer-view union plus a byte cursor preserved typed access and produced exact `+0x74` and `+0x75` addressing.'"','','## Common Stall Reasons','','- Exact: none. All four accounts name a closing change.','- Near miss: register allocation or register coloring, 10 of 17 accounts.','- Progressed: register allocation or register coloring, 35 of 40 accounts.','- No progress: register allocation or register coloring, 13 of 19 accounts.','','## Surprise','','All 80 workers left summaries. The exact fixes were unusually structural: explicit stack padding, condition-register steering, a typed pointer union, and typed aliases that resolved a persistent saved-register swap.']
assert len(lines)<=60,len(lines)
open('/tmp/batch09.md','w').write('\\n'.join(lines)+'\\n')
print('json records',len(d),'markdown lines',len(lines),'techniques',len(tech))
