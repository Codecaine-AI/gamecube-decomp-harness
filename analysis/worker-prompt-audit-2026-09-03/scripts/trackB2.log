   326	    systemPrompt: renderXmlMarkdown(isSectionTarget(options.packet) ? sectionTargetPrompt : prompt),
   327	    userPrompt: "",
   328	    systemTemplatePath: agentFilePath(),
   329	    userTemplatePath: promptFilePath(),
   330	    kernelContext: buildWorkerKernelContext(options),
   331	  };
   332	}
