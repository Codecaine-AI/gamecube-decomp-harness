   315	function isSectionTarget(packet: Record<string, unknown>): boolean {
   316	  const target = packet.target;
   317	  if (!target || typeof target !== "object" || Array.isArray(target)) return false;
   318	  const targetRecord = target as Record<string, unknown>;
   319	  if (targetRecord.kind === "section") return true;
   320	  if (targetRecord.kind === "function") return false;
   321	  return String(targetRecord.symbol ?? "").startsWith(".");
   322	}
   323	
   324	export function workerPrompt(options: WorkerPromptOptions): PiPromptBundle {
