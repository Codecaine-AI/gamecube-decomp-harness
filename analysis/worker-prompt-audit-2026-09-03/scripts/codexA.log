+      )}`;
+    });
+    return [
+      `    <first_diff${attrs}>`,
+      `        ${xmlText(summary)}`,
+      ...rowLines,
+      "    </first_diff>",
+    ].join("\n");
+  };
+
+  let rendered = render();
+  while (rendered.length > FIRST_DIFF_CHAR_LIMITS[contextBudget] && rows.length) {
+    rows = rows.slice(0, -1);
+    truncated = true;
+    rendered = render();
+  }
