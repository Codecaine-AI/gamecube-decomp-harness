+      )}`;
+    });
+    return [
+      `    <first_diff${attrs}>`,
+      `        ${xmlText(summary)}`,
+      ...rowLines,
+      "    </first_diff>",
+    ].join("\n");
+  };
+
+  let rendered = render();
