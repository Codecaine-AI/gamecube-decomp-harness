        "worker-packet",
        "target-knowledge-card-v2",
      ]);
      expect(second.kernelContext?.renderedContext).toBe(renderedContext);
    } finally {
      if (previous === undefined) delete process.env.ORCH_GAME_KNOWLEDGE_ROOT;
