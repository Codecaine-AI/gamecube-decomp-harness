   140	export function buildV2TargetCard(
   141	  store: KnowledgeStoreHandle,
   142	  stableKey: string,
   143	  budget: V2CardBudget,
   144	): V2TargetCard | null {
   145	  const target = store.db.query<TargetRow, [string]>(
   146	    "SELECT * FROM target WHERE stable_key = ? AND identity_status = 'current'",
   147	  ).get(stableKey);
   148	  if (!target) return null;
   149	
   150	  const unit = unitView(store).find((row) => row.unit.id === target.unit_entity_id);
   151	  if (!unit) return null;
   152	
   153	  const ledgerRows = targetLedger(store, target.id);
   154	  const record = knowledgeRecord(store, { targetId: target.id });
   155	  if (ledgerRows.length === 0 && Object.keys(record.facts).length === 0) return null;
   156	
   157	  const statusRow = store.db.query<TargetStatusRow, [string]>(
   158	    "SELECT match_pct, linked, size FROM target_status WHERE target_id = ?",
   159	  ).get(target.id);
   160	  const status = statusRow
   161	    ? { match_pct: statusRow.match_pct, linked: Boolean(statusRow.linked), size: statusRow.size }
   162	    : null;
   163	
   164	  const card: V2TargetCard = {
   165	    stable_key: stableKey,
   166	    target: {
   167	      kind: target.kind,
   168	      unit: target.unit,
   169	      symbol: target.symbol,
   170	      source_path: unit.unit.locator,
   171	      identity_status: target.identity_status,
   172	    },
   173	    context_budget: budget,
   174	    ledger: buildLedger(ledgerRows, budget),
   175	    status,
   176	    facts: {
   177	      naming_note: CARD_NAMING_NOTE,
   178	      by_type: buildFactMap(record),
   179	    },
   180	    links: buildLinks(store, record.links, budget),
   181	  };
   182	  return card;
   183	}
