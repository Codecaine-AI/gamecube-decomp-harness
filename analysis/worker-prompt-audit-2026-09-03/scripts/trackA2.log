   105	function readSubject(store: KnowledgeStoreHandle, subject: SubjectRef): SubjectIdentity | null {
   106	  if (subject.targetId !== undefined) {
   107	    const row = store.db.query<any, [string]>("SELECT * FROM target WHERE id = ?").get(subject.targetId);
   108	    return row ? { subjectKind: "target", id: row.id, kind: row.kind, stableKey: row.stable_key, unit: row.unit, symbol: row.symbol, address: row.address, identityStatus: row.identity_status } : null;
   109	  }
   110	  const row = store.db.query<any, [string]>("SELECT * FROM entity WHERE id = ?").get(subject.entityId);
   111	  return row ? { subjectKind: "entity", id: row.id, kind: row.kind, locator: row.locator, identityStatus: row.identity_status } : null;
   112	}
   113	
   114	function readLinks(store: KnowledgeStoreHandle, subject: SubjectRef): KnowledgeLink[] {
   115	  const isTarget = subject.targetId !== undefined;
   116	  const id = subject.targetId ?? subject.entityId!;
   117	  const fromColumn = isTarget ? "from_target_id" : "from_entity_id";
   118	  const toColumn = isTarget ? "to_target_id" : "to_entity_id";
   119	  const rows = store.db.query<LinkRow, [string, string, string, string, string, string, string]>(`
   120	    SELECT l.id, CASE WHEN l.${fromColumn} = ? THEN 'outgoing' ELSE 'incoming' END AS direction,
   121	      l.role, l.why, l.kind AS source_kind, l.locator AS source_locator, l.digest,
   122	      CASE WHEN l.${fromColumn} = ? THEN l.to_target_id ELSE l.from_target_id END AS other_target_id,
   123	      CASE WHEN l.${fromColumn} = ? THEN l.to_entity_id ELSE l.from_entity_id END AS other_entity_id,
   124	      t.kind AS target_kind, t.stable_key, t.unit, t.symbol, t.address,
   125	      t.identity_status AS target_identity_status,
   126	      e.kind AS entity_kind, e.locator AS entity_locator, e.identity_status AS entity_identity_status
   127	    FROM link l
   128	    LEFT JOIN target t ON t.id = CASE WHEN l.${fromColumn} = ? THEN l.to_target_id ELSE l.from_target_id END
   129	    LEFT JOIN entity e ON e.id = CASE WHEN l.${fromColumn} = ? THEN l.to_entity_id ELSE l.from_entity_id END
   130	    WHERE l.${fromColumn} = ? OR l.${toColumn} = ?
   131	    ORDER BY l.id
   132	  `).all(id, id, id, id, id, id, id);
   133	  return rows.map((row) => ({
   134	    id: row.id, direction: row.direction, role: row.role, why: row.why,
   135	    kind: row.source_kind, locator: row.source_locator, digest: row.digest,
   136	    other: row.other_target_id !== null
   137	      ? { subjectKind: "target", id: row.other_target_id, kind: row.target_kind!, stableKey: row.stable_key!, unit: row.unit!, symbol: row.symbol, address: row.address, identityStatus: row.target_identity_status! }
   138	      : { subjectKind: "entity", id: row.other_entity_id!, kind: row.entity_kind!, locator: row.entity_locator!, identityStatus: row.entity_identity_status! },
   139	  }));
   140	}
