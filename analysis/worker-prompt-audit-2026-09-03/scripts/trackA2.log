   701	function workerTargetKnowledgeCardV2Xml(
   702	  packet: Record<string, unknown>,
   703	  game: RunGameMetadata | undefined,
   704	  contextBudget: WorkerPromptContextBudget,
   705	): string {
   706	  const target = asRecord(packet.target);
   707	  const unit = optionalString(target.unit);
   708	  if (!unit) return "";
   709	  const card = loadV2TargetCard({
   710	    gameId: game?.gameId,
   711	    unit,
   712	    symbol: optionalString(target.symbol) ?? null,
   713	    budget: contextBudget,
   714	  });
   715	  return card ? targetKnowledgeCardV2Xml(card) : "";
   716	}
