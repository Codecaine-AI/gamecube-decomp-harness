   128	  size: number | null;
   129	}
   130	
   131	const CARD_NAMING_NOTE =
   132	  "The target.symbol column is the only name a worker may write into source. inferred_name facts are guesses, not canonical names.";
   133	
   134	const BUDGET_CAPS: Record<V2CardBudget, { ledgerEntries: number; links: number; linkedFacts: number }> = {
   135	  full: { ledgerEntries: 20, links: 8, linkedFacts: 3 },
   136	  compact: { ledgerEntries: 8, links: 4, linkedFacts: 1 },
   137	  minimal: { ledgerEntries: 3, links: 2, linkedFacts: 0 },
   138	};
