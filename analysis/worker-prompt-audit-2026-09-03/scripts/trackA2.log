   197	export function loadV2TargetCard(options: {
   198	  gameId?: string;
   199	  unit: string;
   200	  symbol?: string | null;
   201	  budget: V2CardBudget;
   202	}): V2TargetCard | null {
   203	  if (!options.unit) return null;
   204	  const stableKey = options.symbol ? `${options.unit}:${options.symbol}` : options.unit;
   205	  const dbPath = resolve(gameKnowledgeRoot(options.gameId ?? "melee"), "knowledge.sqlite");
   206	  if (!existsSync(dbPath)) return null;
   207	
   208	  let db: Database | null = null;
   209	  try {
   210	    db = new Database(dbPath, { readonly: true });
   211	    return buildV2TargetCard({ db }, stableKey, options.budget);
   212	  } catch {
   213	    return null;
   214	  } finally {
   215	    if (db) db.close();
   216	  }
   217	}
   218	
   219	function buildLedger(entries: TargetLedgerEntry[], budget: V2CardBudget): V2CardLedger {
   220	  const cappedEntries = entries.slice(0, BUDGET_CAPS[budget].ledgerEntries).map(toLedgerEntry);
   221	  const regressionCount = entries.filter((entry) => entry.type === "event" && entry.isRegression).length;
   222	  const ledger: V2CardLedger = {
   223	    ...(regressionCount > 0 ? { regression_count: regressionCount } : {}),
   224	    runs: summarizeRuns(entries),
   225	    entries: cappedEntries,
   226	  };
   227	  return ledger;
   228	}
   229	
   230	function summarizeRuns(entries: TargetLedgerEntry[]): V2LedgerRun[] {
   231	  const runs = new Map<string, V2LedgerRun>();
   232	  for (const entry of entries) {
   233	    if (entry.type !== "submission") continue;
   234	    const existing = runs.get(entry.workerRun.id);
   235	    if (existing) {
   236	      existing.submission_count += 1;
   237	      if (entry.score > existing.best_score) existing.best_score = entry.score;
   238	      continue;
   239	    }
   240	    runs.set(entry.workerRun.id, {
   241	      final_outcome: entry.workerRun.finalOutcome,
   242	      integration: entry.workerRun.integration,
   243	      submission_count: 1,
   244	      best_score: entry.score,
   245	    });
   246	  }
   247	  return [...runs.values()];
   248	}
   249	
   250	function toLedgerEntry(entry: TargetLedgerEntry): V2LedgerEntry {
   251	  if (entry.type === "event") {
   252	    return {
   253	      type: "event",
   254	      kind: entry.kind,
   255	      cause: entry.cause,
   256	      summary: entry.summary,
   257	      ...(entry.isRegression ? { regression: true } : {}),
   258	    };
   259	  }
   260	  if (entry.type === "submission") {
   261	    return {
   262	      type: "submission",
   263	      seq: entry.seq,
   264	      description: entry.description,
   265	      score: entry.score,
   266	      run_outcome: entry.workerRun.finalOutcome,
   267	      integration: entry.workerRun.integration,
   268	      ...(entry.workerRun.integration === "conflicted"
   269	        ? { conflict_paths: entry.workerRun.integrationDetail?.conflict_paths.slice(0, 10) ?? [] }
   270	        : {}),
   271	    };
   272	  }
   273	  return {
   274	    type: "pull_request",
   275	    pr_ref: entry.prRef,
   276	    outcome: entry.outcome,
   277	    attribution: entry.attribution,
   278	    summary: entry.summary,
   279	  };
   280	}
   281	
   282	function buildFactMap(record: ReturnType<typeof knowledgeRecord>): Partial<Record<string, V2FactSummary>> {
   283	  const byType: Partial<Record<string, V2FactSummary>> = {};
   284	  for (const [type, fact] of Object.entries(record.facts)) {
   285	    if (!fact) continue;
   286	    byType[type] = {
   287	      value: formatFactValue(fact.type, fact.value, fact.confidence),
   288	      rationale: fact.rationale,
   289	      confidence: fact.confidence,
   290	    };
   291	  }
   292	  return byType;
   293	}
   294	
   295	function buildLinks(
   296	  store: KnowledgeStoreHandle,
