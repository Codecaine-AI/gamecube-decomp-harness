   417	      reason: "Knowledge graph DB is not available.",
   418	    };
   419	  const store = openKnowledgeGraph(graphDb);
   420	  try {
   421	    return {
   422	      card: fileGraphCard(store, sourcePath) as unknown as Record<
   423	        string,
   424	        unknown
   425	      >,
   426	      graphDb,
   427	      status: "ready",
   428	      reason: null,
   429	    };
   430	  } catch (error) {
   431	    return {
   432	      card: {},
   433	      graphDb,
   434	      status: "failed",
   435	      reason: error instanceof Error ? error.message : String(error),
   436	    };
   437	  } finally {
   438	    store.db.close();
   439	  }
   440	}
