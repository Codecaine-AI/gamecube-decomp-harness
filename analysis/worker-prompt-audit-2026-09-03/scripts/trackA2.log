    80	export function knowledgeRecord(store: KnowledgeStoreHandle, subjectRef: SubjectRef): KnowledgeRecord {
    81	  const column = subjectRef.targetId !== undefined ? "target_id" : "entity_id";
    82	  const id = subjectRef.targetId ?? subjectRef.entityId!;
    83	  const facts: Partial<Record<FactType, KnowledgeFact>> = {};
    84	  const factRows = store.db.query<FactEvidenceRow, [string]>(`
    85	    SELECT f.id AS fact_id, f.type, f.value, f.rationale, f.confidence, f.updated_at,
    86	      e.id AS evidence_id, e.kind AS evidence_kind, e.locator AS evidence_locator,
    87	      e.digest AS evidence_digest, e.why AS evidence_why, e.captured_at AS evidence_captured_at
    88	    FROM fact f LEFT JOIN evidence e ON e.fact_id = f.id
    89	    WHERE f.${column} = ? ORDER BY f.type, e.captured_at, e.id
    90	  `).all(id);
    91	  for (const row of factRows) {
    92	    const fact = facts[row.type] ??= {
    93	      id: row.fact_id, type: row.type, value: row.value, rationale: row.rationale,
    94	      confidence: row.confidence, updatedAt: row.updated_at, evidence: [],
    95	    };
    96	    if (row.evidence_id !== null) fact.evidence.push({
    97	      id: row.evidence_id, kind: row.evidence_kind!, locator: row.evidence_locator!,
    98	      digest: row.evidence_digest, why: row.evidence_why!, capturedAt: row.evidence_captured_at!,
    99	    });
   100	  }
   101	
   102	  return { subject: readSubject(store, subjectRef), facts, links: readLinks(store, subjectRef) };
   103	}
