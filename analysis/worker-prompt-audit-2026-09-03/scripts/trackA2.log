    43	/** Returns target activity newest first. Equal timestamps are ordered by type and id. */
    44	export function targetLedger(store: KnowledgeStoreHandle, targetId: string): TargetLedgerEntry[] {
    45	  const submissionEntries: TargetLedgerEntry[] = store.db.query<SubmissionRow, [string]>(`
    46	    SELECT s.id AS submission_id, s.seq, s.description, s.hypothesis, s.score, s.submitted_at, s.runtime_ref,
    47	      w.id AS worker_run_id, w.goal, w.baseline, w.run_id, w.worker_state_id, w.final_outcome,
    48	      w.error_type, w.integration, w.integration_detail, w.started_at, w.ended_at, w.closed_at,
    49	      n.summary AS narrative_summary
    50	    FROM submission s JOIN worker_run w ON w.id = s.worker_run_id
    51	    LEFT JOIN run_narrative n ON n.worker_run_id = w.id
    52	    WHERE w.target_id = ?
    53	  `).all(targetId).map((row) => ({
    54	    type: "submission", timestamp: row.submitted_at, id: row.submission_id, seq: row.seq,
    55	    description: row.description, hypothesis: row.hypothesis, score: row.score, runtimeRef: row.runtime_ref,
    56	    workerRun: { id: row.worker_run_id, goal: row.goal, baseline: parseBaseline(row.baseline), runId: row.run_id,
    57	      summary: row.narrative_summary,
    58	      workerStateId: row.worker_state_id, finalOutcome: row.final_outcome, errorType: row.error_type,
    59	      integration: row.integration, integrationDetail: parseIntegrationDetail(row.integration_detail),
    60	      startedAt: row.started_at, endedAt: row.ended_at, closedAt: row.closed_at },
    61	    isRegression: false,
    62	  }));
    63	  const prEntries: TargetLedgerEntry[] = store.db.query<PullRequestRow, [string]>(`
    64	    SELECT p.id, p.pr_ref, p.summary, p.outcome, p.merged_at,
    65	      CASE WHEN p.target_id = t.id THEN 'target' ELSE 'unit' END AS attribution
    66	    FROM target t
    67	    JOIN pull_request p
    68	      ON p.target_id = t.id OR p.entity_id = t.unit_entity_id
    69	    WHERE t.id = ?
    70	  `).all(targetId).map((row) => ({
    71	    type: "pull_request", timestamp: row.merged_at, id: row.id, prRef: row.pr_ref,
    72	    summary: row.summary, outcome: row.outcome, attribution: row.attribution, isRegression: false,
    73	  }));
    74	  const eventEntries: TargetLedgerEntry[] = store.db.query<any, [string]>(`
    75	    SELECT e.*, r.ref_kind, r.ref_id FROM event e
    76	    LEFT JOIN event_ref r ON r.event_id = e.id WHERE e.target_id = ?
    77	    ORDER BY e.id, r.ref_kind, r.ref_id
    78	  `).all(targetId).reduce<TargetLedgerEntry[]>((entries, row) => {
    79	    let entry = entries.find((candidate) => candidate.type === "event" && candidate.id === row.id);
    80	    if (!entry) {
    81	      entry = { type: "event", timestamp: row.created_at, id: row.id, kind: row.kind, cause: row.cause,
    82	        summary: row.summary, refs: [], isRegression: row.kind === "regression" };
    83	      entries.push(entry);
    84	    }
    85	    if (entry.type === "event" && row.ref_kind !== null) entry.refs.push({ refKind: row.ref_kind, refId: row.ref_id });
    86	    return entries;
    87	  }, []);
    88	  return [...submissionEntries, ...prEntries, ...eventEntries].sort((a, b) =>
    89	    b.timestamp.localeCompare(a.timestamp) || a.type.localeCompare(b.type) || a.id.localeCompare(b.id));
    90	}
