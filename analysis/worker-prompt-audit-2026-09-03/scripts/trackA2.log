   686	function targetGraphFileCardXml(
   687	  packet: Record<string, unknown>,
   688	  game?: RunGameMetadata,
   689	  contextBudget: WorkerPromptContextBudget = "full",
   690	): string {
   691	  const compactCard = compactTargetGraphFileCard(packet, game, contextBudget);
   692	  const status = optionalString(compactCard.status);
   693	  const unavailable = status && status !== "ready" ? ' unavailable="true"' : "";
   694	  return [
   695	    `    <target_graph_file_card context_budget="${contextBudget}"${unavailable}>`,
   696	    jsonBlockXml("details_json", compactCard),
   697	    "    </target_graph_file_card>",
   698	  ].join("\n");
   699	}
