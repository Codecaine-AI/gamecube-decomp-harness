   442	function compactTargetGraphFileCard(
   443	  packet: Record<string, unknown>,
   444	  game?: RunGameMetadata,
   445	  contextBudget: WorkerPromptContextBudget = "full",
   446	): Record<string, unknown> {
   447	  const target = asRecord(packet.target);
   448	  const sourcePath = String(target.source_path ?? "");
   449	  const targetSymbol = optionalString(target.symbol);
   450	  const targetUnit = optionalString(target.unit);
   451	  const targetStableKey = targetUnit
   452	    ? [targetUnit, targetSymbol].filter(Boolean).join(":")
   453	    : undefined;
   454	  const fromPacket = fileCardFromPacket(packet);
   455	  const loaded = Object.keys(fromPacket.card).length
   456	    ? { ...fromPacket, status: fromPacket.status ?? "ready" }
   457	    : fileCardFromGraph(sourcePath, game, fromPacket.graphDb);
   458	  const card = loaded.card;
   459	  if (!Object.keys(card).length) {
   460	    return compactObject({
   461	      status: loaded.status ?? "unavailable",
   462	      source: "code_graph_file_card",
   463	      graph_db: loaded.graphDb,
   464	      source_path: sourcePath,
   465	      reason: loaded.reason,
   466	      has_graph_context: false,
   467	      search_leads: {
   468	        symbols: compactObject({
   469	          source_path: sourcePath,
   470	        }),
   471	        follow_up_queries: [
   472	          compactObject({
   473	            tool: "code_graph_file_card",
   474	            source_path: sourcePath,
   475	          }),
   476	          compactObject({ tool: "code_graph_search", query: sourcePath }),
   477	          compactObject({
   478	            tool: "knowledge_graph_search",
   479	            query: [sourcePath, optionalString(target.symbol)].filter(Boolean).join(" "),
   480	          }),
   481	          ...(targetStableKey
   482	            ? [
   483	                compactObject({
   484	                  tool: "kv2_subject_record",
   485	                  target_stable_key: targetStableKey,
   486	                }),
   487	                compactObject({
   488	                  tool: "kv2_attempt_search",
   489	                  target_stable_key: targetStableKey,
   490	                }),
   491	              ]
   492	            : []),
   493	        ],
   494	      },
   495	      no_context_note:
   496	        loaded.reason ??
   497	        "No graph context is attached to this target source path.",
   498	    });
   499	  }
   500	
   501	  const functions = asRecordArray(card.functions)
   502	    .map(compactFunction)
   503	    .filter((fn) => Object.keys(fn).length > 0);
   504	  const targetFunction =
   505	    functions.find(
   506	      (fn) =>
   507	        functionName(fn) === targetSymbol ||
   508	        optionalString(fn.symbol) === targetSymbol,
   509	    ) ?? null;
   510	  const sameFileFunctions = functions.filter((fn) => fn !== targetFunction);
   511	  const prHistory = asRecord(card.pr_history);
   512	  const mismatchPatterns = asRecordArray(card.mismatch_patterns);
   513	  const touchingPrs = asRecordArray(prHistory.touching_prs);
   514	  const resourceHits = asRecordArray(card.resource_hits);
   515	  const opseqAnalogs = asRecordArray(card.tool_hits).filter(
   516	    (hit) => optionalString(hit.tool_id) === "opseq",
   517	  );
   518	  const topOpseqAnalog = opseqAnalogs.reduce<Record<string, unknown> | null>(
   519	    (best, hit) => {
   520	      if (!best) return hit;
   521	      const bestScore = optionalNumber(best.score) ?? Number.NEGATIVE_INFINITY;
   522	      const hitScore = optionalNumber(hit.score) ?? Number.NEGATIVE_INFINITY;
   523	      return hitScore > bestScore ? hit : best;
   524	    },
   525	    null,
   526	  );
   527	  const topAnalogSymbols = [
   528	    ...new Set(
   529	      [...opseqAnalogs]
   530	        .sort(
   531	          (left, right) =>
   532	            (optionalNumber(right.score) ?? Number.NEGATIVE_INFINITY) -
   533	            (optionalNumber(left.score) ?? Number.NEGATIVE_INFINITY),
   534	        )
   535	        .map((hit) => optionalString(hit.analog_symbol))
   536	        .filter((symbol): symbol is string => Boolean(symbol)),
   537	    ),
   538	  ].slice(0, 2);
   539	  const topAnalogStableKeys = [
   540	    ...new Set(
   541	      [...opseqAnalogs]
   542	        .sort(
   543	          (left, right) =>
   544	            (optionalNumber(right.score) ?? Number.NEGATIVE_INFINITY) -
   545	            (optionalNumber(left.score) ?? Number.NEGATIVE_INFINITY),
   546	        )
   547	        .map((hit) => {
   548	          const analogUnit = optionalString(hit.analog_unit);
   549	          const analogSymbol = optionalString(hit.analog_symbol);
   550	          return analogUnit && analogSymbol
   551	            ? `${analogUnit}:${analogSymbol}`
   552	            : undefined;
   553	        })
   554	        .filter((stableKey): stableKey is string => Boolean(stableKey)),
   555	    ),
   556	  ].slice(0, 2);
   557	  const unitNames = asRecordArray(card.units)
   558	    .map((unit) => optionalString(unit.unit) ?? optionalString(unit.name))
   559	    .filter((unit): unit is string => Boolean(unit));
   560	  const sameFileSymbols = sameFileFunctions
   561	    .map((fn) => optionalString(fn.symbol) ?? functionName(fn))
   562	    .filter(Boolean)
   563	    .slice(0, 8);
   564	  const mismatchQueries = mismatchPatterns
   565	    .map((pattern) => optionalString(pattern.title))
   566	    .filter((title): title is string => Boolean(title))
   567	    .slice(0, 4);
   568	  const followUpQueries = [
   569	    compactObject({ tool: "code_graph_file_card", source_path: sourcePath }),
   570	    compactObject({
   571	      tool: "code_graph_search",
   572	      query: [sourcePath, targetSymbol].filter(Boolean).join(" "),
   573	    }),
   574	    compactObject({
   575	      tool: "graph_related_functions",
   576	      source_path: sourcePath,
   577	      symbol: targetSymbol,
   578	    }),
   579	    compactObject({
   580	      tool: "kv2_pr_search",
   581	      query: [sourcePath, targetSymbol].filter(Boolean).join(" "),
   582	    }),
   583	    ...(targetStableKey
   584	      ? [
   585	          compactObject({
   586	            tool: "kv2_subject_record",
   587	            target_stable_key: targetStableKey,
   588	          }),
   589	          compactObject({
   590	            tool: "kv2_attempt_search",
   591	            target_stable_key: targetStableKey,
   592	          }),
   593	        ]
   594	      : []),
   595	    ...(mismatchQueries.length
   596	      ? [
   597	          compactObject({
   598	            tool: "knowledge_graph_search",
   599	            query: mismatchQueries.join(" OR "),
   600	          }),
   601	        ]
   602	      : []),
   603	    ...(topAnalogSymbols.length
   604	      ? [
   605	          compactObject({
   606	            tool: "kv2_attempt_search",
   607	            query: topAnalogSymbols.join(" OR "),
   608	          }),
   609	          ...topAnalogStableKeys.map((stableKey) => compactObject({
   610	            tool: "kv2_subject_record",
   611	            target_stable_key: stableKey,
   612	          })),
   613	          compactObject({
   614	            tool: "knowledge_graph_search",
   615	            query: topAnalogSymbols.join(" OR "),
   616	          }),
   617	        ]
   618	      : []),
   619	  ];
   620	  const attachmentCounts = {
   621	    same_file_functions: sameFileFunctions.length,
   622	    mismatch_patterns: mismatchPatterns.length,
   623	    touching_prs: touchingPrs.length,
   624	    resources: resourceHits.length,
   625	    opseq_analogs: opseqAnalogs.length,
   626	    review_risks: asRecordArray(prHistory.review_risks).length,
   627	    tactics: asRecordArray(prHistory.tactics).length,
   628	  };
   629	  const hasGraphContext =
   630	    functions.length > 0 ||
   631	    Object.values(attachmentCounts).some((count) => count > 0);
   632	  const cardSourcePath = optionalString(card.source_path) ?? sourcePath;
   633	  const authority =
   634	    "Graph-derived context. Current source, headers, objdiff, and validation output outrank this summary.";
   635	  const pastPrSearchTerms = [targetSymbol, sourcePath, ...mismatchQueries]
   636	    .filter(Boolean)
   637	    .slice(0, 8);
   638	  const searchLeads = (queries: Array<Record<string, unknown>>) => ({
   639	    symbols: {
   640	      source_path: cardSourcePath,
   641	      units: unitNames.slice(0, 4),
   642	      target_symbol: targetSymbol,
   643	      same_file_symbols: sameFileSymbols,
   644	    },
   645	    target_function: targetFunction,
   646	    top_opseq_analog: topOpseqAnalog ? compactToolHit(topOpseqAnalog) : null,
   647	    attachment_counts: attachmentCounts,
   648	    follow_up_queries: queries,
   649	    past_prs: {
   650	      search_terms: pastPrSearchTerms,
   651	    },
   652	  });
   653	  const noContextNote = !hasGraphContext
   654	    ? "Graph file card had no attached functions, patterns, PRs, resources, opseq analogs, review risks, or tactics for this source path."
   655	    : null;
   656	
   657	  if (contextBudget === "minimal") {
   658	    return compactObject({
   659	      status: "ready",
   660	      source: "code_graph_file_card",
   661	      context_budget: contextBudget,
   662	      authority,
   663	      graph_db: loaded.graphDb,
   664	      source_path: cardSourcePath,
   665	      editability: asRecord(card.editability),
   666	      has_graph_context: hasGraphContext,
   667	      search_leads: searchLeads(followUpQueries.slice(0, 3)),
   668	      no_context_note: noContextNote,
   669	    });
   670	  }
   671	
   672	  return compactObject({
   673	    status: "ready",
   674	    source: "code_graph_file_card",
   675	    context_budget: contextBudget,
   676	    authority,
   677	    graph_db: loaded.graphDb,
   678	    source_path: cardSourcePath,
   679	    editability: asRecord(card.editability),
   680	    has_graph_context: hasGraphContext,
   681	    search_leads: searchLeads(followUpQueries),
   682	    no_context_note: noContextNote,
   683	  });
   684	}
