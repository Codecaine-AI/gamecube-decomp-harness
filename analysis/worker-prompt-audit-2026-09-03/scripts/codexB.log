+function bestEvidence(fact: KnowledgeFact): V2FactSummary["evidence"] | undefined {
+  const evidence = [...fact.evidence].sort((a, b) => {
+    const preferred = (kind: string) => kind === "attempt" || kind === "pr" ? 1 : 0;
