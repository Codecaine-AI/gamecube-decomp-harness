      const renderedContext = first.kernelContext?.renderedContext ?? "";

      expect(renderedContext).toMatch(
        /<target_knowledge[^>]*unavailable="true"[^>]*reason="[^"]+"\s*\/>/,
      );
      expect(first.kernelContext?.inputs.map((input) => input.loaderKind)).toEqual([
        "worker-packet",
        "target-knowledge",
      ]);
