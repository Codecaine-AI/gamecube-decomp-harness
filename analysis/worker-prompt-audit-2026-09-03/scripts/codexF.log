export const MELEE_SESSION_CONTEXT_LOADER_KIND = "melee-session-context";
export const MELEE_INLINE_CONTEXT_LOADER_KINDS = [
  "worker-packet",
  "target-knowledge",
  "integration-conflict-item",
  "integration-queue-summary",
  "pr-index-context",
  "pr-slice-diff",
  "review-lint-findings",
